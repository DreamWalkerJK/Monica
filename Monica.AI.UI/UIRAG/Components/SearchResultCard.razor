@using System.Globalization
@using Microsoft.Extensions.Localization
@using Monica.AI.RAG.Models
@using Monica.AI.UI.Localization
@inject IStringLocalizer<AIResource> L

<article class="result-passage">
    <div class="result-layout">
    <div class="result-diagnostics">
        @if (Rank > 0) { <span class="result-rank">@L["KnowledgeWorkbench:Retrieval:Rank", Rank]</span> }
        <div class="score-evidence"><span>@PrimaryScoreLabel</span><strong title="@RawPrimaryScore">@PrimaryScoreText</strong></div>
        @if (Result.ScoreKind == TextSearchScoreKind.HybridRank && Result.SimilarityScore is not null)
        {
            <div class="score-evidence"><span>@L["RAG:Search:Score:HybridRankLabel"]</span><strong title="@FormatRaw(Result.Score)">@FormatScore(Result.Score)</strong></div>
        }
    </div>
    <div class="result-body">
        <h3>@(Result.SourceName ?? L["RAG:Search:Result:UnknownSource"].Value)</h3>
        <div class="result-provenance">
            <span>@(KnowledgeBaseName ?? Result.KnowledgeBaseId ?? L["RAG:Search:Result:MissingKnowledgeBase"].Value)</span>
            @if (!string.IsNullOrWhiteSpace(Result.SectionPath)) { <span>@Result.SectionPath</span> }
        </div>
        <p class="result-text">@Result.Text</p>
        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Description" OnClick="HandleClick" aria-label="@L["KnowledgeWorkbench:Retrieval:ViewSource", Result.SourceName ?? L["RAG:Search:Result:UnknownSource"].Value]">@L["RAG:Search:Result:ViewInDocument"]</MudButton>
    </div>
    </div>
</article>

@code {
    /// <summary>The returned passage and its original source identity.</summary>
    [Parameter, EditorRequired] public TextSearchResult Result { get; set; } = null!;
    /// <summary>The one-based display position in facade result order; zero hides the position.</summary>
    [Parameter] public int Rank { get; set; }
    /// <summary>The originating knowledge-base display name, falling back to result identity when absent.</summary>
    [Parameter] public string? KnowledgeBaseName { get; set; }
    /// <summary>Invoked by the native document inspection action.</summary>
    [Parameter] public EventCallback OnClick { get; set; }
    private double? PrimaryScore => Result.SimilarityScore ?? Result.Score;
    private string PrimaryScoreLabel => Result.SimilarityScore is not null || Result.ScoreKind == TextSearchScoreKind.VectorSimilarity
        ? L["RAG:Search:Score:SimilarityLabel"].Value : L["RAG:Search:Score:HybridRankLabel"].Value;
    private string PrimaryScoreText => FormatScore(PrimaryScore);
    private string RawPrimaryScore => FormatRaw(PrimaryScore);
    private string FormatScore(double? score) => score?.ToString("0.0000", CultureInfo.CurrentCulture) ?? L["KnowledgeWorkbench:Retrieval:ScoreMissing"].Value;
    private string FormatRaw(double? score) => score?.ToString("R", CultureInfo.InvariantCulture) ?? L["KnowledgeWorkbench:Retrieval:ScoreMissing"].Value;
    private Task HandleClick() => OnClick.InvokeAsync();
}
