@using Monica.AI.UI.UIChat.State
@using Microsoft.Extensions.Localization
@using Monica.AI.UI.Localization
@using Monica.AI.UI.UIChat.Support
@using Monica.UI.Shell.Support
@implements IAsyncDisposable
@inject IStringLocalizer<AIResource> L
@inject IJSRuntime JSRuntime
@inject IBrowserStorage BrowserStorage
<div class="chat-container" @ref="_root">
    <div class="reading-resize-guides @(ShowTrajectory ? "hidden-guides" : null)">
        <div class="reading-resize-handle left-handle" data-reading-resize="left" role="separator" tabindex="0" aria-orientation="vertical" aria-label="@L["Workbench:ResizeReadingWidth"]" title="@L["Workbench:ResizeReadingWidthHint"]"></div>
        <div class="reading-resize-handle right-handle" data-reading-resize="right" role="separator" tabindex="0" aria-orientation="vertical" aria-label="@L["Workbench:ResizeReadingWidth"]" title="@L["Workbench:ResizeReadingWidthHint"]"></div>
    </div>
    @if (State.HasHistoryConflict)
    {
        <MudAlert Severity="Severity.Warning" Dense="true">
            @L["Workbench:HistoryConflict"]
            <MudButton Size="Size.Small" OnClick="@State.ReloadHistoryAsync" Disabled="@(State.IsSending || State.IsUploading)">@L["Workbench:ReloadHistory"]</MudButton>
        </MudAlert>
    }
    <ChatErrorDisplay ErrorMessage="@State.ErrorMessage" OnDismissed="@State.DismissError" />
    @if (ShowTrajectory && State.CurrentSession is { } session)
    {
        <ChatTrajectory Session="@session" SelectedStep="@State.InspectedStep" />
    }
    else
    {
        <ChatMessageList Session="@State.CurrentSession" EnableMarkdown="@State.EnableMarkdown"
                         EnableAutoScroll="@State.EnableAutoScroll" IsSending="@State.IsSending"
                         OnEditMessage="@State.EditMessageAsync" OnRetryMessage="@State.RetryMessageAsync" OnInspect="@OnInspect" />
    }
    <ChatInputArea Disabled="@(State.HasHistoryConflict || State.IsHistoryUpdating)" IsSending="@State.IsSending" IsUploading="@State.IsUploading"
                   ModelName="@State.CurrentModelName"
                   Providers="@State.Providers" ProviderId="@State.CurrentProviderId" ShowProviderInfo="@State.ShowProviderSelector"
                   CurrentModel="@State.CurrentModel" ReasoningLevel="@State.CurrentSession?.Settings.ReasoningLevel"
                   ReasoningLevelChanged="@State.ChangeReasoningAsync"
                   ContextUsage="@State.CurrentSession?.ContextUsage" AutomaticCompaction="@(State.CurrentSession?.Settings.AutomaticCompaction ?? true)"
                   AutomaticCompactionChanged="@State.SetAutomaticCompactionAsync" OnCompact="@State.CompactAsync"
                   CompactionThreshold="@(State.CurrentSession?.Settings.CompactionThreshold ?? .8)" RetainedTurns="@(State.CurrentSession?.Settings.RetainedTurns ?? 4)"
                   OutputBudget="@State.CurrentSession?.Settings.MaxOutputTokens" CompactionPreferencesChanged="@State.SetCompactionPreferencesAsync"
                   SessionId="@State.CurrentSessionId" Attachments="@State.Attachments" OnUpload="@State.UploadAttachmentsAsync" OnRemoveAttachment="@State.RemoveAttachmentAsync"
                   CapabilityCandidates="@State.CapabilityCandidates" KnowledgeBases="@State.KnowledgeBases"
                   SelectedKnowledgeBaseIds="@State.SelectedKnowledgeBaseIds" SelectedKnowledgeBaseIdsChanged="@State.SetSelectedKnowledgeBases"
                   OnSend="@State.SendMessageAsync" OnCancel="@State.CancelAsync" OnModelChanged="@State.SelectModelAsync" />
</div>
@code {
    [Parameter, EditorRequired] public required ChatPageState State { get; set; }
    [Parameter] public bool ShowTrajectory { get; set; }
    [Parameter] public EventCallback<ChatExecutionStep> OnInspect { get; set; }
    private ElementReference _root;
    private ChatReadingWidthSession? _readingWidth;
    private bool _disposed;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _disposed) return;
        _readingWidth = new ChatReadingWidthSession(JSRuntime, BrowserStorage);
        await _readingWidth.InitializeAsync(_root);
    }
    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        var readingWidth = _readingWidth;
        _readingWidth = null;
        if (readingWidth is not null) await readingWidth.DisposeAsync();
    }
}
