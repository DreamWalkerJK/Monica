@using Microsoft.Extensions.Localization
@using Monica.AI.UI.Localization
@using Monica.Markdown.Abstractions
@using Monica.Markdown.Models
@using Monica.UI.Shared.Components.Markdown
@using Monica.AI.UI.Shared.Support
@implements IAsyncDisposable
@inject IServiceProvider ServiceProvider
@inject IStringLocalizer<AIResource> L

<MudDialog ContentClass="pa-0" Style="max-height:calc(100dvh - 24px);margin:12px">
    <DialogContent>
        <div class="chat-source-preview-root">
            @if (_isLoading)
            {
                <div class="chat-source-preview-loading">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        @L["Chat:SourcePreview:Loading"]
                    </MudText>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(_errorMessage))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true">
                    @_errorMessage
                </MudAlert>
            }
            else
            {
                <div class="chat-source-preview-header">
                    <div class="chat-source-preview-title-block">
                        <MudText Typo="Typo.h6">@GetDocumentTitle()</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @L["Chat:SourcePreview:Path", NormalizeSourcePath(SourcePath)]
                        </MudText>
                    </div>
                </div>

                <div class="chat-source-preview-content">
                    <MoMarkdown Value="@_content"
                                EnableMermaid="true"
                                ScopeKey="@_document?.GroupKey"
                                DocumentRelativePath="@_document?.RelativePath" />
                </div>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" OnClick="Close">
            @L["Common:Actions:Close"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter, EditorRequired]
    public required string SourcePath { get; set; }

    /// <summary>Optional exact catalog group. An unqualified path must match only one registered group.</summary>
    [Parameter] public string? SourceGroupKey { get; set; }

    private bool _isLoading = true;
    private string _errorMessage = string.Empty;
    private MarkdownDocument? _document;
    private string _content = string.Empty;
    private string _loadedSourcePath = string.Empty;
    private readonly AIAdministrationOperationLifetime _reads = new();
    private int _generation;
    private string? _loadedGroup;

    protected override Task OnParametersSetAsync()
    {
        var normalizedSourcePath = NormalizeSourcePath(SourcePath);
        if (_reads.IsRetired || string.Equals(_loadedSourcePath, normalizedSourcePath, StringComparison.OrdinalIgnoreCase) && _loadedGroup == SourceGroupKey)
        {
            return Task.CompletedTask;
        }
        _loadedSourcePath = normalizedSourcePath;
        _loadedGroup = SourceGroupKey;
        var generation = ++_generation;
        var groupKey = SourceGroupKey;
        return _reads.RunAsync(token => LoadAsync(normalizedSourcePath, groupKey, generation, token));
    }

    private async Task LoadAsync(string normalizedSourcePath, string? groupKey, int generation, CancellationToken token)
    {
        _isLoading = true;
        _errorMessage = string.Empty;
        _document = null;
        _content = string.Empty;

        var markdownService = ServiceProvider.GetService(typeof(IMarkdownDocumentCatalog)) as IMarkdownDocumentCatalog;
        if (markdownService is null)
        {
            _errorMessage = L["Chat:SourcePreview:Unavailable"];
            _isLoading = false;
            return;
        }

        try
        {
            if (Uri.TryCreate(normalizedSourcePath, UriKind.Absolute, out var uri) && uri.Scheme is "http" or "https")
            { _errorMessage = L["Chat:SourcePreview:NotFound", normalizedSourcePath]; return; }
            var matches = await FindDocumentsByPathAsync(markdownService, normalizedSourcePath, groupKey, token);
            if (_reads.IsRetired || generation != _generation) return;
            if (matches.Count > 1)
            { _errorMessage = L["Chat:SourcePreview:Ambiguous"]; return; }
            var document = matches.SingleOrDefault();
            if (document is null)
            {
                _errorMessage = L["Chat:SourcePreview:NotFound", normalizedSourcePath];
                return;
            }

            var content = await markdownService.GetDocumentContentAsync(document);
            if (_reads.IsRetired || generation != _generation) return;
            _document = document;
            _content = content;
        }
        catch (OperationCanceledException) when (token.IsCancellationRequested) { }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            if (!_reads.IsRetired && generation == _generation) _errorMessage = L["Chat:SourcePreview:LoadFailed", ex.Message];
        }
        finally
        {
            if (!_reads.IsRetired && generation == _generation) _isLoading = false;
        }
    }

    private void Close() => MudDialog.Close();

    private string GetDocumentTitle()
        => _document?.Title is { Length: > 0 } title
            ? title
            : L["Chat:SourcePreview:FallbackTitle"];

    private static async Task<List<MarkdownDocument>> FindDocumentsByPathAsync(
        IMarkdownDocumentCatalog markdownService,
        string documentPath, string? groupKey, CancellationToken token)
    {
        var matches = new List<MarkdownDocument>();
        var groups = await markdownService.GetAllDocumentGroupsAsync();
        token.ThrowIfCancellationRequested();
        foreach (var group in groups.Where(group => groupKey is null || group.Key == groupKey))
        {
            var documents = await markdownService.GetDocumentsAsync(group.Key);
            token.ThrowIfCancellationRequested();
            matches.AddRange(documents.Where(document => string.Equals(document.RelativePath, documentPath, StringComparison.OrdinalIgnoreCase)));
        }
        return matches;
    }

    public ValueTask DisposeAsync() => _reads.RetireAsync();

    private static string NormalizeSourcePath(string value)
        => Uri.UnescapeDataString(value.Replace('\\', '/')).Trim().TrimStart('/');
}
