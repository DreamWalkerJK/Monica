@using Microsoft.Extensions.Localization
@using Monica.AI.UI.Localization
@using Monica.AI.UI.UIChat.Support
@implements IAsyncDisposable
@inject IStringLocalizer<AIResource> L

<div class="message-list" @ref="_messageListRef">
    @if (Session?.Turns.Count is not > 0)
    {
        <div class="welcome-panel">
            <span class="welcome-eyebrow">@L["Workbench:WelcomeEyebrow"]</span>
            <MudText Typo="Typo.h4">@L["Workbench:WelcomeTitle"]</MudText>
            <MudText Typo="Typo.body1" Class="welcome-subtitle">@L["Workbench:WelcomeDescription"]</MudText>
            <div class="welcome-features">
                <span><MudIcon Icon="@Icons.Material.Outlined.AttachFile" Size="Size.Small" />@L["Workbench:WelcomeAttachments"]</span>
                <span><MudIcon Icon="@Icons.Material.Outlined.AccountTree" Size="Size.Small" />@L["Workbench:WelcomeTools"]</span>
                <span><MudIcon Icon="@Icons.Material.Outlined.Timeline" Size="Size.Small" />@L["Workbench:WelcomeTrajectory"]</span>
            </div>
        </div>
    }
    else
    {
        <div class="transcript">
            @foreach (var turn in Session.Turns)
            {
                <section class="conversation-turn" @key="turn.Id">
                    <ChatMessageItem Message="@turn.UserMessage" SessionId="@Session.SessionId" Disabled="@IsSending" OnEdit="@OnEditMessage" />
                    @if (turn.AssistantMessage is { } assistant)
                    {
                        <ChatMessageItem Message="@assistant" SessionId="@Session.SessionId" EnableMarkdown="@EnableMarkdown"
                                         Steps="@turn.Steps" Status="@turn.Status" Running="@(turn.Status is ChatExecutionStatus.Running or ChatExecutionStatus.AwaitingApproval)"
                                         Disabled="@IsSending" OnRetry="@OnRetryMessage" OnInspect="@OnInspect" />
                    }
                    @foreach (var error in turn.ErrorMessages)
                    {
                        <ChatErrorMessageItem Message="@error" OnRetry="@OnRetryMessage" />
                    }
                </section>
            }
        </div>
    }
</div>
@code {
    [Inject] private IJSRuntime JSRuntime { get; set; } = null!;

    [Parameter] public ChatSession? Session { get; set; }
    [Parameter] public bool IsSending { get; set; }
    [Parameter] public bool EnableMarkdown { get; set; } = true;
    [Parameter] public EventCallback<ChatExecutionStep> OnInspect { get; set; }
    [Parameter] public bool EnableAutoScroll { get; set; } = true;
    [Parameter] public EventCallback<(AIChatMessage Message, string NewContent)> OnEditMessage { get; set; }
    [Parameter] public EventCallback<AIChatMessage> OnRetryMessage { get; set; }

    private ElementReference _messageListRef;
    private ChatMessageListInteropSession? _interopSession;
    private bool _disposed;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_disposed && firstRender && EnableAutoScroll)
        {
            _interopSession = new ChatMessageListInteropSession(JSRuntime);
            await _interopSession.InitializeAsync(_messageListRef);
        }
    }

    /// <summary>
    /// Scroll to the bottom of the message list
    /// </summary>
    public async Task ScrollToBottomAsync()
    {
        if (!_disposed && _interopSession is not null)
        {
            await _interopSession.ScrollToBottomAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        var interopSession = _interopSession;
        _interopSession = null;
        if (interopSession is not null)
        {
            await interopSession.DisposeAsync();
        }
    }
}
