@using Microsoft.Extensions.Localization
@using Monica.AI.UI.Localization
@using Monica.AI.UI.Shared.Support
@implements IAsyncDisposable
@inject IDialogService DialogService
@inject IStringLocalizer<AIResource> L

<div class="attachments">
    @foreach (var attachment in Attachments)
    {
        var originSession = SessionId;
        @if (attachment.Kind == ChatAttachmentKind.Image && SessionId is not null)
        {
            <ChatAttachmentImage @key="(SessionId, attachment.Id)" Attachment="@attachment" SessionId="@SessionId" Removable="@Removable" Disabled="@Disabled" OnPreview="@(() => PreviewAsync(originSession, attachment))" OnRemove="@(() => OnRemove.InvokeAsync(attachment))" />
        }
        else
        {
        <MudChip CloseIcon="@MoIcons.Close" T="string" Variant="Variant.Outlined" Size="Size.Small" Disabled="@Disabled"
                 Icon="@(attachment.Kind == ChatAttachmentKind.Image ? MoIcons.Image : MoIcons.FileText)"
                 OnClick="@(() => PreviewAsync(originSession, attachment))" OnClose="@(Removable ? EventCallback.Factory.Create<MudChip<string>>(this, () => OnRemove.InvokeAsync(attachment)) : default)">
            @attachment.FileName <span class="attachment-size">@($"{attachment.Size / 1024d:0.#} KB")</span>
        </MudChip>
        }
    }
</div>
@code {
    [Parameter] public IReadOnlyList<ChatAttachmentReference> Attachments { get; set; } = [];
    [Parameter] public string? SessionId { get; set; }
    [Parameter] public bool Removable { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<ChatAttachmentReference> OnRemove { get; set; }
    private readonly AIAdministrationOperationLifetime _operations = new();
    private AIAdministrationDialogSession _dialogs = null!;
    private string? _originSessionId;
    private bool _openingPreview;
    private Task? _retirement;

    protected override void OnInitialized() => _dialogs = CreateDialogOwner();

    private AIAdministrationDialogSession CreateDialogOwner() => new(DialogService, action => InvokeAsync(action));

    protected override Task OnParametersSetAsync()
    {
        if (_originSessionId == SessionId || _operations.IsRetired) return Task.CompletedTask;
        _originSessionId = SessionId;
        var previous = _dialogs;
        _dialogs = CreateDialogOwner();
        // A reused attachment surface must close and drain its previous session's actual preview.
        return _operations.RunAsync(_ => previous.DisposeAsync().AsTask());
    }

    private async Task PreviewAsync(string? originSession, ChatAttachmentReference attachment)
    {
        if (_operations.IsRetired || _openingPreview || Disabled || originSession is null || originSession != SessionId
            || !Attachments.Any(current => current.Id == attachment.Id)) return;
        _openingPreview = true;
        var dialogs = _dialogs;
        try
        {
            await _operations.RunAsync(async token =>
            {
                token.ThrowIfCancellationRequested();
                await dialogs.ShowAsync<ChatAttachmentPreviewDialog>(attachment.FileName,
                    new() { [nameof(ChatAttachmentPreviewDialog.Attachment)] = attachment,
                        [nameof(ChatAttachmentPreviewDialog.SessionId)] = originSession },
                    new() { FullWidth = true, MaxWidth = MaxWidth.Large, CloseButton = true });
            });
        }
        catch (OperationCanceledException) when (_operations.IsRetired) { }
        finally { _openingPreview = false; }
    }

    /// <summary>Closes owned native previews and drains their reads without disposing the borrowed dialog service.</summary>
    public ValueTask DisposeAsync() => new(_retirement ??= RetireAsync());

    private async Task RetireAsync() => await Task.WhenAll(_operations.RetireAsync().AsTask(), _dialogs.DisposeAsync().AsTask());
}
