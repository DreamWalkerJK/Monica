@using System.Windows.Input
@using Microsoft.Extensions.Localization
@using Monica.AI.UI.Localization
@using Monica.AI.UI.UIChat.Support
@using Monica.UI.Shared.Components.Markdown
@inject IDialogService DialogService
@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject ISnackbar Snackbar
@inject IStringLocalizer<AIResource> L

<article class="message-wrapper @(IsUser ? "user-message" : "assistant-message")">
    @if (_isEditing)
    {
        <div class="edit-area">
            <MudTextField T="string" @bind-Value="_editContent" Variant="Variant.Outlined" Lines="3" Sizing="InputSizing.Auto" MaxLines="12" />
            <div class="edit-actions"><MudButton OnClick="HandleCancelEdit">@L["Common:Actions:Cancel"]</MudButton><MudButton Color="Color.Primary" OnClick="HandleSaveEdit">@L["Workbench:EditAndResend"]</MudButton></div>
        </div>
    }
    else
    {
        <div class="message-content">
            @if (!IsUser)
            {
                <ChatExecutionProcess Steps="@Steps" Running="@Running" FinalAnswerStepId="@FinalAnswerStepId" OnInspect="@OnInspect" />
            }
            @if (IsUser)
            {
                <div class="user-text"><AgentCapabilityReferenceText Text="@DisplayContent" /></div>
            }
            else if (!string.IsNullOrEmpty(DisplayContent))
            {
                @if (EnableMarkdown) { <MoMarkdown Value="@DisplayContent" EnableMermaid="true" Props="@_assistantMarkdownProps" /> }
                else { <div class="plain-text">@DisplayContent</div> }
            }
            @if (Message.Parts.Any(part => part.Attachment is not null))
            {
                <ChatAttachments Attachments="@Message.Parts.Where(part => part.Attachment is not null).Select(part => part.Attachment!).ToArray()" SessionId="@SessionId" />
            }
            @if (Running && string.IsNullOrEmpty(DisplayContent) && Steps.Count == 0)
            {
                <span class="waiting-label"><MudProgressCircular Size="Size.Small" Indeterminate="true" />@L["Workbench:Waiting"]</span>
            }
            <footer class="message-footer">
                <time datetime="@Message.CreatedAt.ToString("O")">@Message.CreatedAt.ToLocalTime().ToString("HH:mm:ss")</time>
                @if (Status is ChatExecutionStatus.Cancelled or ChatExecutionStatus.Interrupted or ChatExecutionStatus.AwaitingApproval)
                {
                    <MudText Typo="Typo.caption" Color="@ChatExecutionPresentation.StatusColor(Status.Value)">@ChatExecutionPresentation.Status(Status.Value, L)</MudText>
                }
                @if (!IsUser && Steps.Count > 0) { <ChatExecutionMetrics Steps="@Steps" /> }
                <div class="message-actions">
                    <MudIconButton Icon="@Icons.Material.Outlined.ContentCopy" Size="Size.Small" OnClick="HandleCopy" aria-label="@L["Chat:Actions:Copy"]" />
                    @if (IsUser) { <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" Disabled="@Disabled" OnClick="HandleStartEdit" aria-label="@L["Chat:Actions:Edit"]" /> }
                    else { <MudIconButton Icon="@Icons.Material.Outlined.Refresh" Size="Size.Small" Disabled="@Disabled" OnClick="HandleRetry" aria-label="@L["Chat:Actions:Retry"]" /> }
                </div>
            </footer>
        </div>
    }
</article>

@code {
    [Parameter] public required AIChatMessage Message { get; set; }
    [Parameter] public bool EnableMarkdown { get; set; } = true;
    [Parameter] public IReadOnlyList<ChatExecutionStep> Steps { get; set; } = [];
    [Parameter] public bool Running { get; set; }
    [Parameter] public ChatExecutionStatus? Status { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? SessionId { get; set; }
    [Parameter] public EventCallback<ChatExecutionStep> OnInspect { get; set; }
    private ChatExecutionStep? FinalRequest => Steps.LastOrDefault(step => step.Request is { Output.Count: > 0 });
    private string? FinalAnswerStepId => FinalRequest?.Request?.Output.Any(part => part.Kind == ChatContentKind.ToolCall) == false ? FinalRequest.Id : null;
    private string DisplayContent => IsUser || Steps.Count == 0 ? Message.Content
        : FinalAnswerStepId is not null ? string.Concat(FinalRequest!.Request!.Output.Where(part => part.Kind == ChatContentKind.Text).Select(part => part.Text)) : string.Empty;
    [Parameter] public EventCallback<(AIChatMessage Message, string NewContent)> OnEdit { get; set; }
    [Parameter] public EventCallback<AIChatMessage> OnRetry { get; set; }

    private bool IsUser => Message.Role == AIChatRole.User;
    private bool _isEditing;
    private string _editContent = string.Empty;

    private readonly MudMarkdownProps _assistantMarkdownProps = new();
    private ICommand? _assistantMarkdownLinkCommand;

    protected override void OnInitialized()
    {
        _assistantMarkdownLinkCommand = new AsyncCommand(HandleMarkdownLinkClickAsync);
        _assistantMarkdownProps.Link.Command = _assistantMarkdownLinkCommand;
    }

    private async Task HandleCopy()
    {
        var success = await JSRuntime.InvokeAsync<bool>("MoClipboard.copyText", DisplayContent);
        Snackbar.Add(success ? L["Chat:Clipboard:Copied"] : L["Chat:Clipboard:CopyFailed"],
                     success ? Severity.Success : Severity.Error);
    }

    private void HandleStartEdit()
    {
        _editContent = Message.Content;
        _isEditing = true;
    }

    private void HandleCancelEdit()
    {
        _isEditing = false;
        _editContent = string.Empty;
    }

    private async Task HandleSaveEdit()
    {
        if (string.IsNullOrWhiteSpace(_editContent))
        {
            Snackbar.Add(L["Chat:Validation:MessageRequired"], Severity.Warning);
            return;
        }

        _isEditing = false;
        await OnEdit.InvokeAsync((Message, _editContent));
        _editContent = string.Empty;
    }

    private async Task HandleRetry()
    {
        await OnRetry.InvokeAsync(Message);
    }

    private async Task HandleMarkdownLinkClickAsync(object? parameter)
    {
        try
        {
            if (parameter is not string targetUrl || string.IsNullOrWhiteSpace(targetUrl))
            {
                return;
            }

            if (TryResolveMarkdownSourcePath(targetUrl, out var sourcePath))
            {
                var parameters = new DialogParameters
                {
                    [nameof(ChatSourcePreviewDialog.SourcePath)] = sourcePath
                };

                await DialogService.ShowAsync<ChatSourcePreviewDialog>(
                    L["Chat:SourcePreview:Title"],
                    parameters,
                    new DialogOptions
                    {
                        CloseButton = true,
                        FullWidth = true,
                        MaxWidth = MaxWidth.Large
                    });
                return;
            }

            if (IsExternalUrl(targetUrl))
            {
                await JSRuntime.InvokeVoidAsync("open", targetUrl, "_blank");
                return;
            }

            NavigationManager.NavigateTo(targetUrl);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{L["Chat:SourcePreview:OpenFailed"]}: {ex.Message}", Severity.Error);
        }
    }

    private static bool TryResolveMarkdownSourcePath(string rawUrl, out string sourcePath)
    {
        sourcePath = string.Empty;
        if (string.IsNullOrWhiteSpace(rawUrl))
        {
            return false;
        }

        var trimmedUrl = rawUrl.Trim();
        if (trimmedUrl.StartsWith('#'))
        {
            return false;
        }

        if (Uri.TryCreate(trimmedUrl, UriKind.Absolute, out var absoluteUri))
        {
            if (!string.Equals(absoluteUri.Scheme, Uri.UriSchemeHttp, StringComparison.OrdinalIgnoreCase)
                && !string.Equals(absoluteUri.Scheme, Uri.UriSchemeHttps, StringComparison.OrdinalIgnoreCase))
            {
                return false;
            }

            var absolutePath = Uri.UnescapeDataString(absoluteUri.AbsolutePath);
            if (!absolutePath.EndsWith(".md", StringComparison.OrdinalIgnoreCase))
            {
                return false;
            }

            sourcePath = NormalizeSourcePath(absolutePath);
            return !string.IsNullOrWhiteSpace(sourcePath);
        }

        var withoutFragment = trimmedUrl.Split(['#', '?'], 2)[0];
        if (!withoutFragment.EndsWith(".md", StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        sourcePath = NormalizeSourcePath(withoutFragment);
        return !string.IsNullOrWhiteSpace(sourcePath);
    }

    private static bool IsExternalUrl(string targetUrl)
        => Uri.TryCreate(targetUrl, UriKind.Absolute, out var absoluteUri)
           && (string.Equals(absoluteUri.Scheme, Uri.UriSchemeHttp, StringComparison.OrdinalIgnoreCase)
               || string.Equals(absoluteUri.Scheme, Uri.UriSchemeHttps, StringComparison.OrdinalIgnoreCase));

    private static string NormalizeSourcePath(string value)
        => Uri.UnescapeDataString(value.Replace('\\', '/')).Trim().TrimStart('/');

    private sealed class AsyncCommand(Func<object?, Task> executeAsync) : ICommand
    {
        public event EventHandler? CanExecuteChanged
        {
            add { }
            remove { }
        }

        public bool CanExecute(object? parameter) => true;

        public async void Execute(object? parameter)
        {
            try
            {
                await executeAsync(parameter);
            }
            catch
            {
            }
        }
    }
}
