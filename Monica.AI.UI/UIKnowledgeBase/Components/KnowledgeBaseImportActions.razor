@using Microsoft.Extensions.Localization
@using Monica.AI.UI.Localization
@using Monica.AI.UI.UIKnowledgeBase.State
@inject IStringLocalizer<AIResource> L

<section class="import-shelf" aria-label="@L["KnowledgeWorkbench:AddSources"]">
    <div class="import-heading"><MoIcon Icon="@MoIcons.FilePlus" Size="1.5rem" /><div><h3>@L["KnowledgeWorkbench:AddSources"]</h3><p>@L["KnowledgeWorkbench:ImportHint"]</p></div></div>
    <div class="import-methods">
        <div class="markdown-import">
            <MudSelect OpenIcon="@MoIcons.ChevronDown" CloseIcon="@MoIcons.ChevronUp" CheckedIcon="@MoIcons.SquareCheck" UncheckedIcon="@MoIcons.Square" IndeterminateIcon="@MoIcons.SquareMinus" T="string" @bind-Value="SelectedMarkdownGroup" Label="@L["RAG:Indexing:MarkdownGroup"]" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(PageState.IsMarkdownGroupsLoading || PageState.MarkdownGroups.Count == 0)">
                @foreach (var group in PageState.MarkdownGroups) { <MudSelectItem T="string" Value="@group">@group</MudSelectItem> }
            </MudSelect>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@MoIcons.FolderOpen" OnClick="PageState.ShowDocumentImportDialogAsync" Disabled="@string.IsNullOrEmpty(SelectedMarkdownGroup)">@L["KnowledgeBase:DocumentImport:Add"]</MudButton>
        </div>
        <div class="file-import">
            <MudFileUpload T="IBrowserFile" Accept=".txt,.md,.pdf" MaximumFileCount="1" FilesChanged="PageState.UploadFileAsync">
                <CustomContent Context="upload"><MudButton Variant="Variant.Outlined" StartIcon="@MoIcons.FileUpload" OnClick="upload.OpenFilePickerAsync">@L["RAG:Indexing:UploadFile"]</MudButton></CustomContent>
            </MudFileUpload>
            <span>@L["KnowledgeWorkbench:UploadHint"]</span>
        </div>
    </div>
    @if (PageState.IsMarkdownGroupsLoading) { <MudProgressLinear Color="Color.Primary" Indeterminate="true" /> }
</section>
@code {
    /// <summary>Gets or sets the page-owned state that captures the originating collection before imports or uploads.</summary>
    [Parameter, EditorRequired] public required KnowledgeBaseManagePageState PageState { get; set; }
    private string? SelectedMarkdownGroup { get => PageState.SelectedMarkdownGroup; set => PageState.SelectedMarkdownGroup = value; }
}
