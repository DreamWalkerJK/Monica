@attribute [Route(PAGE_URL)]
@rendermode InteractiveServer
@implements IAsyncDisposable

<PageTitle>@L["Pages:AIChat:Title"]</PageTitle>
<HeadContent><link href="_content/Monica.AI.UI/css/ai-chat-page.css" rel="stylesheet" /></HeadContent>
@{
    RenderFragment history = @<div class="history-panel" role="@(_compactHistory && _sessionDrawerOpen ? "dialog" : "complementary")"
                                  aria-label="@L["Session:Conversations"]" aria-modal="@(_compactHistory && _sessionDrawerOpen ? "true" : null)">
        <SessionList Sessions="@PageState.Sessions" CurrentSessionId="@PageState.CurrentSessionId"
                     IsLoading="@PageState.IsHistoryLoading" OnNewSession="@CreateSessionAsync"
                     Disabled="@(PageState.IsHistoryBusy || PageState.HasHistoryConflict || PageState.HasHistoryLoadFailure)" ArchivedCount="@PageState.ArchivedSessions.Count"
                     OnSelectSession="@SelectSessionAsync" OnPinSession="@PageState.TogglePinAsync"
                     OnArchiveSession="@PageState.ArchiveSessionAsync" OnOpenArchive="@(() => _archiveOpen = true)"
                     ShowClose="@_compactHistory" OnClose="CloseSessionDrawer" />
    </div>;
}
<div class="ai-chat-shell" @ref="_shellElement" @onkeydown="HandleHistoryKeyDown" data-short="@(_layout.IsObserved && _layout.Height <= 600 ? "true" : "false")">
    <MudDrawerContainer Class="ai-chat-layout">
        @if (PageState.ShowSessionList)
        {
            <MudDrawer @key="_compactHistory" Open="_sessionDrawerOpen" OpenChanged="SetSessionDrawerOpen" Variant="@(_compactHistory ? DrawerVariant.Temporary : DrawerVariant.Persistent)" Fixed="false"
                       Width="@(_compactHistory ? "min(304px, calc(100% - 48px))" : "272px")" Elevation="0" Class="ai-session-drawer">
                @if (_compactHistory && _sessionDrawerOpen)
                {
                    <MudFocusTrap>@history</MudFocusTrap>
                }
                else
                {
                    @history
                }
            </MudDrawer>
        }
        <MudMainContent Class="ai-main">
          <div class="ai-main-surface" @ref="_mainElement">
            <header class="ai-topbar">
                <div class="topbar-left">
                    @if (PageState.ShowSessionList)
                    {
                        <MudIconButton Icon="@MoIcons.Menu" Size="Size.Small" OnClick="ToggleSessionDrawer" aria-label="@L["Session:ToggleHistory"]"
                                       aria-expanded="@(_sessionDrawerOpen ? "true" : "false")" />
                    }
                    <span class="conversation-title" title="@(PageState.CurrentSession?.Title ?? L["Pages:AIChat:Title"])">@(PageState.CurrentSession?.Title ?? L["Pages:AIChat:Title"])</span>
                </div>
                <div class="conversation-views" role="group" aria-label="@L["Workbench:Views"]">
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default" aria-pressed="@(!_trajectory ? "true" : "false")" OnClick="@(() => _trajectory = false)">@L["Workbench:Chat"]</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default" aria-pressed="@(_trajectory ? "true" : "false")" OnClick="@(() => _trajectory = true)">@L["Workbench:Trajectory"]</MudButton>
                </div>
                <div class="conversation-options">
                    <MudMenu Icon="@MoIcons.MoreHorizontal" AriaLabel="@L["Workbench:ConversationSettings"]" Dense="true">
                        <MudMenuItem OnClick="@PageState.OpenPromptSettingsAsync" Disabled="@PageState.IsInputBlocked">@L["Provider:Settings:SystemPrompt"]</MudMenuItem>
                        <MudMenuItem Href="/ai-providers">@L["Workbench:ProviderSettings"]</MudMenuItem>
                        <MudMenuItem Href="@AgentCapabilityManagePage.PAGE_URL">@L["Pages:AICapabilities:Title"]</MudMenuItem>
                    </MudMenu>
                </div>
            </header>
            @if (PageState.IsHistoryLoading)
            {
                <div class="history-loading" role="status"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /><span>@L["Chat:History:Loading"]</span></div>
            }
            else
            {
                <CascadingValue Value="_layout">
                    <ChatContainer State="@PageState" ShowTrajectory="@_trajectory" OnInspect="InspectStep" />
                </CascadingValue>
            }
          </div>
        </MudMainContent>
    </MudDrawerContainer>
</div>
<ChatArchiveDialog @bind-Open="_archiveOpen" Sessions="@PageState.ArchivedSessions"
                   Disabled="@(PageState.IsHistoryBusy || PageState.HasHistoryLoadFailure)" HasConflict="@PageState.HasHistoryConflict"
                   RestoreSessions="@PageState.RestoreArchivedSessionsAsync" DeleteSessions="@PageState.DeleteArchivedSessionsAsync" />
