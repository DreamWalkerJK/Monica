@using Microsoft.Extensions.Localization
@using ModelContextProtocol.Client
@using Monica.AI.Mcp.Facades
@using Monica.AI.Mcp.Models
@using Monica.AI.UI.Localization
@implements IAsyncDisposable
@inject McpFacade McpFacade
@using Monica.UI.Shared.Components.Dialogs
@inject IStringLocalizer<AIResource> L

<MudDialog Style="width:calc(100vw - 24px);max-height:calc(100dvh - 24px);margin:12px" Gutters="false" TitleClass="pa-0" ContentClass="pa-0" ActionsClass="pa-0">
    <TitleContent>
        <div class="external-mcp-heading">
            <MoDialogHeading Text="@(IsEdit ? L["Capabilities:Mcp:Dialog:EditTitle"] : L["Capabilities:Mcp:Dialog:AddTitle"])" />
        </div>
    </TitleContent>
    <DialogContent>
        <div class="external-mcp-form">
        <MudForm>
            <fieldset class="profile-fields" disabled="@_isSaving">
            <div class="profile-groups">
                <section class="profile-section">
                <h3>@L["Capabilities:Mcp:Dialog:IdentityEndpoint"]</h3>
                <MudTextField T="string"
                              Value="@Name"
                              ValueChanged="OnNameChanged"
                              Label="@L["Capabilities:Mcp:Dialog:Name"]"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Disabled="@(IsEdit || _isSaving)"
                              Required="true"
                              RequiredError="@L["Common:Validation:Required"]" />

                <MudTextField Disabled="@_isSaving" T="string"
                              @bind-Value="@Description"
                              Label="@L["Capabilities:Mcp:Dialog:Description"]"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Lines="2"
                              Immediate="true"
                              Required="true"
                              RequiredError="@L["Common:Validation:Required"]" />

                <MudTextField Disabled="@_isSaving" T="string"
                              @bind-Value="@Endpoint"
                              Label="@L["Capabilities:Mcp:Dialog:Endpoint"]"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Required="true"
                              RequiredError="@L["Common:Validation:Required"]"
                              Error="@(!string.IsNullOrWhiteSpace(EndpointValidationMessage))"
                              ErrorText="@EndpointValidationMessage" />

                <div class="connection-grid">
                        <MudSelect Disabled="@_isSaving" T="HttpTransportMode"
                                   @bind-Value="@TransportMode"
                                   Label="@L["Capabilities:Mcp:Dialog:TransportMode"]"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense">
                            <MudSelectItem T="HttpTransportMode" Value="HttpTransportMode.AutoDetect">AutoDetect</MudSelectItem>
                            <MudSelectItem T="HttpTransportMode" Value="HttpTransportMode.StreamableHttp">StreamableHttp</MudSelectItem>
                            <MudSelectItem T="HttpTransportMode" Value="HttpTransportMode.Sse">Sse</MudSelectItem>
                        </MudSelect>

                        <MudNumericField Disabled="@_isSaving" T="int"
                                         @bind-Value="@ConnectionTimeoutSeconds"
                                         Label="@L["Capabilities:Mcp:Dialog:Timeout"]"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense"
                                         Immediate="true"
                                         Min="1"
                                         Max="300" />
                </div>

                </section>
                <section class="profile-section">
                <h3>@L["Capabilities:Mcp:Dialog:AgentExposure"]</h3>
                <p class="form-help">@L["Capabilities:Mcp:Dialog:ExposureHelp"]</p>
                <MudSwitch Disabled="@_isSaving" T="bool"
                           @bind-Value="@IsAgentToolEnabled"
                           Color="Color.Primary"
                           Label="@L["Capabilities:Mcp:Dialog:ExposeTools"]" />

                </section>
                <section class="profile-section headers-section">
                    <div class="headers-title-row">
                        <h3>@L["Capabilities:Mcp:Dialog:Headers"]</h3>
                        <MudButton Variant="Variant.Text"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="AddHeader">
                            @L["Capabilities:Mcp:Dialog:AddHeader"]
                        </MudButton>
                    </div>

                    <p class="form-help">@L["Capabilities:Mcp:Dialog:HeadersHelp"]</p>
                    @if (_headers.Count == 0)
                    {
                        <MudText Typo="Typo.body2">
                            @L["Capabilities:Mcp:Dialog:NoHeaders"]
                        </MudText>
                    }
                    else
                    {
                        <div class="headers-list">
                            @foreach (var header in _headers)
                            {
                                <div class="header-row" @key="header">
                                    <div class="header-row-heading">
                                        <span>@(string.IsNullOrWhiteSpace(header.Name) ? L["Capabilities:Mcp:Dialog:HeaderName"] : header.Name)</span>
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Color="Color.Error"
                                                   Size="Size.Small"
                                                   OnClick="@(() => RemoveHeader(header))"
                                                   aria-label="@L["Capabilities:Mcp:Dialog:RemoveHeader"]" />

                                    </div>
                                    <div class="header-fields">
                                    <MudTextField Disabled="@_isSaving" T="string"
                                                  @bind-Value="@header.Name"
                                                  Label="@L["Capabilities:Mcp:Dialog:HeaderName"]"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  Immediate="true" />
                                    <MudTextField Disabled="@_isSaving" T="string"
                                                  @bind-Value="@header.Value"
                                                  Label="@L["Capabilities:Mcp:Dialog:HeaderValue"]"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense"
                                                  Immediate="true"
                                                  InputType="InputType.Password"
                                                  autocomplete="new-password" />
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </section>

                <section class="profile-section">
                <h3>@L["Capabilities:Mcp:Dialog:TestResult"]</h3>
                <p class="form-help">@L["Capabilities:Mcp:Dialog:TestHelp"]</p>
                @if (_testedProfile is not null && !TestResultMatches)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">@L["Capabilities:Mcp:Dialog:DraftChanged"]</MudAlert>
                }
                @if (_error is not null && (!_errorIsTest || TestResultMatches))
                {
                    <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
                }
                @if (_lastTestResult is not null && TestResultMatches)
                {
                    <MudAlert Severity="@(_lastTestResult.Success ? Severity.Success : Severity.Error)" Dense="true">
                        <div class="test-result">
                            <MudText Typo="Typo.body2">@FormatConnectivityMessage(_lastTestResult)</MudText>
                            @if (_lastTestResult.Success)
                            {
                                <MudText Typo="Typo.caption">
                                    @L["Capabilities:Mcp:Dialog:DiscoveredTools", _lastTestResult.ToolCount]
                                </MudText>
                                @if (_lastTestResult.ToolNames?.Count > 0)
                                {
                                    <div class="test-tool-list">
                                        @foreach (var toolName in _lastTestResult.ToolNames)
                                        {
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@toolName</MudChip>
                                        }
                                    </div>
                                }
                            }
                        </div>
                    </MudAlert>
                }
                </section>
            </div>
            </fieldset>
        </MudForm>
        </div>
    </DialogContent>
    <DialogActions>
        <div class="external-mcp-actions">
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.NetworkPing"
                   Disabled="@(!CanSubmit)"
                   aria-disabled="@((_isTesting || _isSaving || !CanSubmit).ToString().ToLowerInvariant())"
                   OnClick="TestAsync">
            @if (_isTesting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
            }
            @L["Capabilities:Mcp:Test"]
        </MudButton>
        <div class="profile-final-actions">
        <MudButton OnClick="Cancel">@L["Common:Cancel"]</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   Disabled="@(!CanSubmit)"
                   aria-disabled="@((_isTesting || _isSaving || !CanSubmit).ToString().ToLowerInvariant())"
                   OnClick="SubmitAsync">
            @(SubmitText ?? L["Common:Actions:Save"].Value)
        </MudButton>
        </div>
        </div>
    </DialogActions>
</MudDialog>
