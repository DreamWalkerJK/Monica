@using Microsoft.Extensions.Localization
@using Monica.AI.UI.Localization
@inject IStringLocalizer<AIResource> L

<div class="provider-selector">
    <MudMenu Label="@(Providers.FirstOrDefault(p => p.ProviderId == SelectedProviderId)?.DisplayName ?? L["Provider:Label"])"
             EndIcon="@Icons.Material.Filled.ExpandMore" AriaLabel="@L["Provider:Label"]" Dense="true" Disabled="@Disabled">
        @foreach (var provider in Providers)
        {
            <MudMenuItem OnClick="@(() => SelectedProviderIdChanged.InvokeAsync(provider.ProviderId))"
                         Icon="@(provider.ProviderId == SelectedProviderId ? Icons.Material.Filled.Check : null)">
                @provider.DisplayName
            </MudMenuItem>
        }
    </MudMenu>
</div>

@code {
    [Parameter] public IReadOnlyList<AIProviderInfo> Providers { get; set; } = [];
    [Parameter] public string? SelectedProviderId { get; set; }
    [Parameter] public string? SelectedModelName { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public EventCallback<string> SelectedProviderIdChanged { get; set; }
}
