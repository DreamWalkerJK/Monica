@using Microsoft.Extensions.Localization
@using Monica.AI.Configuration.Models
@using Monica.AI.UI.Localization
@inject IStringLocalizer<AIResource> L

<div class="model-capabilities">
    @if (Model.Kind == AIModelKind.Embedding)
    {
        <span class="capability-badge embedding"><MoIcon Icon="@MoIcons.Brackets" Size="1.5rem" />@L["Settings:Embedding"]</span>
    }
    else
    {
        <span class="capability-badge"><MoIcon Icon="@MoIcons.Type" Size="1.5rem" />@L["Settings:TextInput"]</span>
        @if (Model.SupportsImage == true) { <span class="capability-badge image"><MoIcon Icon="@MoIcons.Image" Size="1.5rem" />@L["Settings:ImageInput"]</span> }
        @if (Model.SupportsDocuments == true) { <span class="capability-badge document"><MoIcon Icon="@MoIcons.FileText" Size="1.5rem" />@L["Settings:NativeDocuments"]</span> }
        @if (Model.SupportsTools == true) { <span class="capability-badge tool"><MoIcon Icon="@MoIcons.Wrench" Size="1.5rem" />@L["Settings:FunctionTools"]</span> }
        @if (Model.SupportsReasoning == true) { <span class="capability-badge reasoning"><MoIcon Icon="@MoIcons.Brain" Size="1.5rem" />@L["Workbench:Reasoning"]</span> }
        @if (Model.SupportsImage is null || Model.SupportsDocuments is null || Model.SupportsTools is null || Model.SupportsReasoning is null)
        {
            <MudTooltip Text="@L["Settings:UnknownCapabilitiesHelp"]"><span class="unknown-capabilities"><MoIcon Icon="@MoIcons.Info" Size="1.5rem" />@L["Settings:PartiallyKnown"]</span></MudTooltip>
        }
    }
</div>

@code {
    /// <summary>Model metadata to summarize; unknown capabilities remain visibly unverified.</summary>
    [Parameter, EditorRequired] public required AIModelConfiguration Model { get; set; }
}
