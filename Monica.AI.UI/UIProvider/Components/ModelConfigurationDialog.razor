@using Microsoft.Extensions.Localization
@using Monica.AI.Configuration.Models
@using Monica.AI.Providers
@using Monica.AI.UI.Localization
@inject IStringLocalizer<AIResource> L
@implements IDisposable

<MudDialog>
    <DialogContent>
        <div class="model-form">
            <div class="metadata-heading">
                <span>@L["Settings:ModelHelp"]</span>
                @if (OnDiscover is not null)
                {
                    <MudButton Size="Size.Small" StartIcon="@Icons.Material.Outlined.AutoFixHigh" Disabled="@(Busy || string.IsNullOrWhiteSpace(_name))" OnClick="FetchMetadataAsync">@L["Settings:FillMetadata"]</MudButton>
                }
            </div>
            <fieldset class="model-fields" disabled="@Busy">
                <MudTextField T="string" @bind-Value="_name" Label="@L["Settings:ModelId"]" Required="true" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <div class="form-grid">
                    <MudTextField T="string" @bind-Value="_display" Label="@L["Settings:DisplayName"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    <MudSelect T="AIModelKind" @bind-Value="_kind" Label="@L["Settings:ModelKind"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                        <MudSelectItem T="AIModelKind" Value="@AIModelKind.Chat">@L["Workbench:Chat"]</MudSelectItem>
                        <MudSelectItem T="AIModelKind" Value="@AIModelKind.Embedding">@L["Settings:Embedding"]</MudSelectItem>
                    </MudSelect>
                </div>
                <section class="form-grid limits-section">
                    <div>
                        <ModelSettingLabel Label="@L["Workbench:ContextCapacity"]" Help="@L["Settings:ContextLimitHelp"]" />
                        <MudTextField T="string" @bind-Value="_contextText" Immediate="true" Placeholder="256K" aria-label="@L["Workbench:ContextCapacity"]"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Error="@InvalidContext" ErrorText="@L["Settings:InvalidTokenQuantity"]" />
                        <span class="limit-preview">@TokenPreview(_contextText, _kind == AIModelKind.Chat)</span>
                    </div>
                    <div>
                        <ModelSettingLabel Label="@L["Settings:MaxOutput"]" Help="@L["Settings:OutputLimitHelp"]" />
                        <MudTextField T="string" @bind-Value="_outputText" Immediate="true" Placeholder="32K" aria-label="@L["Settings:MaxOutput"]"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Error="@InvalidOutput" ErrorText="@L["Settings:InvalidTokenQuantity"]" />
                        <span class="limit-preview">@TokenPreview(_outputText, false)</span>
                    </div>
                </section>
                @if (_kind == AIModelKind.Embedding)
                {
                    <MudNumericField T="int?" @bind-Value="_dimensions" Label="@L["Settings:EmbeddingDimensions"]" Min="1" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" />
                }
                else
                {
                    <section>
                        <ModelSettingLabel Label="@L["Settings:InputTypes"]" Help="@L["Settings:InputTypesHelp"]" />
                        <div class="capability-choices">
                            <ModelCapabilityCheckbox Label="@L["Settings:TextInput"]" Value="true" Disabled="true" Locked="true" />
                            <ModelCapabilityCheckbox Label="@L["Settings:ImageInput"]" @bind-Value="_images" Disabled="@Busy" />
                            <ModelCapabilityCheckbox Label="@L["Settings:NativeDocuments"]" @bind-Value="_documents" Disabled="@Busy" />
                        </div>
                    </section>
                    <section>
                        <ModelSettingLabel Label="@L["Settings:Capabilities"]" Help="@L["Settings:CapabilityHelp"]" />
                        <div class="capability-choices">
                            <ModelCapabilityCheckbox Label="@L["Settings:FunctionTools"]" @bind-Value="_tools" Disabled="@Busy" />
                            <ModelCapabilityCheckbox Label="@L["Workbench:Reasoning"]" Value="@_reasoning" ValueChanged="SetReasoning" Disabled="@Busy" />
                        </div>
                    </section>
                    @if (_reasoning != false)
                    {
                        <section>
                            <ModelSettingLabel Label="@L["Settings:ReasoningLevels"]" Help="@L["Settings:ReasoningLevelsHelp"]" />
                            <ModelReasoningPicker Selected="@SelectedLevelIds" SelectedChanged="SetLevels"
                                                  @bind-DefaultLevel="_defaultReasoning" Disabled="@Busy" />
                            <span class="limit-preview">@L["Settings:ReasoningDefaultSummary", _defaultReasoning ?? L["Settings:ReasoningAuto"]]</span>
                        </section>
                        <details class="advanced-settings">
                            <summary>@L["Settings:AdvancedMappings"]</summary>
                            <p>@L["Settings:MappingHelp"]</p>
                            @foreach (var level in _levels)
                            {
                                <div class="reasoning-row @(ProviderType == EAIProviderType.Anthropic ? "has-budget" : null)" @key="level">
                                    <MudTextField T="string" @bind-Value="level.Id" Label="@L["Settings:LevelId"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    <MudTextField T="string" @bind-Value="level.DisplayName" Label="@L["Settings:DisplayName"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    <MudTextField T="string" @bind-Value="level.ProviderValue" Label="@L["Settings:ProviderValue"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    @if (ProviderType == EAIProviderType.Anthropic)
                                    {
                                        <MudNumericField T="int?" @bind-Value="level.Budget" Label="@L["Settings:ThinkingBudget"]" Min="1024" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    }
                                    <MudIconButton Icon="@Icons.Material.Outlined.Close" Size="Size.Small" OnClick="@(() => RemoveLevel(level))" aria-label="@L["Settings:RemoveLevel"]" />
                                </div>
                            }
                            <MudButton Size="Size.Small" StartIcon="@Icons.Material.Outlined.Add" OnClick="AddLevel">@L["Settings:AddLevel"]</MudButton>
                        </details>
                    }
                }
            </fieldset>
            @if (_fetching) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" /> }
            @if (_metadataMessage is not null) { <MudAlert Severity="Severity.Info" Dense="true">@_metadataMessage</MudAlert> }
            @if (_error is not null) { <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert> }
        </div>
    </DialogContent>
    <DialogActions>
        <div class="model-dialog-actions">
            <MudButton Disabled="@Busy" OnClick="Reset">@L["Settings:ResetForm"]</MudButton>
            <div><MudButton Disabled="@_saving" OnClick="@(() => Dialog.Cancel())">@L["Common:Actions:Cancel"]</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync" Disabled="@Busy">@L["Common:Actions:Save"]</MudButton></div>
        </div>
    </DialogActions>
</MudDialog>
