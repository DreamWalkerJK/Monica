@using Monica.Core.Localization.Abstractions
@using Monica.UI.Shell.Models
@using Monica.UI.Shell.Support
@inject ILocalizationCatalog LocalizationCatalog

<div class="@(ShowPageIcons ? "mo-navigation-tree" : "mo-navigation-tree is-quiet")">
    @foreach (var item in Group.Items)
    {
            <MudNavLink Href="@item.Href" Icon="@(ShowPageIcons ? item.Icon : null)" Match="NavLinkMatch.All"
                        Class="@(item == ActiveItem ? "active" : null)">
                @if (ShowPageIcons)
                {
                    @item.ResolveText(LocalizationCatalog)
                }
                else
                {
                    <span class="mo-navigation-tree__destination"><span class="mo-navigation-tree__dot" aria-hidden="true"></span>@item.ResolveText(LocalizationCatalog)</span>
                }
            </MudNavLink>
    }
    @foreach (var child in Group.Children)
    {
        <MudNavGroup @key="child.Id" Title="@child.DisplayName" Icon="@(ShowPageIcons ? child.Icon : null)" ExpandIcon="@ShellIcons.ChevronDown"
                     Expanded="@ContainsActive(child)">
            <NavigationTree Group="@child" ActiveItem="@ActiveItem" ShowPageIcons="@ShowPageIcons" />
        </MudNavGroup>
    }
</div>

@code {
    /// <summary>The authorized branch whose direct items and nested children are rendered.</summary>
    [Parameter, EditorRequired] public NavigationGroup Group { get; set; } = default!;
    /// <summary>The single longest matching destination in the complete navigation tree.</summary>
    [Parameter] public NavigationItem? ActiveItem { get; set; }

    /// <summary>Gets or sets whether leaf destinations show their registered icons. Defaults to true; false uses quiet dots in overview menus.</summary>
    [Parameter] public bool ShowPageIcons { get; set; } = true;

    private bool ContainsActive(NavigationGroup group) =>
        ActiveItem is not null && NavigationTreeBuilder.Flatten([group]).Contains(ActiveItem);
}
