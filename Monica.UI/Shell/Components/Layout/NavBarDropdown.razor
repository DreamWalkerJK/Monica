@using Monica.UI.Shell.Models
@using Monica.UI.Shell.Support

<div class="navbar-item" data-navigation-category-id="@Group.Id.Value">
    <NavigationPopover Group="@Group" ActiveItem="@ActiveItem" Label="@Group.DisplayName" StartIcon="@Group.Icon"
                       Header="@Group.DisplayName" HeaderDescription="@Group.Description"
                       ShowOverview="true" OpenOnHover="true" Class="@MenuClass" />
</div>

@code {
    [Parameter, EditorRequired] public NavigationGroup Group { get; set; } = default!;
    [Parameter] public NavigationItem? ActiveItem { get; set; }
    private string MenuClass => ActiveItem is not null && NavigationTreeBuilder.Flatten([Group]).Contains(ActiveItem)
        ? "navbar-menu navbar-link is-active" : "navbar-menu navbar-link";
}
