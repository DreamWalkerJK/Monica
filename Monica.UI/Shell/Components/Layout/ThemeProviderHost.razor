@inject ThemeState ThemeService
@inject IBrowserStorage BrowserStorage
@inject IJSRuntime JSRuntime
@using Monica.UI.Shell.State
@using Monica.UI.Shell.Support
@implements IAsyncDisposable

<MudMarkdownThemeProvider Theme="@ThemeService.CurrentTheme" IsDarkMode="@ThemeService.IsDarkMode" DefaultScrollbar="true" />

<div class="@ThemeService.GetThemeCssClass()" data-theme="@ThemeService.GetThemeDataAttribute()">
    @ChildContent
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private ThemeProviderHostSession? _themeSession;

    protected override void OnInitialized()
    {
        _themeSession = new ThemeProviderHostSession(
            ThemeService,
            BrowserStorage,
            JSRuntime,
            () => InvokeAsync(StateHasChanged));
    }

    protected override Task OnAfterRenderAsync(bool firstRender) =>
        firstRender && _themeSession is { } session ? session.InitializeAsync() : Task.CompletedTask;

    public ValueTask DisposeAsync() => _themeSession?.DisposeAsync() ?? ValueTask.CompletedTask;
}
