@using Microsoft.Extensions.Options
@using Monica.Modules
@using Monica.UI.Localization
@using Monica.UI.Shell.Support
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject IOptions<ModuleShellUIOption> Options
@inject IStringLocalizer<NavigationSearchResource> L
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<MudIconButton Icon="@ShellIcons.Search" Color="Color.Default" Size="Size.Medium" Class="action-button"
               OnClick="RequestSearchAsync" aria-label="@L["Search:Action"]" title="@L["Search:Action"]" />

@code {
    private readonly CancellationTokenSource _lifetime = new();
    private readonly object _disposeSync = new();
    private NavigationSearchInteropSession<NavigationSearch>? _interop;
    private IDialogReference? _dialog;
    private Task? _openingTask;
    private Task? _resultTask;
    private Task? _disposeTask;
    private bool _disposed;

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _disposed)
        {
            return Task.CompletedTask;
        }

        _interop = new NavigationSearchInteropSession<NavigationSearch>(JSRuntime, this);
        return _interop.InitializeAsync("observeShortcut");
    }

    /// <summary>Opens the host's custom search callback or the built-in palette; repeated requests share one opening operation.</summary>
    [JSInvokable]
    public Task RequestSearchAsync() => InvokeAsync(() =>
    {
        if (_disposed || _dialog is not null)
        {
            return Task.CompletedTask;
        }

        return _openingTask is { IsCompleted: false } ? _openingTask : _openingTask = OpenAsync();
    });

    private async Task OpenAsync()
    {
        if (Options.Value.NavBarSearchAction is { } customSearch)
        {
            await customSearch();
            return;
        }

        var reference = await DialogService.ShowAsync<NavigationSearchDialog>(L["Search:Title"], new DialogOptions
        {
            NoHeader = true,
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Large,
            FullWidth = true
        });
        if (_disposed)
        {
            DialogService.Close(reference);
            return;
        }

        _dialog = reference;
        _resultTask = ObserveResultAsync(reference);
    }

    private async Task ObserveResultAsync(IDialogReference reference)
    {
        try
        {
            var result = await reference.Result.WaitAsync(_lifetime.Token);
            await InvokeAsync(() =>
            {
                if (_dialog == reference)
                {
                    _dialog = null;
                }

                if (!_disposed && result is { Canceled: false, Data: NavigationSearchEntry entry })
                {
                    Navigation.NavigateTo(entry.Item.Href);
                }
            });
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested)
        {
            // The shell no longer owns a result consumer after circuit teardown.
        }
    }

    public ValueTask DisposeAsync()
    {
        lock (_disposeSync)
        {
            _disposed = true;
            return new ValueTask(_disposeTask ??= DisposeCoreAsync());
        }
    }

    private async Task DisposeCoreAsync()
    {
        _lifetime.Cancel();
        try
        {
            if (_dialog is { } dialog) DialogService.Close(dialog);
            if (_openingTask is { } opening) await opening;
            if (_resultTask is { } result) await result;
        }
        finally
        {
            try
            {
                if (_interop is { } interop) await interop.DisposeAsync();
            }
            finally { _lifetime.Dispose(); }
        }
    }
}
