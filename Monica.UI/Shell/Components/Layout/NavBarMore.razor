@using Monica.UI.Shell.Models
@inject IStringLocalizer<SharedResource> L

<div class="navbar-more">
    <NavigationPopover Groups="@Categories" ActiveItem="@ActiveItem" Label="@L["NavBar:More"]"
                       Header="@L["NavBar:MoreModules"]" HeaderDescription="@L["NavBar:MorePages"]"
                       ShowOverview="true" Class="navbar-menu navbar-link"
                       AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" />
</div>

@code {
    [Parameter] public IReadOnlyList<NavigationGroup> Categories { get; set; } = [];
    [Parameter] public NavigationItem? ActiveItem { get; set; }
}
