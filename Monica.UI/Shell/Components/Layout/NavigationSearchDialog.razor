@using System.Globalization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.DependencyInjection
@using Monica.UI.Localization
@using Monica.UI.Shared.Components.Dialogs
@using Monica.UI.Shell.Support
@inject NavigationSearchCatalog Catalog
@inject PageAccessEvaluator PageAccess
@inject IStringLocalizer<NavigationSearchResource> L
@inject IServiceProvider Services
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<MudDialog Class="navigation-search-dialog" ContentClass="navigation-search-dialog-content" Gutters="false" DefaultFocus="DefaultFocus.FirstChild">
    <DialogContent>
        <div class="navigation-search" @ref="_root">
            <div class="search-input-row">
                <MoIcon Icon="@MoIcons.Search" Class="search-input-icon" />
                <MudTextField T="string" Value="@_query" ValueChanged="SetQuery" Immediate="true" Variant="Variant.Text"
                              Underline="false" Class="search-input" Placeholder="@L["Search:Placeholder"]"
                              aria-label="@L["Search:Action"]" role="combobox" aria-autocomplete="list"
                              aria-controls="@_listId" aria-expanded="true" aria-activedescendant="@ActiveResultId" />
                <MudButton Variant="Variant.Text" OnClick="Close" Class="search-close" aria-label="@L["Search:Close"]"><kbd>Esc</kbd></MudButton>
            </div>
            <div class="search-results-heading">
                <MoDialogHeading Text="@L["Search:Title"]" />
                <span aria-live="polite">@L["Search:ResultCount", _results.Count]</span>
            </div>
            <div class="search-results" id="@_listId" role="listbox" aria-label="@L["Search:Registry"]">
                @if (_loading)
                {
                    <div class="search-empty" role="status"><MudProgressCircular Indeterminate="true" Size="Size.Small" /><p>@L["Search:Loading"]</p></div>
                }
                else if (_results.Count == 0)
                {
                    <div class="search-empty">
                        <MoIcon Icon="@MoIcons.Search" Size="24px" />
                        <h2>@L[_entries.Count == 0 ? "Search:EmptyTitle" : "Search:NoMatchesTitle"]</h2>
                        <p>@L[_entries.Count == 0 ? "Search:EmptyDescription" : "Search:NoMatchesDescription"]</p>
                    </div>
                }
                else
                {
                    @for (var index = 0; index < _results.Count; index++)
                    {
                        var entry = _results[index];
                        var revision = _entriesRevision;
                        <button @key="entry.Item.Href" type="button" class="search-result @(index == _selectedIndex ? "is-selected" : null)"
                                id="@ResultId(index)" data-search-result-index="@index" role="option" aria-selected="@(index == _selectedIndex ? "true" : "false")"
                                @onclick="@(() => OpenResultAsync(entry, revision))">
                            <span class="search-result-icon"><MoIcon Icon="@entry.Icon" /></span>
                            <span class="search-result-copy"><span class="search-result-title">@entry.Title</span><span class="search-result-description">@entry.Description</span>
                                @if (entry.CategoryBreadcrumb != entry.RootCategory)
                                {
                                    <span class="search-result-breadcrumb">@entry.CategoryBreadcrumb</span>
                                }
                            </span>
                            <span class="search-result-category">@entry.RootCategory</span>
                        </button>
                    }
                }
            </div>
            <div class="search-footer">
                <span><kbd>↑</kbd><kbd>↓</kbd> @L["Search:Navigate"]</span>
                <span><kbd>↵</kbd> @L["Search:Open"]</span>
                <span class="search-shortcut"><kbd>Ctrl / ⌘ K</kbd> @L["Search:Shortcut"]</span>
            </div>
        </div>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    private readonly ComponentRenderTracker _renders = new();
    private readonly object _disposeSync = new();
    private readonly string _listId = $"mo-search-{Guid.NewGuid():N}";
    private ElementReference _root;
    private NavigationSearchInteropSession<NavigationSearchDialog>? _interop;
    private NavigationSearchDialogSession? _session;
    private AuthenticationStateProvider? _authentication;
    private IReadOnlyList<NavigationSearchEntry> _entries = [];
    private IReadOnlyList<NavigationSearchEntry> _results = [];
    private string _query = string.Empty;
    private int _selectedIndex;
    private long _entriesRevision;
    private bool _loading = true;
    private bool _scrollSelection;
    private bool _disposed;
    private Task? _disposeTask;
    private string? ActiveResultId => _results.Count > 0 ? ResultId(_selectedIndex) : null;
    private string ResultId(int index) => $"{_listId}-{index}";

    protected override async Task OnInitializedAsync()
    {
        _session = new NavigationSearchDialogSession(
            Catalog.CreateEntriesAsync,
            (entry, token) => PageAccess.IsAuthorizedAsync(entry.Item, token),
            action => InvokeAsync(action));
        _authentication = Services.GetService<AuthenticationStateProvider>();
        if (_authentication is not null)
        {
            _authentication.AuthenticationStateChanged += HandleAuthenticationChanged;
        }
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        if (_disposed || _session is not { } session) return;
        _loading = true;
        var snapshot = await session.RefreshAsync();
        if (_disposed || snapshot is null || !session.IsCurrent(snapshot.Revision))
        {
            return;
        }

        _entries = snapshot.Entries;
        _entriesRevision = snapshot.Revision;
        _loading = false;
        SetQuery(_query);
    }

    private void HandleAuthenticationChanged(Task<AuthenticationState> state)
    {
        if (_disposed || _session is not { } session) return;
        var revision = session.InvalidateAuthentication();
        _renders.Queue(() => InvokeAsync(async () =>
        {
            if (_disposed || !session.IsCurrent(revision)) return;
            _entries = [];
            _results = [];
            _loading = true;
            StateHasChanged();
            try { await state.WaitAsync(session.LifetimeToken); }
            catch (OperationCanceledException) when (session.LifetimeToken.IsCancellationRequested) { return; }
            catch { /* Access evaluation fails closed through the registered page policies. */ }
            if (_disposed || !session.IsCurrent(revision)) return;
            await RefreshAsync();
            if (!_disposed) StateHasChanged();
        }));
    }

    private void SetQuery(string? query)
    {
        _query = query ?? string.Empty;
        _results = NavigationSearchMatcher.Search(_entries, _query, CultureInfo.CurrentCulture, _entries.Count);
        _selectedIndex = 0;
        _scrollSelection = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed) return;
        if (firstRender)
        {
            _interop = new NavigationSearchInteropSession<NavigationSearchDialog>(JSRuntime, this);
            await _interop.InitializeAsync("observeDialogKeys", _root);
        }
        if (!_disposed && _scrollSelection && _interop is { } interop)
        {
            _scrollSelection = false;
            try { await interop.ScrollSelectionAsync(_root, _selectedIndex); }
            catch (JSDisconnectedException) { /* The disconnected browser has no visible selection. */ }
        }
    }

    /// <summary>Handles navigation keys from the focused search input, excluding IME composition and typing keys.</summary>
    [JSInvokable]
    public Task HandleSearchKeyAsync(string key) => InvokeAsync(async () =>
    {
        if (_disposed || _results.Count == 0) return;
        if (key == "Enter")
        {
            await OpenResultAsync(_results[_selectedIndex], _entriesRevision);
        }
        else if (key is "ArrowDown" or "ArrowUp")
        {
            _selectedIndex = (_selectedIndex + (key == "ArrowDown" ? 1 : -1) + _results.Count) % _results.Count;
            _scrollSelection = true;
            StateHasChanged();
        }
    });

    private async Task OpenResultAsync(NavigationSearchEntry entry, long revision)
    {
        if (_disposed || _session is not { } session) return;
        var result = await session.ActivateAsync(entry, revision, accepted =>
        {
            if (!_disposed) Dialog.Close(DialogResult.Ok(accepted));
        });
        if (!_disposed && result == NavigationSearchDialogSession.ActivationResult.Denied && session.IsCurrent(revision))
        {
            await RefreshAsync();
            if (!_disposed) StateHasChanged();
        }
    }

    private async Task Close()
    {
        var retirement = DisposeAsync().AsTask();
        Dialog.Cancel();
        await retirement;
    }

    public ValueTask DisposeAsync()
    {
        TaskCompletionSource completion;
        lock (_disposeSync)
        {
            if (_disposeTask is { } disposal) return new ValueTask(disposal);
            _disposed = true;
            completion = new(TaskCreationOptions.RunContinuationsAsynchronously);
            _disposeTask = completion.Task;
        }

        _ = DisposeCoreAsync(completion);
        return new ValueTask(completion.Task);
    }

    private async Task DisposeCoreAsync(TaskCompletionSource completion)
    {
        try
        {
            if (_authentication is not null)
            {
                _authentication.AuthenticationStateChanged -= HandleAuthenticationChanged;
            }

            // Start both owners before awaiting either: observer callbacks can be awaiting access evaluation.
            var policies = _session?.DisposeAsync().AsTask() ?? Task.CompletedTask;
            var observer = _interop?.DisposeAsync().AsTask() ?? Task.CompletedTask;
            var renders = _renders.CompleteAsync().AsTask();
            await Task.WhenAll(policies, observer, renders);
            completion.TrySetResult();
        }
        catch (Exception exception)
        {
            completion.TrySetException(exception);
        }
    }
}
