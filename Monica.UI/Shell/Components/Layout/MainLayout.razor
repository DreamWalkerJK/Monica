@using Microsoft.Extensions.Options
@using Monica.Modules
@using Monica.UI.Shell.State
@using Monica.UI.Shell.Support
@inherits LayoutComponentBase
@inject IOptions<ModuleShellUIOption> Options
@inject ThemeState ThemeService
@inject ShellState Shell
@inject IStringLocalizer<SharedResource> L
@implements IAsyncDisposable

<ThemeProviderHost>
    <MudPopoverProvider />
    <MudDialogProvider />
    <MudSnackbarProvider />

    <div class="mo-layout" data-theme="@ThemeService.GetThemeDataAttribute()"
         data-layout="@(Shell.Layout == Monica.UI.Shell.Models.ShellNavigationLayout.Sidebar ? "sidebar" : "topbar")"
         data-sidebar-collapsed="@Shell.SidebarCollapsed.ToString().ToLowerInvariant()">
        <NavBar />
        <div class="mo-main-content">
            <main class="mo-body-content">
                @Body
            </main>
        </div>
    </div>
</ThemeProviderHost>

<div id="blazor-error-ui" data-nosnippet>
    @L["Layout:Error"]
    <a href="." class="reload">@L["Layout:Reload"]</a>
    <button type="button" class="dismiss" aria-label="@L["Layout:DismissError"]">×</button>
</div>

@code {
    private readonly ComponentRenderTracker _renderTracker = new();

    protected override void OnInitialized()
    {
        base.OnInitialized();
        ThemeService.OnThemeChanged += HandleThemeChanged;
        Shell.OnChanged += HandleThemeChanged;
    }

    protected override Task OnAfterRenderAsync(bool firstRender) =>
        firstRender ? Shell.InitializeAsync() : Task.CompletedTask;

    public async ValueTask DisposeAsync()
    {
        ThemeService.OnThemeChanged -= HandleThemeChanged;
        Shell.OnChanged -= HandleThemeChanged;
        await _renderTracker.CompleteAsync();
    }

    private void HandleThemeChanged()
    {
        _renderTracker.Queue(() => InvokeAsync(StateHasChanged));
    }
}

