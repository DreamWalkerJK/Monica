@typeparam TItem

@foreach (var item in Items)
{
    if (item.IsDivider)
    {
        <MudDivider Class="mo-context-menu-divider" />
    }
    else if (item.HasSubMenu)
    {
        <MudMenu Label="@item.Text"
                 AriaLabel="@item.Text"
                 StartIcon="@item.Icon"
                 Disabled="@item.Disabled"
                 Dense="true"
                 DropShadow="false"
                 PopoverClass="mo-context-menu-popover"
                 ListClass="mo-context-menu-list">
            <MoContextMenuItems TItem="TItem"
                                Items="@GetSubItems(item)"
                                ContextItem="ContextItem"
                                OnItemRequested="OnItemRequested"
                                OnItemSelected="OnItemSelected" />
        </MudMenu>
    }
    else
    {
        <MudMenuItem Icon="@item.Icon"
                     Disabled="@item.Disabled"
                     AutoClose="false"
                     Class="mo-context-menu-item"
                     OnClick="@(() => SelectAsync(item))">
            <span class="mo-context-menu-label">@item.Text</span>
            @if (!string.IsNullOrWhiteSpace(item.ShortcutText))
            {
                <kbd class="mo-context-menu-shortcut">@item.ShortcutText</kbd>
            }
        </MudMenuItem>
    }
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<ContextMenuItem<TItem>> Items { get; set; } = [];

    /// <summary>The retained context used by the default leaf-action pipeline.</summary>
    [Parameter]
    public TItem? ContextItem { get; set; }

    /// <summary>Optionally owns selection instead of the default leaf action and selected notification.</summary>
    /// <remarks>
    /// When supplied, this callback is responsible for executing the action and any completion notifications.
    /// MoContextMenu uses it to bind selection to the exact rendered opening. Without it, the existing
    /// OnClick(ContextItem), then OnItemSelected order and fault propagation are preserved.
    /// </remarks>
    [Parameter]
    public EventCallback<ContextMenuItem<TItem>> OnItemRequested { get; set; }

    [Parameter]
    public EventCallback<ContextMenuItem<TItem>> OnItemSelected { get; set; }

    private static IReadOnlyList<ContextMenuItem<TItem>> GetSubItems(ContextMenuItem<TItem> item)
        => item.SubItems ?? [];

    private async Task SelectAsync(ContextMenuItem<TItem> item)
    {
        if (item.Disabled || item.IsDivider || item.HasSubMenu) return;
        var requested = OnItemRequested;
        if (requested.HasDelegate)
        {
            await requested.InvokeAsync(item);
            return;
        }

        var context = ContextItem;
        var action = item.OnClick;
        var callback = OnItemSelected;
        if (action is not null) await action(context);
        await callback.InvokeAsync(item);
    }
}
