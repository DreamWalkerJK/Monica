@* Inline value mark: a compact soft-fill chip with role ink around a key number inside a finding sentence. *@
<mark class="mo-vl-mark @Role.ToCssClass() @Class">@ChildContent</mark>

@code {
    /// <summary>Gets or sets the palette role whose soft fill and ink carry this mark.</summary>
    [Parameter] public MoVisualRole Role { get; set; } = MoVisualRole.Primary;

    /// <summary>Gets or sets the marked value or phrase.</summary>
    [Parameter, EditorRequired] public RenderFragment ChildContent { get; set; } = default!;

    /// <summary>Gets or sets an optional identification class.</summary>
    [Parameter] public string? Class { get; set; }
}
