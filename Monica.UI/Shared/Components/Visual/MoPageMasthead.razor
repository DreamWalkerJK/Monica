@* Page masthead: crumb, page title, a status meta line, and the action group with exactly one filled primary action. *@
<header class="mo-vl-masthead @Class">
    <div class="mo-vl-masthead__identity">
        @if (!string.IsNullOrWhiteSpace(Crumb))
        {
            <p class="mo-vl-crumb">@Crumb</p>
        }
        <h1 class="mo-vl-title" id="@HeadingId">
            @if (TitleContent is not null)
            {
                @TitleContent
            }
            else
            {
                @Title
            }
        </h1>
        @if (Meta is not null)
        {
            <div class="mo-vl-meta">@Meta</div>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="mo-vl-actions">@Actions</div>
    }
</header>

@code {
    /// <summary>Gets or sets the page title text.</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    /// <summary>Gets or sets rich title content; takes precedence over <see cref="Title"/> when supplied.</summary>
    [Parameter] public RenderFragment? TitleContent { get; set; }

    /// <summary>Gets or sets the optional crumb line above the title.</summary>
    [Parameter] public string? Crumb { get; set; }

    /// <summary>Gets or sets the status line under the title: status dot with halo, revision, copyable identity chip, capture time.</summary>
    [Parameter] public RenderFragment? Meta { get; set; }

    /// <summary>Gets or sets the action group; callers place exactly one filled primary action in it.</summary>
    [Parameter] public RenderFragment? Actions { get; set; }

    /// <summary>Gets or sets the id used by focus-on-navigate and aria-labelledby references.</summary>
    [Parameter] public string? HeadingId { get; set; }

    /// <summary>Gets or sets an optional identification class.</summary>
    [Parameter] public string? Class { get; set; }
}
