<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <GenerateStaticWebAssetsManifest>true</GenerateStaticWebAssetsManifest>
  </PropertyGroup>

  <PropertyGroup>
    <PackageDescription>Blazor UI components and utilities for Monica framework based on MudBlazor, providing reusable UI building blocks and theming support.</PackageDescription>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" Version="9.11.0" />
    <PackageReference Include="MudBlazor.Markdown" Version="9.10.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Monica.Core\Monica.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\**\*.json" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Icons\Assets\**\*" Pack="false" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <Content Update="Icons\Assets\**\*" Pack="false" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
    <None Remove="Icons\Assets\Lucide\LICENSE" />
    <None Include="Icons\Assets\Lucide\LICENSE" Pack="true" PackagePath="licenses/lucide/"
          CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <_ContentIncludedByDefault Remove="Properties\launchSettings.json" />
  </ItemGroup>

</Project>
