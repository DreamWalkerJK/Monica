@using System.Globalization
@using Microsoft.Extensions.Localization
@using Monica.UI.Localization
@using Monica.UI.UISystemInfo.Models
@using Monica.UI.UISystemInfo.Support
@inject IStringLocalizer<SystemInfoResource> L

<dl class="system-info-pulse" aria-label="@L["Page:Pulse:AriaLabel"]">
    <div>
        <dt><MoIcon Icon="@MoIcons.Clock" Size="1.25rem" />@L["Page:Pulse:ProcessUptime"]</dt>
        <dd class="system-info-live-uptime">@SystemInfoDisplayFormatter.FormatDuration(Uptime)</dd>
    </div>
    <div>
        <dt><MoIcon Icon="@MoIcons.Cpu" Size="1.25rem" />@L["Page:Pulse:WorkingSet"] <span>@L["Page:Status:Snapshot"]</span></dt>
        <dd class="system-info-working-set" title="@L["Page:Sections:Runtime:WorkingSetAtCapture"]">@SystemInfoDisplayFormatter.FormatScaledBytes(Snapshot.Process.WorkingSetBytes, CultureInfo.CurrentCulture)</dd>
        <small>@SystemInfoDisplayFormatter.FormatByteCount(Snapshot.Process.WorkingSetBytes, CultureInfo.CurrentCulture)</small>
    </div>
    <div>
        <dt><MoIcon Icon="@MoIcons.Hash" Size="1.25rem" />@L["Page:Pulse:ProcessId"]</dt>
        <dd>@Snapshot.Process.ProcessId.ToString(CultureInfo.CurrentCulture)</dd>
    </div>
    <div>
        <dt><MoIcon Icon="@MoIcons.History" Size="1.25rem" />@L["Page:Pulse:EvidenceAge"]</dt>
        <dd class="system-info-evidence-age">@EvidenceAge</dd>
    </div>
</dl>

@code {
    [Parameter, EditorRequired] public SystemInfoSnapshot Snapshot { get; set; } = null!;
    [Parameter] public DateTimeOffset NowUtc { get; set; }

    private TimeSpan Uptime => NowUtc > Snapshot.Process.StartedAtUtc
        ? NowUtc - Snapshot.Process.StartedAtUtc
        : TimeSpan.Zero;

    private string EvidenceAge
    {
        get
        {
            var seconds = Math.Max(0, (int)(NowUtc - Snapshot.CapturedAtUtc).TotalSeconds);
            return seconds == 0
                ? L["Page:Status:JustNow"].Value
                : L["Page:Status:SecondsAgo", seconds].Value;
        }
    }
}
