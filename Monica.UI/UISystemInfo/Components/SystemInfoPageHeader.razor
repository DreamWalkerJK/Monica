@using System.Globalization
@using Microsoft.Extensions.Localization
@using Monica.UI.Localization
@using Monica.UI.UISystemInfo.Models
@using Monica.UI.UISystemInfo.Support
@inject IStringLocalizer<SystemInfoResource> L

<header class="system-info-masthead">
    <div class="system-info-masthead__copy">
        <span class="system-info-masthead__eyebrow">@L["Page:Eyebrow"]</span>
        <h1>@L["Page:Title"]</h1>
        <p>@L["Page:Summary"]</p>
    </div>
    <div class="system-info-masthead__actions">
        @if (Snapshot is { } snapshot)
        {
            <div class="system-info-capture">
                <span>@L["Page:Pulse:CapturedAt"]</span>
                <time datetime="@snapshot.CapturedAtUtc.ToString("O")" title="@SystemInfoDisplayFormatter.FormatDateTime(snapshot.CapturedAtUtc, CultureInfo.CurrentCulture)">@SystemInfoDisplayFormatter.FormatTime(snapshot.CapturedAtUtc, CultureInfo.CurrentCulture)</time>
            </div>
        }
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Refresh"
                   Disabled="@IsRefreshing" OnClick="RefreshRequested" Class="system-info-action">
            @L["Page:Actions:Refresh"]
        </MudButton>
        @if (EnableRestart)
        {
            <MudButton Variant="Variant.Text" Color="Color.Default" StartIcon="@Icons.Material.Outlined.RestartAlt"
                       Disabled="@RestartRequested" OnClick="RestartRequestedCallback" Class="system-info-action">
                @L["Page:Actions:Restart"]
            </MudButton>
        }
    </div>
</header>

@code {
    [Parameter] public SystemInfoSnapshot? Snapshot { get; set; }
    [Parameter] public bool EnableRestart { get; set; }
    [Parameter] public bool IsRefreshing { get; set; }
    [Parameter] public bool RestartRequested { get; set; }
    [Parameter] public EventCallback RefreshRequested { get; set; }
    [Parameter] public EventCallback RestartRequestedCallback { get; set; }
}
