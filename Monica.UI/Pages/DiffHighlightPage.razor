@attribute [Route(DIFF_HIGHLIGHT_URL)]
@implements IAsyncDisposable
@using Microsoft.Extensions.Localization
@using Microsoft.JSInterop
@using Monica.UI.Localization
@using Monica.UI.UIDiffHighlight.Components
@using Monica.UI.UIDiffHighlight.Facades
@using Monica.UI.UIDiffHighlight.Models
@using Monica.UI.UIDiffHighlight.State
@inject DiffHighlightFacade DiffHighlightFacade
@inject IStringLocalizer<SharedResource> L
@inject IJSRuntime JS

@{ var comparison = Comparison; }
<PageTitle>@L["DiffHighlightPage:PageTitle"]</PageTitle>
<div class="diff-highlight-page" @ref="_pageElement" data-accepted-revision="@_accepted?.Revision" data-draft-revision="@comparison.DraftRevision" data-visit="@_visit">
    <header class="diff-page-identity">
        <MoIcon Icon="@MoIcons.Columns" Style="color:var(--mud-palette-primary)" Size="2.25rem" />
        <div><h1>@L["DiffHighlightPage:Title"]</h1><p>@L["DiffHighlightPage:Description"]</p></div>
    </header>
    <section class="diff-draft-surface" aria-label="@L["DiffHighlightPage:Drafts"]" style="@EditorSizing">
        <div class="diff-draft-commands">
            <MudSelect T="EDiffHighlightMode" Value="_state.Options.Mode" ValueChanged="ChangeModeAsync" Label="@L["DiffHighlightPage:CompareMode"]" Variant="Variant.Outlined" Margin="Margin.Dense" OpenIcon="@MoIcons.ChevronDown" CloseIcon="@MoIcons.ChevronUp">
                <MudSelectItem T="EDiffHighlightMode" Value="EDiffHighlightMode.Line">@L["DiffHighlightPage:Modes:Line"]</MudSelectItem>
                <MudSelectItem T="EDiffHighlightMode" Value="EDiffHighlightMode.Character">@L["DiffHighlightPage:Modes:Character"]</MudSelectItem>
                <MudSelectItem T="EDiffHighlightMode" Value="EDiffHighlightMode.Mixed">@L["DiffHighlightPage:Modes:Mixed"]</MudSelectItem>
            </MudSelect>
            <MudSelect T="EDiffOutputFormat" Value="_state.Options.OutputFormat" ValueChanged="ChangeFormatAsync" Label="@L["DiffHighlightPage:OutputFormat"]" Variant="Variant.Outlined" Margin="Margin.Dense" OpenIcon="@MoIcons.ChevronDown" CloseIcon="@MoIcons.ChevronUp">
                <MudSelectItem T="EDiffOutputFormat" Value="EDiffOutputFormat.Html">@L["DiffHighlightPage:Formats:Html"]</MudSelectItem>
                <MudSelectItem T="EDiffOutputFormat" Value="EDiffOutputFormat.Markdown">@L["DiffHighlightPage:Formats:Markdown"]</MudSelectItem>
                <MudSelectItem T="EDiffOutputFormat" Value="EDiffOutputFormat.PlainText">@L["DiffHighlightPage:Formats:PlainText"]</MudSelectItem>
            </MudSelect>
            <div class="diff-sample-action"><MudButton Variant="Variant.Outlined" StartIcon="@MoIcons.Refresh" OnClick="LoadSampleAsync">@L["DiffHighlightPage:LoadSample"]</MudButton><span>@L["DiffHighlightPage:SampleHint"]</span></div>
        </div>
        <div class="diff-rules">
            <MudExpansionPanels Elevation="0"><MudExpansionPanel Text="@L["DiffHighlightPage:ConfigOptions"]" Icon="@MoIcons.Sliders">
                <div class="diff-rule-fields">
                    <MudSwitch T="bool" Value="_state.Options.IgnoreWhitespace" ValueChanged="ChangeWhitespaceAsync" Label="@L["DiffHighlightPage:IgnoreWhitespace"]" Color="Color.Primary" />
                    <MudSwitch T="bool" Value="_state.Options.IgnoreCase" ValueChanged="ChangeCaseAsync" Label="@L["DiffHighlightPage:IgnoreCase"]" Color="Color.Primary" />
                    <MudNumericField T="int" Value="_state.Options.MaxCharacterDiffLength" ValueChanged="ChangeLimitAsync" Label="@L["DiffHighlightPage:MaxCharacterDiffLength"]" Min="100" Max="1000" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </div>
                <p class="diff-rules-help">@L["DiffHighlightPage:RulesHint"]</p>
            </MudExpansionPanel></MudExpansionPanels>
        </div>
        <div class="diff-draft-pair">
            <div class="diff-draft-editor">
                <MudTextField T="string" Value="_state.OriginText" ValueChanged="ChangeOriginalAsync" Lines="@EditorLines" Label="@L["DiffHighlightPage:OriginalText"]" InputId="diff-original-draft" Variant="Variant.Outlined" Class="diff-text-input" Immediate="true" spellcheck="false" Placeholder="@L["DiffHighlightPage:OriginalTextPlaceholder"]" />
            </div>
            <div class="diff-draft-editor diff-draft-editor--updated">
                <MudTextField T="string" Value="_state.NewText" ValueChanged="ChangeUpdatedAsync" Lines="@EditorLines" Label="@L["DiffHighlightPage:NewText"]" InputId="diff-updated-draft" Variant="Variant.Outlined" Class="diff-text-input" Immediate="true" spellcheck="false" Placeholder="@L["DiffHighlightPage:NewTextPlaceholder"]" />
            </div>
        </div>
        <footer class="diff-draft-footer">
            <MudSwitch T="bool" Value="_state.AutoRefresh" ValueChanged="ChangeAutoAsync" Label="@L["DiffHighlightPage:AutoRefresh"]" Color="Color.Primary" />
            <span class="diff-draft-status" role="status" aria-live="polite">@GetDraftStatus(comparison)</span>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@MoIcons.Columns" OnClick="CompareAsync" Disabled="@comparison.IsBusy">@L["DiffHighlightPage:ManualRefresh"]</MudButton>
        </footer>
    </section>
    @if (comparison.IsFailureCurrent && comparison.Failure is { } failure)
    {
        <div class="diff-failure"><MudAlert Severity="Severity.Error" Icon="@MoIcons.Error">@L["DiffHighlightPage:ComparisonFailed"]: @failure.Message</MudAlert></div>
    }
    @if (_accepted is not null && _result is not null)
    {
        <div class="diff-accepted-reader">
            <DiffResultPresentation Result="_result" Continuous="true" IsCurrent="@comparison.IsAcceptedCurrent" InputsEmpty="@_accepted.Input.IsEmpty" ComparedAt="@_accepted.ReceivedAt" HeadingId="diff-accepted-heading" CurrentInputsLabel="@L["DiffHighlightPage:CurrentDrafts"]" EarlierInputsLabel="@L["DiffHighlightPage:EarlierDrafts"]">
                <Actions><MudButton Class="diff-back-to-drafts" Variant="Variant.Text" StartIcon="@MoIcons.ArrowUp" OnClick="BackToDraftsAsync">@L["DiffHighlightPage:BackToDrafts"]</MudButton></Actions>
            </DiffResultPresentation>
        </div>
    }
    else
    {
        <div class="diff-uncomputed"><MoIcon Size="1.5rem" Icon="@MoIcons.Columns" /><p>@L["DiffHighlightPage:EnterTextAndRefresh"]</p></div>
    }
</div>

@code {
    public const string DIFF_HIGHLIGHT_URL = "/diff-highlight-debug";
    private readonly DiffHighlightPageState _state = new();
    private readonly string _visit = Guid.NewGuid().ToString("N");
    private DiffComparisonController _controller = null!;
    private DiffComparisonEvidence? _accepted;
    private DiffHighlightResult? _result;
    private ElementReference _pageElement;
    private Task<IJSObjectReference>? _moduleImport;
    private readonly List<Task> _revealTasks = [];
    private long? _revealRevision;
    private bool _retired;
    private Task? _retirementTask;
    private DiffComparisonState Comparison => _controller.State;
    private int ContentLines => Math.Max(_state.OriginText.Count(c => c == '\n'), _state.NewText.Count(c => c == '\n')) + 1;
    private int EditorLines => Math.Clamp(ContentLines, 6, 9);
    private string EditorSizing => $"--diff-wide-lines:{EditorLines};--diff-compact-lines:{Math.Clamp(ContentLines, 5, 8)}";
    private string GetDraftStatus(DiffComparisonState comparison) => L[comparison.IsBusy ? "DiffHighlightPage:Comparing" : comparison.IsFailureCurrent ? "DiffHighlightPage:FailedDraft" : comparison.IsAcceptedCurrent ? "DiffHighlightPage:CurrentDrafts" : "DiffHighlightPage:PendingDrafts"];

    protected override async Task OnInitializedAsync()
    {
        _controller = DiffComparisonController.ForFacade(DiffHighlightFacade);
        _state.LoadSampleData();
        CaptureDraft();
        await RequestAsync(false);
    }
    private void CaptureDraft() => _controller.SetDraft(DiffComparisonInput.Capture(_state.OriginText, _state.NewText, _state.Options));
    private Task ChangeOriginalAsync(string value) { _state.SetOriginText(value); return DraftChangedAsync(); }
    private Task ChangeUpdatedAsync(string value) { _state.SetNewText(value); return DraftChangedAsync(); }
    private Task ChangeModeAsync(EDiffHighlightMode value) { _state.Options.Mode = value; return DraftChangedAsync(); }
    private Task ChangeFormatAsync(EDiffOutputFormat value) { _state.Options.OutputFormat = value; return DraftChangedAsync(); }
    private Task ChangeWhitespaceAsync(bool value) { _state.Options.IgnoreWhitespace = value; return DraftChangedAsync(); }
    private Task ChangeCaseAsync(bool value) { _state.Options.IgnoreCase = value; return DraftChangedAsync(); }
    private Task ChangeLimitAsync(int value) { _state.Options.MaxCharacterDiffLength = Math.Clamp(value, 100, 1000); return DraftChangedAsync(); }
    private async Task DraftChangedAsync()
    {
        if (_retired) return;
        _revealRevision = null;
        CaptureDraft();
        if (_state.AutoRefresh) await RequestAsync(false);
    }
    private async Task ChangeAutoAsync(bool value)
    {
        _state.AutoRefresh = value;
        if (value && !_retired) { CaptureDraft(); await RequestAsync(false); }
    }
    private async Task LoadSampleAsync() { if (_retired) return; _state.LoadSampleData(); await DraftChangedAsync(); }
    private async Task CompareAsync() { if (_retired || Comparison.IsBusy) return; CaptureDraft(); await RequestAsync(true); }
    private async Task RequestAsync(bool manual)
    {
        var requestedRevision = Comparison.DraftRevision;
        var work = _controller.RequestAsync();
        StateHasChanged();
        await work;
        if (_retired) return;
        var completed = Comparison;
        if (!ReferenceEquals(_accepted, completed.Accepted))
        {
            _accepted = completed.Accepted;
            _result = _accepted?.CreateResult();
        }
        if (manual && completed.IsAcceptedCurrent && completed.Accepted?.Revision == requestedRevision)
            _revealRevision = requestedRevision;
        StateHasChanged();
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_retired || _revealRevision is not { } revision || !Comparison.IsAcceptedCurrent || _accepted?.Revision != revision) return;
        _revealRevision = null;
        _revealTasks.RemoveAll(task => task.IsCompleted);
        var reveal = RevealAsync(revision);
        _revealTasks.Add(reveal);
        await reveal;
    }
    private async Task RevealAsync(long revision)
    {
        try
        {
            _moduleImport ??= JS.InvokeAsync<IJSObjectReference>("import", "./_content/Monica.UI/UIDiffHighlight/diff-page.js").AsTask();
            var module = await _moduleImport;
            if (!_retired && Comparison.IsAcceptedCurrent && _accepted?.Revision == revision)
                await module.InvokeVoidAsync("revealAccepted", _pageElement, "diff-accepted-heading", revision.ToString(), _visit);
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
    }
    private async Task BackToDraftsAsync()
    {
        if (_retired) return;
        _revealTasks.RemoveAll(task => task.IsCompleted);
        var reveal = RevealDraftsAsync();
        _revealTasks.Add(reveal);
        await reveal;
    }
    private async Task RevealDraftsAsync()
    {
        try
        {
            _moduleImport ??= JS.InvokeAsync<IJSObjectReference>("import", "./_content/Monica.UI/UIDiffHighlight/diff-page.js").AsTask();
            var module = await _moduleImport;
            if (!_retired) await module.InvokeVoidAsync("revealDrafts", _pageElement, "diff-original-draft", _visit);
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
    }
    public ValueTask DisposeAsync() => new(_retirementTask ??= RetireAsync());
    private async Task RetireAsync()
    {
        _retired = true;
        _revealRevision = null;
        try
        {
            await _controller.DisposeAsync();
            await Task.WhenAll(_revealTasks);
        }
        finally
        {
            if (_moduleImport is not null)
            {
                try { await (await _moduleImport).DisposeAsync(); }
                catch (JSDisconnectedException) { }
                catch (TaskCanceledException) { }
            }
        }
    }
}
