@using Monica.UI.UIDiffHighlight.Facades
@using Monica.UI.UIDiffHighlight.Models
@using Monica.UI.UIDiffHighlight.State
@implements IAsyncDisposable
@inject DiffHighlightFacade DiffHighlightFacade
@inject IStringLocalizer<SharedResource> L

@{ var state = _comparison.State; }
<div class="diff-viewer" aria-busy="@(state.IsBusy ? "true" : "false")" data-draft-revision="@state.DraftRevision">
    @if (state.IsBusy)
    {
        <p class="diff-viewer__busy" role="status">@L["DiffViewer:Comparing"]</p>
    }
    @if (state.Failure is { } failure)
    {
        <section class="diff-viewer__error" role="alert">
            <strong>@(state.IsFailureCurrent ? L["DiffViewer:ComparisonFailed"] : L["DiffViewer:FailureStale"])</strong>
            <p>@failure.Message</p>
        </section>
    }
    @if (_projection is { } result && _projectionEvidence is { } evidence)
    {
        <DiffResultPresentation Result="@result" IsCurrent="@(evidence.Input == state.Draft)"
                                InputsEmpty="@evidence.Input.IsEmpty" ComparedAt="@evidence.ReceivedAt" ViewMode="@ViewMode" />
    }
    else if (!state.IsBusy && state.Failure is null)
    {
        <p class="diff-viewer__uncomputed">@L["DiffViewer:Uncomputed"]</p>
    }
</div>

@code {
    /// <summary>Original draft text. Defaults to empty; captured by value before each comparison.</summary>
    [Parameter] public string OriginText { get; set; } = string.Empty;
    /// <summary>Updated draft text. Defaults to empty; captured by value before each comparison.</summary>
    [Parameter] public string NewText { get; set; } = string.Empty;
    /// <summary>
    /// Draft comparison settings. Defaults to Line mode. Each request captures a detached copy,
    /// including styles; null delegates defaults to the facade rather than mutating this parameter.
    /// </summary>
    [Parameter] public DiffHighlightOptions? Options { get; set; } = new() { Mode = EDiffHighlightMode.Line };
    /// <summary>
    /// True by default: changed inputs/settings and re-enabling this option request comparison.
    /// False retains prior accepted evidence until RefreshDiffAsync; draft changes still invalidate currentness.
    /// Both-empty admission clears evidence without invoking the facade.
    /// </summary>
    [Parameter] public bool AutoRefresh { get; set; } = true;
    /// <summary>
    /// Initial or genuinely changed parent layout, Unified by default. Local reader choices survive
    /// unrelated parent rerenders; a different parent value resets the local effective layout.
    /// </summary>
    [Parameter] public EDiffViewMode ViewMode { get; set; } = EDiffViewMode.Unified;

    private DiffComparisonController _comparison = null!;
    private DiffComparisonEvidence? _projectionEvidence;
    private DiffHighlightResult? _projection;
    private bool _autoWasEnabled;
    private bool _retired;

    protected override void OnInitialized() => _comparison = DiffComparisonController.ForFacade(DiffHighlightFacade);

    protected override async Task OnParametersSetAsync()
    {
        if (_retired) return;
        var input = CaptureDraft();
        var changed = _comparison.SetDraft(input);
        var enabled = AutoRefresh && !_autoWasEnabled;
        _autoWasEnabled = AutoRefresh;
        if (AutoRefresh && (changed || enabled))
        {
            if (input.IsEmpty) _comparison.ClearEvidence();
            else await _comparison.RequestAsync();
        }
        if (!_retired) SynchronizeProjection();
    }

    /// <summary>
    /// Explicitly compares the current detached draft and awaits actual admitted serial work,
    /// including the latest coalesced request. Both-empty inputs clear evidence without computation.
    /// A failed current attempt retains the previous whole accepted comparison. Retirement stops
    /// admission and suppresses rendering while draining any already admitted noncancelable work.
    /// </summary>
    public async Task RefreshDiffAsync()
    {
        if (_retired) return;
        var input = CaptureDraft();
        _comparison.SetDraft(input);
        if (input.IsEmpty) _comparison.ClearEvidence();
        else
        {
            var work = _comparison.RequestAsync();
            StateHasChanged();
            await work;
        }
        if (_retired) return;
        SynchronizeProjection();
        StateHasChanged();
    }

    private DiffComparisonInput CaptureDraft() => DiffComparisonInput.Capture(OriginText, NewText, Options);
    private void SynchronizeProjection()
    {
        var accepted = _comparison.State.Accepted;
        if (ReferenceEquals(accepted, _projectionEvidence)) return;
        _projectionEvidence = accepted;
        _projection = accepted?.CreateResult();
    }

    /// <summary>Retires this wrapper and drains its actual comparison work; the injected facade remains borrowed.</summary>
    public ValueTask DisposeAsync()
    {
        _retired = true;
        return _comparison.DisposeAsync();
    }
}
