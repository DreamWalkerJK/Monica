@using Monica.UI.UIDiffHighlight.Models
@inject IStringLocalizer<SharedResource> L

<div class="diff-lines" data-view="@ViewMode" data-display="@DisplayMode">
    @if (DiffResult?.Lines is { Count: > 0 } lines)
    {
        @if (ViewMode == EDiffViewMode.Split)
        {
            <p class="diff-lines__stacked-hint">@L["DiffViewer:SplitStacked"]</p>
            <div class="diff-lines__headings" aria-hidden="true"><span>@L["DiffViewer:OriginalContent"]</span><span>@L["DiffViewer:NewContent"]</span></div>
        }
        @for (var index = 0; index < lines.Count; index++)
        {
            var line = lines[index];
            @if (ViewMode == EDiffViewMode.Split)
            {
                <div class="diff-pair" data-logical-index="@index" data-type="@line.Type" role="group"
                     aria-label="@(line.Type == EDiffLineType.Modified ? L["DiffViewer:Modified"].Value : null)">
                    @Cell(line, index, true, line.Type == EDiffLineType.Added, true)
                    @Cell(line, index, false, line.Type == EDiffLineType.Deleted, true)
                </div>
            }
            else if (DisplayMode == EDiffDisplayMode.Compare && line.Type == EDiffLineType.Modified)
            {
                <div class="diff-modified" data-logical-index="@index" data-type="Modified" role="group" aria-label="@L["DiffViewer:Modified"]">
                    @Cell(line, index, true)
                    @Cell(line, index, false)
                </div>
            }
            else if (DisplayMode != EDiffDisplayMode.NewOnly || line.Type != EDiffLineType.Deleted)
            {
                @if (DisplayMode != EDiffDisplayMode.OldOnly || line.Type != EDiffLineType.Added)
                {
                    var oldSide = DisplayMode == EDiffDisplayMode.OldOnly
                        || (DisplayMode == EDiffDisplayMode.Compare && line.Type != EDiffLineType.Added);
                    @Cell(line, index, oldSide, bothNumbers: DisplayMode == EDiffDisplayMode.Compare && line.Type == EDiffLineType.Unchanged)
                }
            }
        }
    }
</div>

@code {
    /// <summary>Accepted logical lines and side-specific ranges. Null or no lines renders an empty reader; no work is computed.</summary>
    [Parameter] public DiffHighlightResult? DiffResult { get; set; }
    /// <summary>
    /// Accepted settings controlling character-range presentation. Defaults to null (no ranges);
    /// callers should pass the result's accepted options rather than live draft settings.
    /// </summary>
    [Parameter] public DiffHighlightOptions? Options { get; set; }
    /// <summary>Unified by default. Split keeps each logical pair together and stacks that pair below reader width 760px.</summary>
    [Parameter] public EDiffViewMode ViewMode { get; set; } = EDiffViewMode.Unified;
    /// <summary>Compare by default. Original/updated filtering applies to Unified only; Split always shows both source sides.</summary>
    [Parameter] public EDiffDisplayMode DisplayMode { get; set; } = EDiffDisplayMode.Compare;

    private RenderFragment Cell(DiffLine line, int index, bool oldSide, bool absent = false, bool paired = false, bool bothNumbers = false) => @<div
        class="diff-cell @CellClass(line, oldSide, absent) @(paired ? "diff-cell--paired" : null)"
        data-side="@(oldSide ? "old" : "new")" data-logical-index="@index" data-type="@line.Type" data-absent="@(absent ? "true" : "false")"
        role="group" aria-label="@(oldSide ? L["DiffViewer:OriginalContent"] : L["DiffViewer:NewContent"])">
        <div class="diff-cell__metadata">
            <span class="diff-cell__side">@(oldSide ? L["DiffViewer:OriginalContent"] : L["DiffViewer:NewContent"])</span>
            <span class="diff-cell__number" data-side="@(oldSide ? "old" : "new")">@Number(oldSide ? line.OldLineNumber : line.NewLineNumber)</span>
            @if (bothNumbers)
            {
                <span class="diff-cell__number" data-side="new" title="@L["DiffViewer:NewContent"]">@Number(line.NewLineNumber)</span>
            }
            <span class="diff-cell__marker" aria-hidden="true">@Marker(line, oldSide, absent)</span>
        </div>
        <div class="diff-cell__content">
            <code class="diff-source" data-side="@(oldSide ? "old" : "new")" data-logical-index="@index"
                  data-line-number="@(oldSide ? line.OldLineNumber : line.NewLineNumber)">@Source(line, oldSide, absent)</code>
            @if (absent)
            {
                <span class="diff-cell__absence">@L["DiffViewer:Absent"]</span>
            }
        </div>
    </div>;

    private static string Number(int number) => number > 0 ? number.ToString() : string.Empty;
    private static string CellClass(DiffLine line, bool oldSide, bool absent) => absent ? "diff-cell--absent" : line.Type switch
    {
        EDiffLineType.Added => "diff-cell--added",
        EDiffLineType.Deleted => "diff-cell--deleted",
        EDiffLineType.Modified => oldSide ? "diff-cell--deleted" : "diff-cell--added",
        _ => "diff-cell--unchanged"
    };
    private static string Marker(DiffLine line, bool oldSide, bool absent) => absent ? string.Empty : line.Type switch
    {
        EDiffLineType.Added => "+",
        EDiffLineType.Deleted => "−",
        EDiffLineType.Modified => oldSide ? "−" : "+",
        _ => string.Empty
    };

    private RenderFragment Source(DiffLine line, bool oldSide, bool absent) => builder =>
    {
        var content = absent ? string.Empty : oldSide ? line.OldContent : line.NewContent;
        var cursor = 0;
        if (Options?.Mode is EDiffHighlightMode.Character or EDiffHighlightMode.Mixed && line.CharacterDiffs is { } ranges)
        {
            // Every range is interpreted in its own source side's coordinates; text comes from that side.
            foreach (var range in ranges.Where(range => oldSide
                         ? range.Type is EDiffLineType.Deleted or EDiffLineType.Modified
                         : range.Type is EDiffLineType.Added or EDiffLineType.Modified).OrderBy(range => range.Start))
            {
                var start = Math.Clamp(range.Start, cursor, content.Length);
                var end = (int)Math.Clamp((long)range.Start + range.Length, start, content.Length);
                if (start > cursor) builder.AddContent(0, content[cursor..start]);
                if (end > start)
                {
                    builder.OpenElement(1, "span");
                    builder.AddAttribute(2, "class", oldSide ? "diff-range-deleted" : "diff-range-added");
                    builder.AddContent(3, content[start..end]);
                    builder.CloseElement();
                }
                cursor = end;
            }
        }
        // AddContent encodes all raw source fragments, including a genuinely empty source line.
        builder.AddContent(4, content[cursor..]);
    };
}
