@using Microsoft.Extensions.Localization
@using System.Globalization
@using Monica.Core.Modularity.Diagnostics.Models
@using Monica.UI.Localization
@using Monica.UI.UIModuleSystem.State
@using Monica.UI.UIModuleSystem.Support
@inject IStringLocalizer<ModuleSystemResource> L

@if (Session.Snapshot is { } snapshot)
{
    var startupDuration = snapshot.Summary.ApplicationStartupDurationMs;
    var recordedDuration = startupDuration ?? snapshot.Summary.TotalCompositionDurationMs;
    var findingsPresentation = GetFindingsPresentation(snapshot.Findings);
    var rankedModules = snapshot.Modules.OrderByDescending(ModuleCost).Take(5).ToArray();
    var maximumCost = rankedModules.FirstOrDefault() is { } firstModule ? ModuleCost(firstModule) : 0;
    <div class="overview-layout">
        <section class="composition-portrait" aria-label="@L["Aria:SummaryMetrics"]">
            <div class="composition-portrait__identity">
                <div class="composition-portrait__label">
                    <MudIcon Icon="@Icons.Material.Outlined.Timeline" Size="Size.Small" />
                    <span>@(startupDuration.HasValue ? L["Overview:Kpis:ApplicationStartup"] : L["Overview:Kpis:Composition"])</span>
                    <span class="composition-portrait__tracking">@(startupDuration.HasValue ? L["Overview:Kpis:Tracked"] : L["Overview:Kpis:Exact"])</span>
                </div>
                <strong class="composition-portrait__duration">@ModuleDiagnosticsDisplay.Duration(recordedDuration)</strong>
                <code class="composition-portrait__exact">@ModuleDiagnosticsDisplay.ExactMilliseconds(recordedDuration)</code>
                <p>@(startupDuration.HasValue ? L["Overview:Kpis:StartupBoundary"] : L["Atlas:Overview:StartupNotTracked"])</p>
                @if (Session.Comparison?.ApplicationStartupDurationDeltaMs is { } startupDelta && startupDuration.HasValue)
                {
                    <span class="composition-portrait__delta">@FormatExactDelta(startupDelta)</span>
                }
            </div>
            <div class="composition-portrait__context">
                <span class="overview-eyebrow">@L["Overview:Kpis:StartupTiming"]</span>
                <h2>@L["Overview:Kpis:Composition"]</h2>
                <strong class="composition-portrait__composition">@ModuleDiagnosticsDisplay.ExactMilliseconds(snapshot.Summary.TotalCompositionDurationMs)</strong>
                <p>@CompositionDetail()</p>
                @if (startupDuration is { } totalStartupMs)
                {
                    var share = CompositionShare(snapshot.Summary.TotalCompositionDurationMs, totalStartupMs);
                    <div class="startup-share">
                        <div class="startup-share__heading"><span>@L["Overview:Kpis:CompositionShare"]</span><code>@FormatPercentage(share)</code></div>
                        <svg class="startup-share__bar" viewBox="0 0 100 6" preserveAspectRatio="none" role="img"
                             aria-label="@L["Overview:Kpis:CompositionShareAria", FormatPercentage(share)]">
                            <rect class="startup-share__remaining" x="0" y="0" width="100" height="6" rx="3" />
                            <rect class="startup-share__composition" x="0" y="0" width="@FormatSvgNumber(share)" height="6" rx="3" />
                        </svg>
                        <div class="startup-share__legend" aria-hidden="true"><span><i></i>@L["Overview:Kpis:Composition"]</span><span><i></i>@L["Overview:Kpis:RemainingStartup"]</span></div>
                    </div>
                }
            </div>
            <dl class="composition-facts">
                <div><dt>@L["Overview:Kpis:ActiveModules"]</dt><dd>@snapshot.Summary.ActiveModuleCount <small>@L["Overview:Kpis:Declared", snapshot.Summary.ModuleCount]</small></dd></div>
                <div><dt>@L["Atlas:Overview:DirectDependencies"]</dt><dd>@snapshot.Topology.Edges.Length</dd></div>
                <div><dt>@L["Overview:Kpis:ServiceRegistration"]</dt><dd>@ModuleDiagnosticsDisplay.ExactMilliseconds(snapshot.Summary.ServiceRegistrationDurationMs)</dd><small>@L["Overview:Kpis:CompositionShareValue", FormatPercentage(CompositionShare(snapshot.Summary.ServiceRegistrationDurationMs, snapshot.Summary.TotalCompositionDurationMs))]</small></div>
                <div><dt>@L["Overview:Kpis:TypeDiscovery"]</dt><dd>@ModuleDiagnosticsDisplay.Duration(snapshot.Summary.TypeDiscoveryDurationMs)</dd><small>@L["Overview:Kpis:Queries", snapshot.TypeDiscovery.Statistics.DistinctQueryCount] · @L["Overview:Kpis:Matches", snapshot.TypeDiscovery.Statistics.MatchCount]</small></div>
            </dl>
        </section>

        <ModuleWorkbenchCriticalPathRibbon Session="@Session" ModuleSelected="@ModuleSelected" />

        <div class="overview-evidence-grid">
            <section class="evidence-panel" aria-labelledby="findings-title">
                <header class="panel-heading">
                    <div><span class="overview-eyebrow">@L["Overview:Findings:Eyebrow"]</span><h2 id="findings-title">@L["Overview:Findings:Title"]</h2></div>
                    <span class="finding-count finding-count--@findingsPresentation">@snapshot.Findings.Length</span>
                </header>
                <div class="finding-totals"><span>@L["Overview:Kpis:Errors", snapshot.Summary.ErrorCount]</span><span>@L["Overview:Kpis:Warnings", snapshot.Findings.Count(static finding => finding.Severity == ModuleDiagnosticFindingSeverity.Warning)]</span></div>
                @if (snapshot.Findings.IsEmpty)
                {
                    <p class="compact-empty-state"><MudIcon Icon="@Icons.Material.Outlined.Checklist" Size="Size.Small" /><span>@L["Overview:Findings:Empty"]</span></p>
                }
                else
                {
                    <ul class="finding-list">
                        @foreach (var finding in snapshot.Findings.Take(6))
                        {
                            <li><MudIcon Icon="@FindingIcon(finding.Severity)" Color="@FindingColor(finding.Severity)" Size="Size.Small" /><div><p>@ModuleDiagnosticsDisplay.Finding(finding, L)</p><code>@finding.Code</code></div></li>
                        }
                    </ul>
                    @if (snapshot.Findings.Length > 6)
                    {
                        <MudExpansionPanels Class="finding-overflow">
                            <MudExpansionPanel Text="@L["Overview:Findings:Remaining", snapshot.Findings.Length - 6]">
                                <div class="finding-overflow-list">
                                    <ul class="finding-list">
                                        @foreach (var finding in snapshot.Findings.Skip(6))
                                        {
                                            <li><MudIcon Icon="@FindingIcon(finding.Severity)" Color="@FindingColor(finding.Severity)" Size="Size.Small" /><div><p>@ModuleDiagnosticsDisplay.Finding(finding, L)</p><code>@finding.Code</code></div></li>
                                        }
                                    </ul>
                                </div>
                            </MudExpansionPanel>
                        </MudExpansionPanels>
                    }
                }
            </section>

            <section class="evidence-panel" aria-labelledby="hotspots-title">
                <header class="panel-heading"><div><span class="overview-eyebrow">@L["Overview:Hotspots:Eyebrow"]</span><h2 id="hotspots-title">@L["Overview:Hotspots:Title"]</h2></div></header>
                <p class="panel-description">@L["Atlas:Overview:ContributionHint"]</p>
                <div class="hotspot-list">
                    @foreach (var item in rankedModules.Select((module, index) => (module, index)))
                    {
                        <MudTooltip Text="@item.module.FullTypeName">
                            <button type="button" data-module-id="@item.module.ModuleKey.Id" @onclick="@(() => ModuleSelected.InvokeAsync(item.module))">
                                <span class="hotspot-rank" aria-hidden="true">@((item.index + 1).ToString("00"))</span>
                                <span class="hotspot-identity"><strong>@item.module.TypeName</strong><small>@item.module.AssemblyName</small></span>
                                <code>@ModuleDiagnosticsDisplay.Duration(ModuleCost(item.module))</code>
                                <svg viewBox="0 0 100 3" preserveAspectRatio="none" aria-hidden="true" focusable="false"><rect class="hotspot-meter-track" width="100" height="3" /><rect class="hotspot-meter-value" width="@FormatSvgNumber(CompositionShare(ModuleCost(item.module), maximumCost))" height="3" /></svg>
                            </button>
                        </MudTooltip>
                    }
                </div>
            </section>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public ModuleSystemWorkbenchSession Session { get; set; } = default!;
    [Parameter] public EventCallback<ModuleDiagnosticsModule> ModuleSelected { get; set; }

    private static double ModuleCost(ModuleDiagnosticsModule module) =>
        module.SerialCallbackDurationMs + module.StartupWorkDurationMs;

    private static double CompositionShare(double numeratorMs, double denominatorMs) =>
        denominatorMs <= 0 ? 0 : Math.Clamp(numeratorMs / denominatorMs * 100, 0, 100);

    private static string FormatPercentage(double value) =>
        string.Create(CultureInfo.InvariantCulture, $"{value:F1}%");

    private static string FormatSvgNumber(double value) =>
        value.ToString("0.####", CultureInfo.InvariantCulture);

    private string CompositionDetail() => Session.Comparison is { } comparison
        ? FormatDelta(comparison.TotalDurationDeltaMs)
        : L["Overview:Kpis:FinalCompositionInterval"];

    private string FormatExactDelta(double delta) => delta switch
    {
        > 0 => L["Comparison:Slower", ModuleDiagnosticsDisplay.ExactMilliseconds(delta)],
        < 0 => L["Comparison:Faster", ModuleDiagnosticsDisplay.ExactMilliseconds(Math.Abs(delta))],
        _ => L["Comparison:Unchanged"]
    };

    private static string GetFindingsPresentation(IReadOnlyList<ModuleDiagnosticFinding> findings) =>
        findings.Any(static finding => finding.Severity == ModuleDiagnosticFindingSeverity.Error)
            ? "error"
            : findings.Any(static finding => finding.Severity == ModuleDiagnosticFindingSeverity.Warning) ? "warning" : "none";

    private static Color FindingColor(ModuleDiagnosticFindingSeverity severity) => severity switch
    {
        ModuleDiagnosticFindingSeverity.Error => Color.Error,
        ModuleDiagnosticFindingSeverity.Warning => Color.Warning,
        _ => Color.Info
    };

    private static string FindingIcon(ModuleDiagnosticFindingSeverity severity) => severity switch
    {
        ModuleDiagnosticFindingSeverity.Error => Icons.Material.Outlined.ErrorOutline,
        ModuleDiagnosticFindingSeverity.Warning => Icons.Material.Outlined.WarningAmber,
        _ => Icons.Material.Outlined.Info
    };

    private string FormatDelta(double delta) => delta switch
    {
        > 0 => L["Comparison:Slower", ModuleDiagnosticsDisplay.Duration(delta)],
        < 0 => L["Comparison:Faster", ModuleDiagnosticsDisplay.Duration(Math.Abs(delta))],
        _ => L["Comparison:Unchanged"]
    };
}
