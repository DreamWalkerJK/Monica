@using Microsoft.Extensions.Localization
@using Monica.Core.Modularity.Diagnostics.Models
@using Monica.UI.Localization
@using Monica.UI.UIModuleSystem.State
@using Monica.UI.UIModuleSystem.Support
@inject IStringLocalizer<ModuleSystemResource> L

@if (Session.Snapshot is { } snapshot)
{
    <div class="discovery-layout">
        <header class="discovery-summary" aria-labelledby="discovery-title">
            <div class="discovery-summary__copy">
                <span class="discovery-eyebrow">@L["Discovery:Eyebrow"]</span>
                <h2 id="discovery-title">@L["Discovery:Title"]</h2>
                <p>@L["Discovery:Description"]</p>
            </div>
            <dl class="discovery-counts" aria-label="@L["Aria:SummaryMetrics"]">
                <div class="discovery-count discovery-count--types"><dt>@L["Discovery:Counts:Types"]</dt><dd>@snapshot.TypeDiscovery.Statistics.EnumeratedTypeCount</dd></div>
                <div class="discovery-count"><dt>@L["Discovery:Counts:Assemblies"]</dt><dd>@snapshot.TypeDiscovery.Statistics.AssemblyCount</dd></div>
                <div class="discovery-count"><dt>@L["Discovery:Counts:Plans"]</dt><dd>@snapshot.TypeDiscovery.Statistics.PlanCount</dd></div>
                <div class="discovery-count"><dt>@L["Discovery:Counts:Queries"]</dt><dd>@snapshot.TypeDiscovery.Statistics.DistinctQueryCount</dd></div>
                <div class="discovery-count"><dt>@L["Discovery:Counts:Matches"]</dt><dd>@snapshot.TypeDiscovery.Statistics.MatchCount</dd></div>
            </dl>
            <p class="discovery-count-scope">@L["Discovery:Counts:ScopeHint"]</p>
        </header>

        <section class="discovery-stage-ledger" aria-labelledby="discovery-stages-title">
            <header class="discovery-stage-heading">
                <h3 id="discovery-stages-title">@L["Discovery:Stages:Title"]</h3>
                <p>@L["Discovery:Stages:Description"]</p>
            </header>
            @if (snapshot.TypeDiscovery.Stages.Length == 0)
            {
                <p class="discovery-stage-empty">@L["Discovery:Stages:Empty"]</p>
            }
            else
            {
                <ol class="discovery-stages" style="@($"--discovery-stage-count: {snapshot.TypeDiscovery.Stages.Length};")">
                    @for (var stageIndex = 0; stageIndex < snapshot.TypeDiscovery.Stages.Length; stageIndex++)
                    {
                        var stage = snapshot.TypeDiscovery.Stages[stageIndex];
                        <li class="discovery-stage">
                            <div class="discovery-stage-head">
                                <span class="discovery-stage-marker" aria-hidden="true"><MudIcon Icon="@StageIcon(stage.Stage)" Size="Size.Small" /></span>
                                <span class="discovery-stage-number" aria-hidden="true">@((stageIndex + 1).ToString("D2"))</span>
                            </div>
                            <span class="discovery-stage-name">@ModuleDiagnosticsDisplay.Stage(stage.Stage, L)</span>
                            <strong class="discovery-stage-duration">@ModuleDiagnosticsDisplay.Duration(stage.DurationMs)</strong>
                            <details class="discovery-stage-evidence">
                                <summary>@L["Discovery:Stages:SpanId"]</summary>
                                <IdentifierValue Value="@stage.SpanId" />
                            </details>
                        </li>
                    }
                </ol>
            }
        </section>

        <ModuleWorkbenchAssemblyExplorer Session="@Session" />

        <div class="discovery-grid">
            <section class="discovery-query-ledger" aria-labelledby="query-title">
                <header class="discovery-evidence-heading">
                    <h3 id="query-title">@L["Discovery:Queries:Title"]</h3>
                    <p>@L["Discovery:Queries:Description"]</p>
                </header>
                <div class="query-table-wrapper" role="region" aria-labelledby="query-title" tabindex="0">
                    <MudTable T="TypeDiscoveryQuerySummary"
                              Items="@snapshot.TypeDiscovery.Queries"
                              Dense="true"
                              Hover="true"
                              Elevation="0"
                              Breakpoint="Breakpoint.None">
                        <HeaderContent>
                            <MudTh>@L["Discovery:Queries:QueryId"]</MudTh>
                            <MudTh>@L["Discovery:Queries:Consumers"]</MudTh>
                            <MudTh>@L["Discovery:Queries:Matches"]</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="query">
                            <MudTd DataLabel="@L["Discovery:Queries:QueryId"]">
                                <div class="query-identity"><IdentifierValue Value="@query.QueryId" /></div>
                            </MudTd>
                            <MudTd DataLabel="@L["Discovery:Queries:Consumers"]">
                                <span class="query-consumers">@(query.ConsumerModules.Length == 0 ? L["Common:None"].Value : ConsumerNames(query))</span>
                            </MudTd>
                            <MudTd DataLabel="@L["Discovery:Queries:Matches"]"><span class="query-match-count">@query.MatchCount</span></MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <p class="discovery-query-empty">@L["Discovery:Queries:Empty"]</p>
                        </NoRecordsContent>
                    </MudTable>
                </div>
            </section>

            <section class="discovery-commit" aria-labelledby="commit-title">
                <header class="discovery-evidence-heading">
                    <h3 id="commit-title">@L["Discovery:Commit:Title"]</h3>
                    <p>@L["Discovery:Commit:Description"]</p>
                </header>
                <dl class="commit-facts">
                    <div><dt>@L["Discovery:Commit:Callbacks"]</dt><dd>@snapshot.TypeDiscovery.Statistics.CommitCallbackCount</dd></div>
                    <div><dt>@L["Discovery:Commit:Added"]</dt><dd>@snapshot.TypeDiscovery.Statistics.ServiceRegistrations.AddedCount</dd></div>
                    <div><dt>@L["Discovery:Commit:Replaced"]</dt><dd>@snapshot.TypeDiscovery.Statistics.ServiceRegistrations.ReplacedCount</dd></div>
                    <div><dt>@L["Discovery:Commit:Skipped"]</dt><dd>@snapshot.TypeDiscovery.Statistics.ServiceRegistrations.SkippedCount</dd></div>
                    <div><dt>@L["Discovery:Commit:Excluded"]</dt><dd>@snapshot.TypeDiscovery.Statistics.ExcludedTypeCount</dd></div>
                </dl>
            </section>
        </div>
    </div>
}

@code {
    [Parameter, EditorRequired] public ModuleSystemWorkbenchSession Session { get; set; } = default!;

    private string ConsumerNames(TypeDiscoveryQuerySummary query) => string.Join(", ", query.ConsumerModules.Select(key =>
        Session.Snapshot?.Modules.FirstOrDefault(module => module.ModuleKey == key)?.TypeName ?? key.Value));

    private static string StageIcon(ModuleSystemStage stage) => stage switch
    {
        ModuleSystemStage.TypeDiscoveryPlanDeclaration => Icons.Material.Outlined.Article,
        ModuleSystemStage.TypeDiscoveryAssemblyResolution => Icons.Material.Outlined.Inventory2,
        ModuleSystemStage.TypeDiscoveryTypeEnumeration => Icons.Material.Outlined.DataArray,
        ModuleSystemStage.TypeDiscoveryQueryEvaluation => Icons.Material.Outlined.FilterAlt,
        ModuleSystemStage.TypeDiscoveryRegistrationCommit => Icons.Material.Outlined.DoneAll,
        _ => Icons.Material.Outlined.Settings
    };

}
