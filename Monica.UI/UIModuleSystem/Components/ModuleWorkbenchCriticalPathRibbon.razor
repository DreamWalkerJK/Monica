@using Microsoft.Extensions.Localization
@using Monica.Core.Modularity.Diagnostics.Models
@using Monica.UI.Localization
@using Monica.UI.UIModuleSystem.State
@using Monica.UI.UIModuleSystem.Support
@inject IStringLocalizer<ModuleSystemResource> L

<section class="critical-ribbon @(CriticalSpans.Count == 0 ? "critical-ribbon--empty" : null)" aria-labelledby="critical-ribbon-title">
    <header class="ribbon-heading">
        <h2 id="critical-ribbon-title">@L["Overview:CriticalPath:Title"]</h2>
        <span class="ribbon-count">@L["Overview:CriticalPath:Count", CriticalSpans.Count]</span>
        <p class="ribbon-hint">@L["Overview:CriticalPath:Hint"]</p>
    </header>

    @if (CriticalSpans.Count == 0)
    {
        <div class="ribbon-empty">
            <div class="ribbon-empty__content">
                <span class="ribbon-empty__icon" aria-hidden="true">
                    <MudIcon Icon="@Icons.Material.Outlined.Route" Size="Size.Small" />
                </span>
                <p>@L["Overview:CriticalPath:Empty"]</p>
            </div>
        </div>
    }
    else
    {
        <ol class="ribbon-segments">
            @foreach (var span in CriticalSpans)
            {
                var isSelected = IsSelected(span);
                var display = TraceDisplay(span);
                var subject = SpineDisplay(span, display);
                <li class="ribbon-segment-shell @SpanKindClass(span.Kind)" @key="span.SpanId">
                    <span class="ribbon-segment__node" aria-hidden="true"></span>
                    <MudTooltip Text="@SpanTooltip(span, display)">
                        <button type="button"
                                class="ribbon-segment @(isSelected ? "selected" : null)"
                                data-span-id="@span.SpanId"
                                aria-label="@SpanTooltip(span, display)"
                                aria-current="@(isSelected ? "step" : null)"
                                aria-pressed="@(isSelected ? "true" : "false")"
                                @onclick="@(() => SelectSpanAsync(span))">
                            <span class="ribbon-segment__identity">
                                <strong>@subject.Primary</strong>
                                <small>@subject.Secondary</small>
                            </span>
                            <code title="@ModuleDiagnosticsDisplay.ExactMilliseconds(span.DurationMs)">@ModuleDiagnosticsDisplay.Duration(span.DurationMs)</code>
                        </button>
                    </MudTooltip>
                </li>
            }
        </ol>
    }
</section>

@code {
    [Parameter, EditorRequired] public ModuleSystemWorkbenchSession Session { get; set; } = default!;
    [Parameter] public EventCallback<ModuleDiagnosticsModule> ModuleSelected { get; set; }

    private ModuleDiagnosticsSnapshot? _criticalSnapshot;
    private IReadOnlyList<ModuleDiagnosticsTraceSpan> _criticalSpans = [];

    private IReadOnlyList<ModuleDiagnosticsTraceSpan> CriticalSpans
    {
        get
        {
            var snapshot = Session.Snapshot;
            if (ReferenceEquals(snapshot, _criticalSnapshot))
            {
                return _criticalSpans;
            }

            _criticalSnapshot = snapshot;
            if (snapshot is null)
            {
                return _criticalSpans = [];
            }

            var causalSpanIds = new HashSet<string>(StringComparer.Ordinal);
            foreach (var segment in snapshot.BlockingChain)
            {
                causalSpanIds.Add(segment.WorkSpanId);
                causalSpanIds.Add(segment.BarrierSpanId);
                if (!string.IsNullOrWhiteSpace(segment.CommitSpanId))
                {
                    causalSpanIds.Add(segment.CommitSpanId);
                }
            }

            // TraceSpans is already the snapshot's immutable occurrence order. Filtering it preserves the
            // complete causal sequence while de-duplicating barrier spans shared by pending work items.
            return _criticalSpans = snapshot.TraceSpans
                .Where(span => causalSpanIds.Contains(span.SpanId))
                .ToArray();
        }
    }

    private bool IsSelected(ModuleDiagnosticsTraceSpan span) =>
        string.Equals(Session.SelectedTraceSpanId, span.SpanId, StringComparison.Ordinal);

    private async Task SelectSpanAsync(ModuleDiagnosticsTraceSpan span)
    {
        Session.SelectTraceSpan(span);
        if (span.ModuleKey is not { } moduleKey || Session.Snapshot is null)
        {
            return;
        }

        var module = Session.Snapshot.Modules.FirstOrDefault(candidate => candidate.ModuleKey == moduleKey);
        if (module is not null)
        {
            await ModuleSelected.InvokeAsync(module);
        }
    }

    private ModuleDiagnosticsTraceDisplay TraceDisplay(ModuleDiagnosticsTraceSpan span) => Session.Snapshot is { } snapshot
        ? ModuleDiagnosticsDisplay.TraceSpan(span, snapshot, L)
        : new ModuleDiagnosticsTraceDisplay(span.Name ?? L["Common:Unknown"], L[$"Enums:TraceKind:{span.Kind}"]);

    private string SpanTooltip(ModuleDiagnosticsTraceSpan span, ModuleDiagnosticsTraceDisplay display) => L[
        "Overview:CriticalPath:SpanDescription",
        display.Primary,
        display.Secondary,
        ModuleDiagnosticsDisplay.Duration(span.DurationMs)];

    private ModuleDiagnosticsTraceDisplay SpineDisplay(
        ModuleDiagnosticsTraceSpan span,
        ModuleDiagnosticsTraceDisplay display)
    {
        var workName = span.Kind == ModuleDiagnosticsTraceSpanKind.StartupWork
            ? span.Name
            : span.CallbackKind == ModuleCallbackKind.StartupWorkCommit
                && span.WorkItemId is not null
                ? Session.Snapshot?.TraceSpans.FirstOrDefault(candidate =>
                    candidate.Kind == ModuleDiagnosticsTraceSpanKind.StartupWork
                    && string.Equals(candidate.WorkItemId, span.WorkItemId, StringComparison.Ordinal))?.Name
                : null;

        if (!string.IsNullOrWhiteSpace(workName)
            && !string.Equals(workName, display.Primary, StringComparison.Ordinal))
        {
            var activity = span.CallbackKind is { } callback
                ? ModuleDiagnosticsDisplay.Callback(callback, L)
                : L[$"Enums:TraceKind:{span.Kind}"].Value;
            return new ModuleDiagnosticsTraceDisplay(workName, $"{activity} · {display.Primary}");
        }

        return string.IsNullOrWhiteSpace(display.Secondary)
            || string.Equals(display.Primary, display.Secondary, StringComparison.OrdinalIgnoreCase)
                ? display with { Secondary = L[$"Enums:TraceKind:{span.Kind}"] }
                : display;
    }

    private static string SpanKindClass(ModuleDiagnosticsTraceSpanKind kind) => kind switch
    {
        ModuleDiagnosticsTraceSpanKind.SystemStage => "ribbon-kind--system",
        ModuleDiagnosticsTraceSpanKind.ModuleCallback => "ribbon-kind--callback",
        ModuleDiagnosticsTraceSpanKind.StartupWork => "ribbon-kind--work",
        ModuleDiagnosticsTraceSpanKind.StartupBarrier => "ribbon-kind--barrier",
        _ => "ribbon-kind--system"
    };

}
