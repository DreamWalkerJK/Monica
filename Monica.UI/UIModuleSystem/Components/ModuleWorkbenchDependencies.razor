
@using Microsoft.Extensions.Localization
@using System.Globalization
@using Monica.Core.Modularity.Diagnostics.Models
@using Monica.UI.Localization
@using Monica.UI.UIModuleSystem.State
@using Monica.UI.UIModuleSystem.Support
@inject IStringLocalizer<ModuleSystemResource> L

@if (Session.Snapshot is { } snapshot)
{
    <div class="dependencies-layout">
        <section class="topology-workspace" aria-labelledby="dependencies-title">
            <header class="topology-heading">
                <div class="topology-heading__identity">
                    <span class="topology-eyebrow">@L["Dependencies:Eyebrow"]</span>
                    <h2 id="dependencies-title">@L["Dependencies:Title"]</h2>
                    <p>@L["Dependencies:Description"]</p>
                </div>
                <div class="graph-scope-actions" aria-label="@L["Dependencies:Controls:Scope"]">
                    <MudButton Variant="@(Session.ShowFullDependencyGraph ? Variant.Filled : Variant.Text)"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Outlined.Public"
                               aria-pressed="@(Session.ShowFullDependencyGraph ? "true" : "false")"
                               OnClick="@(() => SetGraphScope(true))">
                        @L["Dependencies:Controls:FullHost"]
                    </MudButton>
                    <MudButton Variant="@(!Session.ShowFullDependencyGraph ? Variant.Filled : Variant.Text)"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Outlined.CenterFocusStrong"
                               aria-pressed="@(!Session.ShowFullDependencyGraph ? "true" : "false")"
                               OnClick="@(() => SetGraphScope(false))">
                        @L["Dependencies:Controls:Neighborhood"]
                    </MudButton>
                </div>
            </header>

            <div class="topology-scope-summary">
                <div class="topology-scope-evidence">
                    <strong>@Session.VisibleDependencyModules.Count</strong>
                    <div>
                        <span>@L["Dependencies:Overview:Modules"]</span>
                        <small>@(Session.ShowFullDependencyGraph
                            ? L["Dependencies:Graph:FullHostMode"]
                            : L["Dependencies:Graph:NeighborhoodMode", Session.DependencyNeighborhoodDepth])</small>
                    </div>
                </div>
                <div class="topology-facts"><MoFactGrid Facts="@TopologyFacts" /></div>
            </div>

            <div class="graph-command-deck" aria-label="@L["Dependencies:Controls:Label"]">
                <div class="graph-field graph-field--focus">
                    <MudAutocomplete T="string"
                                     Label="@L["Dependencies:FocusModule"]"
                                     Value="@Session.SelectedModule?.ModuleKey.Id"
                                     ValueChanged="@SelectModuleById"
                                     SearchFunc="@SearchModules"
                                     ToStringFunc="@ModuleDisplayName"
                                     Clearable="false"
                                     CoerceValue="false"
                                     SelectValueOnTab="true"
                                     Variant="Variant.Outlined"
                                     Margin="Margin.Dense" />
                </div>
                <div class="graph-field graph-field--highlight">
                    <MudTextField T="string"
                                  Label="@L["Dependencies:Controls:Search"]"
                                  Placeholder="@L["Dependencies:Controls:SearchPlaceholder"]"
                                  Value="@_searchText"
                                  ValueChanged="@SetSearchText"
                                  Immediate="true"
                                  Clearable="true"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Outlined.Search" />
                </div>
                <div class="graph-field graph-field--layout">
                    <MudSelect T="string"
                               Label="@L["Dependencies:Controls:Layout"]"
                               Value="@_layout"
                               ValueChanged="@SetLayout"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Dense="true">
                        <MudSelectItem T="string" Value="@("force")">@L["Dependencies:Layouts:Force"]</MudSelectItem>
                        <MudSelectItem T="string" Value="@("layered")">@L["Dependencies:Layouts:Layered"]</MudSelectItem>
                        <MudSelectItem T="string" Value="@("radial")">@L["Dependencies:Layouts:Radial"]</MudSelectItem>
                    </MudSelect>
                </div>
                <div class="graph-command-actions">
                    @if (!Session.ShowFullDependencyGraph)
                    {
                        <MudButton Variant="Variant.Outlined"
                                   StartIcon="@Icons.Material.Outlined.ZoomOutMap"
                                   Disabled="@(Session.DependencyNeighborhoodDepth >= 3)"
                                   OnClick="@Session.ExpandDependencyNeighborhood">
                            @L["Dependencies:Expand", Session.DependencyNeighborhoodDepth]
                        </MudButton>
                    }
                    <div class="graph-viewport-actions">
                        <MudTooltip Text="@L["Dependencies:Controls:ZoomIn"]">
                            <MudIconButton Icon="@Icons.Material.Outlined.ZoomIn" OnClick="@ZoomInAsync" aria-label="@L["Dependencies:Controls:ZoomIn"]" />
                        </MudTooltip>
                        <MudTooltip Text="@L["Dependencies:Controls:ZoomOut"]">
                            <MudIconButton Icon="@Icons.Material.Outlined.ZoomOut" OnClick="@ZoomOutAsync" aria-label="@L["Dependencies:Controls:ZoomOut"]" />
                        </MudTooltip>
                        <MudTooltip Text="@L["Dependencies:Controls:Fit"]">
                            <MudIconButton Icon="@Icons.Material.Outlined.FitScreen" OnClick="@FitAsync" aria-label="@L["Dependencies:Controls:Fit"]" />
                        </MudTooltip>
                        <MudTooltip Text="@L["Dependencies:Controls:FocusSelected"]">
                            <MudIconButton Icon="@Icons.Material.Outlined.MyLocation" Disabled="@(Session.SelectedModule is null)" OnClick="@FocusSelectedAsync" aria-label="@L["Dependencies:Controls:FocusSelected"]" />
                        </MudTooltip>
                    </div>
                </div>
            </div>

            <div class="topology-working-area">
                <section class="dependency-graph-panel" aria-label="@L["Aria:DependencyGraph", Session.VisibleDependencyModules.Count, Session.VisibleDependencyEdges.Count]">
                    <ModuleDependencyGraphCanvas @ref="_graphCanvas"
                                                 Session="@Session"
                                                 Layout="@_layout"
                                                 SearchText="@_searchText"
                                                 ModuleSelected="@ModuleSelected" />
                    <div class="graph-legend" aria-label="@L["Dependencies:Legend:Title"]">
                        <span class="legend-core">@L["Dependencies:Legend:Core"]</span>
                        <span class="legend-ui">@L["Dependencies:Legend:Ui"]</span>
                        <span class="legend-web">@L["Dependencies:Legend:Web"]</span>
                        <span class="legend-host">@L["Dependencies:Legend:HostRequired"]</span>
                        <span class="legend-outgoing">@L["Dependencies:Legend:Requires"]</span>
                        <span class="legend-incoming">@L["Dependencies:Legend:RequiredBy"]</span>
                    </div>
                </section>

                @if (Session.SelectedModule is { } selected)
                {
                    <aside class="dependency-inspector @(selected.IsUiModule ? "mo-vl-role--info" : selected.IsWebModule ? "mo-vl-role--secondary" : "mo-vl-role--primary")" aria-label="@L["Aria:DependencyInspector"]" @key="selected.ModuleKey">
                        <header class="selected-module-identity">
                            <span class="topology-eyebrow">@L["Dependencies:Selected:Eyebrow"]</span>
                            <h3>@selected.TypeName</h3>
                            <IdentifierValue Value="@selected.FullTypeName" />
                            <div class="selected-capabilities">
                                <span>@L["Dependencies:Selected:Depth", selected.DependencyDepth]</span>
                                @if (selected.IsUiModule) { <span>@L["ModuleDrawer:Capabilities:UI"]</span> }
                                @if (selected.IsWebModule) { <span>@L["ModuleDrawer:Capabilities:Web"]</span> }
                                @if (selected.RequiresWebHost) { <span>@L["ModuleDrawer:Capabilities:WebHost"]</span> }
                            </div>
                            <MudButton Variant="Variant.Text"
                                       EndIcon="@Icons.Material.Outlined.ArrowForward"
                                       OnClick="@(() => ModuleSelected.InvokeAsync(selected))">
                                @L["Dependencies:Selected:Inspect"]
                            </MudButton>
                        </header>
                        <div class="selected-module-relations">
                            <RelationshipList Title="@L["Dependencies:Selected:Requires"]"
                                              EmptyText="@L["Dependencies:Selected:NoDependencies"]"
                                              Modules="@RequiredModules(selected)"
                                              ModuleSelected="@ModuleSelected" />
                            <RelationshipList Title="@L["Dependencies:Selected:RequiredBy"]"
                                              EmptyText="@L["Dependencies:Selected:NoDependents"]"
                                              Modules="@DependentModules(selected)"
                                              ModuleSelected="@ModuleSelected" />
                        </div>
                    </aside>
                }
            </div>

            <section class="dependency-table-section">
                <MudButton Variant="Variant.Text"
                           StartIcon="@Icons.Material.Outlined.TableRows"
                           OnClick="@(() => Session.SetShowDependencyTable(!Session.ShowDependencyTable))"
                           aria-expanded="@(Session.ShowDependencyTable ? "true" : "false")">
                    @(Session.ShowDependencyTable ? L["Dependencies:Table:Hide"] : L["Dependencies:Table:Show"])
                </MudButton>
                <MudCollapse Expanded="@Session.ShowDependencyTable">
                    <div class="dependency-table-wrapper" role="region" aria-label="@L["Aria:DependencyTable"]" tabindex="0">
                        <MudTable T="ModuleDiagnosticsDependencyEdge" Items="@Session.VisibleDependencyEdges" Dense="true" Hover="true" Breakpoint="Breakpoint.None">
                            <HeaderContent>
                                <MudTh>@L["Dependencies:Table:Source"]</MudTh>
                                <MudTh>@L["Dependencies:Table:Target"]</MudTh>
                            </HeaderContent>
                            <RowTemplate Context="edge">
                                <MudTd DataLabel="@L["Dependencies:Table:Source"]">@ModuleName(edge.SourceModule)</MudTd>
                                <MudTd DataLabel="@L["Dependencies:Table:Target"]">@ModuleName(edge.TargetModule)</MudTd>
                            </RowTemplate>
                        </MudTable>
                    </div>
                </MudCollapse>
            </section>
        </section>
    </div>
}

@code {
    private ModuleDependencyGraphCanvas? _graphCanvas;
    private string _layout = "force";
    private string _searchText = string.Empty;

    [Parameter, EditorRequired] public ModuleSystemWorkbenchSession Session { get; set; } = default!;
    [Parameter] public EventCallback<ModuleDiagnosticsModule> ModuleSelected { get; set; }

    private IReadOnlyList<MoFact> TopologyFacts => Session.Snapshot is null
        ? []
        :
        [
            new(L["Dependencies:Overview:Edges"], Session.VisibleDependencyEdges.Count.ToString(CultureInfo.InvariantCulture)),
            new(L["Dependencies:Overview:Depth"], Session.VisibleDependencyModules.Select(static module => module.DependencyDepth).DefaultIfEmpty().Max().ToString(CultureInfo.InvariantCulture)),
            new(L["Dependencies:Overview:UiModules"], Session.VisibleDependencyModules.Count(static module => module.IsUiModule).ToString(CultureInfo.InvariantCulture)),
            new(L["Dependencies:Overview:WebModules"], Session.VisibleDependencyModules.Count(static module => module.IsWebModule).ToString(CultureInfo.InvariantCulture)),
        ];

    private void SetGraphScope(bool fullHost) => Session.SetShowFullDependencyGraph(fullHost);
    private void SetLayout(string value) => _layout = value;
    private void SetSearchText(string? value) => _searchText = value ?? string.Empty;
    private Task ZoomInAsync() => _graphCanvas?.ZoomInAsync() ?? Task.CompletedTask;
    private Task ZoomOutAsync() => _graphCanvas?.ZoomOutAsync() ?? Task.CompletedTask;
    private Task FitAsync() => _graphCanvas?.FitAsync() ?? Task.CompletedTask;
    private Task FocusSelectedAsync() => _graphCanvas?.FocusSelectedAsync() ?? Task.CompletedTask;

    private async Task SelectModuleById(string moduleId)
    {
        var module = Session.Snapshot?.Modules.FirstOrDefault(candidate =>
            string.Equals(candidate.ModuleKey.Id, moduleId, StringComparison.Ordinal));
        if (module is not null)
        {
            Session.SelectModule(module, openDrawer: false);
            await ModuleSelected.InvokeAsync(module);
            Session.CloseModuleDrawer();
        }
    }

    private Task<IEnumerable<string>> SearchModules(string? value, CancellationToken cancellationToken)
    {
        var modules = Session.Snapshot?.Modules
            .Where(module => string.IsNullOrWhiteSpace(value)
                             || module.TypeName.Contains(value, StringComparison.OrdinalIgnoreCase)
                             || module.FullTypeName.Contains(value, StringComparison.OrdinalIgnoreCase))
            .Select(static module => module.ModuleKey.Id)
            ?? [];
        return Task.FromResult(modules);
    }

    private string ModuleDisplayName(string? moduleId) => Session.Snapshot?.Modules
        .FirstOrDefault(module => string.Equals(module.ModuleKey.Id, moduleId, StringComparison.Ordinal))?.TypeName
        ?? moduleId
        ?? string.Empty;

    private IReadOnlyList<ModuleDiagnosticsModule> RequiredModules(ModuleDiagnosticsModule module) =>
        RelatedModules(snapshotEdge => snapshotEdge.SourceModule == module.ModuleKey, static edge => edge.TargetModule);

    private IReadOnlyList<ModuleDiagnosticsModule> DependentModules(ModuleDiagnosticsModule module) =>
        RelatedModules(snapshotEdge => snapshotEdge.TargetModule == module.ModuleKey, static edge => edge.SourceModule);

    private IReadOnlyList<ModuleDiagnosticsModule> RelatedModules(
        Func<ModuleDiagnosticsDependencyEdge, bool> predicate,
        Func<ModuleDiagnosticsDependencyEdge, Monica.Core.Modularity.Models.ModuleKey> keySelector)
    {
        if (Session.Snapshot is not { } snapshot)
        {
            return [];
        }

        var keys = snapshot.Topology.Edges.Where(predicate).Select(keySelector).ToHashSet();
        return snapshot.Modules.Where(module => keys.Contains(module.ModuleKey)).ToArray();
    }

    private string ModuleName(Monica.Core.Modularity.Models.ModuleKey key) =>
        Session.Snapshot?.Modules.FirstOrDefault(module => module.ModuleKey == key)?.TypeName ?? key.Value;
}
