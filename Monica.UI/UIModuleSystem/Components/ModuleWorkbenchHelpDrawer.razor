@using Microsoft.Extensions.Localization
@using Monica.UI.Localization
@using Monica.UI.UIModuleSystem.State
@inject IStringLocalizer<ModuleSystemResource> L

<MudDrawer Open="@Session.IsHelpDrawerOpen"
           OpenChanged="@OpenChanged"
           Anchor="Anchor.End"
           Variant="DrawerVariant.Temporary"
           Overlay="true"
           OverlayAutoClose="true"
           Fixed="true"
           Width="min(28rem, 100vw)"
           Elevation="4"
           role="dialog"
           aria-modal="true"
           aria-labelledby="module-help-title">
    @if (Session.IsHelpDrawerOpen)
    {
        <div class="help-drawer-content" @onkeydown="HandleKeyDownAsync">
            <MudFocusTrap Class="help-drawer-focus" DefaultFocus="DefaultFocus.FirstChild">
                <MudDrawerHeader>
                    <div class="help-header">
                        <MudIconButton Class="help-close" Icon="@Icons.Material.Outlined.Close"
                                       OnClick="@(() => OpenChanged.InvokeAsync(false))"
                                       aria-label="@L["Aria:CloseHelp"]" />
                        <div>
                            <span class="help-eyebrow">@L["Help:Eyebrow"]</span>
                            <h2 id="module-help-title">@L["Help:Title"]</h2>
                        </div>
                    </div>
                </MudDrawerHeader>
                <div class="help-topics">
                    <article><MudIcon Icon="@Icons.Material.Outlined.Route" Color="Color.Primary" /><div><strong>@L["Help:CriticalPath:Title"]</strong><p>@L["Help:CriticalPath:Description"]</p></div></article>
                    <article><MudIcon Icon="@Icons.Material.Outlined.Verified" Color="Color.Success" /><div><strong>@L["Help:Outcome:Title"]</strong><p>@L["Help:Outcome:Description"]</p></div></article>
                    <article><MudIcon Icon="@Icons.Material.Outlined.FindInPage" Color="Color.Info" /><div><strong>@L["Help:Discovery:Title"]</strong><p>@L["Help:Discovery:Description"]</p></div></article>
                    <article><MudIcon Icon="@Icons.Material.Outlined.Security" Color="Color.Warning" /><div><strong>@L["Help:Privacy:Title"]</strong><p>@L["Help:Privacy:Description"]</p></div></article>
                </div>
            </MudFocusTrap>
        </div>
    }
</MudDrawer>

@code {
    [Parameter, EditorRequired] public ModuleSystemWorkbenchSession Session { get; set; } = default!;
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    private Task HandleKeyDownAsync(KeyboardEventArgs args) =>
        args.Key == "Escape" ? OpenChanged.InvokeAsync(false) : Task.CompletedTask;
}
