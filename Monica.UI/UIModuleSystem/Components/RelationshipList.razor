@using Microsoft.Extensions.Localization
@using Monica.Core.Modularity.Diagnostics.Models
@using Monica.UI.Localization
@inject IStringLocalizer<ModuleSystemResource> L

<section class="relationship-list @(Compact ? "relationship-list--compact" : null)">
    <MudText Typo="Typo.subtitle2">
        @Title
        @if (Compact)
        {
            <span class="relationship-count">@Modules.Count</span>
        }
    </MudText>
    @if (Modules.Count == 0)
    {
        <span>@(string.IsNullOrWhiteSpace(EmptyText) ? L["ModuleDrawer:Dependencies:Empty"] : EmptyText)</span>
    }
    else
    {
        @foreach (var module in Modules)
        {
            @if (ModuleSelected.HasDelegate)
            {
                <button type="button" class="relationship-button" title="@(Compact ? module.FullTypeName : null)" aria-label="@(Compact ? module.FullTypeName : null)" @onclick="@(() => ModuleSelected.InvokeAsync(module))">
                    <strong>@module.TypeName</strong>
                    <code title="@module.FullTypeName">@module.FullTypeName</code>
                </button>
            }
            else
            {
                <div title="@(Compact ? module.FullTypeName : null)">
                    <strong>@module.TypeName</strong>
                    <code title="@module.FullTypeName">@module.FullTypeName</code>
                </div>
            }
        }
    }
</section>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public IReadOnlyList<ModuleDiagnosticsModule> Modules { get; set; } = [];
    [Parameter] public string? EmptyText { get; set; }
    [Parameter] public EventCallback<ModuleDiagnosticsModule> ModuleSelected { get; set; }

    /// <summary>
    /// Displays related modules as wrapping identity chips with a count in the heading.
    /// Defaults to <see langword="false"/> to retain the full relationship rows.
    /// </summary>
    [Parameter] public bool Compact { get; set; }
}
