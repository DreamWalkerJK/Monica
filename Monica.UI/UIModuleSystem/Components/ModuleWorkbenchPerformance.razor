@using Microsoft.Extensions.Localization
@using Monica.Core.Modularity.Diagnostics.Models
@using Monica.Core.Modularity.Models
@using Monica.UI.Localization
@using Monica.UI.UIModuleSystem.State
@using Monica.UI.UIModuleSystem.Support
@inject IStringLocalizer<ModuleSystemResource> L

@if (Session.Snapshot is { } snapshot)
{
    <div class="performance-layout">
        <ModuleCompositionWaterfall Session="@Session" ModuleSelected="@ModuleSelected" />

        @if (snapshot.Summary.PerformanceBudgets.Length > 0)
        {
            <section class="performance-panel performance-budgets" aria-labelledby="performance-budgets-title">
                <header class="performance-heading">
                    <div>
                        <span class="performance-eyebrow">@L["Performance:Budgets:Eyebrow"]</span>
                        <h2 id="performance-budgets-title">@L["Performance:Budgets:Title"]</h2>
                    </div>
                </header>
                <div class="budget-grid">
                    @foreach (var budget in snapshot.Summary.PerformanceBudgets)
                    {
                        <article data-budget-tone="@BudgetTone(budget.IsExceeded)">
                            <strong>@L[$"Enums:Budget:{budget.Kind}"]</strong>
                            <span>@L["Performance:Budgets:Measurement", ModuleDiagnosticsDisplay.Duration(budget.ActualDurationMs), ModuleDiagnosticsDisplay.Duration(budget.LimitDurationMs)]</span>
                            <MudProgressLinear Value="@Math.Min(100, budget.Utilization * 100)" Color="@(budget.IsExceeded ? Color.Warning : Color.Success)" Rounded="true" />
                            <small>@L["Performance:Budgets:Utilization", budget.Utilization.ToString("P0")]</small>
                        </article>
                    }
                </div>
            </section>
        }

        <div class="performance-grid @(!snapshot.BlockingChain.IsEmpty ? "performance-grid--causal" : null)">
            <section class="performance-panel performance-contributors" aria-labelledby="contributors-title">
                <header class="performance-heading">
                    <div>
                        <span class="performance-eyebrow">@L["Performance:Contributors:Eyebrow"]</span>
                        <h2 id="contributors-title">@L["Performance:Contributors:Title"] <span class="performance-record-count">@Session.PerformanceContributors.Count</span></h2>
                    </div>
                </header>
                <div class="contributor-filters">
                    <div class="performance-field">
                        <MudSelect T="int" Label="@L["Performance:Filters:Limit"]" Value="@Session.PerformanceContributorLimit" ValueChanged="@SetContributorLimit" Dense="true" Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem T="int" Value="10">10</MudSelectItem>
                            <MudSelectItem T="int" Value="25">25</MudSelectItem>
                            <MudSelectItem T="int" Value="50">50</MudSelectItem>
                            <MudSelectItem T="int" Value="0">@L["Common:All"]</MudSelectItem>
                        </MudSelect>
                    </div>
                    <div class="performance-field">
                        <MudNumericField T="double" Label="@L["Performance:Filters:MinimumMs"]" Value="@Session.PerformanceMinimumDurationMs" ValueChanged="@SetMinimumDuration" Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </div>
                    <div class="performance-field performance-field--switch">
                        <MudSwitch T="bool" Label="@L["Performance:Filters:HideZero"]" Value="@Session.HideZeroDurationContributors" ValueChanged="@SetHideZero" Color="Color.Primary" />
                    </div>
                </div>
                <div class="contributors-table-wrapper" role="region" aria-labelledby="contributors-title" tabindex="0">
                    <MudTable T="ModuleDiagnosticsModule" Items="@Session.PerformanceContributors" Dense="true" Hover="true" Breakpoint="Breakpoint.None">
                        <HeaderContent>
                            <MudTh>@L["Modules:Columns:Module"]</MudTh>
                            <MudTh>@L["Performance:Columns:Callbacks"]</MudTh>
                            <MudTh>@L["Performance:Columns:StartupWork"]</MudTh>
                            <MudTh>@L["Performance:Columns:Total"]</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="module">
                            <MudTd DataLabel="@L["Modules:Columns:Module"]">
                                <button type="button" class="performance-module-button" title="@module.FullTypeName" @onclick="@(() => ModuleSelected.InvokeAsync(module))">@module.TypeName</button>
                            </MudTd>
                            <MudTd DataLabel="@L["Performance:Columns:Callbacks"]"><code>@ModuleDiagnosticsDisplay.Duration(module.SerialCallbackDurationMs)</code></MudTd>
                            <MudTd DataLabel="@L["Performance:Columns:StartupWork"]"><code>@ModuleDiagnosticsDisplay.Duration(module.StartupWorkDurationMs)</code></MudTd>
                            <MudTd DataLabel="@L["Performance:Columns:Total"]">
                                <ModuleCostBreakdownBar ModuleName="@module.TypeName" CallbackDurationMs="@module.SerialCallbackDurationMs" StartupWorkDurationMs="@module.StartupWorkDurationMs" MaximumDurationMs="@MaximumModuleCost" />
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent><p class="performance-empty">@L["Performance:Contributors:Empty"]</p></NoRecordsContent>
                    </MudTable>
                </div>
            </section>

            @if (snapshot.BlockingChain.IsEmpty)
            {
                <section class="performance-blocking-summary" aria-labelledby="blocking-title">
                    <MudIcon Icon="@Icons.Material.Outlined.LinkOff" Size="Size.Small" />
                    <div><h2 id="blocking-title">@L["Performance:Blocking:Title"]</h2><p>@L["Performance:Blocking:Empty"]</p></div>
                </section>
            }
            else
            {
                <section class="performance-panel performance-blocking" aria-labelledby="blocking-title">
                    <header class="performance-heading">
                        <div><span class="performance-eyebrow">@L["Performance:Blocking:Eyebrow"]</span><h2 id="blocking-title">@L["Performance:Blocking:Title"]</h2></div>
                    </header>
                    <div class="blocking-list">
                        @foreach (var segment in snapshot.BlockingChain.OrderByDescending(static segment => segment.BlockingDurationMs))
                        {
                            var module = snapshot.Modules.FirstOrDefault(candidate => candidate.ModuleKey == segment.ModuleKey);
                            <article>
                                <button type="button" disabled="@(module is null)" @onclick="@(() => SelectModuleAsync(module))">
                                    <span><strong>@(module?.TypeName ?? segment.ModuleKey.Value)</strong><small>@L[$"Enums:Barrier:{segment.Barrier}"] · @segment.WorkItemId</small></span>
                                    <code>@ModuleDiagnosticsDisplay.Duration(segment.BlockingDurationMs)</code>
                                </button>
                                <div class="blocking-linkage">
                                    <div><span>@L["Performance:Blocking:BarrierSpan"]</span><IdentifierValue Value="@segment.BarrierSpanId" /></div>
                                    <div><span>@L["Performance:Blocking:WorkSpan"]</span><IdentifierValue Value="@segment.WorkSpanId" /></div>
                                    @if (!string.IsNullOrWhiteSpace(segment.CommitSpanId))
                                    {
                                        <div><span>@L["Performance:Blocking:CommitSpan", ModuleDiagnosticsDisplay.Duration(segment.CommitDurationMs)]</span><IdentifierValue Value="@(segment.CommitSpanId!)" /></div>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                </section>
            }
        </div>

        @if (Session.Comparison is { } comparison)
        {
            <section class="performance-panel comparison-evidence" aria-labelledby="comparison-evidence-title">
                <header class="performance-heading"><div><span class="performance-eyebrow">@L["Comparison:Eyebrow"]</span><h2 id="comparison-evidence-title">@L["Comparison:EvidenceTitle"]</h2></div></header>
                <dl class="comparison-kpis">
                    <div><dt>@L["Overview:Kpis:Composition"]</dt><dd>@SignedDuration(comparison.TotalDurationDeltaMs)</dd></div>
                    <div><dt>@L["Overview:Kpis:TypeDiscovery"]</dt><dd>@SignedDuration(comparison.TypeDiscoveryDurationDeltaMs)</dd></div>
                    <div><dt>@L["Comparison:ModulesChanged"]</dt><dd>+@comparison.AddedModules.Count / -@comparison.RemovedModules.Count</dd></div>
                    <div><dt>@L["Comparison:EdgesChanged"]</dt><dd>+@comparison.AddedEdges.Count / -@comparison.RemovedEdges.Count</dd></div>
                </dl>
                <div class="comparison-changes">
                    <MudExpansionPanels MultiExpansion="true">
                        <MudExpansionPanel Text="@L["Comparison:AddedModules", comparison.AddedModules.Count]"><ChangeList Values="@comparison.AddedModules" EmptyText="@L["Comparison:NoChanges"]" /></MudExpansionPanel>
                        <MudExpansionPanel Text="@L["Comparison:RemovedModules", comparison.RemovedModules.Count]"><ChangeList Values="@comparison.RemovedModules" EmptyText="@L["Comparison:NoChanges"]" /></MudExpansionPanel>
                        <MudExpansionPanel Text="@L["Comparison:AddedEdges", comparison.AddedEdges.Count]"><ChangeList Values="@comparison.AddedEdges" EmptyText="@L["Comparison:NoChanges"]" /></MudExpansionPanel>
                        <MudExpansionPanel Text="@L["Comparison:RemovedEdges", comparison.RemovedEdges.Count]"><ChangeList Values="@comparison.RemovedEdges" EmptyText="@L["Comparison:NoChanges"]" /></MudExpansionPanel>
                    </MudExpansionPanels>
                </div>
            </section>
        }

        <section class="performance-panel performance-discovery" aria-labelledby="discovery-stages-title">
            <header class="performance-heading"><div><span class="performance-eyebrow">@L["Performance:Discovery:Eyebrow"]</span><h2 id="discovery-stages-title">@L["Performance:Discovery:Title"]</h2></div></header>
            <ol class="stage-strip" role="region" aria-labelledby="discovery-stages-title" tabindex="0">
                @foreach (var stage in snapshot.TypeDiscovery.Stages)
                {
                    <li><span>@ModuleDiagnosticsDisplay.Stage(stage.Stage, L)</span><strong title="@ModuleDiagnosticsDisplay.ExactMilliseconds(stage.DurationMs)">@ModuleDiagnosticsDisplay.Duration(stage.DurationMs)</strong></li>
                }
            </ol>
        </section>

        <section class="performance-panel performance-startup-work" aria-labelledby="startup-work-title">
            <header class="performance-heading"><div><span class="performance-eyebrow">@L["Performance:StartupWork:Eyebrow"]</span><h2 id="startup-work-title">@L["Performance:StartupWork:Title"]</h2></div></header>
            <div class="startup-work-table-wrapper" role="region" aria-labelledby="startup-work-title" tabindex="0">
                <MudTable T="ModuleDiagnosticsTraceSpan" Items="@StartupWorkSpans" RowsPerPage="10" Dense="true" Hover="true" Breakpoint="Breakpoint.None">
                    <HeaderContent>
                        <MudTh>@L["Performance:Columns:Module"]</MudTh>
                        <MudTh>@L["Performance:Columns:WorkItem"]</MudTh>
                        <MudTh>@L["Performance:Columns:Queue"]</MudTh>
                        <MudTh>@L["Performance:Columns:Duration"]</MudTh>
                        <MudTh>@L["Performance:Columns:State"]</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="work">
                        <MudTd DataLabel="@L["Performance:Columns:Module"]">@TracePrimaryLabel(work)</MudTd>
                        <MudTd DataLabel="@L["Performance:Columns:WorkItem"]"><code>@(work.WorkItemId ?? work.Name ?? L["Common:NotAvailable"])</code></MudTd>
                        <MudTd DataLabel="@L["Performance:Columns:Queue"]"><code>@ModuleDiagnosticsDisplay.Duration(work.QueueDurationMs ?? 0)</code></MudTd>
                        <MudTd DataLabel="@L["Performance:Columns:Duration"]"><code>@ModuleDiagnosticsDisplay.Duration(work.DurationMs)</code></MudTd>
                        <MudTd DataLabel="@L["Performance:Columns:State"]">
                            <span class="performance-work-state @(work.IsFailed ? "performance-work-state--failed" : work.IsComplete ? "performance-work-state--complete" : "performance-work-state--running")">
                                @(work.IsFailed ? L["Enums:SpanState:Failed"] : work.IsComplete ? L["Enums:SpanState:Complete"] : L["Enums:SpanState:Running"])
                            </span>
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent><p class="performance-empty">@L["Performance:StartupWork:Empty"]</p></NoRecordsContent>
                    <PagerContent><MudTablePager PageSizeOptions="@(new[] { 10, 25, 50 })" /></PagerContent>
                </MudTable>
            </div>
        </section>
    </div>
}

@code {
    [Parameter, EditorRequired] public ModuleSystemWorkbenchSession Session { get; set; } = default!;
    [Parameter] public EventCallback<ModuleDiagnosticsModule> ModuleSelected { get; set; }

    private static string BudgetTone(bool isExceeded) => isExceeded ? "warning" : "success";

    private IReadOnlyList<ModuleDiagnosticsTraceSpan> StartupWorkSpans => Session.Snapshot?.TraceSpans
        .Where(static span => span.Kind == ModuleDiagnosticsTraceSpanKind.StartupWork)
        .OrderByDescending(static span => span.DurationMs)
        .ToArray() ?? [];

    private double MaximumModuleCost => Session.Snapshot?.Modules
        .Select(ModuleCost)
        .DefaultIfEmpty(0)
        .Max() ?? 0;

    private string TracePrimaryLabel(ModuleDiagnosticsTraceSpan span) => Session.Snapshot is { } snapshot
        ? ModuleDiagnosticsDisplay.TraceSpan(span, snapshot, L).Primary
        : span.Name ?? L[$"Enums:TraceKind:{span.Kind}"];

    private void SetContributorLimit(int value) => Session.SetPerformanceFilters(
        value,
        Session.PerformanceMinimumDurationMs,
        Session.HideZeroDurationContributors);

    private void SetMinimumDuration(double value) => Session.SetPerformanceFilters(
        Session.PerformanceContributorLimit,
        value,
        Session.HideZeroDurationContributors);

    private void SetHideZero(bool value) => Session.SetPerformanceFilters(
        Session.PerformanceContributorLimit,
        Session.PerformanceMinimumDurationMs,
        value);

    private async Task SelectModuleAsync(ModuleDiagnosticsModule? module)
    {
        if (module is not null)
        {
            await ModuleSelected.InvokeAsync(module);
        }
    }

    private static double ModuleCost(ModuleDiagnosticsModule module) =>
        module.SerialCallbackDurationMs + module.StartupWorkDurationMs;

    private static string SignedDuration(double duration) =>
        $"{(duration > 0 ? "+" : duration < 0 ? "-" : string.Empty)}{ModuleDiagnosticsDisplay.Duration(Math.Abs(duration))}";
}
