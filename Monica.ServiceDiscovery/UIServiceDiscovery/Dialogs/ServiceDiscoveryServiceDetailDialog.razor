@namespace Monica.ServiceDiscovery.UIServiceDiscovery.Dialogs
@using Monica.ServiceDiscovery.UIServiceDiscovery.Components
@using Monica.ServiceDiscovery.Localization
@using Monica.ServiceDiscovery.Models
@using Monica.UI.Shared.Components.Dialogs
@inject IStringLocalizer<ServiceDiscoveryResource> L

<MudDialog>
    <TitleContent><MoDialogHeading Text="@L["ServiceDetailDialog:Title", _service?.AppName ?? L["Shared:Values:Unknown"].Value]" /></TitleContent>
    <DialogContent>
        @if (_service is not null) { <div class="service-dialog-content"><ServiceDiscoveryServiceDetail Service="@_service" CapturedAt="@_capturedAt" /></div> }
    </DialogContent>
    <DialogActions><MudButton Color="Color.Default" OnClick="Close">@L["Shared:Actions:Close"]</MudButton></DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    /// <summary>Gets or sets the service read to freeze for this dialog's lifetime.</summary>
    [Parameter, EditorRequired] public RegisteredServiceStatus Service { get; set; } = null!;
    /// <summary>Gets or sets the UTC capture time of the originating directory read.</summary>
    [Parameter] public DateTime? CapturedAt { get; set; }
    private RegisteredServiceStatus? _service;
    private DateTime? _capturedAt;

    protected override void OnParametersSet()
    {
        if (_service is not null || Service is null) return;
        _service = ServiceDiscoverySnapshot.Copy(Service);
        _capturedAt = CapturedAt is { } captured
            ? captured.Kind == DateTimeKind.Local ? captured.ToUniversalTime() : DateTime.SpecifyKind(captured, DateTimeKind.Utc)
            : null;
    }

    private void Close() => MudDialog.Close();
}
