@using Monica.ServiceDiscovery.Localization
@using Monica.ServiceDiscovery.UIServiceDiscovery.Models
@inject IStringLocalizer<ServiceDiscoveryResource> L

<div class="atlas-layout">
    <fieldset class="atlas-layout__types">
        <legend>@L["DomainLayout:Labels:LayoutType"]</legend>
        <div class="atlas-layout__buttons">
            <button type="button" aria-pressed="@(CurrentLayout == DomainLayoutType.Force ? "true" : "false")" @onclick="@(() => SetLayout(DomainLayoutType.Force))">@L["DomainLayout:Types:Force"]</button>
            <button type="button" aria-pressed="@(CurrentLayout == DomainLayoutType.Hierarchy ? "true" : "false")" @onclick="@(() => SetLayout(DomainLayoutType.Hierarchy))">@L["DomainLayout:Types:Hierarchy"]</button>
            <button type="button" aria-pressed="@(CurrentLayout == DomainLayoutType.Circular ? "true" : "false")" @onclick="@(() => SetLayout(DomainLayoutType.Circular))">@L["DomainLayout:Types:Circular"]</button>
            <button type="button" aria-pressed="@(CurrentLayout == DomainLayoutType.RadialTree ? "true" : "false")" @onclick="@(() => SetLayout(DomainLayoutType.RadialTree))">@L["DomainLayout:Types:RadialTree"]</button>
        </div>
    </fieldset>
    @if (CurrentLayout == DomainLayoutType.Force)
    {
        <div class="atlas-layout__slider"><span>@L["DomainLayout:Labels:NodeSpacing", ForceDistance]</span>
            <MudSlider T="int" Value="@ForceDistance" ValueChanged="OnForceDistanceChanged" Min="100" Max="400" Step="10" Color="Color.Primary" aria-label="@L["DomainLayout:Labels:NodeSpacing", ForceDistance]" /></div>
        <div class="atlas-layout__slider"><span>@L["DomainLayout:Labels:RepulsionStrength", ForceStrength]</span>
            <MudSlider T="int" Value="@ForceStrength" ValueChanged="OnForceStrengthChanged" Min="-1200" Max="-400" Step="50" Color="Color.Primary" aria-label="@L["DomainLayout:Labels:RepulsionStrength", ForceStrength]" /></div>
    }
</div>

@code {
    [Parameter] public DomainLayoutType CurrentLayout { get; set; } = DomainLayoutType.Force;
    [Parameter] public EventCallback<DomainLayoutType> CurrentLayoutChanged { get; set; }

    [Parameter] public int ForceDistance { get; set; } = 200;
    [Parameter] public EventCallback<int> ForceDistanceChanged { get; set; }

    [Parameter] public int ForceStrength { get; set; } = -800;
    [Parameter] public EventCallback<int> ForceStrengthChanged { get; set; }

    private async Task SetLayout(DomainLayoutType layoutType)
    {
        CurrentLayout = layoutType;
        await CurrentLayoutChanged.InvokeAsync(layoutType);
    }

    private async Task OnForceDistanceChanged(int value)
    {
        ForceDistance = value;
        await ForceDistanceChanged.InvokeAsync(value);
    }

    private async Task OnForceStrengthChanged(int value)
    {
        ForceStrength = value;
        await ForceStrengthChanged.InvokeAsync(value);
    }
}
