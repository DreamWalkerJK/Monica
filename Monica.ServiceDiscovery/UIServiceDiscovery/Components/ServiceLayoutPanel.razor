@using Monica.ServiceDiscovery.Localization
@using Monica.ServiceDiscovery.UIServiceDiscovery.Models
@inject IStringLocalizer<ServiceDiscoveryResource> L

<div class="atlas-layout">
    <fieldset class="atlas-layout__types">
        <legend>@L["ServiceLayout:Labels:LayoutType"]</legend>
        <div class="atlas-layout__buttons">
            <button type="button" aria-pressed="@(CurrentLayout == ServiceLayoutType.Force ? "true" : "false")" @onclick="@(() => SetLayout(ServiceLayoutType.Force))">@L["ServiceLayout:Types:Force"]</button>
            <button type="button" aria-pressed="@(CurrentLayout == ServiceLayoutType.Hierarchy ? "true" : "false")" @onclick="@(() => SetLayout(ServiceLayoutType.Hierarchy))">@L["ServiceLayout:Types:Hierarchy"]</button>
            <button type="button" aria-pressed="@(CurrentLayout == ServiceLayoutType.Circular ? "true" : "false")" @onclick="@(() => SetLayout(ServiceLayoutType.Circular))">@L["ServiceLayout:Types:Circular"]</button>
            <button type="button" aria-pressed="@(CurrentLayout == ServiceLayoutType.Grid ? "true" : "false")" @onclick="@(() => SetLayout(ServiceLayoutType.Grid))">@L["ServiceLayout:Types:Grid"]</button>
        </div>
    </fieldset>
    @if (CurrentLayout == ServiceLayoutType.Force)
    {
        <div class="atlas-layout__slider"><span>@L["ServiceLayout:Labels:NodeSpacing", ForceDistance]</span>
            <MudSlider T="int" Value="@ForceDistance" ValueChanged="OnForceDistanceChanged" Min="50" Max="500" Step="10" Color="Color.Primary" aria-label="@L["ServiceLayout:Labels:NodeSpacing", ForceDistance]" /></div>
        <div class="atlas-layout__slider"><span>@L["ServiceLayout:Labels:RepulsionStrength", ForceStrength]</span>
            <MudSlider T="int" Value="@ForceStrength" ValueChanged="OnForceStrengthChanged" Min="-1000" Max="-100" Step="50" Color="Color.Primary" aria-label="@L["ServiceLayout:Labels:RepulsionStrength", ForceStrength]" /></div>
    }
</div>

@code {
    [Parameter] public ServiceLayoutType CurrentLayout { get; set; } = ServiceLayoutType.Force;
    [Parameter] public EventCallback<ServiceLayoutType> CurrentLayoutChanged { get; set; }

    [Parameter] public int ForceDistance { get; set; } = 150;
    [Parameter] public EventCallback<int> ForceDistanceChanged { get; set; }

    [Parameter] public int ForceStrength { get; set; } = -500;
    [Parameter] public EventCallback<int> ForceStrengthChanged { get; set; }

    private async Task SetLayout(ServiceLayoutType layoutType)
    {
        CurrentLayout = layoutType;
        await CurrentLayoutChanged.InvokeAsync(layoutType);
    }

    private async Task OnForceDistanceChanged(int value)
    {
        ForceDistance = value;
        await ForceDistanceChanged.InvokeAsync(value);
    }

    private async Task OnForceStrengthChanged(int value)
    {
        ForceStrength = value;
        await ForceStrengthChanged.InvokeAsync(value);
    }
}
