@using Monica.ServiceDiscovery.Localization
@using Monica.ServiceDiscovery.Models
@using Monica.ServiceDiscovery.UIServiceDiscovery.Dialogs
@inject IDialogService DialogService
@inject IStringLocalizer<ServiceDiscoveryResource> L
@implements IAsyncDisposable

@code {
    private readonly HashSet<Task<IDialogReference>> _opening = [];
    private readonly HashSet<IDialogReference> _dialogs = [];
    private bool _disposed;

    /// <summary>Freezes selected evidence and opens a native inspector owned by this route's lifetime.</summary>
    public async Task ShowAsync(RegisteredServiceStatus service, DateTime? capturedAt = null)
    {
        if (_disposed) return;
        var parameters = new DialogParameters<ServiceDiscoveryServiceDetailDialog>
        {
            { dialog => dialog.Service, ServiceDiscoverySnapshot.Copy(service) },
            { dialog => dialog.CapturedAt, capturedAt }
        };
        var pending = DialogService.ShowAsync<ServiceDiscoveryServiceDetailDialog>(
            L["ServiceList:Dialogs:ServiceDetailTitle"].Value, parameters,
            new DialogOptions { CloseOnEscapeKey = true, FullWidth = true, MaxWidth = MaxWidth.Large, CloseButton = true });
        _opening.Add(pending);
        try
        {
            var dialog = await pending;
            if (_disposed) Cancel(dialog);
            else
            {
                _dialogs.RemoveWhere(item => item.Result.IsCompleted);
                _dialogs.Add(dialog);
            }
        }
        finally { _opening.Remove(pending); }
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        foreach (var dialog in _dialogs) Cancel(dialog);
        foreach (var pending in _opening.ToArray()) Cancel(await pending);
        _dialogs.Clear();
    }

    private static void Cancel(IDialogReference dialog)
    {
        var result = DialogResult.Cancel();
        dialog.Close(result);
        dialog.Dismiss(result);
    }
}
