@using Monica.StateStore.Abstractions
@using Monica.StateStore.UI.Models
@inject IStringLocalizer<StateStoreResource> L

<MudCard Class="provider-row" Elevation="0">
    <MudCardHeader>
        <CardHeaderAvatar>
            <MudAvatar Color="@GetProviderColor()" Size="Size.Large">
                <MoIcon Icon="@GetProviderIcon()" Size="1.5rem" />
            </MudAvatar>
        </CardHeaderAvatar>
        <CardHeaderContent>
            <MudText Typo="Typo.h6">@L.GetProviderDisplayName(Provider)</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@Provider.ImplementationType</MudText>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudChip T="string" Color="@GetProviderColor()" Size="Size.Small" CheckedIcon="@MoIcons.Check" CloseIcon="@MoIcons.Close">
                @L.GetProviderTypeText(Provider.ProviderType)
            </MudChip>
        </CardHeaderActions>
    </MudCardHeader>

    <MudCardContent Class="provider-row__capabilities">
        <MudStack Spacing="2">
            @* Capability label *@
            <div class="d-flex flex-wrap gap-1">
                @if (Provider.IsDefaultStateStore)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled" CheckedIcon="@MoIcons.Check" CloseIcon="@MoIcons.Close">
                        <MoIcon Icon="@MoIcons.Star" Size="1.25rem" Class="mr-1" />
                        IStateStore
                    </MudChip>
                }

                @if (Provider.SupportsKeyScanning)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined" CheckedIcon="@MoIcons.Check" CloseIcon="@MoIcons.Close">
                        <MoIcon Icon="@MoIcons.Search" Size="1.25rem" Class="mr-1" />
                        @L["ProviderCard:Labels:KeyScanning"]
                    </MudChip>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined" CheckedIcon="@MoIcons.Check" CloseIcon="@MoIcons.Close">
                        <MoIcon Icon="@MoIcons.SearchOff" Size="1.25rem" Class="mr-1" />
                        @L["ProviderCard:Labels:NoScanningSupport"]
                    </MudChip>
                }

                @if (Provider.IsDistributed)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined" CheckedIcon="@MoIcons.Check" CloseIcon="@MoIcons.Close">
                        <MoIcon Icon="@MoIcons.Cloud" Size="1.25rem" Class="mr-1" />
                        @L["ProviderCard:Labels:Distributed"]
                    </MudChip>
                }

                @if (Provider.HasOptionDiagnostics)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined" CheckedIcon="@MoIcons.Check" CloseIcon="@MoIcons.Close">
                        <MoIcon Icon="@MoIcons.Settings" Size="1.25rem" Class="mr-1" />
                        @L["ProviderCard:Labels:HasConfiguration"]
                    </MudChip>
                }

            </div>
        </MudStack>
    </MudCardContent>

    <MudCardActions Class="provider-row__actions">
        <MudButton Variant="Variant.Text"
                   Color="Color.Primary"
                   EndIcon="@MoIcons.ExternalLink"
                   OnClick="OnViewDetails">
            @L["ProviderCard:Actions:ViewDetails"]
        </MudButton>
    </MudCardActions>
</MudCard>

@code {
    [Parameter] public StateStoreProviderInfo Provider { get; set; } = null!;

    [Parameter] public EventCallback<StateStoreProviderInfo> OnViewDetailsClicked { get; set; }

    private string GetProviderIcon() => Provider.ProviderType switch
    {
        EStateStoreProviderType.Redis => MoIcons.Database,
        EStateStoreProviderType.Dapr => MoIcons.Cloud,
        EStateStoreProviderType.Memory => MoIcons.Cpu,
        _ => MoIcons.Help
    };

    private Color GetProviderColor() => Provider.ProviderType switch
    {
        EStateStoreProviderType.Redis => Color.Error,
        EStateStoreProviderType.Dapr => Color.Info,
        EStateStoreProviderType.Memory => Color.Success,
        _ => Color.Default
    };

    private async Task OnViewDetails()
    {
        await OnViewDetailsClicked.InvokeAsync(Provider);
    }
}
