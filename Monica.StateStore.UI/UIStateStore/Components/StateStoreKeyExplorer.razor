@using Monica.UI.Shared.Components.States
@using Monica.UI.Shared.Components.Dialogs
@using Monica.Modules
@using Monica.StateStore.UI.Models
@using Monica.StateStore.UI.Services
@using Monica.StateStore.Models
@inject StateStoreUIService StateStoreService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IStringLocalizer<StateStoreResource> L
@inject IJSRuntime JS
@implements IAsyncDisposable
@implements IDisposable

<div class="state-browser-workspace" @ref="_workspace" data-visit="@_visit" data-provider-generation="@_providerGeneration" data-result-generation="@_resultGeneration" data-selection-generation="@_selectionGeneration" data-selected-key="@selectedKey?.Key" data-picker-open="@(_pickerOpen ? "true" : "false")" data-focus-version="@_focusVersion" aria-busy="@(isSearching ? "true" : "false")">
    <header class="workspace-identity">
        <div class="workspace-identity__copy">@HeaderContent</div>
        @if (CanCreateSelectedProviderKeys())
        {
            <MudButton Class="create-key" Color="Color.Success" Variant="Variant.Outlined" StartIcon="@MoIcons.Add" OnClick="OpenCreateKeyDialog">@L["KeyExplorer:Actions:Create"]</MudButton>
        }
    </header>
    <section class="workspace-commands">
        <div class="provider-context">
            <span class="section-label">@L["KeyExplorer:Labels:ProviderScope"]</span>
            @if (Providers.Count > 1)
            {
                <MudSelect T="string" Class="provider-select" Value="@selectedProvider?.UniqueId" ValueChanged="SelectProviderIdentity" Label="@L["KeyExplorer:Labels:ProviderScope"]" Variant="Variant.Outlined" OpenIcon="@MoIcons.ChevronDown" CloseIcon="@MoIcons.ChevronUp">
                    @foreach (var provider in Providers)
                    {
                        <MudSelectItem T="string" Value="@provider.UniqueId"><span class="provider-option">@GetProviderCaption(provider)</span></MudSelectItem>
                    }
                </MudSelect>
            }
            else if (selectedProvider is not null)
            {
                <strong class="provider-name">@L.GetProviderDisplayName(selectedProvider)</strong>
            }
            @if (selectedProvider is not null)
            {
                <span>@GetProviderCardDescription(selectedProvider)</span>
                <div class="provider-actions">
                    <MudButton Variant="Variant.Text" OnClick="() => OpenProviderDetail(selectedProvider)">@L["ProviderCard:Actions:ViewDetails"]</MudButton>
                    @if (OnRefreshProviders.HasDelegate)
                    {
                        <MudButton Variant="Variant.Text" Disabled="@isRefreshingProviders" OnClick="RefreshProvidersAsync">@L["KeyExplorer:Actions:RefreshProviders"]</MudButton>
                    }
                </div>
            }
        </div>
        <div class="query-context">
            <div class="mode-switch" role="group" aria-label="@L["KeyExplorer:Labels:SearchMode"]">
                <MudButton Variant="@(IsSearchMode(EStateStoreKeySearchMode.ExactKey) ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" Disabled="@(selectedProvider?.SupportsExactLookup != true)" aria-pressed="@(IsSearchMode(EStateStoreKeySearchMode.ExactKey) ? "true" : "false")" OnClick="() => SetSearchMode(EStateStoreKeySearchMode.ExactKey)">@L["KeyExplorer:Labels:ExactLookupMode"]</MudButton>
                <MudButton Variant="@(IsSearchMode(EStateStoreKeySearchMode.PatternScan) ? Variant.Filled : Variant.Outlined)" Color="Color.Primary" Disabled="@(selectedProvider?.SupportsKeyScanning != true)" aria-pressed="@(IsSearchMode(EStateStoreKeySearchMode.PatternScan) ? "true" : "false")" OnClick="() => SetSearchMode(EStateStoreKeySearchMode.PatternScan)">@L["KeyExplorer:Labels:PatternSearchMode"]</MudButton>
            </div>
            <div class="query-field-row">
                <MudTextField T="string" Class="search-field" Value="@searchQuery" ValueChanged="ChangeQuery" Label="@GetSearchLabel()" Placeholder="@GetSearchPlaceholder()" Variant="Variant.Outlined" Immediate="true" Disabled="@(selectedProvider is null)" Adornment="Adornment.End" AdornmentIcon="@MoIcons.Search" OnAdornmentClick="SearchKeysAsync" OnKeyDown="OnSearchKeyDown" UserAttributes="@_structuredInput" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@(!CanSearch())" OnClick="SearchKeysAsync">@GetSearchActionText()</MudButton>
            </div>
            <p class="query-help">@GetSearchModeDescription()</p>
            @if (!string.IsNullOrEmpty(GetWorkspaceSupportMessage())) { <MudAlert Severity="Severity.Info" Dense="true" Icon="@MoIcons.Info">@GetWorkspaceSupportMessage()</MudAlert> }
        </div>
    </section>
    @if (browseResult is not null)
    {
        <div class="accepted-context" data-query="@browseResult.Query" data-mode="@browseResult.AppliedMode" data-provider="@_acceptedProvider?.UniqueId">
            <div><span>@GetProviderCaption(_acceptedProvider!) · @GetSearchModeText(browseResult.AppliedMode)</span><span class="accepted-query"><span>@L["KeyExplorer:Labels:CompletedQuery"]</span> <code>@browseResult.Query</code></span></div>
            <strong>@L["KeyExplorer:Labels:ShownMatched", keys.Count, browseResult.TotalCount]</strong>
            @if (browseResult.HasMore) { <p>@L["KeyExplorer:Messages:ShowingFirst", keys.Count]</p> }
        </div>
    }
    @if (isSearching)
    {
        <div class="workspace-state"><MoContentState Loading="true"><MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Small" /><p>@GetSearchActionText()</p></MoContentState></div>
    }
    else if (!string.IsNullOrWhiteSpace(browseError))
    {
        <MudAlert Severity="Severity.Error" Icon="@MoIcons.Error">@browseError</MudAlert>
    }
    else if (!hasBrowsed || selectedProvider is null)
    {
        <div class="workspace-state"><MoContentState><h2>@L[selectedProvider is null ? "KeyExplorer:Workspace:NoProviderTitle" : "KeyExplorer:Workspace:ReadyTitle"]</h2><p>@L[selectedProvider is null ? "KeyExplorer:Workspace:NoProviderSubtitle" : "KeyExplorer:Workspace:ReadySubtitle"]</p></MoContentState></div>
    }
    else if (browseResult?.IsMissing == true)
    {
        <div class="workspace-state"><MoContentState><h2>@L["KeyExplorer:Messages:MissingKeyTitle"]</h2><p>@L["KeyExplorer:Messages:MissingKeyDescription", browseResult.Query]</p></MoContentState></div>
    }
    else if (keys.Count == 0)
    {
        <div class="workspace-state"><MoContentState><h2>@L["KeyExplorer:Messages:NoKeysFound"]</h2><p>@L["KeyExplorer:Messages:NoKeysFoundHint"]</p></MoContentState></div>
    }
    else
    {
        <div class="workspace-master-detail">
            <section class="inventory">
                <header class="inventory-heading" id="@(_visit + "-inventory")" tabindex="-1"><h2>@L["KeyExplorer:Labels:Keys"]</h2><MudButton Class="picker-toggle" Variant="Variant.Text" aria-expanded="@(_pickerOpen ? "true" : "false")" aria-controls="@(_visit + "-list")" OnClick="TogglePicker">@L["KeyExplorer:Actions:ChooseKeys"]</MudButton></header>
                <div class="compact-selection"><code title="@selectedKey?.Key">@selectedKey?.Key</code></div>
                @if (CanShowRowSelection() && selectedKeyNames.Count > 0)
                    {
                        <div class="bulk-actions"><span>@L["KeyExplorer:Labels:SelectedCount", selectedKeyNames.Count]</span><MudButton Variant="Variant.Text" Color="Color.Error" Disabled="@_isMutating" OnClick="DeleteSelectedKeysAsync">@L["KeyExplorer:Actions:DeleteSelected", selectedKeyNames.Count]</MudButton></div>
                    }
                <div class="inventory-body" id="@(_visit + "-list")">
                    <div class="results-list">
                        @foreach (var item in keys)
                        {
                            <div class="@GetResultRowClass(item)" @key="item.Key">
                                @if (CanShowRowSelection()) { <MudCheckBox T="bool" Color="Color.Primary" Value="@selectedKeyNames.Contains(item.Key)" ValueChanged="value => ToggleKeySelection(item, value)" aria-label="@L["KeyExplorer:Labels:SelectKey", item.Key]" CheckedIcon="@MoIcons.SquareCheck" UncheckedIcon="@MoIcons.Square" IndeterminateIcon="@MoIcons.SquareMinus" /> }
                                <button class="result-select" type="button" aria-pressed="@(selectedKey?.Key == item.Key ? "true" : "false")" title="@item.Key" data-key="@item.Key" @onclick="() => SelectKeyManualAsync(item)"><code class="result-key">@item.Key</code><span class="result-preview">@GetResultPreviewText(item)</span>@if (item.IsValueLoaded || loadingKeyName == item.Key) { <span class="result-status" data-tone="@GetResultStatusColor(item)">@GetResultStatusText(item)</span> }</button>
                            </div>
                        }
                    </div>
                </div>
            </section>
            @if (selectedKey is not null)
            {
                <section class="inspector">
                    <header class="inspector-heading" id="@(_visit + "-detail")"><span class="section-label">@L["KeyExplorer:Detail:SelectedKeyLabel"]</span><h2 tabindex="-1"><code>@selectedKey.Key</code></h2></header>
                    <div class="inspector-actions">
                        @if (CanViewKeys()) { <MudButton Variant="Variant.Outlined" OnClick="() => ViewKeyAsync(selectedKey)">@L["KeyExplorer:Actions:View"]</MudButton> }
                        @if (CanEditSelectedProviderKeys()) { <MudButton Variant="Variant.Outlined" Disabled="@_isMutating" OnClick="() => EditKeyAsync(selectedKey)">@L["KeyExplorer:Actions:Edit"]</MudButton> }
                        @if (CanDeleteSelectedProviderKey()) { <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="@_isMutating" OnClick="() => DeleteKeyAsync(selectedKey)">@L["KeyExplorer:Actions:Delete"]</MudButton> }
                        <MudButton Class="back-to-keys" Variant="Variant.Text" OnClick="BackToKeysAsync">@L["KeyExplorer:Actions:BackToKeys"]</MudButton>
                    </div>
                    <dl class="key-facts"><div><dt>@L["KeyExplorer:Detail:Labels:ETag"]</dt><dd><code>@(string.IsNullOrEmpty(selectedKey.ETag) ? L["KeyExplorer:Detail:NotSupplied"].Value : selectedKey.ETag)</code></dd></div><div><dt>@L["KeyExplorer:Detail:Labels:TTL"]</dt><dd><code>@GetTtlText(selectedKey)</code></dd></div></dl>
                    <h3>@L["KeyExplorer:Labels:ValuePreview"]</h3>
                    @if (loadingKeyName == selectedKey.Key) { <p role="status">@L["KeyExplorer:Statuses:Loading"]</p> }
                    else if (!string.IsNullOrWhiteSpace(selectedKey.Error))
                    {
                        <MudAlert Severity="Severity.Error" Icon="@MoIcons.Error">@(selectedKey.RawValue is null ? selectedKey.Error : L["KeyExplorer:Messages:ValueRefreshFailed", selectedKey.Error])</MudAlert>
                        <MudButton Variant="Variant.Text" OnClick="ReloadSelectedKeyAsync">@L["KeyValuePreview:Actions:LoadValue"]</MudButton>
                        @if (selectedKey.RawValue is not null) { <p>@L["KeyExplorer:Messages:PreviewRetainedTitle"]</p><pre class="value-preview">@selectedKey.RawValue</pre> }
                    }
                    else if (selectedProvider?.SupportsValuePreview != true) { <p>@L["KeyExplorer:Messages:ValuePreviewUnavailable"]</p> }
                    else if (!selectedKey.IsValueLoaded) { <p>@L["KeyExplorer:Statuses:SelectToInspect"]</p> }
                    else if (selectedKey.RawValue is null) { <p>@L["KeyValuePreview:Labels:Empty"]</p> }
                    else { <pre class="value-preview">@selectedKey.RawValue</pre> }
                </section>
            }
        </div>
    }
</div>
<StateStoreProviderDetailDialog IsVisible="isProviderDetailVisible" IsVisibleChanged="OnProviderDetailVisibilityChanged" Provider="providerDetailTarget" />
<MudDialog Visible="@(_confirmation is not null)" VisibleChanged="OnConfirmationVisibilityChanged" Options="@_confirmationOptions" ContentClass="pa-0" ActionsClass="pa-0">
    <TitleContent><MoDialogHeading Text="@(_confirmation?.Title ?? string.Empty)" /></TitleContent>
    <DialogContent><div class="confirmation-content"><p>@_confirmation?.Message</p><code class="confirmation-provider">@_confirmation?.Provider</code></div></DialogContent>
    <DialogActions><div class="confirmation-actions"><MudButton OnClick="() => CompleteConfirmation(false)">@L["KeyExplorer:Dialogs:DeleteKeyCancel"]</MudButton><MudButton Color="Color.Error" OnClick="() => CompleteConfirmation(true)">@_confirmation?.ConfirmLabel</MudButton></div></DialogActions>
</MudDialog>
