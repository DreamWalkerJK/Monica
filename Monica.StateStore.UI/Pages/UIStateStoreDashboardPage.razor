@using Monica.UI.Shared.Components.States
@attribute [Route(PAGE_URL)]
@using Microsoft.Extensions.Options
@using Monica.Modules
@using Monica.StateStore.UI.Models
@using Monica.StateStore.UI.Services
@using Monica.StateStore.UI.UIStateStore.Components
@using Monica.Core.Results
@inject StateStoreUIService StateStoreService
@inject IOptions<ModuleStateStoreUIOption> Options
@inject IStringLocalizer<StateStoreResource> L
@implements IDisposable

<PageTitle>@L["Dashboard:PageTitle"]</PageTitle>

<div class="state-store-dashboard-page">
    @if (_providerError is not null)
    {
        <div class="provider-discovery-error">
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Icon="@MoIcons.Error">
                @_providerError
                <MudButton Color="Color.Error" Variant="Variant.Text" OnClick="LoadProvidersAsync">
                    @L["Dashboard:Actions:Retry"]
                </MudButton>
            </MudAlert>
        </div>
    }

    @if (_providers.Count > 0)
    {
        <StateStoreKeyExplorer Providers="_providers"
                               Options="Options.Value"
                               OnRefreshProviders="LoadProvidersAsync">
            <HeaderContent>@PageIdentity</HeaderContent>
        </StateStoreKeyExplorer>
    }
    else
    {
        @PageIdentity
        @if (_providerError is null)
        {
            <section class="provider-empty-state" role="status"><MoContentState>
                <MoIcon Icon="@MoIcons.Database" Size="1.5rem" Style="color:var(--mud-palette-primary);" />
                <div>
                    <h2>@L["Dashboard:Messages:NoProviders"]</h2>
                    <p>@L["Dashboard:Messages:NoProvidersDescription"]</p>
                </div>
                <MudButton Color="Color.Primary" Variant="Variant.Outlined" OnClick="LoadProvidersAsync">
                    @L["KeyExplorer:Actions:RefreshProviders"]
                </MudButton>
            </MoContentState></section>
        }
    }
</div>

@code {
    public const string PAGE_URL = "/state-store-dashboard";

    private List<StateStoreProviderInfo> _providers = [];
    private string? _providerError;
    private bool _disposed;

    private RenderFragment PageIdentity => @<header class="state-page-identity">
        <h1>@L["Dashboard:Title"]</h1>
        @if (_providers.Count > 0 || _providerError is null)
        {
            <p>@(_providers.Count == 1 ? L["Dashboard:Summary:RegisteredProvider"] : L["Dashboard:Summary:RegisteredProviders", _providers.Count])</p>
        }
    </header>;

    protected override Task OnInitializedAsync() => LoadProvidersAsync();

    private Task LoadProvidersAsync()
    {
        if (_disposed)
        {
            return Task.CompletedTask;
        }

        // Discovery is synchronous. Keep the mounted explorer and its accepted query
        // alive while replacing only a successfully retrieved registration snapshot.
        if (StateStoreService.GetRegisteredProviders().IsFailed(out var error, out var data))
        {
            _providerError = L["Dashboard:Messages:LoadProviderFailed", error];
        }
        else
        {
            _providers = data;
            _providerError = null;
        }

        return Task.CompletedTask;
    }

    public void Dispose() => _disposed = true;
}
