<!DOCTYPE html>
<html lang="@Language">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@DocumentTitle</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%236841e8'/%3E%3Cpath d='M6 9 L11.2 9 L16 16.6 L20.8 9 L26 9 L26 23 L20.8 23 L16 15.4 L11.2 23 L6 23 Z' fill='%23fbf8f1'/%3E%3C/svg%3E"/>
    <base href="@BaseUri"/>
    <HeadOutlet @rendermode="InteractiveServer"/>
    <link rel="stylesheet" href="css/themes/guide/guide-theme.css"/>
    <link rel="stylesheet" href="css/guide-components.css"/>
    <link rel="stylesheet" href="Monica.Guide.styles.css"/>
    <script src="js/guide-shell.js"></script>
</head>
<body>
    <Routes @rendermode="InteractiveServer"/>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>

@code {
    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    [Inject]
    private SetupSession Session { get; set; } = default!;

    private string Language => Session.Language;

    private string BaseUri => Navigation.BaseUri;

    /// <summary>The browser tab title names the product this wizard session guides.</summary>
    private string DocumentTitle => $"{Session.CurrentProduct.DisplayName} Guide";
}
