@inherits LayoutComponentBase
@implements IDisposable

@* Keeps the browser tab title aligned with the current product even after an in-session
   bundle switch re-renders the layout; the static title in App.razor covers first paint. *@
<PageTitle>@DocumentTitle</PageTitle>

<div class="shell">
    <aside class="sidebar">
        <div class="brand">
            <div class="brand-row">
                <span class="monica-mark" aria-hidden="true">
                    <i class="mark-plane mark-plane-violet"></i>
                    <i class="mark-plane mark-plane-ink"></i>
                    <i class="mark-cut"></i>
                </span>
                <div class="brand-text">
                    <div class="brand-name">Monica Guide</div>
                    <div class="brand-product">@Session.CurrentProduct.DisplayName</div>
                </div>
            </div>
            <span class="release-stamp" title="@GuideAppInfo.CurrentVersion">@ProductVersion</span>
        </div>
        <nav class="nav">
            <NavLink class="nav-item" ActiveClass="active" href="" Match="NavLinkMatch.All">
                <span>@Session.T("dashboard")</span>
            </NavLink>
            <NavLink class="nav-item" ActiveClass="active" href="workspaces">
                <span>@Session.T("workspaces")</span>
            </NavLink>
            @if (Session.CurrentProduct.OwnsGlobalAgentPolicy)
            {
                <NavLink class="nav-item" ActiveClass="active" href="sources">
                    <span>@Session.T("sources")</span>
                </NavLink>
            }
            <NavLink class="nav-item" ActiveClass="active" href="install">
                <span>@Session.T("install")</span>
            </NavLink>
            <NavLink class="nav-item" ActiveClass="active" href="update">
                <span>@Session.T("update")</span>
            </NavLink>
            <NavLink class="nav-item" ActiveClass="active" href="uninstall">
                <span>@Session.T("uninstall")</span>
            </NavLink>
        </nav>
        <div class="sidebar-footer">
            <div class="footer-tools">
                <button class="tool-btn" @onclick="Session.ToggleLanguage">
                    <Icon Name="globe" Size="14"/>
                    @LanguageSwitchLabel
                </button>
                <button class="tool-btn" @onclick="ToggleTheme">
                    <Icon Name="@ThemeIcon" Size="14"/>
                    @ThemeLabel
                </button>
            </div>
            <div class="sidebar-note">
                <Icon Name="shield" Size="14"/>
                <span>127.0.0.1 · /s/token</span>
            </div>
        </div>
    </aside>
    <main class="content">
        @* The startup diagnosis warms in the background; once it lands, any skill-projection
           or workspace staleness finding is promoted to a layout-level banner so drift stays
           visible on every page, not only on the Overview check list. *@
        @if (DriftTargets is { Count: > 0 } targets)
        {
            <div class="banner banner-warn layout-banner" role="status">
                <Icon Name="alert" Size="16"/>
                <div class="layout-banner-main">
                    <span class="layout-banner-text">
                        @Session.T("drift-banner")
                        <a href="">@Session.T("drift-banner-cta")</a>
                    </span>
                    <span class="drift-chips">
                        @foreach (var target in targets)
                        {
                            <span class="drift-chip" title="@target.Detail">@target.Label · @KindLabel(target.Kind)</span>
                        }
                    </span>
                </div>
            </div>
        }
        @Body
    </main>
</div>

@code {
    [Inject]
    private SetupSession Session { get; set; } = default!;

    [Inject]
    private IJSRuntime Js { get; set; } = default!;

    /// <summary>One drifted target: its display label, global/workspace kind, and check lines as a tooltip.</summary>
    private sealed record DriftTargetView(string Label, string Kind, string Detail);

    /// <summary>
    /// The proactive drift prompt, grouped per target. Skill-projection and workspace checks
    /// that warn or fail name their target through the engine's structured details, so the
    /// banner answers "which targets — global or workspace" at a glance while each chip's
    /// tooltip carries the exact check messages (which name the drifted skills). Leftover
    /// foreign directories are excluded: their remediation is manual cleanup, not a skill
    /// update. Null while the startup diagnosis is still running or when clean.
    /// </summary>
    private IReadOnlyList<DriftTargetView>? DriftTargets
    {
        get
        {
            var drifted = Session.DashboardCache?.Checks.Items
                .Where(check => check.Status is GuideCheckStatus.Warning or GuideCheckStatus.Error
                    && (check.Id.StartsWith("skills.", StringComparison.Ordinal)
                        || check.Id.StartsWith("workspace.", StringComparison.Ordinal))
                    && !check.Id.EndsWith(".foreign", StringComparison.Ordinal)
                    && !check.Id.EndsWith(".stale-alias", StringComparison.Ordinal))
                .ToArray();
            if (drifted is not { Length: > 0 })
            {
                return null;
            }

            return drifted
                .GroupBy(check => (
                    Label: check.TargetLabel ?? check.Id,
                    Kind: check.TargetKind ?? (check.Id.StartsWith("workspace.", StringComparison.Ordinal) ? "workspace" : "global")))
                .OrderBy(static group => group.Key.Kind, StringComparer.Ordinal)
                .ThenBy(static group => group.Key.Label, StringComparer.Ordinal)
                .Select(static group => new DriftTargetView(
                    group.Key.Label,
                    group.Key.Kind,
                    string.Join("\n", group.Select(check => $"{check.Id}: {check.Message}").Order(StringComparer.Ordinal))))
                .ToArray();
        }
    }

    private string KindLabel(string kind)
        => kind == "workspace" ? Session.T("drift-kind-workspace") : Session.T("drift-kind-global");

    // The informational version carries the full commit hash; the sidebar shows the
    // short form and the tooltip keeps the complete identity.
    private string ProductVersion => ShortVersion(GuideAppInfo.CurrentVersion);

    private string DocumentTitle => $"{Session.CurrentProduct.DisplayName} Guide";

    private static string ShortVersion(string version)
    {
        var metadata = version.IndexOf('+');
        return metadata > 0 && version.Length > metadata + 9
            ? $"{version[..(metadata + 9)]}…"
            : version;
    }

    private string LanguageSwitchLabel => Session.Language == "zh-CN" ? "EN" : "中文";

    private string ThemeIcon { get; set; } = "moon";

    private string ThemeLabel { get; set; } = "Dark";

    protected override void OnInitialized()
    {
        Session.LanguageChanged += OnLanguageChanged;
        // The banner is a pure function of the dashboard cache, so it follows every
        // replacement: startup warmup landing, manual refresh, or a product switch.
        Session.DashboardChanged += OnDashboardChanged;
    }

    private void OnLanguageChanged() => InvokeAsync(() =>
    {
        ApplyThemeLabel();
        StateHasChanged();
    });

    private void OnDashboardChanged() => InvokeAsync(StateHasChanged);

    private void ApplyThemeLabel() => ThemeLabel = Session.Language == "zh-CN"
        ? (ThemeIcon == "sun" ? "浅色" : "深色")
        : (ThemeIcon == "sun" ? "Light" : "Dark");

    private async Task ToggleTheme()
    {
        try
        {
            var next = await Js.InvokeAsync<string>("mwSetupToggleTheme");
            ThemeIcon = next == "light" ? "sun" : "moon";
        }
        catch (JSDisconnectedException)
        {
            ThemeIcon = ThemeIcon == "sun" ? "moon" : "sun";
        }
        ApplyThemeLabel();
    }

    public void Dispose()
    {
        Session.LanguageChanged -= OnLanguageChanged;
        Session.DashboardChanged -= OnDashboardChanged;
    }
}
