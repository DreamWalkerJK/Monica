@page "/"
@implements IDisposable

<div class="overview-header">
    <div>
        <h1 class="page-title">@Session.T("dashboard")</h1>
        <p class="page-sub">@Session.T("dashboard-sub")</p>
    </div>
    <button class="btn btn-secondary" disabled="@Busy" @onclick="() => LoadAsync(true)">
        <Icon Name="update" Size="16"/> @Session.T("refresh")
    </button>
</div>

@if (LoadError is { } loadError)
{
    <div class="banner banner-error" role="alert">@loadError</div>
}

@if (Shell is null && Model is null)
{
    <div class="card">
        <h2>@Session.CurrentProduct.DisplayName · @Session.T("health-checks")</h2>
        <div class="loading"><span class="spinner"></span>@Session.T("diagnosing")</div>
    </div>
}
else
{
    var errors = Model?.Checks.Items.Count(static item => item.Status == GuideCheckStatus.Error) ?? 0;
    var warnings = Model?.Checks.Items.Count(static item => item.Status == GuideCheckStatus.Warning) ?? 0;

    <section class="overview-identity">
        <div class="overview-product">
            <span class="overview-eyebrow">@Session.T("title")</span>
            <h2>@Session.CurrentProduct.DisplayName</h2>
            <div class="overview-version mono">@(InstalledVersion ?? Session.T("not-installed"))</div>
            @if (Shell?.BundleRoot is { } root)
            {
                <div class="overview-location mono" title="@root">@root</div>
            }
            @if (InstalledVersion is not null && Session.CurrentProduct.ServesLoopback)
            {
                <span class="overview-runtime">@Session.T(Shell!.CockpitRunning ? "running" : "stopped") · @Session.T("port") @Shell.ConfiguredPort</span>
            }
        </div>
        <div class="actions">
            @if (InstalledVersion is null)
            {
                <a class="btn btn-primary btn-lg" href="install">
                    <Icon Name="rocket" Size="16"/>
                    @Session.T("go-install")
                </a>
            }
            else
            {
                <a class="btn btn-secondary" href="install">
                    <Icon Name="rocket" Size="16"/>
                    @Session.T("go-install")
                </a>
                @if (Session.CurrentProduct.ServesLoopback)
                {
                    @if (!Shell!.CockpitRunning)
                    {
                        <button class="btn btn-primary" disabled="@StartBusy" @onclick="StartCockpitAsync">
                            <Icon Name="power" Size="16"/>
                            @Session.T("start-cockpit")
                        </button>
                    }
                    else
                    {
                        <a class="btn btn-primary" href="@CockpitUrl" target="_blank">
                            <Icon Name="external" Size="16"/>
                            @Session.T("open-cockpit")
                        </a>
                        <button class="btn btn-secondary" disabled="@StopBusy" @onclick="StopCockpitAsync">
                            <Icon Name="power" Size="16"/>
                            @Session.T("stop-cockpit")
                        </button>
                    }
                }
                <a class="btn btn-secondary" href="uninstall">
                    <Icon Name="uninstall" Size="16"/>
                    @Session.T("go-uninstall")
                </a>
            }
        </div>
    </section>

    <section class="overview-summary" aria-label="@Session.T("diagnosis-title")">
        @if (Model is not null)
        {
            <div class="overview-status @HeroClass" role="status">
                <Icon Name="@HeroIcon" Size="22"/>
                <div>
                    <strong>@(Model.Error is not null ? Session.T("error") : errors + warnings > 0 ? $"{errors + warnings} {Session.T(errors + warnings == 1 ? "summary-attention-one" : "summary-attention")}" : Session.T("summary-ok"))</strong>
                    <p>@Model.SummaryMessage</p>
                </div>
            </div>
        }
        else
        {
            <div class="loading"><span class="spinner"></span>@Session.T("diagnosing")</div>
        }
    </section>

    <section class="card overview-environment">
        <h2>@Session.T("environment")</h2>
        <div class="stat-grid">
            <div class="stat">
                <div class="label"><Icon Name="folder" Size="14"/> @Session.T("workspace-summary")</div>
                <div class="value chips">
                    @if (!WorkspacesLoaded)
                    {
                        <span class="note">@Session.T("operating")</span>
                    }
                    else if (WorkspaceSummary is null)
                    {
                        <a class="chip" href="workspaces">@Session.T("workspaces-none")</a>
                    }
                    else
                    {
                        <a class="chip @(WorkspaceSummary.Healthy ? "ok" : "warn")" href="workspaces">@WorkspaceSummaryText</a>
                    }
                </div>
            </div>
            <div class="stat">
                <div class="label">
                    <Icon Name="host" Size="14"/> @Session.T("detected-agents")
                    <button class="btn btn-ghost btn-tiny label-action" disabled="@(PresenceBusy || Model is null)"
                            title="@Session.T("redetect-hosts-note")" @onclick="RedetectPresenceAsync">
                        @if (PresenceBusy)
                        {
                            <span class="spinner"></span>
                        }
                        else
                        {
                            <Icon Name="update" Size="12"/>
                        }
                        @Session.T("redetect-hosts")
                    </button>
                </div>
                <div class="value chips">
                    @if (PresenceBusy || Model is null)
                    {
                        <span class="chip">@Session.T("detecting-hosts")</span>
                    }
                    else if (Model.Presence.Count == 0)
                    {
                        <span class="note">@Session.T("hosts-empty")</span>
                    }
                    else
                    {
                        @foreach (var presence in Model.Presence)
                        {
                            <span class="chip">@PresenceChip(presence)</span>
                        }
                    }
                    @if (Model?.PresenceDetectedAt is { } detectedAt)
                    {
                        <span class="stat-time">@string.Format(Session.T("detected-at"), detectedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm"))</span>
                    }
                    @if (Model?.PresenceWarnings is { Count: > 0 })
                    {
                        @foreach (var warning in Model.PresenceWarnings)
                        {
                            <span class="chip warn">@Session.T("detection-incomplete"): @warning</span>
                        }
                    }
                    @if (PresenceError is not null)
                    {
                        <span class="chip warn">@Session.T("detection-failed"): @PresenceError</span>
                    }
                </div>
            </div>
        </div>
        @if (PresenceBusy && PresencePhases.Count > 0)
        {
            <PhaseProgress Phases="PresencePhases" Active="PresenceBusy"/>
        }
    </section>

    <section class="card overview-diagnosis">
        <div class="overview-diagnosis-head">
            <h2>@Session.T("health-checks")</h2>
            @if (Model is not null)
            {
                <div class="chips">
                    <span class="chip">@Model.Checks.Items.Count @Session.T(Model.Checks.Items.Count == 1 ? "diagnosis-checked-one" : "diagnosis-checked")</span>
                    @if (errors > 0) { <span class="badge error">@errors @Session.T(errors == 1 ? "diagnosis-errors-one" : "diagnosis-errors")</span> }
                    @if (warnings > 0) { <span class="badge warning">@warnings @Session.T(warnings == 1 ? "diagnosis-warnings-one" : "diagnosis-warnings")</span> }
                </div>
            }
        </div>
        @if (Model is null)
        {
            @if (Phases.Count > 0)
            {
                <PhaseProgress Phases="Phases" Active="Busy"/>
            }
            else
            {
                <div class="loading"><span class="spinner"></span>@Session.T("diagnosing")</div>
            }
        }
        else
        {
            @if (Busy && Phases.Count > 0)
            {
                <PhaseProgress Phases="Phases" Active="Busy"/>
            }
            <CheckList View="Model.Checks" EmptyText="@Session.T("checks-empty")"/>
        }
    </section>

    @if (Integration is { Installed: true })
    {
        <div class="card overview-integration">
            <h2>@Session.T("integration")</h2>
            <p class="note">@Session.T("integration-immediate")</p>
            <div class="switch-row">
                <span class="switch-text">
                    <span class="primary">@Session.T("desktop-shortcut")</span>
                    <span class="secondary">@Session.T("integration-note")</span>
                </span>
                <label class="switch">
                    <input type="checkbox" checked="@Integration.DesktopShortcut" aria-label="@Session.T("desktop-shortcut")"
                           disabled="@IntegrationBusy"
                           @onchange="e => ToggleIntegrationAsync(desktop: (bool)e.Value!, startMenu: Integration!.StartMenuShortcut, autoStart: Integration.AutoStart)"/>
                    <span class="track"></span>
                </label>
            </div>
            <div class="switch-row">
                <span class="switch-text">
                    <span class="primary">@Session.T("startmenu-shortcut")</span>
                </span>
                <label class="switch">
                    <input type="checkbox" checked="@Integration.StartMenuShortcut" aria-label="@Session.T("startmenu-shortcut")"
                           disabled="@IntegrationBusy"
                           @onchange="e => ToggleIntegrationAsync(desktop: Integration!.DesktopShortcut, startMenu: (bool)e.Value!, autoStart: Integration.AutoStart)"/>
                    <span class="track"></span>
                </label>
            </div>
            <div class="switch-row">
                <span class="switch-text">
                    <span class="primary">@Session.T("autostart")</span>
                </span>
                <label class="switch">
                    <input type="checkbox" checked="@Integration.AutoStart" aria-label="@Session.T("autostart")"
                           disabled="@IntegrationBusy"
                           @onchange="e => ToggleIntegrationAsync(desktop: Integration!.DesktopShortcut, startMenu: Integration.StartMenuShortcut, autoStart: (bool)e.Value!)"/>
                    <span class="track"></span>
                </label>
            </div>
            @if (Integration.Error is not null)
            {
                <p class="error-text">@Integration.Error</p>
            }
        </div>
    }

    @if (Model?.Error is { } error)
    {
        <div class="card danger-zone">
            <div class="banner banner-error">
                <Icon Name="error-circle" Size="18"/>
                <span>@error</span>
            </div>
        </div>
    }
}

@code {
    [Inject] private SetupFacade Facade { get; set; } = default!;
    [Inject] private SetupSession Session { get; set; } = default!;
    [Inject] private ILogger<Dashboard> Logger { get; set; } = default!;

    private SetupDashboardShellView? Shell { get; set; }
    private SetupDashboardView? Model { get; set; }
    private SetupDesktopIntegrationView? Integration { get; set; }
    private sealed record WorkspaceSummaryView(int Count, int HealthyCount)
    {
        public bool Healthy => Count == HealthyCount;
    }
    private WorkspaceSummaryView? WorkspaceSummary { get; set; }
    private string WorkspaceSummaryText => WorkspaceSummary is { } summary
        ? $"{summary.Count} · {summary.HealthyCount} {Session.T("workspace-summary-healthy")}"
        : string.Empty;
    private bool WorkspacesLoaded { get; set; }
    private List<GuidePhase> Phases { get; set; } = [];
    private List<GuidePhase> PresencePhases { get; set; } = [];
    private bool Busy { get; set; }
    private bool PresenceBusy { get; set; }
    private bool StartBusy { get; set; }
    private bool StopBusy { get; set; }
    private bool IntegrationBusy { get; set; }
    private bool Retired { get; set; }
    private string? PresenceError { get; set; }
    private string? LoadError { get; set; }
    private string? InstalledVersion => Shell?.InstalledVersion;
    private string CockpitUrl => $"http://localhost:{Shell?.ConfiguredPort ?? 0}{Session.CurrentProduct.DefaultRoutes.GetValueOrDefault("ui", "/")}";
    private string HeroClass => Model?.Checks.Status switch
    {
        GuideStatus.Warning => "warn",
        GuideStatus.Error => "error",
        _ => string.Empty
    };
    private string HeroIcon => Model?.Checks.Status switch
    {
        GuideStatus.Ready => "check-circle",
        GuideStatus.Warning => "alert",
        GuideStatus.Error => "error-circle",
        _ => "info"
    };

    protected override void OnInitialized()
    {
        Session.LanguageChanged += OnLanguageChanged;
        Facade.DashboardPhaseReported += OnDashboardPhase;
        Facade.PresencePhaseReported += OnPresencePhase;
        Facade.PresenceChanged += OnPresenceChanged;
        Phases = [.. Facade.RecentDashboardPhases];
        PresencePhases = [.. Facade.RecentPresencePhases];
        if (!RendererInfo.IsInteractive) return;
        if (Facade.PresenceDetectionInProgress is { } detection)
        {
            PresenceBusy = true;
            _ = ObservePresenceAsync(detection);
        }
        _ = LoadAsync();
    }

    // The facade owns diagnosis and detection. Retirement stops this page's adoption
    // and rendering; it does not cancel shared or durable work in the setup engine.
    private async Task LoadAsync(bool force = false)
    {
        if (Retired) return;
        Busy = true;
        LoadError = null;
        if (force) Phases = [];
        try
        {
            var shell = await Facade.LoadDashboardShellAsync();
            if (Retired) return;
            Shell = shell;
            await RepaintAsync();
            var integration = await Task.Run(() => Facade.LoadDesktopIntegration());
            if (Retired) return;
            Integration = integration;
            var workspaces = await Facade.ListWorkspacesAsync();
            if (Retired) return;
            WorkspaceSummary = workspaces.Count == 0 ? null : new WorkspaceSummaryView(
                workspaces.Count, workspaces.Count(static workspace => workspace.Healthy));
            WorkspacesLoaded = true;
            await RepaintAsync();
            var model = await Facade.LoadDashboardAsync(force);
            if (!Retired) Model = model;
        }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Guide Overview diagnosis observation failed.");
            if (!Retired) LoadError = exception.Message;
        }
        finally
        {
            if (!Retired) Busy = false;
        }
        await RepaintAsync();
    }

    private async Task RedetectPresenceAsync()
    {
        if (Retired || PresenceBusy) return;
        PresenceBusy = true;
        PresenceError = null;
        PresencePhases = [];
        await ObservePresenceAsync(Facade.DetectPresenceAsync());
    }

    private async Task ObservePresenceAsync(Task<GuideAgentPresenceSnapshot> detection)
    {
        try { await detection; }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Guide host detection observation failed.");
            if (!Retired) PresenceError = exception.Message;
        }
        finally
        {
            if (!Retired) PresenceBusy = false;
        }
        await RepaintAsync();
    }

    private void OnPresencePhase(GuidePhase phase)
        => _ = DispatchAsync(() => PresencePhases.Add(phase));

    private void OnPresenceChanged(GuideAgentPresenceSnapshot snapshot)
        => _ = DispatchAsync(() =>
        {
            PresenceBusy = false;
            if (Model is not null)
            {
                Model = Model with { Presence = snapshot.Presence,
                    PresenceDetectedAt = snapshot.DetectedAt, PresenceWarnings = snapshot.Warnings };
            }
        });

    private void OnDashboardPhase(GuidePhase phase) => _ = DispatchAsync(() => Phases.Add(phase));
    private void OnLanguageChanged() => _ = RepaintAsync();
    private Task RepaintAsync() => DispatchAsync(static () => { });

    private async Task DispatchAsync(Action adopt)
    {
        if (Retired) return;
        try
        {
            await InvokeAsync(() =>
            {
                if (Retired) return;
                adopt();
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException) when (Retired) { }
        catch (Exception exception)
        {
            Logger.LogError(exception, "Guide Overview render observation failed.");
        }
    }

    private static string PresenceChip(SetupAgentPresence presence)
        => presence.Version is { } version
            ? $"{presence.Agent} {version} @ {presence.EnvironmentSelector}"
            : $"{presence.Agent} @ {presence.EnvironmentSelector}";

    private async Task StartCockpitAsync()
    {
        if (Retired) return;
        StartBusy = true;
        try
        {
            await Task.Run(() => Facade.TryStartProduct(out _));
            if (!Retired) await LoadAsync(true);
        }
        finally { if (!Retired) StartBusy = false; }
    }

    private async Task StopCockpitAsync()
    {
        if (Retired) return;
        StopBusy = true;
        try
        {
            await Task.Run(() => Facade.TryStopProduct(out _));
            if (!Retired) await LoadAsync(true);
        }
        finally { if (!Retired) StopBusy = false; }
    }

    private async Task ToggleIntegrationAsync(bool desktop, bool startMenu, bool autoStart)
    {
        if (Retired || Integration is null) return;
        IntegrationBusy = true;
        try
        {
            var integration = await Task.Run(() => Facade.ApplyDesktopIntegration(desktop, startMenu, autoStart));
            if (!Retired) Integration = integration;
        }
        finally { if (!Retired) IntegrationBusy = false; }
    }

    public void Dispose()
    {
        Retired = true;
        Session.LanguageChanged -= OnLanguageChanged;
        Facade.DashboardPhaseReported -= OnDashboardPhase;
        Facade.PresencePhaseReported -= OnPresencePhase;
        Facade.PresenceChanged -= OnPresenceChanged;
    }
}
