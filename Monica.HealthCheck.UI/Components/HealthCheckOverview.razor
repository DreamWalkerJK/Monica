@inject IStringLocalizer<HealthCheckResource> L

@if (Session.Snapshot is { } snapshot)
{
    var readiness = Session.ReadinessStatus;
    var coverageMissing = Session.ReadinessEntryCount == 0;
    var attention = snapshot.Entries.Where(static entry => entry.Status != HealthCheckState.Healthy)
        .OrderByDescending(static entry => entry.Status).ThenBy(static entry => entry.Name, StringComparer.OrdinalIgnoreCase).ToArray();
    <section class="health-overview state-@(coverageMissing ? "unconfigured" : readiness.ToString().ToLowerInvariant())" aria-labelledby="health-readiness-title">
        <div class="health-readiness">
            <div class="readiness-label"><span class="readiness-dot"></span>@L["Overview:ReadinessLabel"]</div>
            <h2 id="health-readiness-title">@Headline(readiness, coverageMissing)</h2>
            <p class="readiness-description">@ReadinessText(readiness, coverageMissing)</p>
            <div class="readiness-meta"><MoIcon Icon="@MoIcons.ClipboardCheck" Size="1.25rem" /><span>@L["Overview:ReadinessChecks", Session.ReadinessEntryCount]</span><span class="meta-separator">·</span><span>@L["Overview:AutoRefresh"]</span></div>
            <dl class="health-distribution" aria-label="@L["Overview:Distribution"]">
                <div class="distribution-healthy @(snapshot.HealthyCount == 0 ? "is-zero" : null)"><dt>@L["Status:Healthy"]</dt><dd>@snapshot.HealthyCount</dd></div>
                <div class="distribution-degraded @(snapshot.DegradedCount == 0 ? "is-zero" : null)"><dt>@L["Status:Degraded"]</dt><dd>@snapshot.DegradedCount</dd></div>
                <div class="distribution-unhealthy @(snapshot.UnhealthyCount == 0 ? "is-zero" : null)"><dt>@L["Status:Unhealthy"]</dt><dd>@snapshot.UnhealthyCount</dd></div>
                <div class="distribution-duration"><dt>@L["Overview:SnapshotDuration"]</dt><dd title="@L["Overview:DurationMilliseconds", snapshot.Duration.TotalMilliseconds]">@L["Common:DurationMilliseconds", snapshot.Duration.TotalMilliseconds]</dd></div>
            </dl>
        </div>
        <aside class="health-attention" aria-labelledby="health-attention-title">
            <div class="attention-heading"><h3 id="health-attention-title">@L["Overview:AttentionTitle"]</h3><span>@attention.Length</span></div>
            @if (attention.Length == 0)
            {
                <div class="attention-clear"><MoIcon Icon="@MoIcons.Success" Size="1.5rem" Style="color:var(--mud-palette-success);" /><p>@L["Overview:AllClear"]</p></div>
            }
            else
            {
                <div class="attention-list">
                    @foreach (var entry in attention)
                    {
                        <button class="attention-entry" type="button" @onclick="@(() => Session.OpenDetailsAsync(entry))" aria-label="@L["Actions:DetailsFor", entry.Name]">
                            <span class="attention-entry-state"><MoIcon Icon="@(entry.Status == HealthCheckState.Degraded ? MoIcons.Warning : MoIcons.Error)" Size="1.25rem" Style="@HealthCheckDisplay.IconStyle(entry.Status)" />@L.GetStatusText(entry.Status)</span>
                            <strong>@entry.Name</strong>
                            <span class="attention-entry-description">@(string.IsNullOrWhiteSpace(entry.Description) ? L["Details:NoDescription"] : entry.Description)</span>
                            <span class="attention-entry-action">@L["Actions:Details"]<MoIcon Icon="@MoIcons.ArrowRight" Size="1.25rem" /></span>
                        </button>
                    }
                </div>
            }
        </aside>
    </section>
}

@code {
    [Parameter, EditorRequired] public HealthCheckPageSession Session { get; set; } = default!;

    private string Headline(HealthCheckState status, bool missing) => missing ? L["Overview:CoverageMissingTitle"] : status switch
    {
        HealthCheckState.Healthy => L["Overview:Headlines:Healthy"],
        HealthCheckState.Degraded => L["Overview:Headlines:Degraded"],
        _ => L["Overview:Headlines:Unhealthy"]
    };

    private string ReadinessText(HealthCheckState status, bool missing) => missing ? L["Overview:CoverageMissingDescription"] : status switch
    {
        HealthCheckState.Healthy => L["Overview:Ready"],
        HealthCheckState.Degraded => L["Overview:ReadyDegraded"],
        _ => L["Overview:NotReady"]
    };
}
