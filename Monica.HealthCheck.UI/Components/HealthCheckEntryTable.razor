@inject IStringLocalizer<HealthCheckResource> L

<section class="health-table-section" aria-labelledby="health-check-table-title">
    <div class="health-table-heading">
        <div><span class="health-registry-eyebrow">@L["Table:Eyebrow"]</span><h2 id="health-check-table-title">@L["Table:Title"]</h2></div>
        <span class="health-registry-description">@L["Table:Subtitle"]</span>
    </div>
    <HealthCheckFilters Session="@Session" />
    <div class="health-table-scroll">
        <MudTable T="HealthCheckEntrySnapshot" Items="@Session.FilteredEntries" Dense="false" Hover="true"
                  Breakpoint="Breakpoint.Xs" Elevation="0" Class="health-entry-table">
            <HeaderContent>
                <MudTh>@L["Table:Columns:Name"]</MudTh>
                <MudTh>@L["Table:Columns:Status"]</MudTh>
                <MudTh>@L["Table:Columns:Duration"]</MudTh>
                <MudTh><span class="health-column-action">@L["Table:Columns:Actions"]</span></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@L["Table:Columns:Name"]" Class="health-check-cell">
                    <button type="button" class="health-entry-name" @onclick="@(() => Session.OpenDetailsAsync(context))" aria-label="@L["Actions:DetailsFor", context.Name]">@context.Name</button>
                    <p class="health-entry-description" aria-label="@L["Table:Columns:Description"]">@(string.IsNullOrWhiteSpace(context.Description) ? L["Common:NotAvailable"] : context.Description)</p>
                    <div class="health-entry-tags" aria-label="@L["Table:Columns:Tags"]">
                        @foreach (var tag in context.Tags) { <span>@tag</span> }
                    </div>
                </MudTd>
                <MudTd DataLabel="@L["Table:Columns:Status"]">
                    <span class="health-entry-status state-@context.Status.ToString().ToLowerInvariant()"><span class="health-state-dot"></span>@L.GetStatusText(context.Status)</span>
                </MudTd>
                <MudTd DataLabel="@L["Table:Columns:Duration"]"><span class="health-entry-duration">@L["Common:DurationMilliseconds", context.Duration.TotalMilliseconds]</span></MudTd>
                <MudTd DataLabel="@L["Table:Columns:Actions"]">
                    <MudIconButton Icon="@MoIcons.ChevronRight" Size="Size.Small" Color="Color.Default"
                                   OnClick="@(() => Session.OpenDetailsAsync(context))" aria-label="@L["Actions:DetailsFor", context.Name]" />
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <div class="health-table-empty">
                    <MoIcon Icon="@MoIcons.SearchOff" Size="2.25rem" />
                    <p>@L["Table:Empty"]</p>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="@ResetFiltersAsync">@L["Actions:ClearFilters"]</MudButton>
                </div>
            </NoRecordsContent>
        </MudTable>
    </div>
    <div class="health-registry-footer"><MoIcon Icon="@MoIcons.Clock" Size="1.25rem" /><span>@L["Overview:AutoRefresh"]</span><span class="health-footer-count">@L["Filters:Results", Session.FilteredEntries.Count, Session.Snapshot?.Entries.Count ?? 0]</span></div>
</section>

@code {
    [Parameter, EditorRequired] public HealthCheckPageSession Session { get; set; } = default!;
    private async Task ResetFiltersAsync()
    {
        await Session.SetNameFilterAsync(null);
        await Session.SetStatusFilterAsync(null);
        await Session.SetTagFilterAsync(null);
    }
}
