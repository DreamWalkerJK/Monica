@using Monica.EventBus.Kafka.UIEventBusKafka.State
@inject IStringLocalizer<EventBusKafkaResource> L

@{ var topics = FilteredTopics; }
<div class="topic-workspace">
    <KafkaWorkspaceHeader Icon="@MoIcons.Folder" Title="@L["Topics:Title"]"
                          Subtitle="@(State.HasLoadedTopics ? L["Topics:Summary", topics.Count, State.Topics.Count] : L["Common:Values:Unavailable"])">
        <Actions>
            <KafkaPrimaryButton StartIcon="@MoIcons.Add" Disabled="@(IsBusy || !State.CanAdminSelectedCluster)" OnClick="OnCreate">@L["Topics:Actions:Create"]</KafkaPrimaryButton>
        </Actions>
    </KafkaWorkspaceHeader>
    <div class="topic-tools">
        <div class="topic-search"><MudTextField T="string" @bind-Value="_searchText" Immediate="true" DebounceInterval="200" Label="@L["Topics:Search:Label"]" Placeholder="@L["Topics:Search:Placeholder"]"
                           Adornment="Adornment.Start" AdornmentIcon="@MoIcons.Search" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" ClearIcon="@MoIcons.Close" /></div>
        @if (State.HasLoadedTopics)
        {
        <div class="topic-filters" aria-label="@L["Topics:Search:Label"]">
            <KafkaStatusFilter Text="@L["Common:Filters:All"]" Count="@State.Topics.Count" Color="Color.Primary" Selected="@(_filters.Count == 0)" OnClick="ClearFilters" />
            <KafkaStatusFilter Text="@L["Topics:Filters:Application"]" Count="@State.Topics.Count(t => !t.IsInternal)" Color="Color.Info" Selected="@_filters.Contains("application")" OnClick="@(() => ToggleFilter("application"))" />
            <KafkaStatusFilter Text="@L["Topics:Filters:Internal"]" Count="@State.Topics.Count(t => t.IsInternal)" Color="Color.Default" Selected="@_filters.Contains("internal")" OnClick="@(() => ToggleFilter("internal"))" />
            <KafkaStatusFilter Text="@L["Topics:Filters:MetadataUnavailable"]" Count="@State.Topics.Count(t => !t.IsMetadataAvailable)" Color="Color.Warning" Selected="@_filters.Contains("unavailable")" OnClick="@(() => ToggleFilter("unavailable"))" />
        </div>
        }
    </div>
    @if (!string.IsNullOrWhiteSpace(State.TopicsError))
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Icon="@MoIcons.Error">@State.TopicsError</MudAlert>
    }
    @if (!State.CanAdminSelectedCluster)
    {
        <KafkaWorkspaceState Icon="@MoIcons.Lock" Title="@L["Topics:Title"]" Description="@L["Topics:Unavailable"]" AccentColor="Color.Warning" />
    }
    else if (!State.HasLoadedTopics)
    {
        <KafkaWorkspaceState Icon="@MoIcons.Folder" Title="@L["Topics:Title"]" Description="@(State.IsBusy || State.IsLoading ? L["Topics:Loading"] : L["Common:Values:Unavailable"])" />
    }
    else if (State.Topics.Count == 0)
    {
        <KafkaWorkspaceState Icon="@MoIcons.Folder" Title="@L["Topics:Title"]" Description="@L["Topics:Empty"]" ActionLabel="@L["Topics:Actions:Create"]" ActionIcon="@MoIcons.Add" ActionDisabled="@IsBusy" OnAction="OnCreate" />
    }
    else if (topics.Count == 0)
    {
        <KafkaWorkspaceState Icon="@MoIcons.SearchOff" Title="@L["Topics:Search:NoMatches"]" Description="@L["Topics:Search:Placeholder"]" ActionLabel="@L["Common:Actions:ResetFilters"]" OnAction="ResetFilters" />
    }
    else
    {
        <KafkaTableSurface AriaLabel="@L["Topics:Title"]" AccentColor="Color.Info">
            <MudTable T="KafkaTopicSummary" Items="@topics" @bind-RowsPerPage="_rowsPerPage" Dense="true" Hover="true" Square="true" Elevation="0" Breakpoint="Breakpoint.Xs">
                <HeaderContent><MudTh>@L["Topics:Columns:Name"]</MudTh><MudTh>@L["Topics:Columns:Partitions"] / @L["Topics:Columns:Replication"]</MudTh><MudTh>@L["Topics:Columns:RetainedMessages"]</MudTh><MudTh>@L["Topics:Columns:Retention"]</MudTh><MudTh>@L["Topics:Columns:Actions"]</MudTh></HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@L["Topics:Columns:Name"]">
                        <div class="topic-identity">
                            <span class="topic-name">@context.TopicName</span>
                            @if (context.IsInternal) { <span class="topic-description">@L["Topics:Values:Internal"]</span> }
                            @if (!context.IsMetadataAvailable) {
                                <span class="topic-metadata-warning"><MoIcon Icon="@MoIcons.Warning" Size="1.25rem" />@L["Topics:Values:MetadataUnavailable", context.MetadataError ?? string.Empty]</span>
                            }
                        </div>
                    </MudTd>
                    <MudTd DataLabel="@($"{L["Topics:Columns:Partitions"]} / {L["Topics:Columns:Replication"]}")">
                        <div class="topic-topology">
                            <span>@L["Topics:Columns:Partitions"]: @(context.IsMetadataAvailable ? context.Partitions.ToString() : L["Common:Values:Unavailable"].Value)</span>
                            <span>@L["Topics:Columns:Replication"]: @(context.IsMetadataAvailable ? context.ReplicationFactor.ToString() : L["Common:Values:Unavailable"].Value)</span>
                        </div>
                    </MudTd>
                    <MudTd DataLabel="@L["Topics:Columns:RetainedMessages"]">@KafkaMetricDisplayFormatter.FormatOptionalInt64(context.RetainedMessageCount, L["Topics:Values:RetainedMessagesUnknown"])</MudTd>
                    <MudTd DataLabel="@L["Topics:Columns:Retention"]">@FormatRetention(context.RetentionMs)</MudTd>
                    <MudTd DataLabel="@L["Topics:Columns:Actions"]">
                        <MudMenu Icon="@MoIcons.MoreVertical" Size="Size.Small" Dense="true" Disabled="@IsBusy" AriaLabel="@L["Topics:Actions:OpenMenu", context.TopicName]">
                            <MudMenuItem Icon="@MoIcons.Eye" OnClick="@(() => OnViewMessages.InvokeAsync(context))">@L["Topics:Actions:Messages"]</MudMenuItem>
                            <MudMenuItem Icon="@MoIcons.Database" OnClick="@(() => OnViewBacklog.InvokeAsync(context))">@L["Topics:Actions:Backlog"]</MudMenuItem>
                            <MudMenuItem Icon="@MoIcons.Users" OnClick="@(() => OnViewConsumerGroups.InvokeAsync(context))">@L["Topics:Actions:ConsumerGroups"]</MudMenuItem>
                            <MudMenuItem Icon="@MoIcons.Split" Disabled="@(!context.IsMetadataAvailable)" OnClick="@(() => OnIncreasePartitions.InvokeAsync(context))">@L["Topics:Actions:Partitions"]</MudMenuItem>
                            <MudMenuItem Icon="@MoIcons.Clock" Disabled="@(!context.IsMetadataAvailable)" OnClick="@(() => OnUpdateRetention.InvokeAsync(context))">@L["Topics:Actions:Retention"]</MudMenuItem>
                            <MudDivider />
                            <MudMenuItem Icon="@MoIcons.ClearList" IconColor="Color.Error" Disabled="@(!context.IsMetadataAvailable || context.IsInternal)" OnClick="@(() => OnClearMessages.InvokeAsync(context))">@L["Topics:Actions:ClearMessages"]</MudMenuItem>
                            <MudMenuItem Icon="@MoIcons.Delete" IconColor="Color.Error" OnClick="@(() => OnDelete.InvokeAsync(context))">@L["Common:Actions:Delete"]</MudMenuItem>
                        </MudMenu>
                    </MudTd>
                </RowTemplate>
                <PagerContent><MudTablePager PageSizeOptions="@KafkaTablePageSizes.Standard" RowsPerPageString="@L["Common:Pagination:RowsPerPage"]" InfoFormat="@L["Common:Pagination:InfoFormat"]" FirstIcon="@MoIcons.FirstPage" BeforeIcon="@MoIcons.ChevronLeft" NextIcon="@MoIcons.ChevronRight" LastIcon="@MoIcons.LastPage" /></PagerContent>
            </MudTable>
        </KafkaTableSurface>
    }
</div>
@code {
    private string _searchText = string.Empty;
    private int _rowsPerPage = 25;
    private readonly HashSet<string> _filters = [];
    [Parameter, EditorRequired] public EventBusKafkaPageState State { get; set; } = default!;
    /// <summary>Gets or sets the optional owner-supplied disable state; null uses the page state's busy state.</summary>
    [Parameter] public bool? InteractionBusy { get; set; }
    [Parameter] public EventCallback OnCreate { get; set; }
    [Parameter] public EventCallback OnRefresh { get; set; }
    [Parameter] public EventCallback<KafkaTopicSummary> OnDelete { get; set; }
    [Parameter] public EventCallback<KafkaTopicSummary> OnViewMessages { get; set; }
    [Parameter] public EventCallback<KafkaTopicSummary> OnViewBacklog { get; set; }
    [Parameter] public EventCallback<KafkaTopicSummary> OnViewConsumerGroups { get; set; }
    [Parameter] public EventCallback<KafkaTopicSummary> OnIncreasePartitions { get; set; }
    [Parameter] public EventCallback<KafkaTopicSummary> OnUpdateRetention { get; set; }
    [Parameter] public EventCallback<KafkaTopicSummary> OnClearMessages { get; set; }
    private bool IsBusy => InteractionBusy ?? State.IsBusy;
    private List<KafkaTopicSummary> FilteredTopics => State.Topics.Where(topic =>
        (string.IsNullOrWhiteSpace(_searchText) || topic.TopicName.Contains(_searchText.Trim(), StringComparison.OrdinalIgnoreCase)) &&
        (_filters.Count == 0 || (_filters.Contains("application") && !topic.IsInternal) ||
         (_filters.Contains("internal") && topic.IsInternal) || (_filters.Contains("unavailable") && !topic.IsMetadataAvailable))).ToList();
    private string FormatRetention(long? value) => value is null ? L["Topics:Values:RetentionUnknown"] : L["Topics:Values:RetentionMs", value.Value];
    private void ClearFilters() => _filters.Clear();
    private void ToggleFilter(string filter) { if (!_filters.Add(filter)) _filters.Remove(filter); }
    private void ResetFilters() { _searchText = string.Empty; _filters.Clear(); }
}
