@implements IAsyncDisposable
@inject Microsoft.JSInterop.IJSRuntime JSRuntime
@inject ISnackbar Snackbar
@inject IStringLocalizer<ConfigurationUIResource> L

<MudDialog Class="configuration-post-commit-issues-dialog">
    <DialogContent>
        <div class="configuration-post-commit-issues-dialog-body">
            <MudAlert Icon="@MoIcons.Warning" Severity="Severity.Warning" Variant="Variant.Outlined">
                @Summary
            </MudAlert>

            <MudExpansionPanels MultiExpansion="true" Elevation="0" Dense="true">
                @foreach (var issue in Issues)
                {
                    <MudExpansionPanel Text="@GetIssueTitle(issue)" Icon="@MoIcons.Warning">
                        <MudStack Spacing="2">
                            <MudText Typo="Typo.body2">@issue.Message</MudText>
                            <div class="configuration-post-commit-issue-detail">
                                <pre>@issue.Detail</pre>
                            </div>
                            <MudStack Row="true" Justify="Justify.FlexEnd">
                                <MudButton Variant="Variant.Text"
                                           Size="Size.Small"
                                           StartIcon="@MoIcons.Copy"
                                           OnClick="@(() => CopyAsync(issue.Detail))">
                                    @L["Common:Actions:Copy"]
                                </MudButton>
                            </MudStack>
                        </MudStack>
                    </MudExpansionPanel>
                }
            </MudExpansionPanels>
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text"
                   StartIcon="@MoIcons.Copy"
                   OnClick="CopyAllAsync">
            @L["Dialogs:PostCommitIssues:CopyAll"]
        </MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Close">
            @L["Common:Actions:Close"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private readonly ConfigurationOperationLifetime _operations = new();

    internal static DialogOptions DefaultOptions => new()
    {
        MaxWidth = MaxWidth.Large,
        FullWidth = true
    };

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public IReadOnlyList<ConfigurationPostCommitIssue> Issues { get; set; } = [];
    [Parameter] public string? SummaryText { get; set; }

    private string Summary => SummaryText ??
        (Issues.Any(static issue => issue.Kind == ConfigurationPostCommitIssueKind.DistributedNotification)
            ? L["Dialogs:PostCommitIssues:DistributedSummary"].Value
            : L["Dialogs:PostCommitIssues:GeneralSummary"].Value);

    private string GetIssueTitle(ConfigurationPostCommitIssue issue)
    {
        return $"{L[$"Dialogs:PostCommitIssues:Kinds:{issue.Kind}"]}: {issue.Source}";
    }

    private Task CopyAllAsync()
    {
        var details = string.Join(
            $"{Environment.NewLine}{Environment.NewLine}",
            Issues.Select(issue => $"[{GetIssueTitle(issue)}]{Environment.NewLine}{issue.Detail}"));
        return CopyAsync(details);
    }

    private async Task CopyAsync(string text)
    {
        if (_operations.IsRetired) return;
        try
        {
            await _operations.RunAsync(async token =>
            {
                token.ThrowIfCancellationRequested();
                // Retain the actual tokenless interop completion; retirement cannot undo a clipboard write.
                var copied = await JSRuntime.InvokeAsync<bool>("MoClipboard.copyText", new object?[] { text });
                if (_operations.IsRetired) return;
                Snackbar.Add(
                    copied ? L["Dialogs:PostCommitIssues:CopySuccess"] : L["Dialogs:PostCommitIssues:CopyFailed"],
                    copied ? Severity.Success : Severity.Error);
            });
        }
        catch (OperationCanceledException) when (_operations.IsRetired) { }
        catch (Exception) when (!_operations.IsRetired)
        {
            Snackbar.Add(L["Dialogs:PostCommitIssues:CopyFailed"], Severity.Error);
        }
    }

    private void Close()
    {
        if (!_operations.IsRetired) MudDialog.Close();
    }

    /// <summary>Rejects new clipboard work and joins every admitted native clipboard call.</summary>
    /// <remarks>
    /// Repeated disposal shares the actual completion. Injected services are borrowed, a completed clipboard
    /// write is not reversed, and no late snackbar is adopted after retirement.
    /// </remarks>
    public ValueTask DisposeAsync() => _operations.RetireAsync();
}
