@using System.Reflection
@using System.Text.Json
@using System.Text.Json.Serialization
@using Microsoft.Extensions.Hosting
@using Microsoft.JSInterop
@using Monica.Configuration.UI.Localization
@using Monica.UI.Shell.State
@using Monica.UI.Shared.Components.Dialogs
@implements IAsyncDisposable
@inject ConfigurationParameterPackageService PackageService
@inject IJSRuntime JSRuntime
@inject IHostEnvironment HostEnvironment
@inject UserContextState UserContext
@inject IStringLocalizer<ConfigurationUIResource> L

<MudDialog>
    <TitleContent><MoDialogHeading Text="@Title" /></TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["ImportExport:Export:Subtitle"]</MudText>

            <MudSwitch T="bool"
                       @bind-Value="_includeSensitive"
                       Color="Color.Warning"
                       Label="@L["ImportExport:Export:IncludeSensitive"]" />

            <MudGrid Spacing="2">
                <MudItem xs="12" md="4">
                    <MudTextField T="string"
                                  @bind-Value="_exportedBy"
                                  Label="@L["ImportExport:Export:ExportedBy"]"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField T="string"
                                  @bind-Value="_environmentName"
                                  Label="@L["ImportExport:Export:EnvironmentName"]"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField T="string"
                                  @bind-Value="_systemVersion"
                                  Label="@L["ImportExport:Export:SystemVersion"]"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
            </MudGrid>

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <MudAlert Icon="@MoIcons.Error" Severity="Severity.Error">@_error</MudAlert>
            }

            @if (_exporting)
            {
                <ConfigurationPackageProgressPanel Progress="@_progress" />
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@L["Common:Actions:Cancel"]</MudButton>
        <MudButton Color="Color.Primary"
                   Variant="Variant.Filled"
                   StartIcon="@MoIcons.Download"
                   Disabled="@_exporting"
                   OnClick="DownloadAsync">
            @(_exporting ? L["Common:States:Loading"] : L["Common:Actions:Download"])
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private const string PACKAGE_CONTENT_TYPE = "application/json;charset=utf-8";

    private static readonly JsonSerializerOptions PackageJsonOptions = new(ConfigurationJsonDisplayFormatter.ReadableJsonOptions)
    {
        PropertyNamingPolicy = JsonNamingPolicy.CamelCase,
        DefaultIgnoreCondition = JsonIgnoreCondition.WhenWritingNull
    };

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public string? DefinitionKey { get; set; }
    [Parameter] public string? DefinitionDisplayName { get; set; }

    private ConfigurationDownloadInteropSession? _downloadInteropSession;
    private readonly ConfigurationOperationLifetime _operations = new();
    private Task _pendingProgressRender = Task.CompletedTask;
    private bool _disposed;
    private bool _includeSensitive;
    private bool _exporting;
    private string? _error;
    private string? _exportedBy;
    private string? _environmentName;
    private string? _systemVersion;
    private ConfigurationPackageProgress _progress = new()
    {
        Operation = ConfigurationPackageProgressOperation.Export,
        Stage = ConfigurationPackageProgressStage.LoadingDefinitions
    };

    private string Title => string.IsNullOrWhiteSpace(DefinitionDisplayName)
        ? L["ImportExport:Export:AllTitle"]
        : L["ImportExport:Export:DefinitionTitle", DefinitionDisplayName];

    protected override void OnInitialized()
    {
        _downloadInteropSession = new ConfigurationDownloadInteropSession(JSRuntime);
        _exportedBy = UserContext.UserName;
        _environmentName = HostEnvironment.EnvironmentName;
        _systemVersion = Assembly.GetEntryAssembly()?.GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion
                         ?? Assembly.GetEntryAssembly()?.GetName().Version?.ToString();
    }

    private async Task DownloadAsync()
    {
        if (_disposed) return;
        try { await _operations.RunAsync(_ => DownloadCoreAsync()); }
        catch (OperationCanceledException) when (_operations.IsRetired) { }
    }

    private async Task DownloadCoreAsync()
    {
        if (_disposed || _exporting || _downloadInteropSession is null)
        {
            return;
        }

        _exporting = true;
        _error = null;
        ReportProgress(new ConfigurationPackageProgress
        {
            Operation = ConfigurationPackageProgressOperation.Export,
            Stage = ConfigurationPackageProgressStage.LoadingDefinitions
        });
        try
        {
            var progress = new ExportProgress(ReportProgress);
            var document = await PackageService.CreateExportAsync(new ConfigurationExportRequest
            {
                DefinitionKey = DefinitionKey,
                IncludeSensitive = _includeSensitive,
                ExportedBy = _exportedBy,
                EnvironmentName = _environmentName,
                SystemVersion = _systemVersion
            }, progress);
            if (_disposed)
            {
                return;
            }

            var json = JsonSerializer.Serialize(document, PackageJsonOptions);
            var downloaded = await _downloadInteropSession.DownloadTextAsync(
                BuildFileName(),
                PACKAGE_CONTENT_TYPE,
                json);
            if (!_disposed && downloaded)
            {
                MudDialog.Close(DialogResult.Ok(true));
            }
        }
        catch (Exception ex) when (!_disposed)
        {
            _error = ex.Message;
        }
        finally
        {
            if (!_disposed)
            {
                _exporting = false;
            }
        }
    }

    private void ReportProgress(ConfigurationPackageProgress progress)
    {
        if (_disposed)
        {
            return;
        }

        _progress = progress;
        _pendingProgressRender = RenderProgressAsync(_pendingProgressRender);
    }

    private async Task RenderProgressAsync(Task previous)
    {
        await previous;
        await InvokeAsync(() => { if (!_disposed) StateHasChanged(); });
    }

    private sealed class ExportProgress(Action<ConfigurationPackageProgress> report) : IProgress<ConfigurationPackageProgress>
    {
        public void Report(ConfigurationPackageProgress value) => report(value);
    }

    private string BuildFileName()
    {
        var scope = string.IsNullOrWhiteSpace(DefinitionKey) ? "all" : DefinitionKey;
        var safeScope = string.Concat(scope.Select(character => char.IsLetterOrDigit(character) ? character : '-'));
        return $"monica-configuration-{safeScope}-{DateTimeOffset.Now:yyyyMMdd-HHmmss}.json";
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }

    public ValueTask DisposeAsync()
    {
        _disposed = true;
        return _operations.RetireAsync(async () =>
        {
            await _pendingProgressRender;
            var downloadInteropSession = _downloadInteropSession;
            _downloadInteropSession = null;
            if (downloadInteropSession is not null) await downloadInteropSession.DisposeAsync();
        });
    }
}
