@inject IStringLocalizer<ConfigurationUIResource> L

<header class="configuration-page-header">
    <div class="configuration-page-heading-layout">
        <span class="configuration-page-eyebrow">@L["Workbench:Eyebrow"]</span>
        <div class="configuration-page-title-row">
            <h1>@Title</h1>
            @if (TitleAccessory is not null)
            {
                <div class="configuration-page-title-accessory">@TitleAccessory</div>
            }
        </div>
        <p class="configuration-page-subtitle">@Subtitle</p>
        @if (Actions is not null)
        {
            <div class="configuration-page-actions">
                @Actions
            </div>
        }
    </div>
</header>

@code {
    /// <summary>Gets or sets the localized heading for this Configuration route.</summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    /// <summary>Gets or sets the localized description beneath the route heading.</summary>
    [Parameter, EditorRequired]
    public string Subtitle { get; set; } = string.Empty;

    /// <summary>Gets or sets contextual status controls beside the title. The caller owns their state and overlays.</summary>
    [Parameter]
    public RenderFragment? TitleAccessory { get; set; }

    /// <summary>Gets or sets route actions rendered in the common reserved action track.</summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }
}
