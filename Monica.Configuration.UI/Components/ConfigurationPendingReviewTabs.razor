@using Monica.Configuration.UI.Localization
@inject IStringLocalizer<ConfigurationUIResource> L

<div class="configuration-pending-review-tabs">
    <MudTabs PrevIcon="@MoIcons.ChevronLeft" NextIcon="@MoIcons.ChevronRight" Elevation="0" Rounded="false" MinimumTabWidth="112px" TabPanelsClass="pt-4">
        <MudTabPanel Text="@L["PendingReview:Tabs:DefinitionDiff"]" Icon="@MoIcons.FileDiff">
            <ConfigurationPendingDefinitionDiffPreview Changes="@Review.Changes"
                                                       ValidationIssues="@Review.ValidationIssues"
                                                       ActionMode="ActionMode"
                                                       ActionsDisabled="ActionsDisabled"
                                                       JumpRequested="JumpIssueRequested"
                                                       JumpChangeRequested="JumpChangeRequested"
                                                       UndoRequested="UndoRequested" />
        </MudTabPanel>
        <MudTabPanel Text="@L["PendingReview:Tabs:ItemList"]" Icon="@MoIcons.List">
            <ConfigurationPendingReviewList Review="Review"
                                            ActionMode="ActionMode"
                                            ActionsDisabled="ActionsDisabled"
                                            JumpIssueRequested="JumpIssueRequested"
                                            JumpChangeRequested="JumpChangeRequested"
                                            UndoRequested="UndoRequested" />
        </MudTabPanel>
    </MudTabs>
</div>

@code {
    [Parameter, EditorRequired] public ConfigurationPendingReviewState Review { get; set; } = null!;
    [Parameter] public ConfigurationPendingReviewActionMode ActionMode { get; set; }
    [Parameter] public bool ActionsDisabled { get; set; }
    [Parameter] public EventCallback<ConfigurationValidationIssue> JumpIssueRequested { get; set; }
    [Parameter] public EventCallback<PendingChange> JumpChangeRequested { get; set; }
    [Parameter] public EventCallback<ConfigurationPendingReviewUndoRequest> UndoRequested { get; set; }
}
