@inject IStringLocalizer<ConfigurationUIResource> L

<section class="configuration-captured-version" aria-label="@L["Versions:Current:Title"]">
    <div class="configuration-captured-identity">
        <span class="configuration-captured-eyebrow"><MudIcon Icon="@Icons.Material.Outlined.Layers" Size="Size.Small" />@L["Versions:Current:Title"]</span>
        <strong class="configuration-captured-number">@ConfigurationUnifiedVersionDisplayFormatter.VersionLabel(Version)</strong>
        <p>@L["Versions:Workbench:LatestHelp"]</p>
    </div>
    <div class="configuration-captured-audit">
        <div><span>@L["Versions:Workbench:CapturedAt"]</span><time datetime="@Version.CreatedTime.ToString("O")">@ConfigurationUnifiedVersionDisplayFormatter.CreatedTimeText(Version)</time></div>
        <div><span>@L["History:Dialog:Operator"]</span><strong>@ConfigurationUnifiedVersionDisplayFormatter.OperatorText(Version, L["Common:States:Empty"])</strong>
            @if (!string.IsNullOrWhiteSpace(Version.ModifierId)) { <code>@Version.ModifierId</code> }
        </div>
        <div class="configuration-captured-group"><span>@L["Versions:Workbench:CaptureGroup"]</span><code>@ConfigurationUnifiedVersionDisplayFormatter.ValueOrEmpty(Version.MutationGroupId, L["Common:States:Empty"])</code></div>
        @if (!string.IsNullOrWhiteSpace(Version.Reason)) { <p class="configuration-captured-reason">@Version.Reason</p> }
    </div>
    <div class="configuration-captured-scope">
        <MudTooltip Text="@ConfigurationUnifiedVersionDisplayFormatter.DefinitionTooltip(Version, L["Versions:Definitions:Empty"])">
            <span class="configuration-captured-count">@Version.DefinitionCount</span>
            <span>@L["Versions:Workbench:CapturedDefinitions"]</span>
        </MudTooltip>
        @if (Version.TriggerDefinitionKeys.Count > 0)
        {
            <span class="configuration-captured-trigger">@L["Versions:Workbench:TriggeredBy"]</span>
            @foreach (var key in Version.TriggerDefinitionKeys) { <code>@key</code> }
        }
    </div>
</section>

@code {
    /// <summary>Gets or sets the newest returned saved snapshot, not the current effective configuration.</summary>
    [Parameter, EditorRequired] public ConfigurationUnifiedVersionSummary Version { get; set; } = default!;
}
