@using Monica.Framework.UI.Pages
@inject IStringLocalizer<ProjectUnitsResource> L

<div class="project-units-workspace">
    <div class="project-units-workspace__navigation">
        <div class="project-units-workspace__context">
            <MoIcon Icon="@MoIcons.Workflow" Size="1.25rem" />
            <span>@L["Workspace:Context"]</span>
            <span class="project-units-workspace__separator" aria-hidden="true">/</span>
            <span>@L["Pages:ProjectUnits:Title"]</span>
        </div>
        <nav class="project-units-workspace__nav" aria-label="@L["Workspace:NavigationLabel"]">
            @foreach (var entry in Entries)
            {
                <NavLink href="@entry.Route" Match="NavLinkMatch.All" ActiveClass="is-active"
                         class="project-units-workspace__link"
                         aria-current="@(string.Equals(ActiveRoute, entry.Route, StringComparison.OrdinalIgnoreCase) ? "page" : null)">
                    <MoIcon Icon="@entry.Icon" Size="1.25rem" />
                    <span>@L[entry.LabelKey]</span>
                </NavLink>
            }
        </nav>
    </div>
    <div class="project-units-workspace__content">
        @ChildContent
    </div>
</div>

@code {
    /// <summary>Gets or sets the exact route rendered by this workspace instance.</summary>
    [Parameter, EditorRequired]
    public string ActiveRoute { get; set; } = string.Empty;

    /// <summary>Gets or sets the active page content; other route content is not mounted.</summary>
    [Parameter, EditorRequired]
    public RenderFragment? ChildContent { get; set; }

    private static readonly WorkspaceEntry[] Entries =
    [
        new(UIProjectUnitsPage.PAGE_URL, "Page:Tabs:StatusOverview", MoIcons.Dashboard),
        new(UIProjectUnitsCatalogPage.PAGE_URL, "Page:Tabs:ProjectUnit", MoIcons.Workflow),
        new(UIProjectUnitsGraphPage.PAGE_URL, "Page:Tabs:ArchitectureVisualization", MoIcons.Network),
        new(UIProjectUnitsEventsPage.PAGE_URL, "Page:Tabs:DomainEventTester", MoIcons.Calendar),
        new(UIProjectUnitsRequestFiltersPage.PAGE_URL, "Page:Tabs:RequestFilterManager", MoIcons.Filter),
        new(UIProjectUnitsEnumsPage.PAGE_URL, "Page:Tabs:EnumInfo", MoIcons.Braces)
    ];

    private sealed record WorkspaceEntry(string Route, string LabelKey, string Icon);
}
