@using Monica.ProjectUnits.Models
@using MudBlazor.Extensions
@inject IStringLocalizer<ProjectUnitsResource> L
@implements IDisposable

<div class="pu-filter-panel project-unit-filter-panel">
    <div class="pu-filter-panel__query">
        <div class="pu-filter-panel__search">
            <MudTextField T="string" @ref="_searchField" @bind-Value="_queryText"
                          Label="@L["ProjectUnitFilterPanel:Fields:SearchLabel"]"
                          HelperText="@L["ProjectUnitFilterPanel:Fields:SearchHelper"]"
                          Variant="Variant.Outlined" Margin="Margin.Dense"
                          Adornment="Adornment.Start" AdornmentIcon="@MoIcons.Search"
                          Immediate="true" DebounceInterval="300"
                          OnDebounceIntervalElapsed="OnFilterTextChangedAsync" />
        </div>
        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="ClearSearchAsync"
                   StartIcon="@MoIcons.Close">
            @L["ProjectUnitFilterPanel:Actions:ClearSearch"]
        </MudButton>
    </div>
    <details class="pu-filter-panel__facets" open>
        <summary>@L["ProjectUnitFilterPanel:Sections:TypeFilter"] <span>@SelectedUnitTypes.Count / @_unitTypeOptions.Count</span></summary>
        <div class="pu-filter-panel__type-actions">
            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="SelectAllTypesAsync">@L["Shared:Actions:SelectAll"]</MudButton>
            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="ClearAllTypesAsync">@L["Shared:Actions:Clear"]</MudButton>
        </div>
        <div class="pu-filter-panel__chips" tabindex="0" aria-label="@L["ProjectUnitFilterPanel:Sections:TypeFilter"]">
            <MudChipSet CheckedIcon="@MoIcons.Check" CloseIcon="@MoIcons.Close" T="EProjectUnitType" SelectionMode="SelectionMode.MultiSelection"
                        SelectedValues="SelectedUnitTypes" SelectedValuesChanged="OnSelectedUnitTypesChangedAsync">
                @foreach (var option in _unitTypeOptions)
                {
                    <MudChip T="EProjectUnitType" Value="@option.UnitType" Size="Size.Small"
                             Variant="Variant.Outlined"
                             Icon="@ProjectUnitVisualizationConfig.GetUnitTypeIcon(option.UnitType)">
                        @L["ProjectUnitFilterPanel:Formats:TypeCount", L.GetProjectUnitTypeText(option.UnitType), option.Count]
                    </MudChip>
                }
            </MudChipSet>
        </div>
    </details>
    <div class="pu-filter-panel__toggles">
        <MudSwitch T="bool" Value="ShowOnlyWithDependencies" ValueChanged="OnShowOnlyWithDependenciesChangedAsync"
                   Label="@L["ProjectUnitFilterPanel:Switches:OnlyDependencies"]" Color="Color.Primary" Size="Size.Small" />
        <MudSwitch T="bool" Value="ShowOnlyWithAlerts" ValueChanged="OnShowOnlyWithAlertsChangedAsync"
                   Label="@L["ProjectUnitFilterPanel:Switches:OnlyAlerts"]" Color="Color.Primary" Size="Size.Small" />
    </div>
</div>

@code {
    [Parameter] public IReadOnlyCollection<ProjectUnitSummary> Units { get; set; } = [];
    [Parameter] public string FilterText { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> FilterTextChanged { get; set; }
    [Parameter] public IReadOnlyCollection<EProjectUnitType> SelectedUnitTypes { get; set; } = new HashSet<EProjectUnitType>();
    [Parameter] public EventCallback<IReadOnlyCollection<EProjectUnitType>> SelectedUnitTypesChanged { get; set; }
    [Parameter] public bool ShowOnlyWithDependencies { get; set; }
    [Parameter] public EventCallback<bool> ShowOnlyWithDependenciesChanged { get; set; }
    [Parameter] public bool ShowOnlyWithAlerts { get; set; }
    [Parameter] public EventCallback<bool> ShowOnlyWithAlertsChanged { get; set; }
    [Parameter] public EventCallback OnFiltersChanged { get; set; }

    private MudTextField<string>? _searchField;
    private IReadOnlyList<UnitTypeOption> _unitTypeOptions = [];
    private string _queryText = string.Empty;
    private string _ownerQuery = string.Empty;
    private bool _clearing;
    private bool _disposed;

    protected override void OnParametersSet()
    {
        if (!string.Equals(FilterText, _ownerQuery, StringComparison.Ordinal))
        {
            _queryText = FilterText;
            _ownerQuery = FilterText;
        }
        _unitTypeOptions = Units
            .Where(static unit => unit.UnitType != EProjectUnitType.None)
            .GroupBy(static unit => unit.UnitType)
            .Select(static group => new UnitTypeOption(group.Key, group.Count()))
            .OrderByDescending(static option => option.Count)
            .ThenBy(static option => option.UnitType)
            .ToList();
    }

    private async Task OnFilterTextChangedAsync(string? value)
    {
        var query = value ?? string.Empty;
        if (_disposed || _clearing || string.Equals(query, _ownerQuery, StringComparison.Ordinal)
            || !string.Equals(query, _searchField?.GetState(field => field.Text) ?? string.Empty, StringComparison.Ordinal))
        {
            return;
        }
        _queryText = query;
        FilterText = query;
        _ownerQuery = query;
        await FilterTextChanged.InvokeAsync(query);
        if (!_disposed && !_clearing)
        {
            await OnFiltersChanged.InvokeAsync();
        }
    }

    /// <summary>
    /// Clears the native debounced input and publishes an empty query to its owner.
    /// </summary>
    /// <remarks>
    /// This operation does not invoke <see cref="OnFiltersChanged"/>. A caller resetting
    /// other constraints should await it, reset those constraints, and apply filters once.
    /// The field owns its pending debounce; clearing its current text prevents an older
    /// pending callback from restoring the previous query.
    /// </remarks>
    public async Task ClearQueryAsync()
    {
        if (_disposed || _clearing)
        {
            return;
        }
        _clearing = true;
        try
        {
            if (_searchField is not null)
            {
                await _searchField.ClearAsync();
            }
            if (_disposed)
            {
                return;
            }
            _queryText = string.Empty;
            _ownerQuery = string.Empty;
            FilterText = string.Empty;
            await FilterTextChanged.InvokeAsync(string.Empty);
        }
        finally
        {
            _clearing = false;
        }
    }

    private async Task ClearSearchAsync()
    {
        await ClearQueryAsync();
        if (!_disposed)
        {
            await OnFiltersChanged.InvokeAsync();
        }
    }

    private async Task OnSelectedUnitTypesChangedAsync(IReadOnlyCollection<EProjectUnitType> values)
    {
        if (_disposed) return;
        SelectedUnitTypes = values;
        await SelectedUnitTypesChanged.InvokeAsync(values);
        if (!_disposed) await OnFiltersChanged.InvokeAsync();
    }

    private Task SelectAllTypesAsync() => OnSelectedUnitTypesChangedAsync(_unitTypeOptions.Select(static option => option.UnitType).ToHashSet());
    private Task ClearAllTypesAsync() => OnSelectedUnitTypesChangedAsync(new HashSet<EProjectUnitType>());

    private async Task OnShowOnlyWithDependenciesChangedAsync(bool value)
    {
        if (_disposed) return;
        ShowOnlyWithDependencies = value;
        await ShowOnlyWithDependenciesChanged.InvokeAsync(value);
        if (!_disposed) await OnFiltersChanged.InvokeAsync();
    }

    private async Task OnShowOnlyWithAlertsChangedAsync(bool value)
    {
        if (_disposed) return;
        ShowOnlyWithAlerts = value;
        await ShowOnlyWithAlertsChanged.InvokeAsync(value);
        if (!_disposed) await OnFiltersChanged.InvokeAsync();
    }

    public void Dispose()
    {
        _disposed = true;
        _searchField = null;
    }

    private sealed record UnitTypeOption(EProjectUnitType UnitType, int Count);
}
