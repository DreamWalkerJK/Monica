@using Microsoft.Extensions.DependencyInjection
@using Monica.DependencyInjection.Models
@inject IStringLocalizer<DependencyInjectionResource> L

<div class="di-issue-index">
    @if (Items.Count > 8 || !string.IsNullOrWhiteSpace(_searchText))
    {
        <div class="di-issue-search">
            <div class="di-issue-search-field">
                <MudTextField T="string"
                              @bind-Value="_searchText"
                              Label="@L["Page:Issues:SearchLabel"]"
                              Placeholder="@L["Page:Issues:SearchPlaceholder"]"
                              Immediate="true"
                              Clearable="true"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Outlined.Search" />
            </div>
            <span class="di-issue-search-count" aria-live="polite">
                @L["Page:Issues:Showing", VisibleItems.Count, Items.Count]
            </span>
        </div>
    }

    @if (IssueGroups.Count == 0)
    {
        <p class="di-issue-empty">
            @L[Items.Count == 0 ? "Page:Issues:Empty" : "Page:Issues:NoMatches"]
        </p>
    }
    else
    {
        <MudExpansionPanels Elevation="0" Dense="true" MultiExpansion="true" Class="di-issue-panels">
            @foreach (var group in IssueGroups)
            {
                <MudExpansionPanel Class="di-issue-panel">
                    <TitleContent>
                        <div class="di-issue-title">
                            <span class="@GetSeverityClass(group.Severity)">
                                @L[$"Page:Shared:IssueSeverities:{group.Severity}"]
                            </span>
                            <div class="di-issue-title-copy">
                                <h3>@GetIssueTitle(group.Kind)</h3>
                                <p>@L[$"Page:Shared:IssueKinds:{group.Kind}:Summary"]</p>
                            </div>
                            <span class="di-issue-group-count">@group.Items.Count</span>
                        </div>
                    </TitleContent>
                    <ChildContent>
                        <div class="di-issue-list-scroll" role="region" tabindex="0" aria-label="@GetIssueTitle(group.Kind)">
                            @foreach (var issue in group.Items)
                            {
                                <article class="di-issue-item">
                                    <header class="di-issue-item-header">
                                        <h4>@issue.SourceImplementationTypeDisplayName</h4>
                                        <span class="di-issue-lifetime">@L[$"Page:Shared:Lifetimes:{issue.Lifetime}"]</span>
                                    </header>
                                    <code class="di-issue-source">@issue.SourceImplementationType</code>
                                    <p class="di-issue-description">@GetIssueDescription(group.Kind, issue)</p>
                                    <dl class="di-issue-metadata">
                                        <div>
                                            <dt>@L["Page:Dialog:Fields:SourceImplementationAssembly"]</dt>
                                            <dd>@GetTextOrFallback(issue.SourceImplementationAssemblyName)</dd>
                                        </div>
                                        <div>
                                            <dt>@L["Page:Dialog:Fields:LifetimeSource"]</dt>
                                            <dd>@L[$"Page:Shared:LifetimeSources:{issue.LifetimeSource}"]</dd>
                                        </div>
                                    </dl>
                                    <div class="di-issue-exposures">
                                        <span class="di-issue-exposure-label">@L["Page:Dialog:Fields:ExposedServices"]</span>
                                        @if (issue.ExposedServices.Count == 0)
                                        {
                                            <p class="di-issue-no-exposures">@L["Page:Issues:NoExposures"]</p>
                                        }
                                        else
                                        {
                                            <ul>
                                                @foreach (var exposedService in issue.ExposedServices)
                                                {
                                                    <li>
                                                        <code>@exposedService.ServiceType</code>
                                                        @if (exposedService.IsKeyedService)
                                                        {
                                                            <span class="di-issue-exposure-key">
                                                                @L["Page:Dialog:Fields:ServiceKey"]: @GetTextOrFallback(exposedService.ServiceKey)
                                                            </span>
                                                        }
                                                    </li>
                                                }
                                            </ul>
                                        }
                                    </div>
                                </article>
                            }
                        </div>
                    </ChildContent>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
    }
</div>

@code {
    [Parameter]
    public IReadOnlyList<DependencyInjectionAutoRegistrationIssueInfo> Items { get; set; } = [];

    private string? _searchText;

    private IReadOnlyList<DependencyInjectionAutoRegistrationIssueInfo> VisibleItems =>
        string.IsNullOrWhiteSpace(_searchText)
            ? Items
            : Items.Where(MatchesSearch).ToArray();

    private IReadOnlyList<IssueGroup> IssueGroups => VisibleItems
        .GroupBy(item => item.Kind)
        .Select(group => new IssueGroup(
            group.Key,
            ResolveGroupSeverity(group),
            group.OrderBy(item => item.SourceImplementationTypeDisplayName, StringComparer.OrdinalIgnoreCase).ToArray()))
        .OrderByDescending(group => group.Severity == DependencyInjectionDiagnosticSeverity.Error)
        .ThenBy(group => group.Kind.ToString(), StringComparer.OrdinalIgnoreCase)
        .ToArray();

    private bool MatchesSearch(DependencyInjectionAutoRegistrationIssueInfo issue)
    {
        var search = _searchText?.Trim() ?? string.Empty;
        return Contains(issue.SourceImplementationType, search)
            || Contains(issue.SourceImplementationTypeDisplayName, search)
            || Contains(issue.SourceImplementationAssemblyName, search)
            || Contains(issue.Kind.ToString(), search)
            || Contains(issue.Severity.ToString(), search)
            || Contains(issue.Lifetime.ToString(), search)
            || Contains(issue.LifetimeSource.ToString(), search)
            || Contains(GetIssueTitle(issue.Kind), search)
            || Contains(L[$"Page:Shared:IssueSeverities:{issue.Severity}"], search)
            || Contains(L[$"Page:Shared:Lifetimes:{issue.Lifetime}"], search)
            || Contains(L[$"Page:Shared:LifetimeSources:{issue.LifetimeSource}"], search)
            || issue.ExposedServices.Any(service => Contains(service.ServiceType, search)
                || Contains(service.ServiceTypeDisplayName, search)
                || Contains(service.ServiceKey, search));
    }

    private static bool Contains(string? value, string search)
    {
        return value?.Contains(search, StringComparison.OrdinalIgnoreCase) == true;
    }

    private static DependencyInjectionDiagnosticSeverity ResolveGroupSeverity(
        IEnumerable<DependencyInjectionAutoRegistrationIssueInfo> issues)
    {
        return issues.Any(item => item.Severity == DependencyInjectionDiagnosticSeverity.Error)
            ? DependencyInjectionDiagnosticSeverity.Error
            : DependencyInjectionDiagnosticSeverity.Warning;
    }

    private static string GetSeverityClass(DependencyInjectionDiagnosticSeverity severity)
    {
        return severity == DependencyInjectionDiagnosticSeverity.Error
            ? "di-issue-severity di-issue-severity--error"
            : "di-issue-severity di-issue-severity--warning";
    }

    private string GetTextOrFallback(string? value)
    {
        return string.IsNullOrWhiteSpace(value) ? L["Page:States:NotAvailable"] : value;
    }

    private string GetIssueTitle(DependencyInjectionAutoRegistrationIssueKind kind)
    {
        return L[$"Page:Shared:IssueKinds:{kind}:Title"];
    }

    private string GetIssueDescription(DependencyInjectionAutoRegistrationIssueKind kind, DependencyInjectionAutoRegistrationIssueInfo issue)
    {
        return kind switch
        {
            DependencyInjectionAutoRegistrationIssueKind.MissingExposedServices => L[
                $"Page:Shared:IssueKinds:{kind}:Description",
                issue.SourceImplementationTypeDisplayName,
                L[$"Page:Shared:Lifetimes:{issue.Lifetime}"]],
            DependencyInjectionAutoRegistrationIssueKind.ConcreteTypeOnlyExposure => L[
                $"Page:Shared:IssueKinds:{kind}:Description",
                issue.SourceImplementationTypeDisplayName],
            _ => issue.SourceImplementationTypeDisplayName
        };
    }

    private sealed record IssueGroup(
        DependencyInjectionAutoRegistrationIssueKind Kind,
        DependencyInjectionDiagnosticSeverity Severity,
        IReadOnlyList<DependencyInjectionAutoRegistrationIssueInfo> Items);
}
