@using Monica.Core.Execution.Models
@using Monica.Framework.UI.UIExecutionPipeline.Support
@inject IStringLocalizer<ExecutionPipelineResource> L

<span class="@("execution-pipeline-status execution-pipeline-status--" + Size.ToString().ToLowerInvariant())" data-status="@Status">
    <MudIcon Icon="@ExecutionPipelinePresentation.GetStatusIcon(Status)" Size="Size.Small" />
    <span>@L[$"Page:Statuses:{Status}"]</span>
</span>

@code {
    [Parameter]
    public ExecutionPipelinePlanStatus Status { get; set; }

    [Parameter]
    public Size Size { get; set; } = Size.Medium;
}
