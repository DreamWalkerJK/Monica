@using Monica.Core.Execution.Models
@inject IStringLocalizer<ExecutionPipelineResource> L

@if (Plan is null)
{
    <div class="execution-pipeline-plan-detail__empty" data-testid="execution-pipeline-plan-unselected">
        <MoIcon Icon="@MoIcons.PointerMouse" Size="2.25rem" />
        <p>@L["Page:States:SelectPlan"]</p>
    </div>
}
else
{
    <article class="execution-pipeline-plan-detail" data-testid="execution-pipeline-plan-detail">
        <header class="execution-pipeline-plan-detail__header">
            <div class="execution-pipeline-plan-detail__identity">
                <span class="execution-pipeline-plan-detail__eyebrow">@L["Page:Plans:SelectedOperation"]</span>
                <MudTooltip Text="@L["Page:Help:Concepts:ExecutionPoint"]" Arrow="true" Placement="Placement.Top">
                    <code class="execution-pipeline-plan-detail__point">@Plan.Descriptor.Point.Value</code>
                </MudTooltip>
                <h2 title="@Plan.Descriptor.FullName">@Plan.Descriptor.Name</h2>
                <p>@Plan.Descriptor.ComponentType.FullName</p>
            </div>
            <div class="execution-pipeline-plan-detail__status">
                <MudTooltip Text="@L["Page:Help:Concepts:PlanStatus"]" Arrow="true" Placement="Placement.Top">
                    <ExecutionPipelineStatusBadge Status="@Plan.Status" />
                </MudTooltip>
                <small>@L["Page:Plans:MaterializationStatus"]</small>
            </div>
        </header>

        @if (Plan.Error is { } error)
        {
            <section class="execution-pipeline-plan-detail__error" role="alert" data-testid="execution-pipeline-plan-error">
                <div class="execution-pipeline-plan-detail__error-heading">
                    <MoIcon Icon="@MoIcons.Error" Size="1.25rem" />
                    <ExecutionPipelineHelpLabel Text="@L["Page:Plans:Fault"]"
                                                HelpText="@L["Page:Help:Plans:Fault"]" />
                </div>
                <div class="execution-pipeline-plan-detail__error-type">
                    <ExecutionPipelineHelpLabel Text="@L["Page:Plans:ExceptionType"]"
                                                HelpText="@L["Page:Help:Plans:ExceptionType"]" />
                    <code>@error.ExceptionType</code>
                </div>
                <p>@error.Message</p>
            </section>
        }

        @if (Plan.Status == ExecutionPipelinePlanStatus.Building)
        {
            <p class="execution-pipeline-plan-detail__building" role="status">@L["Page:States:PlanBuilding"]</p>
        }

        @if (Plan.Status == ExecutionPipelinePlanStatus.Ready || !Plan.Behaviors.IsDefaultOrEmpty)
        {
            <ExecutionPipelineBehaviorChain Plan="@Plan" />
        }

        <ExecutionPipelinePlanOverview Plan="@Plan" />
        <ExecutionPipelineTechnicalIdentity Plan="@Plan" />
    </article>
}

@code {
    [Parameter]
    public ExecutionPipelinePlanSnapshot? Plan { get; set; }
}
