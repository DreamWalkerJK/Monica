@using Monica.Core.Execution.Models
@inject IStringLocalizer<ExecutionPipelineResource> L

<section class="execution-pipeline-summary" aria-label="@L["Page:Summary:AriaLabel"]" data-testid="execution-pipeline-summary">
    <div class="execution-pipeline-summary__scope">
        <span class="execution-pipeline-summary__mark" aria-hidden="true">
            <MoIcon Icon="@MoIcons.Workflow" Size="1.5rem" />
        </span>
        <div>
            <strong>@L["Page:Summary:Scope"]</strong>
            <p>@L["Page:Summary:Description"]</p>
        </div>
    </div>
    <dl class="execution-pipeline-summary__facts">
        <div>
            <dt><ExecutionPipelineHelpLabel Text="@L["Page:Summary:Registrations"]" HelpText="@L["Page:Help:Summary:Registrations"]" /></dt>
            <dd data-testid="execution-pipeline-registration-count">@Snapshot.Registrations.Length</dd>
        </div>
        <div>
            <dt><ExecutionPipelineHelpLabel Text="@L["Page:Summary:Plans"]" HelpText="@L["Page:Help:Summary:Plans"]" /></dt>
            <dd data-testid="execution-pipeline-plan-count">@Snapshot.Plans.Length</dd>
        </div>
        <div>
            <dt><ExecutionPipelineHelpLabel Text="@L["Page:Summary:ExecutionPoints"]" HelpText="@L["Page:Help:Summary:ExecutionPoints"]" /></dt>
            <dd data-testid="execution-pipeline-point-count">@ExecutionPointCount</dd>
        </div>
        <div class="execution-pipeline-summary__faults" data-has-faults="@(FaultCount > 0 ? "true" : "false")">
            <dt><ExecutionPipelineHelpLabel Text="@L["Page:Summary:Faults"]" HelpText="@L["Page:Help:Summary:Faults"]" /></dt>
            <dd data-testid="execution-pipeline-fault-count">@FaultCount</dd>
        </div>
    </dl>
</section>

@code {
    [Parameter, EditorRequired]
    public ExecutionPipelineCatalogSnapshot Snapshot { get; set; } = null!;

    private int ExecutionPointCount => Snapshot.Plans
        .Select(static plan => plan.Descriptor.Point.Value)
        .Distinct(StringComparer.Ordinal)
        .Count();

    private int FaultCount => Snapshot.Plans.Count(static plan => plan.Status == ExecutionPipelinePlanStatus.Faulted);
}
