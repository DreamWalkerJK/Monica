@using Monica.Core.Execution.Models
@inject IStringLocalizer<ExecutionPipelineResource> L

<section class="execution-pipeline-registrations" data-testid="execution-pipeline-registrations">
    <header>
        <div>
            <span class="execution-pipeline-registrations__eyebrow">@L["Page:Registrations:Eyebrow"]</span>
            <h2>@L["Page:Registrations:Title"]</h2>
            <p>@L["Page:Registrations:Description"]</p>
        </div>
        <span class="execution-pipeline-registrations__count">@Registrations.Count</span>
    </header>

    @if (Registrations.Count == 0)
    {
        <div class="execution-pipeline-registrations__empty" data-testid="execution-pipeline-registration-empty">
            <MoIcon Icon="@MoIcons.Puzzle" Size="1.5rem" />
            <p>@L["Page:States:NoRegistrations"]</p>
        </div>
    }
    else
    {
        <table class="execution-pipeline-registrations__table" aria-label="@L["Page:Registrations:Title"]">
            <colgroup>
                <col class="execution-pipeline-registrations__behavior-column" />
                <col class="execution-pipeline-registrations__order-column" />
                <col class="execution-pipeline-registrations__policy-column" />
                <col class="execution-pipeline-registrations__applicability-column" />
            </colgroup>
            <thead>
                <tr>
                    <th scope="col">
                        <ExecutionPipelineHelpLabel Text="@L["Page:Registrations:Behavior"]"
                                                    HelpText="@L["Page:Help:Registrations:Behavior"]" />
                    </th>
                    <th scope="col">
                        <ExecutionPipelineHelpLabel Text="@L["Page:Registrations:Order"]"
                                                    HelpText="@L["Page:Help:Concepts:BehaviorOrder"]" />
                    </th>
                    <th scope="col">@L["Page:Registrations:PolicyColumn"]</th>
                    <th scope="col">@L["Page:Registrations:ApplicabilityColumn"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var registration in Registrations)
                {
                    <tr>
                        <td class="execution-pipeline-registrations__behavior" data-testid="execution-pipeline-registration-row">
                            <span class="execution-pipeline-registrations__mobile-label">@L["Page:Registrations:Behavior"]</span>
                            <strong>@registration.BehaviorType.Name</strong>
                            <code>@registration.BehaviorType.FullName</code>
                            <small>@registration.BehaviorType.AssemblyName</small>
                        </td>
                        <td class="execution-pipeline-registrations__order">
                            <span class="execution-pipeline-registrations__mobile-label">@L["Page:Registrations:Order"]</span>
                            <span>@registration.Order</span>
                        </td>
                        <td>
                            <dl class="execution-pipeline-registrations__facts">
                                <div>
                                    <dt><ExecutionPipelineHelpLabel Text="@L["Page:Registrations:Lifetime"]"
                                                                    HelpText="@L["Page:Help:Concepts:Lifetime"]" /></dt>
                                    <dd>@L[$"Page:Lifetimes:{registration.Lifetime}"]</dd>
                                </div>
                                <div>
                                    <dt><ExecutionPipelineHelpLabel Text="@L["Page:Registrations:Source"]"
                                                                    HelpText="@L["Page:Help:Concepts:Source"]" /></dt>
                                    <dd><ExecutionPipelineSourceBadge SourceModuleKey="@registration.SourceModuleKey" /></dd>
                                </div>
                            </dl>
                        </td>
                        <td>
                            <dl class="execution-pipeline-registrations__facts">
                                <div>
                                    <dt><ExecutionPipelineHelpLabel Text="@L["Page:Registrations:OpenGeneric"]"
                                                                    HelpText="@L["Page:Help:Registrations:OpenGeneric"]" /></dt>
                                    <dd>@(registration.IsOpenGeneric ? L["Page:Common:Yes"] : L["Page:Common:No"])</dd>
                                </div>
                                <div>
                                    <dt><ExecutionPipelineHelpLabel Text="@L["Page:Registrations:DescriptorFilter"]"
                                                                    HelpText="@L["Page:Help:Registrations:DescriptorFilter"]" /></dt>
                                    <dd>@(registration.HasDescriptorFilter ? L["Page:Common:Yes"] : L["Page:Common:No"])</dd>
                                </div>
                            </dl>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<ExecutionBehaviorRegistrationSnapshot> Registrations { get; set; } = [];
}
