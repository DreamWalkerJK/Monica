@attribute [Route(PAGE_URL)]

@using Monica.Framework.UI.UIProjectUnits.Components
@inject IStringLocalizer<ProjectUnitsResource> L

<PageTitle>@L["Pages:ProjectUnits:Overview:Title"]</PageTitle>

<ProjectUnitsWorkspace ActiveRoute="@PAGE_URL">
    <header class="project-units-overview-heading">
        <span class="project-units-overview-heading__eyebrow">@L["Page:Header:Eyebrow"]</span>
        <h1>@L["Page:Header:Title"]</h1>
        <p>@L["Page:Header:Description"]</p>
    </header>

    <ProjectUnitDashboard />
</ProjectUnitsWorkspace>

@code {
    public const string PAGE_URL = "/project-units";
}
