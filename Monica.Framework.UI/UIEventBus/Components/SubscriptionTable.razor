@using Monica.Framework.UI.UIEventBus.Models
@using Monica.Framework.UI.UIEventBus.Support
@using Monica.EventBus.Models
@inject IStringLocalizer<EventBusResource> L

<div class="subscription-table-wrapper">
    <MudTable T="SubscriptionViewModel" Items="Subscriptions" Hover="true" Breakpoint="Breakpoint.Xs"
              Loading="Loading" RowsPerPage="20" Square="true" Elevation="0" LoadingProgressColor="Color.Primary">
        <HeaderContent>
            <MudTh>@L["Registry:EventRoute"]</MudTh>
            <MudTh>@L["SubscriptionTable:Columns:Handler"]</MudTh>
            <MudTh>@L["Registry:ProviderScope"]</MudTh>
            <MudTh>@L["Registry:Registration"]</MudTh>
            <MudTh>@L["Registry:ReportedRuntime"]</MudTh>
            <MudTh>@L["SubscriptionTable:Columns:Actions"]</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="@L["Registry:EventRoute"]"><div class="subscription-cell">
                <MudButton Variant="Variant.Text" Class="subscription-inspect" OnClick="() => OnRowClick.InvokeAsync(context)"
                           aria-label="@L["Registry:Inspect", context.EventType]" title="@context.EventType">@context.EventTypeShortName</MudButton>
                <code class="subscription-topic" title="@context.TopicName">@context.TopicName</code>
                <span class="subscription-discovery">@L.GetDiscoveryModeText(context.IsAutoDiscovered)</span>
            </div></MudTd>
            <MudTd DataLabel="@L["SubscriptionTable:Columns:Handler"]"><div class="subscription-cell">
                <span class="subscription-handler" title="@(context.HandlerType ?? context.ActionMethodSignature)">@L.GetHandlerDisplayText(context)</span>
                <span class="subscription-id" title="@context.SubscriptionId">@context.SubscriptionId</span>
            </div></MudTd>
            <MudTd DataLabel="@L["Registry:ProviderScope"]"><div class="subscription-cell">
                <code class="subscription-key">@EventBusPresentation.KeyText(context.ServiceKey, L)</code>
                <span class="subscription-scope">@L.GetSubscriptionScopeText(context.Scope)</span>
            </div></MudTd>
            <MudTd DataLabel="@L["Registry:Registration"]"><div class="subscription-cell"><EventBusStatusBadge Tone="context.StateColor">@L.GetSubscriptionStateText(context.State)</EventBusStatusBadge></div></MudTd>
            <MudTd DataLabel="@L["Registry:ReportedRuntime"]"><div class="subscription-cell">
                @if (context.TopicStatus is { } status)
                {
                    <EventBusStatusBadge Tone="@EventBusPresentation.RuntimeColor(status.State)">@L.GetTopicRuntimeStateText(status.State)</EventBusStatusBadge>
                }
                else
                {
                    <span class="subscription-no-runtime">@L[context.Scope == EventSubscriptionScope.Local ? "Registry:LocalRuntime" : "Registry:NotReported"]</span>
                }
                @if (ActiveTestListenerIds.Contains(context.SubscriptionId))
                {
                    <span class="subscription-listening">@L["SubscriptionTable:Labels:TestListening"]</span>
                }
            </div></MudTd>
            <MudTd DataLabel="@L["SubscriptionTable:Columns:Actions"]"><div class="subscription-cell">
                <SubscriptionLifecycleControl Subscription="context" IsBusy="IsBusy" OnActivate="() => OnActivate.InvokeAsync(context)"
                    OnDeactivate="() => OnDeactivate.InvokeAsync(context)" OnUnsubscribe="() => OnUnsubscribe.InvokeAsync(context)"
                    OnTest="() => OnTest.InvokeAsync(context)" IsTestListening="ActiveTestListenerIds.Contains(context.SubscriptionId)" />
            </div></MudTd>
        </RowTemplate>
        <PagerContent><MudTablePager FirstIcon="@MoIcons.FirstPage" BeforeIcon="@MoIcons.ChevronLeft" NextIcon="@MoIcons.ChevronRight" LastIcon="@MoIcons.LastPage" PageSizeOptions="@(new[] { 10, 20, 50, 100 })" /></PagerContent>
        <NoRecordsContent><div class="subscription-empty">@L[HasRegistrations ? "Registry:NoMatches" : "Registry:EmptyHost"]</div></NoRecordsContent>
    </MudTable>
</div>

@code {
    [Parameter] public List<SubscriptionViewModel>? Subscriptions { get; set; }
    [Parameter] public bool Loading { get; set; }
    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public bool HasRegistrations { get; set; } = true;
    [Parameter] public EventCallback<SubscriptionViewModel> OnRowClick { get; set; }
    [Parameter] public EventCallback<SubscriptionViewModel> OnActivate { get; set; }
    [Parameter] public EventCallback<SubscriptionViewModel> OnDeactivate { get; set; }
    [Parameter] public EventCallback<SubscriptionViewModel> OnUnsubscribe { get; set; }
    [Parameter] public EventCallback<SubscriptionViewModel> OnTest { get; set; }
    [Parameter] public IReadOnlySet<string> ActiveTestListenerIds { get; set; } = new HashSet<string>();
}
