@inject IStringLocalizer<SeederResource> L

@if (Session.Snapshot is { Configuration: { } configuration })
{
    <section class="seeder-configuration" aria-labelledby="seeder-configuration-title">
        <div class="seeder-configuration-heading">
            <div>
                <span class="seeder-configuration-eyebrow">@L["Configuration:Eyebrow"]</span>
                <h2 id="seeder-configuration-title">@L["Configuration:Title"]</h2>
            </div>
            <span class="seeder-configuration-symbol" aria-hidden="true">
                <MoIcon Icon="@MoIcons.Sliders" Size="1.5rem" />
            </span>
        </div>

        <div class="seeder-policy-groups">
            <section class="seeder-policy-group" aria-labelledby="seeder-scheduling-policy-title">
                <h3 id="seeder-scheduling-policy-title">@L["Configuration:Groups:Scheduling"]</h3>
                <dl class="seeder-configuration-facts">
                    <div>
                        <dt>@L["Configuration:ExecutionMode"]</dt>
                        <dd>@L.GetText(configuration.DefaultExecutionMode)</dd>
                    </div>
                    <div>
                        <dt>@L["Configuration:MaxConcurrency"]</dt>
                        <dd class="seeder-policy-number">@configuration.MaxConcurrency</dd>
                    </div>
                </dl>
            </section>

            <section class="seeder-policy-group" aria-labelledby="seeder-readiness-policy-title">
                <h3 id="seeder-readiness-policy-title">@L["Configuration:Groups:Readiness"]</h3>
                <dl class="seeder-configuration-facts">
                    <div>
                        <dt>@L["Configuration:Criticality"]</dt>
                        <dd>@L.GetText(configuration.DefaultCriticality)</dd>
                    </div>
                </dl>
            </section>

            <section class="seeder-policy-group seeder-policy-retries" aria-labelledby="seeder-retry-policy-title">
                <h3 id="seeder-retry-policy-title">@L["Configuration:Groups:Retries"]</h3>
                <dl class="seeder-configuration-facts">
                    <div>
                        <dt>@L["Configuration:MaxAttempts"]</dt>
                        <dd class="seeder-policy-number">@configuration.DefaultMaxAttempts</dd>
                    </div>
                    <div>
                        <dt>@L["Configuration:RetryBaseDelay"]</dt>
                        <dd class="seeder-policy-number">@L.FormatSeederDuration(configuration.RetryBaseDelay)</dd>
                    </div>
                    <div>
                        <dt>@L["Configuration:RetryMaxDelay"]</dt>
                        <dd class="seeder-policy-number">@L.FormatSeederDuration(configuration.RetryMaxDelay)</dd>
                    </div>
                </dl>
            </section>

            <section class="seeder-policy-group" aria-labelledby="seeder-failure-policy-title">
                <h3 id="seeder-failure-policy-title">@L["Configuration:Groups:Failure"]</h3>
                <dl class="seeder-configuration-facts">
                    <div>
                        <dt>@L["Configuration:FailureBehavior"]</dt>
                        <dd>@L.GetText(configuration.DefaultFailureBehavior)</dd>
                    </div>
                </dl>
            </section>
        </div>

        <p class="seeder-configuration-context">@L["Configuration:Subtitle"]</p>
    </section>
}

@code {
    [Parameter, EditorRequired] public SeederPageSession Session { get; set; } = default!;
}
