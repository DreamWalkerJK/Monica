@inject IStringLocalizer<SeederResource> L

<div class="seeder-filters" role="group" aria-label="@L["Filters:AriaLabel"]">
    <div class="seeder-filter-fields">
        <div class="seeder-filter-field seeder-filter-field--search">
            <MudTextField ClearIcon="@MoIcons.Close" T="string"
                          Value="@Session.SearchText"
                          ValueChanged="@Session.SetSearchTextAsync"
                          Label="@L["Filters:SearchLabel"]"
                          Placeholder="@L["Filters:SearchPlaceholder"]"
                          Immediate="true"
                          Clearable="true"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@MoIcons.Search" />
        </div>
        <div class="seeder-filter-field">
            <MudSelect OpenIcon="@MoIcons.ChevronDown" CloseIcon="@MoIcons.ChevronUp" CheckedIcon="@MoIcons.SquareCheck" UncheckedIcon="@MoIcons.Square" IndeterminateIcon="@MoIcons.SquareMinus" ClearIcon="@MoIcons.Close" T="SeederStatus?"
                       Value="@Session.StatusFilter"
                       ValueChanged="@Session.SetStatusFilterAsync"
                       Label="@L["Filters:StatusLabel"]"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Clearable="true">
                <MudSelectItem T="SeederStatus?" Value="@(null)">@L["Filters:AnyStatus"]</MudSelectItem>
                @foreach (var status in Enum.GetValues<SeederStatus>())
                {
                    <MudSelectItem T="SeederStatus?" Value="@status">@L.GetText(status)</MudSelectItem>
                }
            </MudSelect>
        </div>
        <div class="seeder-filter-field">
            <MudSelect OpenIcon="@MoIcons.ChevronDown" CloseIcon="@MoIcons.ChevronUp" CheckedIcon="@MoIcons.SquareCheck" UncheckedIcon="@MoIcons.Square" IndeterminateIcon="@MoIcons.SquareMinus" ClearIcon="@MoIcons.Close" T="SeederCriticality?"
                       Value="@Session.CriticalityFilter"
                       ValueChanged="@Session.SetCriticalityFilterAsync"
                       Label="@L["Filters:CriticalityLabel"]"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Clearable="true">
                <MudSelectItem T="SeederCriticality?" Value="@(null)">@L["Filters:AnyCriticality"]</MudSelectItem>
                <MudSelectItem T="SeederCriticality?" Value="@SeederCriticality.Required">@L.GetText(SeederCriticality.Required)</MudSelectItem>
                <MudSelectItem T="SeederCriticality?" Value="@SeederCriticality.Optional">@L.GetText(SeederCriticality.Optional)</MudSelectItem>
            </MudSelect>
        </div>
        <div class="seeder-filter-field">
            <MudSelect OpenIcon="@MoIcons.ChevronDown" CloseIcon="@MoIcons.ChevronUp" CheckedIcon="@MoIcons.SquareCheck" UncheckedIcon="@MoIcons.Square" IndeterminateIcon="@MoIcons.SquareMinus" ClearIcon="@MoIcons.Close" T="SeederFailureBehavior?"
                       Value="@Session.FailureBehaviorFilter"
                       ValueChanged="@Session.SetFailureBehaviorFilterAsync"
                       Label="@L["Filters:FailureBehaviorLabel"]"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Clearable="true">
                <MudSelectItem T="SeederFailureBehavior?" Value="@(null)">@L["Filters:AnyFailureBehavior"]</MudSelectItem>
                <MudSelectItem T="SeederFailureBehavior?" Value="@SeederFailureBehavior.ContinueAndRecord">@L.GetText(SeederFailureBehavior.ContinueAndRecord)</MudSelectItem>
                <MudSelectItem T="SeederFailureBehavior?" Value="@SeederFailureBehavior.FailFast">@L.GetText(SeederFailureBehavior.FailFast)</MudSelectItem>
            </MudSelect>
        </div>
    </div>
    <div class="seeder-filter-context">
        <span class="seeder-filter-results" aria-live="polite">@L.FormatSeederFilterResults(Session.FilteredSeeders.Count, Session.Snapshot?.Run.TotalCount ?? 0)</span>
        @if (HasFilters)
        {
            <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="@Session.ClearFiltersAsync">@L["Actions:ClearFilters"]</MudButton>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public SeederPageSession Session { get; set; } = default!;

    private bool HasFilters => !string.IsNullOrWhiteSpace(Session.SearchText)
        || Session.StatusFilter.HasValue
        || Session.CriticalityFilter.HasValue
        || Session.FailureBehaviorFilter.HasValue;
}
