@inject IStringLocalizer<SeederResource> L

<section class="seeder-table-section" aria-labelledby="seeder-table-title">
    <header class="seeder-table-heading">
        <div>
            <span class="seeder-table-eyebrow">@L["Table:Eyebrow"]</span>
            <h2 id="seeder-table-title">@L["Table:Title"]</h2>
        </div>
        <p>@L["Table:Subtitle"]</p>
    </header>

    <SeederFilters Session="@Session" />

    <div class="seeder-table-scroll">
        <MudTable T="SeederExecutionRow"
                  Items="@Rows"
                  Dense="true"
                  Hover="true"
                  Breakpoint="Breakpoint.None"
                  Elevation="0"
                  AriaLabel="@L["Table:Title"]"
                  Class="seeder-execution-table">
            <HeaderContent>
                <MudTh>@L["Table:Columns:Name"]</MudTh>
                <MudTh>@L["Table:Columns:Policy"]</MudTh>
                <MudTh>@L["Table:Columns:Status"]</MudTh>
                <MudTh>@L["Table:Columns:Attempts"]</MudTh>
                <MudTh>@L["Table:Columns:Duration"]</MudTh>
                <MudTh>@L["Table:Columns:Actions"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@L["Table:Columns:Name"]" Class="seeder-identity-cell">
                    <div class="seeder-name">
                        <strong>@context.Seeder.SeederName</strong>
                        <code>@context.Seeder.SeederTypeName</code>
                        <span class="seeder-dependencies" title="@string.Join(", ", context.Seeder.Dependencies)">
                            <span>@L["Table:Columns:Dependencies"]</span>
                            @if (context.Seeder.Dependencies.Length == 0)
                            {
                                <span>@L["Common:None"]</span>
                            }
                            else
                            {
                                <span>@L.FormatSeederDependencyCount(context.Seeder.Dependencies.Length)</span>
                            }
                        </span>
                    </div>
                </MudTd>
                <MudTd DataLabel="@L["Table:Columns:Policy"]">
                    <dl class="seeder-row-policy">
                        <div><dt>@L["Table:Columns:Criticality"]</dt><dd>@L.GetText(context.Seeder.Criticality)</dd></div>
                        <div><dt>@L["Table:Columns:ExecutionMode"]</dt><dd>@L.GetText(context.Seeder.ExecutionMode)</dd></div>
                        <div><dt>@L["Table:Columns:FailureBehavior"]</dt><dd>@L.GetText(context.Seeder.FailureBehavior)</dd></div>
                    </dl>
                </MudTd>
                <MudTd DataLabel="@L["Table:Columns:Status"]">
                    <span class="seeder-row-status seeder-row-status--@context.Seeder.Status.ToString().ToLowerInvariant()">
                        <i aria-hidden="true"></i>@L.GetText(context.Seeder.Status)
                    </span>
                </MudTd>
                <MudTd DataLabel="@L["Table:Columns:Attempts"]">
                    <span class="seeder-row-reading">@L["Table:AttemptsValue", context.Seeder.Attempts, context.Seeder.MaxAttempts]</span>
                </MudTd>
                <MudTd DataLabel="@L["Table:Columns:Duration"]">
                    <span class="seeder-row-reading">@L.FormatSeederDuration(context.Seeder.Duration)</span>
                </MudTd>
                <MudTd DataLabel="@L["Table:Columns:Actions"]" Class="seeder-action-cell">
                    <MudTooltip Text="@L["Actions:Details"]">
                        <MudIconButton id="@SeederDisplay.DetailsTriggerId(context.Seeder.SeederTypeName)"
                                       Icon="@Icons.Material.Outlined.ChevronRight"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="@(() => Session.OpenDetailsAsync(context.Seeder))"
                                       aria-controls="seeder-detail-dialog"
                                       aria-expanded="@(IsDetailsOpen(context.Seeder) ? "true" : "false")"
                                       aria-haspopup="dialog"
                                       aria-label="@L["Actions:DetailsFor", context.Seeder.SeederName]" />
                    </MudTooltip>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <div class="seeder-table-empty" data-testid="seeder-table-empty">
                    @if (Session.Snapshot?.Run.TotalCount == 0)
                    {
                        <MudIcon Icon="@Icons.Material.Outlined.Inventory2" Size="Size.Large" />
                        <strong>@L["Table:NoSeeders"]</strong>
                        <p>@L["Table:NoSeedersDescription"]</p>
                    }
                    else
                    {
                        <MudIcon Icon="@Icons.Material.Outlined.FilterAltOff" Size="Size.Large" />
                        <strong>@L["Table:Empty"]</strong>
                        <p>@L["Table:EmptyDescription"]</p>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@Session.ClearFiltersAsync">@L["Actions:ClearFilters"]</MudButton>
                    }
                </div>
            </NoRecordsContent>
        </MudTable>
    </div>
</section>

@code {
    [Parameter, EditorRequired] public SeederPageSession Session { get; set; } = default!;

    private IEnumerable<SeederExecutionRow> Rows =>
        Session.FilteredSeeders.Select(static seeder => new SeederExecutionRow(seeder));

    private bool IsDetailsOpen(SeederExecutionSnapshot seeder) =>
        Session.IsDetailsOpen && string.Equals(
            Session.SelectedSeeder?.SeederTypeName,
            seeder.SeederTypeName,
            StringComparison.Ordinal);

    // Stable type-name equality preserves row focus as live snapshots replace their evidence.
    private sealed class SeederExecutionRow(SeederExecutionSnapshot seeder) : IEquatable<SeederExecutionRow>
    {
        public SeederExecutionSnapshot Seeder { get; } = seeder;

        public bool Equals(SeederExecutionRow? other) => other is not null && string.Equals(
            Seeder.SeederTypeName,
            other.Seeder.SeederTypeName,
            StringComparison.Ordinal);

        public override bool Equals(object? obj) => obj is SeederExecutionRow other && Equals(other);

        public override int GetHashCode() => StringComparer.Ordinal.GetHashCode(Seeder.SeederTypeName);
    }
}
