@using System.Globalization
@using Monica.Tool.Extensions
@using Monica.Repository.Persistence.Services.Support
@inject IStringLocalizer<RepositoryUIResource> L

@if (Snapshot is null)
{
    <MudAlert Severity="Severity.Info" Icon="@MoIcons.Info">@L["Overview:Empty"]</MudAlert>
}
else if (ShowOptionsOnly)
{
    <OptionsTable Options="Snapshot.Options" />
}
else
{
    <div class="repository-connection-workspace">
        <section class="connection-decision" data-state="@(Snapshot.CanConnect ? "connected" : Snapshot.HasError ? "unknown" : "disconnected")">
            <div class="connection-decision__title"><MoIcon Icon="@(Snapshot.CanConnect ? MoIcons.Success : MoIcons.Error)" Size="1.5rem" /><span>@L["Workbench:Overview:Probe"]</span></div>
            <h3>@(Snapshot.CanConnect ? L["Overview:Values:Connected"] : Snapshot.HasError ? L["Workbench:Overview:Incomplete"] : L["Overview:Values:Disconnected"])</h3>
            <p>@L["Workbench:Overview:ProbeNote"]</p>
            <div class="connection-address"><span>@L["Overview:Connection:Database"]</span><strong>@Value(Snapshot.Connection?.Database)</strong><span>@L["Overview:Connection:DataSource"]</span><code>@Value(Snapshot.Connection?.DataSource)</code></div>
            <div class="connection-string-heading"><h4>@L["Overview:Connection:ConnectionString"]</h4><MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="IsBusy" StartIcon="@(RevealConnectionStrings ? MoIcons.EyeOff : MoIcons.Eye)" OnClick="OnToggleReveal">@(RevealConnectionStrings ? L["Overview:Connection:Hide"] : L["Overview:Connection:Reveal"])</MudButton></div>
            <pre class="connection-string">@Value(RevealConnectionStrings ? Snapshot.Connection?.RevealedConnectionString ?? Snapshot.Connection?.MaskedConnectionString : Snapshot.Connection?.MaskedConnectionString)</pre>
        </section>
        <section class="connection-facts">
            <header><span class="connection-eyebrow">@L["Workbench:Overview:Resolution"]</span><h3>@L["Overview:Provider:Title"]</h3></header>
            <dl><dt>@L["Overview:Provider:ProviderName"]</dt><dd>@Value(Snapshot.ProviderName)</dd><dt>@L["Overview:Metrics:ProviderType"]</dt><dd>@Snapshot.Registration.ProviderType</dd><dt>@L["Overview:Provider:ContextType"]</dt><dd><code>@Snapshot.Registration.DbContextType.GetCleanFullName()</code></dd><dt>@L["Overview:Provider:Assembly"]</dt><dd>@Snapshot.Registration.AssemblyName</dd><dt>@L["Overview:Metrics:MigrationAssembly"]</dt><dd>@Value(Snapshot.MigrationAssembly)</dd></dl>
        </section>
        <section class="connection-facts">
            <header><span class="connection-eyebrow">@L["Workbench:Overview:Configuration"]</span><h3>@L["Overview:Pool:Title"]</h3></header>
            <p>@L["Workbench:Overview:PoolNote"]</p>
            <dl><dt>@L["Overview:Pool:Pooling"]</dt><dd>@(Pool?.Pooling is { } enabled ? enabled ? L["Overview:Pool:Enabled"] : L["Overview:Pool:Disabled"] : L["Workbench:Overview:ProviderDefault"])</dd><dt>@L["Overview:Pool:MaxPoolSize"]</dt><dd>@PoolSize(Pool?.MaxPoolSize, RepositoryConnectionPoolInfo.DefaultMaxPoolSize)</dd><dt>@L["Overview:Pool:MinPoolSize"]</dt><dd>@PoolSize(Pool?.MinPoolSize, RepositoryConnectionPoolInfo.DefaultMinPoolSize)</dd></dl>
        </section>
        <section class="connection-facts connection-sessions">
            <header><span class="connection-eyebrow">@L["Workbench:Overview:DatabaseScope"]</span><h3>@L[DatabaseScopeKnown ? "Overview:Pool:DatabaseSessions" : "Workbench:Activity:DatabaseScopeUnknown"]</h3></header>
            @if (Activity?.Support == RepositoryActivitySupport.Supported && Activity.Summary is { } summary)
            {
                <div class="connection-session-count"><strong>@summary.DatabaseSessions</strong><span>@Value(Snapshot.Connection?.Database)</span></div>
                <dl><dt>@L["Overview:Pool:ActiveSessions"]</dt><dd>@summary.ActiveSessions</dd><dt>@L["Overview:Pool:IdleSessions"]</dt><dd>@summary.IdleSessions</dd><dt>@L["Overview:Pool:IdleInTransactionSessions"]</dt><dd>@summary.IdleInTransactionSessions</dd><dt>@L[IsPostgreSql ? "Workbench:Activity:LockWaitCount" : "Overview:Pool:WaitingSessions"]</dt><dd>@summary.WaitingSessions</dd></dl>
                <p>@L[DatabaseScopeKnown ? "Overview:Pool:SessionsNote" : "Workbench:Activity:DatabaseScopeUnknownDescription"]</p>
                @if (IsPostgreSql) { <p>@L["Workbench:Activity:PostgreSqlWaitNote"]</p> }
            }
            else
            {
                <p>@L[Activity?.Support == RepositoryActivitySupport.Failed ? "Workbench:Overview:SessionsFailed" : "Overview:Pool:SessionsUnavailable"]</p>
            }
            <a href="@ActivityUrl">@L["Workbench:Overview:InspectActivity"] <MoIcon Icon="@MoIcons.ArrowRight" Size="1.25rem" /></a>
        </section>
        <section class="connection-migrations">
            <div><span class="connection-eyebrow">@L["Workbench:Overview:Schema"]</span><h3>@L["Migrations:Title"]</h3><p>@L["Migrations:ContextNote", Value(Snapshot.MigrationAssembly)]</p></div>
            <div class="connection-migration-count"><span>@L["Overview:Metrics:Pending"]</span><strong>@(Snapshot.PendingMigrationCount?.ToString() ?? L["Overview:Values:Unknown"].Value)</strong></div>
            <a href="@MigrationsUrl">@L["Workbench:Overview:InspectMigrations"] <MoIcon Icon="@MoIcons.ArrowRight" Size="1.25rem" /></a>
        </section>
        @if (Snapshot.HasError)
        {
            <div class="connection-error"><MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Icon="@MoIcons.Error">@Snapshot.ErrorMessage</MudAlert></div>
        }
    </div>
}

@code {
    [Parameter] public RepositoryDbContextSnapshot? Snapshot { get; set; }
    [Parameter] public RepositoryMigrationStatus? MigrationStatus { get; set; }
    [Parameter] public RepositoryActivityResult? Activity { get; set; }
    [Parameter] public bool RevealConnectionStrings { get; set; }
    [Parameter] public bool ShowOptionsOnly { get; set; }
    [Parameter] public bool IsBusy { get; set; }
    [Parameter] public string MigrationsUrl { get; set; } = "/repository-dashboard/migrations";
    [Parameter] public string ActivityUrl { get; set; } = "/repository-dashboard/activity";
    [Parameter] public EventCallback OnToggleReveal { get; set; }
    private bool IsPostgreSql => (Activity?.ProviderGuide ?? RepositoryActivityProviderGuideCatalog.Resolve(Activity?.ProviderName ?? Snapshot?.ProviderName)).ProviderKind == RepositoryActivityProviderKind.PostgreSql;
    private bool DatabaseScopeKnown => !string.IsNullOrWhiteSpace(Snapshot?.Connection?.Database);
    private RepositoryConnectionPoolInfo? Pool => Snapshot?.Connection?.Pool;
    private bool CommonPoolDefaults => Snapshot?.ProviderName is { } provider && (provider.Contains("Npgsql", StringComparison.OrdinalIgnoreCase) || provider.Contains("SqlServer", StringComparison.OrdinalIgnoreCase) || provider.Contains("MySql", StringComparison.OrdinalIgnoreCase));
    private string PoolSize(int? value, int fallback) => Pool is not { PoolingEnabled: true } ? Value(null) : value is { } explicitValue ? explicitValue.ToString(CultureInfo.InvariantCulture) : CommonPoolDefaults ? $"{fallback} {L["Overview:Pool:DefaultSuffix"]}" : L["Workbench:Overview:ProviderDefault"].Value;
    private string Value(string? value) => string.IsNullOrWhiteSpace(value) ? L["Common:Values:Unavailable"].Value : value;
}
