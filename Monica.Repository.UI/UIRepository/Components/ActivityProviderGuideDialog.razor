@using Monica.UI.Shared.Components.Dialogs
@inject IStringLocalizer<RepositoryUIResource> L
@inject IJSRuntime JsRuntime
@inject ISnackbar Snackbar
@implements IAsyncDisposable

<MudDialog>
    <TitleContent>
        <MoDialogHeading Text="@L["Activity:Guide:DialogTitle"].Value" />
    </TitleContent>
    <DialogContent>
        <div class="activity-guide">
            <div class="activity-guide__identity">
                <div class="activity-guide__identity-copy">
                    <MudText Typo="Typo.h6">@L["Activity:Guide:Title"]</MudText>
                    <MudText Typo="Typo.body2" Class="activity-guide__provider">@ProviderLine</MudText>
                </div>
                <MudChip T="string" Variant="Variant.Outlined" Class="activity-guide-support"
                         data-tone="@(Guide.IsSupported ? "supported" : "unsupported")"
                         Color="@(Guide.IsSupported ? Color.Success : Color.Warning)"
                         Icon="@(Guide.IsSupported ? MoIcons.Success : MoIcons.Help)" CheckedIcon="@MoIcons.Check" CloseIcon="@MoIcons.Close">
                    @(Guide.IsSupported ? L["Activity:Guide:Supported"] : L["Activity:Guide:Unsupported"])
                </MudChip>
            </div>

            <MudAlert Severity="@(Guide.IsSupported ? Severity.Info : Severity.Warning)" Variant="Variant.Outlined" Dense="true"
                      Class="activity-guide-description" data-tone="@(Guide.IsSupported ? "supported" : "unsupported")" Icon="@(Guide.IsSupported ? MoIcons.Info : MoIcons.Warning)">
                @ProviderDescription
            </MudAlert>

            @if (Guide.IsSupported)
            {
                <div class="activity-guide__scope">
                    <section class="activity-guide__section">
                        <MudText Typo="Typo.subtitle2">@L["Activity:Guide:UsageTitle"]</MudText>
                        <MudText Typo="Typo.body2">@L["Activity:Guide:UsageDescription"]</MudText>
                    </section>
                    <section class="activity-guide__section">
                        <MudText Typo="Typo.subtitle2">@L["Activity:Guide:SourceTitle"]</MudText>
                        <MudText Typo="Typo.body2">@L["Activity:Guide:SourceDescription", Guide.SourceObject ?? L["Common:Values:Unavailable"]]</MudText>
                    </section>
                </div>
                <MudText Typo="Typo.body2" Class="activity-guide__note">@L["Workbench:Activity:Guide:ScopeDescription"]</MudText>

                <section class="activity-guide__section">
                    <div class="activity-guide__section-heading">
                        <div class="activity-guide__section-copy">
                            <MudText Typo="Typo.subtitle2">@L["Activity:Guide:SqlTitle"]</MudText>
                            <MudText Typo="Typo.body2" Class="activity-guide__note">@SourceDescription</MudText>
                        </div>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                   StartIcon="@MoIcons.Copy"
                                   Disabled="@(_retired || string.IsNullOrWhiteSpace(Guide.Sql))"
                                   aria-disabled="@(_copying || _retired || string.IsNullOrWhiteSpace(Guide.Sql) ? "true" : "false")"
                                   OnClick="CopySqlAsync">
                            @L["Common:Actions:Copy"]
                        </MudButton>
                    </div>
                    <div class="activity-guide__sql"><pre>@SqlText</pre></div>
                </section>

                <section class="activity-guide__section">
                    <MudText Typo="Typo.subtitle2">@L["Activity:Guide:ColumnsTitle"]</MudText>
                    <div class="activity-guide__table-boundary">
                        <MudTable T="string" Items="@Guide.SelectedColumns" Dense="true" Hover="true"
                                  Square="true" Elevation="0" Breakpoint="Breakpoint.Xs"
                                  TableAttributes="@(new Dictionary<string, object?> { ["aria-label"] = L["Activity:Guide:ColumnsTitle"].Value })">
                            <HeaderContent>
                                <MudTh>@L["Workbench:Activity:Guide:ColumnName"]</MudTh>
                                <MudTh>@L["Workbench:Activity:Guide:ColumnMeaning"]</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="@L["Workbench:Activity:Guide:ColumnName"].Value">
                                    <span class="activity-guide__column-name">@context</span>
                                </MudTd>
                                <MudTd DataLabel="@L["Workbench:Activity:Guide:ColumnMeaning"].Value">@GetColumnDescription(context)</MudTd>
                            </RowTemplate>
                        </MudTable>
                    </div>
                </section>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Close">@L["Common:Actions:Close"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private readonly CancellationTokenSource _lifetimeCancellation = new();
    private readonly object _lifecycleSync = new();
    private Task _clipboardTask = Task.CompletedTask;
    private Task? _disposeTask;
    private bool _copying;
    private bool _retired;

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>Gets or sets the actual provider catalog guide, including its support status and unmodified SQL.</summary>
    [Parameter, EditorRequired] public RepositoryActivityProviderGuide Guide { get; set; } = null!;

    private string ProviderDisplayName => string.IsNullOrWhiteSpace(Guide.DisplayName)
        ? L["Common:Values:Unavailable"]
        : Guide.DisplayName;

    private string ProviderLine => string.IsNullOrWhiteSpace(Guide.ProviderName)
                                   || string.Equals(Guide.ProviderName, Guide.DisplayName, StringComparison.OrdinalIgnoreCase)
        ? ProviderDisplayName
        : $"{ProviderDisplayName} · {Guide.ProviderName}";

    private string SqlText => Guide.Sql ?? string.Empty;

    private string ProviderDescription => Guide.ProviderKind switch
    {
        RepositoryActivityProviderKind.PostgreSql => L["Activity:Guide:Providers:PostgreSql:Description"],
        RepositoryActivityProviderKind.OpenGauss => L["Activity:Guide:Providers:OpenGauss:Description"],
        _ => L["Activity:Guide:UnsupportedDescription"]
    };

    private string SourceDescription => Guide.ProviderKind switch
    {
        RepositoryActivityProviderKind.PostgreSql => L["Activity:Guide:Providers:PostgreSql:Source"],
        RepositoryActivityProviderKind.OpenGauss => L["Activity:Guide:Providers:OpenGauss:Source"],
        _ => string.Empty
    };

    private Task CopySqlAsync()
    {
        lock (_lifecycleSync)
        {
            if (_retired || _copying || string.IsNullOrWhiteSpace(Guide.Sql)) return Task.CompletedTask;
            _copying = true;
            return _clipboardTask = CopySqlCoreAsync(Guide.Sql, _lifetimeCancellation.Token);
        }
    }

    private async Task CopySqlCoreAsync(string sql, CancellationToken cancellationToken)
    {
        try
        {
            var copied = await JsRuntime.InvokeAsync<bool>("MoClipboard.copyText", cancellationToken, sql);
            if (_retired || cancellationToken.IsCancellationRequested) return;
            Snackbar.Add(copied ? L["Activity:Guide:Copied"] : L["Activity:Guide:CopyFailed"],
                copied ? Severity.Success : Severity.Warning);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested) { }
        catch (JSDisconnectedException) { }
        catch (JSException)
        {
            if (!_retired && !cancellationToken.IsCancellationRequested)
                Snackbar.Add(L["Activity:Guide:CopyFailed"], Severity.Warning);
        }
        finally
        {
            if (!_retired) _copying = false;
        }
    }

    private string GetColumnDescription(string column) => column switch
    {
        "Runtime" => L["Workbench:Activity:Guide:RuntimeDescription"],
        "Datname" => L["Activity:Guide:Columns:Datname"],
        "Usename" => L["Activity:Guide:Columns:Usename"],
        "ApplicationName" => L["Activity:Guide:Columns:ApplicationName"],
        "ClientAddr" => L["Activity:Guide:Columns:ClientAddr"],
        "ClientPort" => L["Activity:Guide:Columns:ClientPort"],
        "Waiting" => Guide.ProviderKind == RepositoryActivityProviderKind.PostgreSql
            ? L["Workbench:Activity:PostgreSqlWaitDescription"] : L["Activity:Guide:Columns:Waiting"],
        "State" => L["Activity:Guide:Columns:State"],
        "Query" => L["Activity:Guide:Columns:Query"],
        "Sessionid" => L["Activity:Guide:Columns:Sessionid"],
        "ResourcePool" => L["Activity:Guide:Columns:ResourcePool"],
        "QueryId" => L["Activity:Guide:Columns:QueryId"],
        "ConnectionInfo" => L["Activity:Guide:Columns:ConnectionInfo"],
        "UniqueSqlId" => L["Activity:Guide:Columns:UniqueSqlId"],
        "TraceId" => L["Activity:Guide:Columns:TraceId"],
        "Pid" => L["Activity:Guide:Columns:Pid"],
        "BackendStart" => L["Activity:Guide:Columns:BackendStart"],
        "XactStart" => L["Activity:Guide:Columns:XactStart"],
        "QueryStart" => L["Workbench:Activity:Guide:QueryStartDescription"],
        "StateChange" => L["Activity:Guide:Columns:StateChange"],
        _ => L["Activity:Guide:Columns:ProviderSpecific"]
    };

    private void Close()
    {
        lock (_lifecycleSync)
        {
            if (_retired) return;
            _retired = true;
        }
        MudDialog.Close();
    }

    /// <summary>Retires callbacks, cancels and drains the admitted clipboard operation, and disposes its lifetime once.</summary>
    public ValueTask DisposeAsync()
    {
        lock (_lifecycleSync)
        {
            _retired = true;
            return new ValueTask(_disposeTask ??= DisposeCoreAsync(_clipboardTask));
        }
    }

    private async Task DisposeCoreAsync(Task clipboardTask)
    {
        try
        {
            await _lifetimeCancellation.CancelAsync();
            await clipboardTask;
        }
        finally { _lifetimeCancellation.Dispose(); }
    }
}
