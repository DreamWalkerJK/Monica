@attribute [Route(PAGE_URL)]
@using Monica.SignalR.UISignalR.Components
@using Monica.SignalR.UISignalR.Models
@using Monica.SignalR.UISignalR.State
@using Microsoft.Extensions.Logging
@using System.Globalization
@inject ISnackbar SnackBar
@inject NavigationManager NavigationManager
@inject SignalRDebugPageStateFactory PageStateFactory
@inject IStringLocalizer<SignalRResource> L
@inject ILogger<UISignalRDebugPage> Logger
@implements IAsyncDisposable

<PageTitle>@L["Pages:SignalRDebug:Title"]</PageTitle>

<div class="signalr-workbench mo-page-shell mo-page-shell--full-width">
    <header class="signalr-workbench-header">
        <div class="signalr-workbench-identity">
            <span class="signalr-workbench-mark" aria-hidden="true"><MudIcon Icon="@Icons.Material.Outlined.Cable" /></span>
            <div>
                <span class="signalr-workbench-eyebrow">@L["Pages:SignalRDebug:Eyebrow"]</span>
                <h1>@L["Pages:SignalRDebug:Heading"]</h1>
                <p>@L["Pages:SignalRDebug:Subtitle"]</p>
            </div>
        </div>
        <dl class="signalr-workbench-summary" aria-label="@L["Pages:SignalRDebug:Summary:AriaLabel"]">
            <div><dt>@L["Pages:SignalRDebug:Summary:Hubs"]</dt><dd>@(PageState.HubsLoaded ? PageState.AvailableHubs.Count.ToString(CultureInfo.CurrentCulture) : "—")</dd></div>
            <div><dt>@L["Pages:SignalRDebug:Summary:Users"]</dt><dd>@(PageState.ConnectedUsersLoaded ? PageState.ConnectedUsers.Count.ToString(CultureInfo.CurrentCulture) : "—")</dd></div>
            <div><dt>@L["Pages:SignalRDebug:Summary:Received"]</dt><dd>@PageState.ConnectionState.TotalReceivedMessages</dd></div>
        </dl>
    </header>

    <div class="signalr-workbench-grid">
        <aside class="signalr-session-rail" aria-label="@L["Pages:SignalRDebug:Sections:Connection"]">
            <SignalRConnectionStatus ConnectionState="@PageState.ConnectionState" SelectedHubRoute="@PageState.SelectedHubRoute"
                                     ActualConnectedHubRoute="@PageState.ConnectedHubRoute" IsServerSideAnonymous="@PageState.IsConnectionNotObserved" />
            <SignalRConnectionConfig AccessToken="@PageState.AccessToken" AccessTokenChanged="@((string value) => PageState.AccessToken = value)"
                                     SelectedHubRoute="@PageState.SelectedHubRoute" SelectedHubRouteChanged="PageState.SelectHubRoute"
                                     AvailableHubs="@PageState.AvailableHubs" IsConnecting="@PageState.ConnectionState.IsConnecting"
                                     IsConnected="@PageState.ConnectionState.IsConnected" CanGenerateTestToken="@PageState.CanGenerateTestToken"
                                     DataLoaded="@PageState.HubsLoaded" IsLoading="@PageState.IsLoadingHubs" LoadFailed="@PageState.HubsLoadFailed"
                                     CapturedAtUtc="@PageState.HubsCapturedAtUtc" OnConnect="ConnectAsync" OnTestUserConnect="TestUserConnectAsync"
                                     OnDisconnect="DisconnectAsync" OnRefreshHubs="LoadHubsAsync" />
            <div class="signalr-trace-settings">
                <span class="signalr-workbench-eyebrow">@L["Pages:SignalRDebug:Settings:Eyebrow"]</span>
                <MudSwitch T="bool" @bind-Value="PageState.VerboseLogging" Color="Color.Primary" Label="@L["Pages:SignalRDebug:Settings:VerboseLogging"]" />
                <p>@L["Pages:SignalRDebug:Settings:VerboseLoggingHelper"]</p>
            </div>
        </aside>

        <section class="signalr-tool-workspace" aria-label="@L["Pages:SignalRDebug:WorkspaceLabel"]">
            <MudTabs Elevation="0" Rounded="false" KeepPanelsAlive="true" Class="signalr-task-tabs">
                <MudTabPanel Text="@L["Pages:SignalRDebug:Tabs:Methods"]" Icon="@Icons.Material.Outlined.Terminal">
                    <div class="signalr-contract-scope"><span>@L["Pages:SignalRDebug:MethodCatalog"]</span><code>@(string.IsNullOrEmpty(PageState.MethodCatalogHubRoute) ? L["UISignalR:Common:None"].Value : PageState.MethodCatalogHubRoute)</code></div>
                    <div class="signalr-method-workspace">
                        <SignalRMethodInvoker HubMethods="@PageState.HubMethods" IsConnected="@PageState.ConnectionState.IsConnected"
                                              SelectedMethodName="@PageState.SelectedMethodName" SelectedMethodNameChanged="PageState.SelectMethod"
                                              MethodParameters="@PageState.MethodParameters" OnInvokeMethod="InvokeMethodAsync" />
                        <SignalRMethodListener HubMethods="@PageState.HubMethods" IsConnected="@PageState.ConnectionState.IsConnected"
                                               OnToggleMethodListener="ToggleMethodListenerAsync" OnEnableAllListeners="EnableAllListenersAsync"
                                               OnDisableAllListeners="DisableAllListenersAsync" />
                    </div>
                </MudTabPanel>
                <MudTabPanel Text="@L["Pages:SignalRDebug:Tabs:Messages"]" Icon="@Icons.Material.Outlined.Forum">
                    <div class="signalr-message-workspace">
                        <SignalRMessageSender UserName="@PageState.UserName" UserNameChanged="@((string value) => PageState.UserName = value)"
                                              Message="@PageState.Message" MessageChanged="@((string value) => PageState.Message = value)"
                                              IsConnected="@PageState.ConnectionState.IsConnected" OnSendMessage="SendMessageAsync" />
                        <SignalRMessageLog Messages="@PageState.Messages" OnClearMessages="ClearMessages" />
                    </div>
                </MudTabPanel>
                <MudTabPanel Text="@L["Pages:SignalRDebug:Tabs:Connections"]" Icon="@Icons.Material.Outlined.PeopleAlt">
                    <SignalRConnectedUsers ConnectedUsers="@PageState.ConnectedUsers" OnRefreshClicked="LoadConnectedUsersAsync"
                                          DataLoaded="@PageState.ConnectedUsersLoaded" IsLoading="@PageState.IsLoadingConnectedUsers"
                                          LoadFailed="@PageState.ConnectedUsersLoadFailed" CapturedAtUtc="@PageState.ConnectedUsersCapturedAtUtc" />
                </MudTabPanel>
                <MudTabPanel Text="@L["Pages:SignalRDebug:Tabs:Sends"]" Icon="@Icons.Material.Outlined.MonitorHeart">
                    <SignalRSendDiagnostics Snapshot="@PageState.SendDiagnostics" OnRefreshClicked="LoadSendDiagnosticsAsync"
                                            IsLoading="@PageState.IsLoadingSendDiagnostics" LoadFailed="@PageState.SendDiagnosticsLoadFailed" />
                </MudTabPanel>
            </MudTabs>
        </section>
    </div>
</div>

@code {
    /// <summary>Gets the route of the browser-session SignalR workbench.</summary>
    public const string PAGE_URL = "/signalr-debug";

    private readonly object _workSync = new();
    private readonly HashSet<Task> _operations = [];
    private SignalRDebugPageState PageState { get; set; } = null!;
    private Task? _retirement;
    private volatile bool _disposed;

    /// <inheritdoc />
    protected override void OnInitialized()
    {
        PageState = PageStateFactory.Create();
        PageState.StateChanged += OnStateChanged;
    }

    /// <inheritdoc />
    protected override Task OnAfterRenderAsync(bool firstRender) => firstRender
        ? RunOperationAsync(PageState.InitializeAsync)
        : Task.CompletedTask;

    private Task LoadHubsAsync() => RunOperationAsync(async () =>
    {
        if (!await PageState.LoadHubsAsync()) Notify("LoadHubsFailed", Severity.Error);
    });

    private Task LoadConnectedUsersAsync() => RunOperationAsync(async () =>
    {
        var success = await PageState.LoadConnectedUsersAsync();
        Notify(success ? "LoadConnectedUsersSuccess" : "LoadConnectedUsersFailed", success ? Severity.Success : Severity.Error);
    });

    private Task LoadSendDiagnosticsAsync() => RunOperationAsync(async () =>
    {
        var success = await PageState.LoadSendDiagnosticsAsync();
        Notify(success ? "LoadSendDiagnosticsSuccess" : "LoadSendDiagnosticsFailed", success ? Severity.Success : Severity.Error);
    });

    private Task ConnectAsync() => RunOperationAsync(async () =>
    {
        var success = await PageState.ConnectAsync(NavigationManager.BaseUri);
        Notify(success ? "ConnectSuccess" : "ConnectFailed", success ? Severity.Success : Severity.Error);
    });

    private Task TestUserConnectAsync() => RunOperationAsync(async () =>
    {
        if (!PageState.CanGenerateTestToken)
        {
            Notify("TestTokenUnavailable", Severity.Warning);
            return;
        }
        var success = await PageState.TestUserConnectAsync(NavigationManager.BaseUri);
        Notify(success ? "TestUserConnectSuccess" : "ConnectFailed", success ? Severity.Success : Severity.Error, PageState.LastTestUserName ?? string.Empty);
    });

    private Task DisconnectAsync() => RunOperationAsync(async () =>
    {
        var success = await PageState.DisconnectAsync();
        Notify(success ? "DisconnectSuccess" : "DisconnectFailed", success ? Severity.Info : Severity.Error);
    });

    private Task SendMessageAsync((string userName, string message) _) => RunOperationAsync(async () =>
    {
        if (!await PageState.SendMessageAsync()) Notify("SendMessageFailed", Severity.Error);
    });

    private Task InvokeMethodAsync((string methodName, List<MethodCallParameter> parameters) data) => RunOperationAsync(async () =>
    {
        var success = await PageState.InvokeSelectedMethodAsync();
        Notify(success ? "InvokeMethodSuccess" : "InvokeMethodFailed", success ? Severity.Success : Severity.Error, data.methodName);
    });

    private Task ToggleMethodListenerAsync((HubMethodInfo method, bool isListening) data) => RunOperationAsync(async () =>
    {
        if (!await PageState.ToggleMethodListenerAsync(data.method, data.isListening)) Notify("ToggleListenerFailed", Severity.Error);
    });

    private Task EnableAllListenersAsync() => RunOperationAsync(async () =>
        Notify("EnableListenersSuccess", Severity.Success, await PageState.EnableAllListenersAsync()));

    private Task DisableAllListenersAsync() => RunOperationAsync(async () =>
        Notify("DisableListenersSuccess", Severity.Success, await PageState.DisableAllListenersAsync()));

    private void ClearMessages()
    {
        if (!_disposed) PageState.ClearMessages();
    }

    private void Notify(string key, Severity severity, params object[] arguments)
    {
        if (!_disposed) SnackBar.Add(L[$"Pages:SignalRDebug:Notifications:{key}", arguments].Value, severity);
    }

    private void OnStateChanged() => _ = RunOperationAsync(() => InvokeAsync(() =>
    {
        if (!_disposed) StateHasChanged();
    }));

    private Task RunOperationAsync(Func<Task> action)
    {
        lock (_workSync)
        {
            if (_disposed) return Task.CompletedTask;
            var operation = ExecuteOperationAsync(action);
            _operations.Add(operation);
            return ObserveOperationAsync(operation);
        }
    }

    private async Task ExecuteOperationAsync(Func<Task> action)
    {
        try { await action(); }
        catch (OperationCanceledException) when (_disposed) { }
        catch (ObjectDisposedException) when (_disposed) { }
        catch (Exception exception)
        {
            Logger.LogError(exception, "The SignalR browser workbench operation failed.");
            Notify("OperationFailed", Severity.Error);
        }
    }

    private async Task ObserveOperationAsync(Task operation)
    {
        try { await operation; }
        finally { lock (_workSync) _operations.Remove(operation); }
    }

    /// <summary>Stops admission, retires the browser session, and drains admitted operations and queued renders.</summary>
    public ValueTask DisposeAsync()
    {
        lock (_workSync) return new ValueTask(_retirement ??= RetireAsync());
    }

    private async Task RetireAsync()
    {
        _disposed = true;
        PageState.StateChanged -= OnStateChanged;
        try { await PageState.DisposeAsync(); }
        finally
        {
            Task[] operations;
            lock (_workSync) operations = _operations.ToArray();
            await Task.WhenAll(operations);
        }
    }
}
