@using Monica.SignalR.UISignalR.Models
@inject IStringLocalizer<SignalRResource> L

<section class="signalr-connection-status" aria-labelledby="@_headingId">
    <MudPaper Square="true" Elevation="0" Class="connection-status-surface">
        <header class="connection-status-heading">
            <h2 id="@_headingId">@L["UISignalR:ConnectionStatus:Title"]</h2>
            <MudChip T="string" Color="@GetConnectionStatusColor()" Size="Size.Small" Icon="@GetConnectionStatusIcon()" CheckedIcon="@MoIcons.Check" CloseIcon="@MoIcons.Close">@GetConnectionStatusText()</MudChip>
        </header>

        <dl class="connection-status-facts">
            <div>
                <dt>@L["UISignalR:ConnectionStatus:ActiveHubLabel"]</dt>
                <dd><code>@(HasActiveTarget ? ActiveRoute : L["UISignalR:ConnectionStatus:NoActiveHub"].Value)</code></dd>
            </div>
            @if (!string.IsNullOrWhiteSpace(SelectedHubRoute) && (!HasActiveTarget || !string.Equals(SelectedHubRoute, ActiveRoute, StringComparison.Ordinal)))
            {
                <div>
                    <dt>@L["UISignalR:ConnectionStatus:DraftHubLabel"]</dt>
                    <dd><code>@SelectedHubRoute</code></dd>
                </div>
            }
            @if (!string.IsNullOrEmpty(ConnectionState.ConnectionId))
            {
                <div>
                    <dt>@L["UISignalR:ConnectionStatus:ConnectionIdLabel"]</dt>
                    <dd><code>@ConnectionState.ConnectionId</code></dd>
                </div>
            }
            <div class="connection-status-received">
                <dt>@L["UISignalR:ConnectionStatus:ReceivedLabel"]</dt>
                <dd>@ConnectionState.TotalReceivedMessages</dd>
            </div>
        </dl>
        @if (IsServerSideAnonymous && ConnectionState.IsConnected)
        {
            <div class="connection-status-registry-note"><MudAlert Severity="Severity.Warning" Dense="true" Icon="@MoIcons.Warning">@L["UISignalR:ConnectionStatus:AnonymousWarning"]</MudAlert></div>
        }
    </MudPaper>
</section>

@code {
    /// <summary>Gets or sets the browser client's reported connection state.</summary>
    [Parameter] public SignalRConnectionState ConnectionState { get; set; } = new();

    /// <summary>Gets or sets the draft route selected for the next connection action.</summary>
    [Parameter] public string SelectedHubRoute { get; set; } = string.Empty;

    /// <summary>
    /// Gets or sets the route actually used by the current browser connection.
    /// When omitted, existing consumers retain the selected-route display behavior.
    /// </summary>
    [Parameter] public string? ActualConnectedHubRoute { get; set; }

    /// <summary>
    /// Gets or sets whether the current connection is absent from the captured server registry.
    /// Registry absence alone does not establish authentication failure.
    /// </summary>
    [Parameter] public bool IsServerSideAnonymous { get; set; }

    private readonly string _headingId = $"signalr-connection-status-{Guid.NewGuid():N}";
    private string ActiveRoute => ActualConnectedHubRoute ?? SelectedHubRoute;
    private bool HasActiveTarget => ConnectionState.IsConnected || !string.IsNullOrEmpty(ActualConnectedHubRoute);

    private Color GetConnectionStatusColor() => ConnectionState.Status switch
    {
        "Connected" => Color.Success,
        "Connecting" or "Reconnecting" => Color.Warning,
        _ => Color.Default
    };

    private string GetConnectionStatusIcon() => ConnectionState.Status switch
    {
        "Connected" => MoIcons.Success,
        "Connecting" or "Reconnecting" => MoIcons.Refresh,
        _ => MoIcons.Unplug
    };

    private string GetConnectionStatusText() => ConnectionState.Status switch
    {
        "Connected" => L["UISignalR:Common:Status:Connected"].Value,
        "Connecting" => L["UISignalR:Common:Status:Connecting"].Value,
        "Reconnecting" => L["UISignalR:Common:Status:Reconnecting"].Value,
        "Disconnected" => L["UISignalR:Common:Status:Disconnected"].Value,
        "Disconnecting" => L["UISignalR:Common:Status:Disconnecting"].Value,
        _ => L["UISignalR:Common:Status:Unknown"].Value
    };
}
