@using Monica.Markdown.Models
@using Microsoft.Extensions.Localization
@using Monica.Markdown.Localization
@inject IStringLocalizer<MarkdownResource> L

<div class="group-list">
    @foreach (var group in Groups)
    {
        var isActive = group.Key == SelectedGroupKey;
        <button type="button"
                class="group-item @(isActive ? "active" : "")"
                @onclick="() => OnGroupClicked(group.Key)"
                title="@GetItemTitle(group)">
            <span class="group-dot @(group.HasConfigurationError ? "invalid" : string.Empty)"></span>

            <div class="group-content">
                <div class="group-title-row">
                    <span class="group-name">@group.Title</span>

                    <div class="group-meta">

                        @if (group.HasConfigurationError)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Warning"
                                     Size="Size.Small"
                                     Color="Color.Warning"
                                     Class="group-warning" />
                        }

                        @if (isActive)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Check"
                                     Size="Size.Small"
                                     Color="Color.Primary"
                                     Class="group-selected" />
                        }
                    </div>
                </div>

                <span class="group-description">@GetDescription(group)</span>
                <span class="group-count">@(group.IsMultilingual
                    ? L["MarkdownViewer:Dialogs:AllLanguagesCount", group.DocumentCount]
                    : L["MarkdownViewer:Navbar:KnowledgeBaseDocumentCount", group.DocumentCount])</span>
            </div>
        </button>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public List<MarkdownDocumentGroup> Groups { get; set; } = [];

    [Parameter]
    public string? SelectedGroupKey { get; set; }

    [Parameter]
    public EventCallback<string> SelectedGroupKeyChanged { get; set; }

    private async Task OnGroupClicked(string groupKey)
    {
        await SelectedGroupKeyChanged.InvokeAsync(groupKey);
    }

    private static string GetDescription(MarkdownDocumentGroup group) =>
        string.IsNullOrWhiteSpace(group.Description) ? group.BasePath : group.Description;

    private static string GetItemTitle(MarkdownDocumentGroup group) =>
        $"{group.Title}{Environment.NewLine}{GetDescription(group)}";
}
