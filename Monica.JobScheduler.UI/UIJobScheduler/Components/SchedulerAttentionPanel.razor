@using Monica.JobScheduler.UI.Localization

@inject IStringLocalizer<JobSchedulerResource> L

@{
    var failedCount = Overview.ExecutionStateCounts.GetValueOrDefault(JobExecutionState.Failed);
    var skippedCount = Overview.ExecutionStateCounts.GetValueOrDefault(JobExecutionState.Skipped);
    var absentCount = Overview.Definitions.Count(static definition => !definition.IsPresent);
    var attentionCategoryCount = (failedCount > 0 ? 1 : 0) + (skippedCount > 0 ? 1 : 0) + (absentCount > 0 ? 1 : 0);
}

<section class="attention-panel" aria-labelledby="attention-panel-title">
    <header class="attention-panel__heading">
        <div>
            <h2 id="attention-panel-title">@L["Overview:Attention:Title"]</h2>
            <p>@L["Overview:Attention:Description"]</p>
        </div>
        <span class="attention-panel__count">
            @L["Overview:Attention:CategoryCount", attentionCategoryCount]
        </span>
    </header>

    @if (attentionCategoryCount == 0)
    {
        <div class="attention-panel__clear">
            <span class="attention-panel__clear-icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Outlined.FactCheck" /></span>
            <div>
                <strong>@L["Overview:Attention:ClearTitle"]</strong>
                <small>@L["Overview:Attention:ClearDescription"]</small>
            </div>
        </div>
    }
    else
    {
        <div class="attention-panel__items">
            @if (failedCount > 0)
            {
                <a href="/job-scheduler/executions?states=Failed" class="attention-panel__item" data-tone="error">
                    <span class="attention-panel__item-icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Outlined.Error" Size="Size.Small" /></span>
                    <span class="attention-panel__item-copy">
                        <strong>@L["Overview:Attention:Failed"]</strong>
                        <small>@L["Overview:Attention:FailedDescription"]</small>
                    </span>
                    <b>@failedCount</b>
                    <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" Size="Size.Small" Class="attention-panel__chevron" />
                </a>
            }
            @if (skippedCount > 0)
            {
                <a href="/job-scheduler/executions?states=Skipped" class="attention-panel__item" data-tone="warning">
                    <span class="attention-panel__item-icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Outlined.SkipNext" Size="Size.Small" /></span>
                    <span class="attention-panel__item-copy">
                        <strong>@L["Overview:Attention:Skipped"]</strong>
                        <small>@L["Overview:Attention:SkippedDescription"]</small>
                    </span>
                    <b>@skippedCount</b>
                    <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" Size="Size.Small" Class="attention-panel__chevron" />
                </a>
            }
            @if (absentCount > 0)
            {
                <a href="/job-scheduler/catalog?present=false" class="attention-panel__item" data-tone="info">
                    <span class="attention-panel__item-icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Outlined.CloudOff" Size="Size.Small" /></span>
                    <span class="attention-panel__item-copy">
                        <strong>@L["Overview:Attention:Absent"]</strong>
                        <small>@L["Overview:Attention:AbsentDescription"]</small>
                    </span>
                    <b>@absentCount</b>
                    <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" Size="Size.Small" Class="attention-panel__chevron" />
                </a>
            }
        </div>
    }
</section>

@code {
    /// <summary>
    /// Gets the current bounded scheduler overview to triage.
    /// </summary>
    [Parameter, EditorRequired]
    public JobSchedulerOverview Overview { get; set; } = null!;
}
