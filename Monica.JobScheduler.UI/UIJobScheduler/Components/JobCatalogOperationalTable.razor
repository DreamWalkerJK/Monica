@using Monica.JobScheduler.UI.Localization

<section class="catalog-table" aria-labelledby="catalog-table-title">
    <header class="catalog-table__heading">
        <div>
            <span class="catalog-table__eyebrow">@L["Catalog:RegistryEyebrow"]</span>
            <h2 id="catalog-table-title">@L["Catalog:Title"]</h2>
            <p>@L["Catalog:Count", TotalCount]</p>
        </div>
        <div class="catalog-table__heading-actions">
            @if (_visibleSummaries.Any(IsRecurring))
            {
                <MudCheckBox T="bool"
                             Value="@AreAllRecurringSelected"
                             ValueChanged="AllRecurringSelectionChanged"
                             Disabled="@IsMutating"
                             Dense="true"
                             Color="Color.Primary"
                             Label="@L["Catalog:Selection:SelectPage"]"
                             aria-label="@L["Catalog:Selection:SelectAll"]" />
            }
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Outlined.Refresh"
                       OnClick="ReloadAsync">@L["Common:Refresh"]</MudButton>
        </div>
    </header>

    @if (FilterContent is not null)
    {
        <div class="catalog-table__filters">@FilterContent</div>
    }
    @if (SelectionContent is not null)
    {
        <div class="catalog-table__selection-toolbar">@SelectionContent</div>
    }

    <div class="catalog-table__data">
        <MudTable @ref="_table"
                  T="JobOperationalSummary"
                  ServerData="LoadServerDataAsync"
                  RowsPerPage="@PageSize"
                  Dense="false"
                  Hover="true"
                  Breakpoint="Breakpoint.Xs"
                  SortLabel="@L["Catalog:SortLabel"]"
                  TableAttributes="@(new Dictionary<string, object?> { ["aria-label"] = L["Catalog:Title"].Value })"
                  HorizontalScrollbar="true"
                  Elevation="0"
                  Square="true"
                  AllowUnsorted="false">
            <ColGroup>
                <col class="catalog-table__selection-column" />
                <col class="catalog-table__definition-column" />
                <col class="catalog-table__plan-column" />
                <col class="catalog-table__evidence-column" />
                <col class="catalog-table__actions-column" />
            </ColGroup>
            <HeaderContent>
                <MudTh Class="catalog-table__selection-heading">
                    <span class="visually-hidden">@L["Catalog:Selection:SelectAll"]</span>
                </MudTh>
                <MudTh Class="catalog-table__definition-heading">
                    <div class="catalog-table__sorts">
                        <MudTableSortLabel T="JobOperationalSummary"
                                           SortLabel="@nameof(JobDefinitionSortField.JobName)"
                                           InitialDirection="SortDirection.Ascending">@L["Catalog:Columns:Definition"]</MudTableSortLabel>
                        <MudTableSortLabel T="JobOperationalSummary"
                                           SortLabel="@nameof(JobDefinitionSortField.OwnerKey)">@L["Catalog:Columns:Owner"]</MudTableSortLabel>
                    </div>
                </MudTh>
                <MudTh>@L["Catalog:Columns:Schedule"]</MudTh>
                <MudTh>@L["Catalog:Columns:LastRun"]</MudTh>
                <MudTh Class="catalog-table__actions-heading">@L["Catalog:Columns:Actions"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                @{
                    var definition = context.Definition;
                    var declaration = definition.Declaration;
                    var effective = definition.EffectiveConfiguration;
                }
                <MudTd Class="catalog-table__selection-cell" DataLabel="@L["Catalog:Selection:SelectPage"]">
                    <div class="catalog-table__selection">
                        @if (IsRecurring(context))
                        {
                            <MudCheckBox T="bool"
                                         Value="@SelectedJobIds.Contains(definition.Id)"
                                         ValueChanged="@(_ => SelectionToggled.InvokeAsync(context))"
                                         Disabled="@IsMutating"
                                         Dense="true"
                                         Color="Color.Primary"
                                         aria-label="@L["Catalog:Selection:SelectJob", effective.JobName]" />
                        }
                        else
                        {
                            <span class="catalog-table__type-icon" aria-hidden="true"><MudIcon Icon="@Icons.Material.Outlined.Bolt" Size="Size.Small" /></span>
                        }
                    </div>
                </MudTd>
                <MudTd Class="catalog-table__definition-cell" DataLabel="@L["Catalog:Columns:Definition"]">
                    <div class="catalog-table__identity">
                        <a class="catalog-table__identity-name" href="@GetDetailHref(context)">@effective.JobName</a>
                        @if (!definition.IsPresent)
                        {
                            <span class="catalog-table__presence">@L["Catalog:AbsentDefinition"]</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(effective.Description))
                        {
                            <p>@effective.Description</p>
                        }
                        <span class="catalog-table__owner" title="@definition.OwnerKey">
                            <MudIcon Icon="@Icons.Material.Outlined.AccountTree" Size="Size.Small" />
                            <span>@definition.OwnerKey</span>
                        </span>
                        <button type="button"
                                class="catalog-table__identity-key"
                                title="@declaration.JobKey"
                                aria-label="@L["Catalog:Actions:CopyKeyFor", declaration.JobKey]"
                                @onclick="@(() => CopyJobKeyAsync(declaration.JobKey))">@declaration.JobKey</button>
                    </div>
                </MudTd>
                <MudTd Class="catalog-table__plan-cell" DataLabel="@L["Catalog:Columns:Schedule"]">
                    <div class="catalog-table__plan">
                        <MudTooltip Text="@GetLifecycleDescription(context)" Placement="Placement.Top" Arrow="true">
                            <span class="catalog-table__lifecycle" data-tone="@GetLifecycleColor(context).ToString().ToLowerInvariant()">
                                <MudIcon Icon="@GetLifecycleIcon(context)" Size="Size.Small" />
                                @GetLifecycleLabel(context)
                            </span>
                        </MudTooltip>
                        @if (IsRecurring(context))
                        {
                            <div class="catalog-table__cron">
                                <CronDescriptionBadge Expression="@effective.Schedule!.CronExpression" Description="@GetCronDescription(context)" />
                            </div>
                            <div class="catalog-table__next">
                                <span>@L["Catalog:Columns:NextRun"]</span>
                                @if (context.RecurringScheduleStatus == JobRecurringScheduleStatus.Scheduled && context.NextOccurrenceUtc is { } nextOccurrenceUtc)
                                {
                                    <MudTooltip Text="@GetNextRunTooltip(nextOccurrenceUtc)" Placement="Placement.Top" Arrow="true">
                                        <time datetime="@nextOccurrenceUtc.ToString("O")">@TimePresentation.FormatTimestamp(nextOccurrenceUtc)</time>
                                    </MudTooltip>
                                }
                                else
                                {
                                    <span class="catalog-table__next-status">@GetNextRunStatusLabel(context)</span>
                                }
                            </div>
                        }
                        else
                        {
                            <span class="catalog-table__on-demand">@L["Catalog:OnDemand"]</span>
                            <code class="catalog-table__arguments">@(declaration.JobArgsKey ?? L["Catalog:Triggered:NoArguments"])</code>
                        }
                    </div>
                </MudTd>
                <MudTd Class="catalog-table__evidence-cell" DataLabel="@L["Catalog:Columns:LastRun"]">
                    @if (context.LatestExecution is { } latest)
                    {
                        <button type="button"
                                class="catalog-table__latest"
                                title="@latest.InstanceId"
                                aria-label="@L["Executions:Actions:OpenDetailsFor", effective.JobName, latest.InstanceId]"
                                @onclick="@(() => OpenLatestExecutionAsync(latest.InstanceId))">
                            <span class="catalog-table__latest-state" data-state="@latest.State.ToString().ToLowerInvariant()">
                                <MudIcon Icon="@GetStateIcon(latest.State)" Size="Size.Small" />
                                @L[$"ExecutionStates:{latest.State}"]
                            </span>
                            <time datetime="@latest.CreatedAtUtc.ToString("O")">@TimePresentation.FormatTimestamp(latest.CreatedAtUtc)</time>
                            <span class="catalog-table__execution-id">@latest.InstanceId</span>
                            <span class="catalog-table__duration">@TimePresentation.FormatExecutionDuration(latest, TimeProvider.GetUtcNow())</span>
                        </button>
                    }
                    else
                    {
                        <span class="catalog-table__never-run">@L["Catalog:History:NeverRun"]</span>
                    }
                </MudTd>
                <MudTd Class="catalog-table__actions-cell" DataLabel="@L["Catalog:Columns:Actions"]">
                    <div class="catalog-table__actions">
                        @if (IsRecurring(context))
                        {
                            <MudTooltip Text="@GetToggleDisabledTooltip(context)">
                                <MudIconButton Icon="@(IsOperatorPaused(context) ? Icons.Material.Outlined.PlayCircleOutline : Icons.Material.Outlined.PauseCircleOutline)"
                                               Color="@(IsOperatorPaused(context) ? Color.Success : Color.Warning)"
                                               Size="Size.Small"
                                               Disabled="@IsMutating"
                                               OnClick="@(() => DisabledStateToggled.InvokeAsync(context))"
                                               aria-label="@L["Catalog:Actions:PolicyFor", GetToggleDisabledLabel(context), effective.JobName, definition.OwnerKey]" />
                            </MudTooltip>
                        }
                        <MudTooltip Text="@L["Catalog:Actions:Run"]">
                            <MudIconButton Icon="@Icons.Material.Outlined.PlayArrow"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           Disabled="@(IsMutating || !definition.IsPresent || (!IsRecurring(context) && definition.IsDisabled))"
                                           OnClick="@(() => RunRequested.InvokeAsync(context))"
                                           aria-label="@L["Catalog:Actions:RunFor", effective.JobName, definition.OwnerKey]" />
                        </MudTooltip>
                        <MudTooltip Text="@L["Catalog:Actions:Details"]">
                            <MudIconButton Icon="@Icons.Material.Outlined.ArrowOutward"
                                           Href="@GetDetailHref(context)"
                                           Size="Size.Small"
                                           aria-label="@L["Catalog:Actions:DetailsFor", effective.JobName, definition.OwnerKey]" />
                        </MudTooltip>
                    </div>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <div class="catalog-table__empty">
                    <MudIcon Icon="@Icons.Material.Outlined.Inventory2" Size="Size.Large" />
                    <p>@(IsQueryFailed ? L["Catalog:QueryUnavailable"] : EmptyText ?? L["Catalog:Empty"])</p>
                </div>
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager PageSizeOptions="@PageSizeOptions"
                               RowsPerPageString="@L["Catalog:Filters:PageSize"]"
                               InfoFormat="@L["Catalog:Pagination:Range"]" />
            </PagerContent>
        </MudTable>
    </div>
</section>
