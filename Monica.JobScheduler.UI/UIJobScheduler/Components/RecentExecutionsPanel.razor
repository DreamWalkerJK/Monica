@using Monica.JobScheduler.UI.Localization
@using Monica.JobScheduler.UI.Pages
@using Monica.JobScheduler.UI.UIJobScheduler.Executions.Support
@using Monica.JobScheduler.UI.UIJobScheduler.Executions.State

@inject IStringLocalizer<JobSchedulerResource> L
@inject TimeProvider TimeProvider
@inject SchedulerTimePresentation TimePresentation
@inject IDialogService DialogService

@implements IAsyncDisposable

@{ var observedAtUtc = TimeProvider.GetUtcNow(); }

<section class="recent-panel" aria-labelledby="recent-panel-title" aria-busy="@IsRefreshing.ToString().ToLowerInvariant()">
    <header class="recent-panel__heading">
        <div>
            <MudText id="recent-panel-title" Typo="Typo.h6" HtmlTag="h2">@L["Overview:Recent:Title"]</MudText>
            <p>@L["Overview:Recent:Description"]</p>
        </div>
        <MudButton Href="@JobExecutionsPage.PAGE_URL" Variant="Variant.Text"
                   EndIcon="@MoIcons.ArrowRight">
            @L["Overview:Recent:AllRecords"]
        </MudButton>
    </header>

    @if (Executions.Count == 0)
    {
        <div class="recent-panel__empty">
            <MoIcon Icon="@MoIcons.Inbox" Size="2.25rem" />
            <p>@L["Overview:Recent:Empty"]</p>
        </div>
    }
    else
    {
        <ol class="recent-panel__timeline">
            @foreach (var execution in Executions)
            {
                var jobTitle = JobSchedulerUiPresentation.GetJobDisplayName(execution.Template);
                <li @key="execution.InstanceId" class="recent-panel__event" data-state="@execution.State.ToString().ToLowerInvariant()">
                    <MudButton Variant="Variant.Text" Class="recent-panel__open"
                               aria-label="@L["Executions:Actions:OpenDetailsFor", jobTitle, execution.InstanceId]"
                               OnClick="@(() => _dialogs.OpenAsync(execution.InstanceId))">
                      <span class="recent-panel__record">
                        <span class="recent-panel__marker" aria-hidden="true">
                            <MoIcon Icon="@ExecutionUiPresentation.GetStateIcon(execution.State)" Size="1.25rem" />
                        </span>
                        <span class="recent-panel__event-copy">
                            <span class="recent-panel__event-heading">
                                <strong title="@jobTitle">@jobTitle</strong>
                                <span class="recent-panel__state">@L[$"ExecutionStates:{execution.State}"]</span>
                            </span>
                            <span class="recent-panel__definition">
                                <code>@execution.Template.OwnerKey</code>
                                <code>@execution.Template.JobKey</code>
                            </span>
                            <code class="recent-panel__instance">@execution.InstanceId</code>
                        </span>
                        <span class="recent-panel__event-time">
                            <time datetime="@execution.CreatedAtUtc.ToString("O")">
                                @TimePresentation.FormatTimestamp(execution.CreatedAtUtc)
                            </time>
                            <small>@TimePresentation.FormatExecutionDuration(execution, observedAtUtc)</small>
                        </span>
                        <MoIcon Icon="@MoIcons.ChevronRight"
                                 Size="1.25rem"
                                 Class="recent-panel__chevron" />
                      </span>
                    </MudButton>
                </li>
            }
        </ol>
    }
</section>

@code {
    /// <summary>
    /// Gets the bounded newest-first execution summaries.
    /// </summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<JobExecutionInstance> Executions { get; set; } = [];

    /// <summary>
    /// Gets whether the owning overview is refreshing. Inspectors stay enabled for native focus restoration.
    /// </summary>
    [Parameter]
    public bool IsRefreshing { get; set; }

    /// <summary>
    /// Gets the refresh callback.
    /// </summary>
    [Parameter]
    public EventCallback OnRefresh { get; set; }

    private ExecutionDialogSession _dialogs = null!;

    protected override void OnInitialized() => _dialogs = new ExecutionDialogSession(
        instanceId => ExecutionDetailDialogLauncher.OpenAsync(DialogService, L, instanceId),
        () => OnRefresh.InvokeAsync());

    public ValueTask DisposeAsync() => _dialogs.DisposeAsync();
}
