@using Monica.JobScheduler.UI.Localization
@using Monica.UI.Shared.Components.Navigation

@inject IStringLocalizer<JobSchedulerResource> L
@inject SchedulerTimePresentation TimePresentation
@inject IOptions<ModuleJobSchedulerOption> SchedulerOptions

<div class="scheduler-workspace mo-page-shell mo-page-shell--full-width">
    <header class="scheduler-workspace__header">
        <div class="scheduler-workspace__heading">
            <MudText Typo="Typo.overline" Class="scheduler-workspace__eyebrow">@L["Workspace:Eyebrow"]</MudText>
            <MudText Typo="Typo.h4" HtmlTag="h1" Class="scheduler-workspace__title">@Title</MudText>
            <MudText Typo="Typo.body1" Class="scheduler-workspace__description">@Description</MudText>
        </div>
        <div class="scheduler-workspace__metadata">
            <div class="scheduler-workspace__context">
                <MudIcon Icon="@Icons.Material.Outlined.Layers" aria-hidden="true" />
                <span title="@SchedulerOptions.Value.SchedulerScopeKey">
                    @L["Workspace:Scope", SchedulerOptions.Value.SchedulerScopeKey]
                </span>
            </div>
            <div class="scheduler-workspace__context">
                <MudIcon Icon="@Icons.Material.Outlined.Schedule" aria-hidden="true" />
                <span title="@TimePresentation.TimeZoneDisplayName">
                    @L["Workspace:TimeZone", TimePresentation.TimeZoneId]
                </span>
            </div>
        </div>
    </header>

    <MoWorkbenchNavigation Label="@L["Workspace:Navigation:AriaLabel"]">
        @foreach (var route in ROUTES)
        {
            <a href="@route.Url" aria-current="@(IsCurrentRoute(route.Url) ? "page" : null)">
                <MudIcon Icon="@route.Icon" aria-hidden="true" />
                <span>@L[route.LabelKey]</span>
            </a>
        }
    </MoWorkbenchNavigation>

    <div class="scheduler-workspace__content">
        @ChildContent
    </div>
</div>

@code {
    private static readonly (string Url, string LabelKey, string Icon)[] ROUTES =
    [
        ("/job-scheduler", "Workspace:Navigation:Overview", Icons.Material.Outlined.SpaceDashboard),
        ("/job-scheduler/catalog", "Workspace:Navigation:Catalog", Icons.Material.Outlined.Inventory2),
        ("/job-scheduler/executions", "Workspace:Navigation:Executions", Icons.Material.Outlined.ReceiptLong),
        ("/job-scheduler/statistics", "Workspace:Navigation:Statistics", Icons.Material.Outlined.QueryStats),
        ("/job-scheduler/runtime", "Workspace:Navigation:Runtime", Icons.Material.Outlined.MonitorHeart)
    ];

    /// <summary>
    /// Gets or sets the route-specific workspace heading.
    /// </summary>
    [Parameter, EditorRequired]
    public string Title { get; set; } = string.Empty;

    /// <summary>
    /// Gets or sets the route-specific operational description.
    /// </summary>
    [Parameter, EditorRequired]
    public string Description { get; set; } = string.Empty;

    /// <summary>
    /// Gets or sets the legacy section hint supplied by existing callers.
    /// </summary>
    /// <remarks>The exact current URL path determines the active route link.</remarks>
    [Parameter]
    public int ActivePanelIndex { get; set; }

    /// <summary>
    /// Gets or sets the route body.
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Inject]
    private NavigationManager Navigation { get; set; } = null!;

    private bool IsCurrentRoute(string route) => string.Equals(
        Navigation.ToAbsoluteUri(Navigation.Uri).AbsolutePath.TrimEnd('/'),
        route,
        StringComparison.OrdinalIgnoreCase);
}
