@using Monica.DevOps.Localization
@using Monica.DevOps.K8S.Models
@using Monica.UI.Shared.Components.Dialogs
@implements IAsyncDisposable
@inject IStringLocalizer<K8SResource> L

<MudDialog DefaultFocus="DefaultFocus.LastChild">
    <TitleContent><MoDialogHeading @ref="_heading" Text="@L["RestartDialog:Title", Preview.ScopeName, Preview.Namespace]" /></TitleContent>
    <DialogContent>
        <div class="operation-review">
            <MudStack Spacing="3">
                <MudAlert Severity="@(Preview.HasRestartableTargets ? Severity.Warning : Severity.Info)" Variant="Variant.Outlined">
                    @(Preview.HasRestartableTargets ? L["RestartDialog:SummaryWithWorkloads", Preview.Workloads.Count, Preview.EligibleTargets.Count] : L["RestartDialog:SummaryWithoutWorkloads"])
                </MudAlert>
                <MudText Typo="Typo.body2">@L["OperationReview:TargetCounts", Preview.RequestedTargets.Count, Preview.EligibleTargets.Count, Preview.IgnoredTargets.Count]</MudText>
                @if (Preview.ResourceType is null || Preview.ResourceType == K8SResourceType.Service)
                {
                    <MudText Typo="Typo.body2">@L["RestartDialog:ServiceExplanation"]</MudText>
                }
                @if (Preview.RestrictionKeywords.Count > 0)
                {
                    <MudText Typo="Typo.body2">@L["OperationReview:AllowedKeywords", string.Join(", ", Preview.RestrictionKeywords)]</MudText>
                }
                <section class="workloads">
                    <MudText Typo="Typo.subtitle1">@L["RestartDialog:WorkloadsToRestart"]</MudText>
                    @if (Preview.Workloads.Count == 0)
                    {
                        <MudText Typo="Typo.body2">@L["RestartDialog:NoWorkloads"]</MudText>
                    }
                    else
                    {
                        <MudTable T="K8SWorkloadReference" Items="Preview.Workloads" Dense="true" Breakpoint="Breakpoint.Sm">
                            <HeaderContent><MudTh>@L["DescribeDialog:Workload"]</MudTh><MudTh>@L["DescribeDialog:ReadyDesired"]</MudTh><MudTh>@L["DescribeDialog:LastRestart"]</MudTh></HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="@L["DescribeDialog:Workload"]">@GetDisplayName(context.Kind, context.Name)</MudTd>
                                <MudTd DataLabel="@L["DescribeDialog:ReadyDesired"]">@context.ReplicaStatus</MudTd>
                                <MudTd DataLabel="@L["DescribeDialog:LastRestart"]">@context.LastRestartedAtDisplay</MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </section>
                <MudExpansionPanels Elevation="0" MultiExpansion="true">
                    <MudExpansionPanel Text="@L["OperationReview:RequestedTargets", Preview.RequestedTargets.Count]">
                        <div class="disclosure-body">
                            @if (Preview.RequestedTargets.Count == 0) { <MudText Typo="Typo.body2">@L["OperationReview:NoRequestedTargets"]</MudText> }
                            else { <ul class="target-list">@foreach (var target in Preview.RequestedTargets) { <li>@GetDisplayName(target.Kind, target.Name)</li> }</ul> }
                        </div>
                    </MudExpansionPanel>
                    <MudExpansionPanel Text="@L["OperationReview:EligibleTargets", Preview.EligibleTargets.Count]">
                        <div class="disclosure-body">
                            @if (Preview.EligibleTargets.Count == 0) { <MudText Typo="Typo.body2">@L["RestartDialog:NoEligibleTargets"]</MudText> }
                            else { <ul class="target-list">@foreach (var target in Preview.EligibleTargets) { <li>@GetDisplayName(target.Kind, target.Name)</li> }</ul> }
                        </div>
                    </MudExpansionPanel>
                    <MudExpansionPanel Text="@L["OperationReview:IgnoredTargets", Preview.IgnoredTargets.Count]" Expanded="@(!Preview.HasRestartableTargets && Preview.IgnoredTargets.Count > 0)">
                        <div class="disclosure-body">
                            @if (Preview.IgnoredTargets.Count == 0) { <MudText Typo="Typo.body2">@L["RestartDialog:NoIgnoredTargets"]</MudText> }
                            else { <ul class="target-list">@foreach (var target in Preview.IgnoredTargets) { <li><span>@GetDisplayName(target.Kind, target.Name)</span><p class="ignored-reason">@target.Reason</p></li> }</ul> }
                        </div>
                    </MudExpansionPanel>
                    <MudExpansionPanel Text="@L["OperationReview:CommandArguments"]">
                        <div class="disclosure-body"><MudText Typo="Typo.body2">@L["OperationReview:CommandArgumentsHelp"]</MudText><div class="command-output"><pre>@string.Join(Environment.NewLine, Preview.CommandPreview)</pre></div></div>
                    </MudExpansionPanel>
                </MudExpansionPanels>
                <MudText Typo="Typo.body2">@L["OperationReview:GeneratedAt", Preview.GeneratedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss zzz")]</MudText>
                <MudText Typo="Typo.body2">@L["OperationReview:ExecutionRechecks"]</MudText>
            </MudStack>
        </div>
    </DialogContent>
    <DialogActions>
        <div class="k8s-confirm-actions">
            @if (Preview.HasRestartableTargets)
            {
                <MudButton Class="k8s-confirm-action" OnClick="Confirm" Variant="Variant.Filled" Color="Color.Warning">@L["RestartDialog:ConfirmWorkloads", Preview.Workloads.Count]</MudButton>
            }
            <MudButton OnClick="Cancel" Variant="Variant.Text">@L["Common:Cancel"]</MudButton>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance? MudDialog { get; set; }
    /// <summary>Gets or sets the preview for the exact captured request. Execution re-plans under current configuration.</summary>
    [Parameter] public K8SRestartPreview Preview { get; set; } = new();
    /// <summary>Retained for source compatibility. The native confirmation label uses the preview's concrete workload count and does not display this value.</summary>
    [Parameter] public string ConfirmButtonText { get; set; } = string.Empty;
    private MoDialogHeading? _heading;
    private void Cancel() => MudDialog?.Cancel();
    private void Confirm() { if (Preview.HasRestartableTargets) MudDialog?.Close(DialogResult.Ok(true)); }
    /// <summary>Drains the owned accessible heading before returning the native result.</summary>
    public ValueTask DisposeAsync() => _heading?.DisposeAsync() ?? ValueTask.CompletedTask;
    private string GetDisplayName(string kind, string name) => $"{GetLocalizedKind(kind)}/{name}";
    private string GetLocalizedKind(string kind) => kind switch
    {
        "Service" => L["ResourceTypes:Service"].Value, "Deployment" => L["ResourceTypes:Deployment"].Value,
        "StatefulSet" => L["ResourceTypes:StatefulSet"].Value, "DaemonSet" => L["ResourceTypes:DaemonSet"].Value, _ => kind
    };
}
