@using Monica.DevOps.K8S.Components
@using Monica.DevOps.Localization
@attribute [Route(PAGE_URL)]
@attribute [Route(UIK8SRuntimeConfigPage.PAGE_URL)]
@inject IStringLocalizer<K8SResource> L
@inject NavigationManager Navigation

@if (ShellRouteContext?.PageType == typeof(UIK8SPage) && IsRuntimeConfigurationRoute(Navigation))
{
    <UIK8SRuntimeConfigPage NamespaceHint="@NamespaceHint" KindHint="@KindHint" SearchHint="@SearchHint" />
}
else
{
    <PageTitle>@L["Pages:K8S:Title"]</PageTitle>
    <K8SInventoryWorkbench NamespaceHint="@NamespaceHint" KindHint="@KindHint" SearchHint="@SearchHint" />
}

@code {
    /// <summary>The existing K8S inventory entry route.</summary>
    public const string PAGE_URL = "/ui/k8s";
    /// <summary>The nonsecret namespace preference, revalidated against discovery.</summary>
    [SupplyParameterFromQuery(Name = "ns")] public string? NamespaceHint { get; set; }
    /// <summary>The nonsecret resource-kind preference.</summary>
    [SupplyParameterFromQuery(Name = "kind")] public string? KindHint { get; set; }
    /// <summary>The local inventory search preference.</summary>
    [SupplyParameterFromQuery(Name = "q")] public string? SearchHint { get; set; }
    /// <summary>
    /// The shell's authorized route context. Changes notify this shared page when its exact route aliases
    /// switch without changing route parameters or query hints.
    /// </summary>
    [CascadingParameter] public RouteData? ShellRouteContext { get; set; }

    internal static bool IsRuntimeConfigurationRoute(NavigationManager navigation)
    {
        var relativePath = navigation.ToBaseRelativePath(navigation.Uri);
        var suffixIndex = relativePath.IndexOfAny(['?', '#']);
        if (suffixIndex >= 0)
        {
            relativePath = relativePath[..suffixIndex];
        }

        return string.Equals(
            relativePath.Trim('/'),
            UIK8SRuntimeConfigPage.PAGE_URL.Trim('/'),
            StringComparison.OrdinalIgnoreCase);
    }
}
