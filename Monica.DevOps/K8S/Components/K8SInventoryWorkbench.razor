@inject Monica.UI.Shared.Services.MoTimeFormatter UiTime
@using Monica.DevOps.K8S.Dialogs
@using Monica.DevOps.K8S.Facades
@using Monica.DevOps.K8S.Models
@using Monica.DevOps.K8S.State
@using Monica.DevOps.K8S.Support
@using Monica.DevOps.Localization
@using Monica.UI.Shell.Support
@implements IAsyncDisposable
@inject K8SFacade Facade
@inject K8SNavigationState NavigationContext
@inject IBrowserStorage Storage
@inject IDialogService DialogService
@inject IStringLocalizer<K8SResource> L

<div class="k8s-workbench">
    <K8SFamilyHeader>
        <Actions><MudButton Variant="Variant.Outlined" StartIcon="@MoIcons.Refresh" Disabled="@Visit.IsBusy" OnClick="Visit.RefreshAllAsync">@L["Workbench:Inventory:RefreshAll"]</MudButton></Actions>
    </K8SFamilyHeader>
    <section class="k8s-inventory">
        <div class="k8s-scope">
            <div class="k8s-scope-identity">
                <MoIcon Icon="@MoIcons.Server" Size="1.5rem" />
                <div class="k8s-namespace-field">
                    <MudSelect T="string" Label="@L["Forms:Namespace"]" Value="@Visit.Namespace" ValueChanged="ChangeNamespaceAsync" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@Visit.IsBusy" OpenIcon="@MoIcons.ChevronDown" CloseIcon="@MoIcons.ChevronUp">
                        @if (!string.IsNullOrEmpty(Visit.Namespace) && Visit.Namespaces?.Any(x => x.Name == Visit.Namespace) != true)
                        { <MudSelectItem T="string" Value="@Visit.Namespace"><span class="k8s-select-option-label">@Visit.Namespace</span></MudSelectItem> }
                        @foreach (var item in Visit.Namespaces ?? [])
                        { <MudSelectItem T="string" Value="@item.Name"><span class="k8s-select-option-label">@(item.Exists ? item.Name : L["Forms:NamespaceMissingDisplay", item.Name].Value)</span></MudSelectItem> }
                    </MudSelect>
                    <div class="k8s-execution-context">@L["Workbench:Inventory:ExecutionNode"]: <span>@(Visit.ExecutionNode is { Length: > 0 } node ? node : L["Workbench:Inventory:NotConfigured"].Value)</span></div>
                </div>
            </div>
            <div class="k8s-namespace-actions">
                <MudMenu Label="@L["Workbench:Inventory:NamespaceOperations"]" Variant="Variant.Outlined" Disabled="@IsOperationLaunchDisabled(OperationLaunchKind.NamespaceMenu)" EndIcon="@MoIcons.ChevronDown">
                    <MudMenuItem Icon="@MoIcons.Restart" Disabled="@Visit.IsBusy" OnClick="@(() => OperateAsync(K8SInventoryOperation.Restart, K8SOperationScope.Namespace, OperationLaunchKind.NamespaceMenu))">@L["Workbench:Inventory:NamespaceRestart"]</MudMenuItem>
                    <MudMenuItem Icon="@MoIcons.ChevronDown" Disabled="@Visit.IsBusy" OnClick="@(() => OperateAsync(K8SInventoryOperation.ScaleDown, K8SOperationScope.Namespace, OperationLaunchKind.NamespaceMenu))">@L["Workbench:Inventory:NamespaceDown"]</MudMenuItem>
                    <MudMenuItem Icon="@MoIcons.ChevronUp" Disabled="@Visit.IsBusy" OnClick="@(() => OperateAsync(K8SInventoryOperation.ScaleUp, K8SOperationScope.Namespace, OperationLaunchKind.NamespaceMenu))">@L["Workbench:Inventory:NamespaceUp"]</MudMenuItem>
                </MudMenu>
                <p>@L["Workbench:Inventory:Scope"]</p>
            </div>
        </div>
        @if (Visit.LatestOperation is { } outcome)
        { <K8SOperationEvidence Restart="@outcome.Restart" Scale="@outcome.Scale" Failure="@outcome.Failure" Namespace="@outcome.Namespace" Scope="@GetOutcomeScope(outcome)" CompletedAt="@outcome.CompletedAtUtc" /> }
        <div class="k8s-inventory-tools">
            <div class="k8s-kind-buttons" role="group" aria-label="@L["Workbench:Inventory:Kind"]">
                @foreach (var kind in Kinds)
                { <MudButton Variant="@(Visit.ResourceType == kind ? Variant.Filled : Variant.Text)" Color="@(Visit.ResourceType == kind ? Color.Primary : Color.Default)" aria-pressed="@(Visit.ResourceType == kind ? "true" : "false")" Disabled="@Visit.IsBusy" OnClick="@(() => ChangeKindAsync(kind))">@KindLabel(kind)</MudButton> }
            </div>
            <div class="k8s-kind-select"><MudSelect T="K8SResourceType" Label="@L["Workbench:Inventory:Kind"]" Value="@Visit.ResourceType" ValueChanged="ChangeKindAsync" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@Visit.IsBusy" OpenIcon="@MoIcons.ChevronDown" CloseIcon="@MoIcons.ChevronUp">@foreach (var kind in Kinds) { <MudSelectItem T="K8SResourceType" Value="@kind"><span class="k8s-select-option-label">@KindLabel(kind)</span></MudSelectItem> }</MudSelect></div>
            <MudButton Variant="Variant.Text" StartIcon="@MoIcons.Refresh" Disabled="@(Visit.IsBusy || !Visit.NamespaceExists)" OnClick="Visit.RefreshListAsync">@L["Workbench:Inventory:RefreshList"]</MudButton>
            <div class="k8s-search"><MudTextField T="string" Label="@L["Forms:SearchCurrentList"]" Value="@Visit.Search" ValueChanged="SearchAsync" Immediate="true" Clearable="true" Adornment="Adornment.Start" AdornmentIcon="@MoIcons.Search" Variant="Variant.Outlined" Margin="Margin.Dense" ClearIcon="@MoIcons.Close" /></div>
        </div>
        @if (Visit.IsBusy && Visit.Activity != K8SInventoryActivity.None)
        { <div class="k8s-read-status" role="status"><MudProgressLinear Indeterminate="true" Color="Color.Primary" /><span>@ActivityLabel()</span> <span>@Visit.ActivityIdentity</span></div> }
        @if (Visit.ContextFailure is { } failure) { <div class="k8s-read-status"><MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Icon="@MoIcons.Error">@L["Workbench:Inventory:ReadFailure", Visit.Namespace, KindLabel(Visit.ResourceType), failure] @if (Visit.Capture is null) { <p>@L["Workbench:Inventory:FirstReadFailed"]</p> }</MudAlert></div> }
        @if (Visit.ReadFailure is { } readFailure) { <div class="k8s-read-status"><MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Icon="@MoIcons.Error">@L["Workbench:Inventory:ReadFailure", readFailure.Namespace, KindLabel(readFailure.ResourceType), readFailure.Message]</MudAlert></div> }
        @if (!string.IsNullOrEmpty(Visit.Namespace) && Visit.Namespaces is not null && !Visit.NamespaceExists) { <div class="k8s-read-status"><MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Icon="@MoIcons.Warning">@L["Workbench:Inventory:MissingNamespace", Visit.Namespace]</MudAlert></div> }
        @if (Visit.Capture is { } capture)
        {
            @if (!Visit.ContextMatchesCapture) { <div class="k8s-read-status"><MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Icon="@MoIcons.Warning">@L["Workbench:Inventory:Retained", Visit.Namespace, KindLabel(Visit.ResourceType)]</MudAlert></div> }
            @if (capture.Items.Count == 0)
            { <div class="k8s-empty"><p>@CaptureLabel(capture)</p><p>@L["Workbench:Inventory:Empty", KindLabel(capture.ResourceType)]</p></div> }
            else
            {
                <MudDataGrid @key="capture.ResourceType" @ref="_grid" T="K8SResourceSummary" Items="capture.Items" QuickFilter="MatchesSearch" SortMode="SortMode.Multiple" Filterable="true" Dense="true" Hover="true" MultiSelection="true" SelectOnRowClick="@(!Visit.IsBusy && Visit.ContextMatchesCapture)" RowsPerPage="20" Comparer="@K8SResourceIdentity.Comparer" SelectedItems="@Visit.SelectedRows" SelectedItemsChanged="SelectRows" FixedHeader="true" Height="auto" Breakpoint="Breakpoint.Xs" Class="k8s-resource-grid" SortIcon="@MoIcons.ArrowUp" DragIndicatorIcon="@MoIcons.GripVertical" FilterIconEmpty="@MoIcons.Filter" FilterIconFilled="@MoIcons.Filter" FilterIconClear="@MoIcons.FilterOff" ColumnOptionsIcon="@MoIcons.MoreVertical">
                    <ToolBarContent>
                        <div class="k8s-list-metadata"><p>@CaptureLabel(capture)</p><span>@L["Workbench:Inventory:TimeExplanation"]</span></div>
                        @if (Visit.SelectedCount > 0)
                        {
                            <div class="k8s-selection">
                                <MudMenu Label="@L["Workbench:Selection:Count", Visit.SelectedCount]" Variant="Variant.Text" MaxHeight="280">
                                    @foreach (var row in Visit.SelectedRows.OrderBy(x => x.Name)) { <MudMenuItem>@row.Name</MudMenuItem> }
                                </MudMenu>
                                <MudButton Variant="Variant.Text" Disabled="@Visit.IsBusy" OnClick="ClearSelection">@L["Workbench:Selection:Clear"]</MudButton>
                                <span class="k8s-selection-spacer"></span>
                                <div class="k8s-selected-wide">
                                    <MudButton Color="Color.Warning" Variant="Variant.Outlined" Disabled="@IsOperationLaunchDisabled(OperationLaunchKind.SelectedRestartButton)" aria-disabled="@(Visit.IsBusy && IsOperationLaunchOrigin(OperationLaunchKind.SelectedRestartButton) ? "true" : null)" OnClick="@(() => OperateAsync(K8SInventoryOperation.Restart, K8SOperationScope.Selected, OperationLaunchKind.SelectedRestartButton))">@L["Workbench:Selection:Restart"]</MudButton>
                                    <MudMenu Label="@L["Workbench:Selection:ReplicaActions"]" Disabled="@IsOperationLaunchDisabled(OperationLaunchKind.SelectedReplicaMenu)" EndIcon="@MoIcons.ChevronDown">
                                        <MudMenuItem Disabled="@Visit.IsBusy" OnClick="@(() => OperateAsync(K8SInventoryOperation.ScaleDown, K8SOperationScope.Selected, OperationLaunchKind.SelectedReplicaMenu))">@L["Workbench:Selection:Down"]</MudMenuItem>
                                        <MudMenuItem Disabled="@Visit.IsBusy" OnClick="@(() => OperateAsync(K8SInventoryOperation.ScaleUp, K8SOperationScope.Selected, OperationLaunchKind.SelectedReplicaMenu))">@L["Workbench:Selection:Up"]</MudMenuItem>
                                    </MudMenu>
                                </div>
                                <div class="k8s-selected-compact"><MudMenu Label="@L["Workbench:Selection:Actions"]" Disabled="@IsOperationLaunchDisabled(OperationLaunchKind.CompactSelectedMenu)" EndIcon="@MoIcons.ChevronDown">
                                    <MudMenuItem Disabled="@Visit.IsBusy" OnClick="@(() => OperateAsync(K8SInventoryOperation.Restart, K8SOperationScope.Selected, OperationLaunchKind.CompactSelectedMenu))">@L["Workbench:Selection:Restart"]</MudMenuItem>
                                    <MudMenuItem Disabled="@Visit.IsBusy" OnClick="@(() => OperateAsync(K8SInventoryOperation.ScaleDown, K8SOperationScope.Selected, OperationLaunchKind.CompactSelectedMenu))">@L["Workbench:Selection:Down"]</MudMenuItem>
                                    <MudMenuItem Disabled="@Visit.IsBusy" OnClick="@(() => OperateAsync(K8SInventoryOperation.ScaleUp, K8SOperationScope.Selected, OperationLaunchKind.CompactSelectedMenu))">@L["Workbench:Selection:Up"]</MudMenuItem>
                                </MudMenu></div>
                                @if (Visit.HiddenSelectionCount(_grid?.FilteredItems ?? capture.Items) is > 0 and var hidden) { <p class="k8s-hidden-selection">@L["Workbench:Selection:Hidden", hidden]</p> }
                            </div>
                        }
                    </ToolBarContent>
                    <Columns>
                        <SelectColumn T="K8SResourceSummary" DisabledFunc="@(_ => Visit.IsBusy || !Visit.ContextMatchesCapture)" ShowInHeader="@(!Visit.IsBusy && Visit.ContextMatchesCapture)" />
                        <PropertyColumn Property="x => x.Name" Title="@L["Columns:Name"]" CellClass="k8s-resource-name" />
                        @if (capture.ResourceType == K8SResourceType.Service)
                        {
                            <PropertyColumn Property="x => x.Type" Title="@L["Columns:ServiceType"]" />
                            <PropertyColumn Property="x => x.ClusterIp" Title="@L["Columns:ClusterIp"]" />
                            <PropertyColumn Property="x => x.PortsDisplay" Title="@L["Columns:Ports"]" />
                            <PropertyColumn Property="x => x.SelectorDisplay" Title="@L["Columns:Selector"]" />
                            <PropertyColumn Property="x => x.LastRestartedAtUtc" Title="@L["Workbench:Inventory:BackingTime"]">
                                <CellTemplate>@UiTime.Format(context.Item.LastRestartedAtUtc)</CellTemplate>
                            </PropertyColumn>
                        }
                        else
                        {
                            <PropertyColumn Property="x => x.ImagesDisplay" Title="@L["Columns:Images"]" />
                            <PropertyColumn Property="x => x.SelectorDisplay" Title="@L["Columns:Selector"]" />
                            <PropertyColumn Property="x => x.ReplicaStatus" Title="@L["Columns:Replicas"]" />
                            <PropertyColumn Property="x => x.LastRestartedAtUtc" Title="@L["Workbench:Inventory:WorkloadTime"]">
                                <CellTemplate>@UiTime.Format(context.Item.LastRestartedAtUtc)</CellTemplate>
                            </PropertyColumn>
                        }
                        <TemplateColumn Title="@L["Columns:Actions"]" Sortable="false" Filterable="false">
                            <CellTemplate><div class="k8s-row-actions" @onclick:stopPropagation="true">
                                <MudButton Variant="Variant.Text" Size="Size.Small" Disabled="@(_retired || Visit.IsRetired || Visit.IsBusy && !IsInspectionOrigin(context.Item))" aria-disabled="@(Visit.IsBusy && IsInspectionOrigin(context.Item) ? "true" : null)" OnClick="@(() => InspectAsync(context.Item))">@L["Actions:Describe"]</MudButton>
                                <MudMenu Icon="@MoIcons.MoreHorizontal" aria-label="@L["Workbench:Selection:RowActions", context.Item.Name]" Disabled="@IsOperationLaunchDisabled(OperationLaunchKind.RowMenu, context.Item)">
                                    <MudMenuItem Icon="@MoIcons.Restart" Disabled="@Visit.IsBusy" OnClick="@(() => OperateAsync(K8SInventoryOperation.Restart, K8SOperationScope.Single, OperationLaunchKind.RowMenu, context.Item))">@L[context.Item.ResourceType == K8SResourceType.Service ? "Actions:RestartBackingWorkloads" : "Actions:Restart"]</MudMenuItem>
                                </MudMenu>
                            </div></CellTemplate>
                        </TemplateColumn>
                    </Columns>
                    <NoRecordsContent><div class="k8s-empty">@L["Workbench:Inventory:NoMatches"]</div></NoRecordsContent>
                    <PagerContent><div class="k8s-pager">
                        <MudDataGridPager T="K8SResourceSummary" PageSizeOptions="PageSizes" RowsPerPageString="@L["Workbench:Pager:Rows"]" InfoFormat="@L["Workbench:Pager:Info"]" ShowNavigation="false" />
                        <div class="k8s-pager-buttons">
                            <MudIconButton Icon="@MoIcons.FirstPage" aria-label="@L["Workbench:Pager:First"]" Disabled="@(_grid?.CurrentPage is null or 0)" OnClick="@(() => _grid?.NavigateTo(Page.First))" />
                            <MudIconButton Icon="@MoIcons.ChevronLeft" aria-label="@L["Workbench:Pager:Previous"]" Disabled="@(_grid?.CurrentPage is null or 0)" OnClick="@(() => _grid?.NavigateTo(Page.Previous))" />
                            <MudIconButton Icon="@MoIcons.ChevronRight" aria-label="@L["Workbench:Pager:Next"]" Disabled="@LastPage" OnClick="@(() => _grid?.NavigateTo(Page.Next))" />
                            <MudIconButton Icon="@MoIcons.LastPage" aria-label="@L["Workbench:Pager:Last"]" Disabled="@LastPage" OnClick="@(() => _grid?.NavigateTo(Page.Last))" />
                        </div>
                    </div></PagerContent>
                </MudDataGrid>
            }
        }
        else if (!Visit.IsBusy && Visit.ContextFailure is null && Visit.ReadFailure is null)
        { <div class="k8s-empty">@L[Visit.Namespaces?.Count == 0 ? "Workbench:Inventory:NoNamespaces" : "Page:SelectNamespace"]</div> }
    </section>
</div>

@code {
    /// <summary>The portable requested namespace, revalidated against current discovery.</summary>
    [Parameter] public string? NamespaceHint { get; set; }
    /// <summary>The portable resource-kind preference.</summary>
    [Parameter] public string? KindHint { get; set; }
    /// <summary>The local search preference.</summary>
    [Parameter] public string? SearchHint { get; set; }
    private static readonly K8SResourceType[] Kinds = [K8SResourceType.Service, K8SResourceType.Deployment, K8SResourceType.StatefulSet, K8SResourceType.DaemonSet];
    private static readonly int[] PageSizes = [10, 20, 50, 100];
    private K8SInventoryVisitController Visit = null!;
    private K8SDialogOwner _dialogs = null!;
    private MudDataGrid<K8SResourceSummary>? _grid;
    private Task _initialization = Task.CompletedTask;
    private Task _browserWork = Task.CompletedTask;
    private Task _parameterWork = Task.CompletedTask;
    private Task _inspectionWork = Task.CompletedTask;
    private Task _operationWork = Task.CompletedTask;
    private K8SResourceIdentity? _inspectionOrigin;
    private OperationLaunchOrigin? _operationOrigin;

    private enum OperationLaunchKind
    {
        SelectedRestartButton,
        SelectedReplicaMenu,
        CompactSelectedMenu,
        NamespaceMenu,
        RowMenu
    }

    private readonly record struct OperationLaunchOrigin(OperationLaunchKind Kind, K8SResourceIdentity? Row = null);
    private bool _retired;
    private bool _browserReady;
    private Task? _retirement;
    private (string?, string?, string?) _hints;
    private bool LastPage => _grid is null || (_grid.CurrentPage + 1) * _grid.RowsPerPage >= _grid.GetFilteredItemsCount();

    protected override Task OnInitializedAsync()
    {
        ApplyHints();
        _hints = (NamespaceHint, KindHint, SearchHint);
        Visit = new(Facade, NavigationContext, PublishAsync);
        _dialogs = new(DialogService, action => InvokeAsync(action));
        return _initialization = Visit.InitializeAsync();
    }

    protected override Task OnParametersSetAsync()
    {
        var hints = (NamespaceHint, KindHint, SearchHint);
        if (hints == _hints || _retired) return Task.CompletedTask;
        _hints = hints;
        var previous = _parameterWork;
        return _parameterWork = SynchronizeAsync();

        async Task SynchronizeAsync()
        {
            await Task.WhenAll(_initialization, previous);
            await Visit.WhenIdleAsync();
            if (_retired || hints != _hints) return;
            ApplyHints();
            Visit.SetSearch(NavigationContext.Search);
            await Visit.ChangeContextAsync(NavigationContext.Namespace, NavigationContext.ResourceType);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _retired) return;
        await _initialization;
        if (_retired) return;
        await (_browserWork = Visit.RestoreBrowserAsync(Storage));
        if (!_retired) _browserReady = true;
    }

    private void ApplyHints()
    {
        if (NamespaceHint is null && KindHint is null && SearchHint is null) return;
        NavigationContext.Namespace = NamespaceHint ?? NavigationContext.Namespace;
        if (K8SResourceTypeExtensions.TryParse(KindHint, out var kind) && Enum.IsDefined(kind)) NavigationContext.ResourceType = kind;
        NavigationContext.Search = SearchHint ?? NavigationContext.Search;
        NavigationContext.HasContext = true;
    }

    private Task PublishAsync() => _retired ? Task.CompletedTask : InvokeAsync(() => { if (!_retired) StateHasChanged(); });
    private async Task ChangeNamespaceAsync(string value) { await Visit.ChangeContextAsync(value, Visit.ResourceType); await PersistAsync(); }
    private async Task ChangeKindAsync(K8SResourceType value) { await Visit.ChangeContextAsync(Visit.Namespace, value); await PersistAsync(); }
    private async Task SearchAsync(string value) { Visit.SetSearch(value); await PersistAsync(); }
    private Task PersistAsync() => !_browserReady || _retired ? Task.CompletedTask : Visit.PersistBrowserAsync(Storage);
    private void SelectRows(HashSet<K8SResourceSummary>? rows) => Visit.SetSelected(rows ?? []);
    private void ClearSelection() => Visit.ClearSelected();
    private bool MatchesSearch(K8SResourceSummary row) => string.IsNullOrWhiteSpace(Visit.Search) || row.SearchText.Contains(Visit.Search, StringComparison.OrdinalIgnoreCase);
    private string KindLabel(K8SResourceType kind) => L[$"ResourceTypes:{kind.ToPluralDisplayName()}"];
    private string ActivityLabel() => L[Visit.Activity switch
    {
        K8SInventoryActivity.Reading => "Workbench:Activity:Reading",
        K8SInventoryActivity.Previewing => "Workbench:Activity:Previewing",
        K8SInventoryActivity.Reviewing => "Workbench:Activity:Reviewing",
        K8SInventoryActivity.Inspecting => "Workbench:Activity:Inspecting",
        K8SInventoryActivity.Executing => "Workbench:Activity:Executing",
        _ => "Workbench:Activity:Reading"
    }];
    private string CaptureLabel(K8SResourceListResult capture) => L["Workbench:Inventory:Capture", KindLabel(capture.ResourceType), capture.Namespace, capture.Items.Count, FormatTime(capture.FetchedAtUtc)];
    private string FormatTime(DateTimeOffset value) => UiTime.Format(value);

    private string GetOutcomeScope(K8SOperationOutcome outcome)
    {
        if (outcome.Failure is null) return outcome.ScopeName;
        var request = outcome.Request;
        var operation = L[request.Operation switch
        {
            K8SInventoryOperation.Restart => "Actions:Restart",
            K8SInventoryOperation.ScaleDown => "Workbench:Operation:ScaleToZero",
            K8SInventoryOperation.ScaleUp => "Workbench:Operation:RestoreReplicas",
            _ => throw new ArgumentOutOfRangeException(nameof(outcome))
        }].Value;
        return request.Scope switch
        {
            K8SOperationScope.Namespace => L["Workbench:Operation:AttemptedNamespace", operation],
            K8SOperationScope.Single => L["Workbench:Operation:AttemptedSingle", operation,
                L[$"ResourceTypes:{request.ResourceType.ToDisplayName()}"].Value, string.Join(", ", request.Names)],
            K8SOperationScope.Selected => L["Workbench:Operation:AttemptedSelected", operation,
                request.Names.Count, KindLabel(request.ResourceType), string.Join(", ", request.Names)],
            _ => throw new ArgumentOutOfRangeException(nameof(outcome))
        };
    }

    private bool IsOperationLaunchOrigin(OperationLaunchKind kind, K8SResourceSummary? row = null) =>
        _operationOrigin == new OperationLaunchOrigin(kind, row is null ? null : K8SResourceIdentity.From(row));

    private bool IsOperationLaunchDisabled(OperationLaunchKind kind, K8SResourceSummary? row = null) =>
        _retired || Visit.IsRetired || !Visit.CanOperate && !(Visit.IsBusy && IsOperationLaunchOrigin(kind, row));

    private Task OperateAsync(K8SInventoryOperation operation, K8SOperationScope scope,
        OperationLaunchKind launchKind, K8SResourceSummary? row = null)
    {
        if (_retired || Visit.IsRetired || _operationOrigin.HasValue) return Task.CompletedTask;
        var request = Visit.CreateRequest(operation, scope, row);
        if (request is null) return Task.CompletedTask;
        // Native menus focus their built-in activator before invoking this handler.
        _operationOrigin = new(launchKind, row is null ? null : K8SResourceIdentity.From(row));
        return _operationWork = OperateCoreAsync();

        async Task OperateCoreAsync()
        {
            try { await Visit.OperateAsync(request, ConfirmRestartAsync, ConfirmScaleAsync); }
            finally { _operationOrigin = null; }
        }
    }

    private bool IsInspectionOrigin(K8SResourceSummary row) =>
        _inspectionOrigin is { } origin && origin == K8SResourceIdentity.From(row);

    private Task InspectAsync(K8SResourceSummary row)
    {
        if (_retired || Visit.IsRetired || Visit.IsBusy || _inspectionOrigin.HasValue) return Task.CompletedTask;
        // Preserve the exact native opener while its inspection drains, including focus restoration.
        _inspectionOrigin = K8SResourceIdentity.From(row);
        return _inspectionWork = InspectCoreAsync();

        async Task InspectCoreAsync()
        {
            try { await Visit.DescribeAsync(row, ShowDescribeAsync); }
            finally { _inspectionOrigin = null; }
        }
    }

    private async Task ShowDescribeAsync(K8SResourceDetails details, CancellationToken token)
    {
        token.ThrowIfCancellationRequested();
        await _dialogs.ShowAsync<K8SDescribeDialog>($"{details.Summary.Kind}/{details.Summary.Name}",
            new DialogParameters<K8SDescribeDialog> { { x => x.Details, details }, { x => x.LifetimeToken, token } },
            new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true });
    }

    private async Task<bool> ConfirmRestartAsync(K8SRestartPreview preview, K8SOperationRequest request, CancellationToken token)
    {
        token.ThrowIfCancellationRequested();
        var result = await _dialogs.ShowAsync<K8SRestartConfirmDialog>(L["Workbench:Operation:RestartTitle", request.Namespace],
            new DialogParameters<K8SRestartConfirmDialog> { { x => x.Preview, preview } },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true, BackdropClick = false, CloseOnEscapeKey = true });
        return result is { Canceled: false };
    }

    private async Task<bool> ConfirmScaleAsync(K8SScalePreview preview, K8SOperationRequest request, CancellationToken token)
    {
        token.ThrowIfCancellationRequested();
        var result = await _dialogs.ShowAsync<K8SScaleConfirmDialog>(L[request.Operation == K8SInventoryOperation.ScaleDown ? "Workbench:Operation:DownTitle" : "Workbench:Operation:UpTitle", request.Namespace],
            new DialogParameters<K8SScaleConfirmDialog> { { x => x.Preview, preview } },
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true, BackdropClick = false, CloseOnEscapeKey = true });
        return result is { Canceled: false };
    }

    public ValueTask DisposeAsync() => new(_retirement ??= RetireAsync());
    private async Task RetireAsync()
    {
        _retired = true;
        var dialogs = _dialogs.DisposeAsync().AsTask();
        var visit = Visit.DisposeAsync().AsTask();
        try { await Task.WhenAll(dialogs, visit, _initialization, _browserWork, _parameterWork, _inspectionWork, _operationWork); }
        finally { _inspectionOrigin = null; _operationOrigin = null; }
    }
}
