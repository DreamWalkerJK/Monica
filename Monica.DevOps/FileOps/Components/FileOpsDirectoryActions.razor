@using Microsoft.AspNetCore.Components.Forms
@using Monica.Tool.Text
@using Monica.DevOps.FileOps.Models
@using Monica.DevOps.FileOps.State
@using Monica.DevOps.Localization
@inject IStringLocalizer<FileOpsResource> L

<div class="directory-actions-owner">
    <div class="directory-actions">
        <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@MoIcons.FolderPlus" Disabled="@(Browse?.CanCreateDirectory != true || Busy && !CreateActive)" aria-disabled="@(CreateUnavailable ? "true" : "false")" OnClick="CreateAsync">@L["Actions:CreateDirectory"]</MudButton>
        <MudTooltip Text="@UploadHint">
            <MudFileUpload T="IBrowserFile" FilesChanged="@((IBrowserFile? file) => file is null ? Task.CompletedTask : Upload.InvokeAsync(file))" MaximumFileCount="1" Disabled="@(Busy || Browse?.CanUpload != true)">
                <CustomContent Context="upload"><MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@MoIcons.FileUpload" Disabled="@(Busy || Browse?.CanUpload != true)" OnClick="upload.OpenFilePickerAsync">@L["Actions:Upload"]</MudButton></CustomContent>
                <SelectedTemplate></SelectedTemplate>
            </MudFileUpload>
        </MudTooltip>
    </div>
    @if (UploadName is not null) { <p class="upload-hint" role="status">@UploadHint</p> }
</div>

@code {
    /// <summary>The borrowed Files controller supplying accepted directory capabilities and admission state.</summary>
    [Parameter, EditorRequired] public FileOpsWorkspaceController Controller { get; set; } = null!;
    /// <summary>Reserves the connected Create opener until its native name-dialog/result chain drains.</summary>
    [Parameter] public bool CreateActive { get; set; }
    /// <summary>Opens the visit-owned native name collector for the captured accepted directory.</summary>
    [Parameter] public EventCallback Create { get; set; }
    /// <summary>Admits one captured browser file through the visit's existing overwrite contract.</summary>
    [Parameter] public EventCallback<IBrowserFile> Upload { get; set; }
    /// <summary>The captured uploading filename, or null while idle.</summary>
    [Parameter] public string? UploadName { get; set; }

    private FileOpsBrowseResult? Browse => Controller.Browse;
    private bool Busy => Controller.IsBusy;
    private bool CreateUnavailable => Busy || CreateActive || Browse?.CanCreateDirectory != true;
    private Task CreateAsync() => CreateUnavailable ? Task.CompletedTask : Create.InvokeAsync();
    private string UploadHint => UploadName is not null ? L["Workspace:Uploading", UploadName] :
        L["Location:UploadRule", Controller.RuntimeConfig?.MaxUploadFileSizeBytes.FormatByteSize() ?? "—"];
}
