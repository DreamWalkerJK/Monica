@using Monica.DevOps.FileOps.Models
@using Monica.DevOps.FileOps.State
@using Monica.DevOps.Localization
@inject IStringLocalizer<FileOpsResource> L
<section class="location-owner" aria-label="@L["Location:Label"]">
    <p class="location-label">@L["Location:CurrentDirectory"]</p>
    <div class="location-line">
        <div class="location-identity">
            <div class="location-root">
                <MudIconButton Icon="@Icons.Material.Outlined.ArrowUpward" aria-label="@L["Location:Up"]" Disabled="@(Busy || Browse?.ParentPath is null)" OnClick="@(() => Up.InvokeAsync())" />
                <MudMenu Label="@RootName" AriaLabel="@L["Location:Root", RootName]" StartIcon="@Icons.Material.Outlined.Folder" EndIcon="@Icons.Material.Filled.ExpandMore" Disabled="@Busy" Class="root-choice" title="@Browse?.CurrentRootPath">
                    @foreach (var root in Controller.RuntimeConfig?.AllowedRoots ?? [])
                    { <MudMenuItem OnClick="@(() => Navigate.InvokeAsync(root))"><span class="exact-root">@root</span></MudMenuItem> }
                </MudMenu>
            </div>
        @if (Browse is { } accepted)
        {
            <nav class="@(AtRoot ? "breadcrumbs breadcrumbs-at-root" : "breadcrumbs")" aria-label="@L["Location:Breadcrumbs"]">
                <span aria-hidden="true">/</span>
                @if (accepted.Breadcrumbs.Count > 4)
                {
                    <MudMenu Icon="@Icons.Material.Filled.MoreHoriz" AriaLabel="@L["Location:Ancestors"]" Disabled="@Busy">
                        @foreach (var segment in accepted.Breadcrumbs.Skip(1).Take(accepted.Breadcrumbs.Count - 3))
                        { <MudMenuItem OnClick="@(() => Navigate.InvokeAsync(segment.Path))">@segment.Name <span class="exact-root">@segment.Path</span></MudMenuItem> }
                    </MudMenu><span aria-hidden="true">/</span>
                    @foreach (var segment in accepted.Breadcrumbs.TakeLast(2).Take(1))
                    { <MudButton Variant="Variant.Text" Disabled="@Busy" OnClick="@(() => Navigate.InvokeAsync(segment.Path))" title="@segment.Path">@segment.Name</MudButton><span aria-hidden="true">/</span> }
                }
                else
                {
                    @foreach (var segment in accepted.Breadcrumbs.Skip(1).Take(Math.Max(0, accepted.Breadcrumbs.Count - 2)))
                    { <MudButton Variant="Variant.Text" Disabled="@Busy" OnClick="@(() => Navigate.InvokeAsync(segment.Path))" title="@segment.Path">@segment.Name</MudButton><span aria-hidden="true">/</span> }
                }
                <h2 title="@accepted.CurrentPath">@DirectoryName</h2>
            </nav>
        }
        </div>
        <div class="location-tools">
            <MudTooltip Text="@L["Location:GoToPath"]"><MudIconButton Icon="@Icons.Material.Outlined.EditLocationAlt" aria-label="@L["Location:GoToPath"]" Disabled="@Busy" OnClick="TogglePath" /></MudTooltip>
            <MudTooltip Text="@L["Actions:Refresh"]"><MudIconButton Icon="@Icons.Material.Outlined.Refresh" aria-label="@L["Actions:Refresh"]" Disabled="@Busy" OnClick="@(() => Refresh.InvokeAsync())" /></MudTooltip>
        </div>
    </div>
    @if (_pathOpen || Browse is null || PathFailed)
    {
        <div class="path-row">
            <MudTextField T="string" Value="@Controller.ProposedPath" ValueChanged="SetPath" Label="@L["Workspace:PathInput"]" Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" ReadOnly="@Busy" OnKeyDown="PathKeyAsync" Error="@PathFailed" ErrorText="@(PathFailed ? Controller.LastRead?.Message : null)" spellcheck="false" />
            <MudButton Variant="Variant.Outlined" Disabled="@(Busy || string.IsNullOrWhiteSpace(Controller.ProposedPath))" OnClick="@(() => Navigate.InvokeAsync(Controller.ProposedPath))">@L["Actions:Browse"]</MudButton>
            <MudIconButton Icon="@Icons.Material.Filled.Close" aria-label="@L["Location:DismissPath"]" Disabled="@(!CanDismissPath)" OnClick="DismissPathAsync" />
        </div>
    }
</section>
@code {
    /// <summary>The borrowed visit state; all accepted identities come from its browse evidence.</summary>
    [Parameter, EditorRequired] public FileOpsWorkspaceController Controller { get; set; } = null!;
    /// <summary>Browses an explicitly captured directory through the visit's draft guard.</summary>
    [Parameter] public EventCallback<string> Navigate { get; set; }
    /// <summary>Navigates to the accepted parent.</summary>
    [Parameter] public EventCallback Up { get; set; }
    /// <summary>Refreshes accepted evidence without replacing drafts.</summary>
    [Parameter] public EventCallback Refresh { get; set; }
    /// <summary>Cancels a pending selection reveal when an operator begins editing location input.</summary>
    [Parameter] public EventCallback Changed { get; set; }
    private bool _pathOpen;
    private FileOpsBrowseResult? Browse => Controller.Browse;
    private bool Busy => Controller.IsBusy;
    private bool PathFailed => Controller.LastRead is { Kind: FileOpsOperationKind.Browse, Succeeded: false };
    private bool AtRoot => Browse is { } browse && string.Equals(Path.TrimEndingDirectorySeparator(browse.CurrentPath), Path.TrimEndingDirectorySeparator(browse.CurrentRootPath), OperatingSystem.IsWindows() ? StringComparison.OrdinalIgnoreCase : StringComparison.Ordinal);
    private bool CanDismissPath => !Busy && !PathFailed && string.Equals(Controller.ProposedPath, Browse?.CurrentPath, StringComparison.Ordinal);
    private string RootName => Name(Browse?.CurrentRootPath);
    private string DirectoryName => Browse?.Breadcrumbs.LastOrDefault()?.Name ?? Name(Browse?.CurrentPath);
    private static string Name(string? path) => string.IsNullOrEmpty(path) ? "—" : Path.GetFileName(Path.TrimEndingDirectorySeparator(path)) is { Length: > 0 } name ? name : path;
    private async Task SetPath(string? value) { if (Busy) return; Controller.ProposedPath = value ?? ""; await Changed.InvokeAsync(); }
    private async Task TogglePath() { if (Busy) return; if (!_pathOpen && !PathFailed) Controller.ProposedPath = Browse?.CurrentPath ?? Controller.ProposedPath; _pathOpen = true; await Changed.InvokeAsync(); }
    private async Task DismissPathAsync() { if (!CanDismissPath) return; _pathOpen = false; await Changed.InvokeAsync(); }
    private async Task PathKeyAsync(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && !Busy && !string.IsNullOrWhiteSpace(Controller.ProposedPath)) await Navigate.InvokeAsync(Controller.ProposedPath);
        else if (args.Key == "Escape" && CanDismissPath) await DismissPathAsync();
    }
}
