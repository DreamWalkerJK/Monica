@using Monica.UI.Shared.Components.Dialogs
@using Monica.DevOps.FileOps.Models
@using Monica.DevOps.FileOps.State
@using Monica.Tool.Text
@implements IAsyncDisposable
<div class="policy-dialog-owner">
<MudDialog DefaultFocus="DefaultFocus.FirstChild" ContentClass="policy-content" ActionsClass="policy-footer" Style="width:calc(100vw - 32px);max-width:960px;max-height:calc(100dvh - 32px);margin:16px;overflow:hidden;border-radius:12px" OnKeyUp="KeyUpAsync" OnBackdropClick="@(_ => RequestDismissAsync())">
    <TitleContent><div class="policy-titlebar"><div class="policy-title"><MoDialogHeading Text="@L["Policy:Title"]" /><span>@L["Policy:HostMemory"]</span></div><MudIconButton Icon="@MoIcons.Close" aria-label="@L["Policy:Close"]" aria-disabled="@(Busy ? "true" : "false")" OnClick="RequestDismissAsync" /></div></TitleContent>
    <DialogContent>
<div class="policy-workspace">
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Icon="@MoIcons.Info">@L["Policy:Scope"]</MudAlert>
    @if (_accessDenied)
    { <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" role="status" Icon="@MoIcons.Warning">@L["Policy:AccessDenied"]</MudAlert> }
    else if (!_initialized)
    {
        @if (Busy) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="@L["Policy:Loading"]" /> }
        <FileOpsOutcomeView Outcome="@_read" />
    }
    else
    {
        @if (Busy) { <MudProgressLinear Indeterminate="true" Color="Color.Primary" aria-label="@L["Workspace:Working"]" /> }
        <section class="policy-surface" aria-label="@L["Policy:Form"]">
            <div class="policy-groups">
                <section class="policy-locations"><h2>@L["Policy:Locations"]</h2>
                    <div class="technical-fields">
                        <MudTextField T="string" Label="@L["Policy:AllowedRoots"]" HelperText="@L["Policy:RootsHelper"]" Value="@_roots" ValueChanged="SetRoots" Lines="2" Sizing="InputSizing.Auto" MaxLines="12" Variant="Variant.Outlined" Immediate="true" spellcheck="false" />
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Icon="@MoIcons.Warning">@L["Policy:EmptyRoots"]</MudAlert>
                        <MudTextField T="string" Label="@L["Policy:Startup"]" HelperText="@L["Policy:StartupHelper"]" Value="@_draft.StartupPath" ValueChanged="SetStartup" Variant="Variant.Outlined" Immediate="true" spellcheck="false" />
                        <MudTextField T="string" Label="@L["Policy:ReadOnlyPaths"]" HelperText="@L["Policy:ReadOnlyHelper"]" Value="@_readOnly" ValueChanged="SetReadOnly" Lines="2" Sizing="InputSizing.Auto" MaxLines="12" Variant="Variant.Outlined" Immediate="true" spellcheck="false" />
                    </div>
                </section>
                <div class="policy-right">
                    <section><h2>@L["Policy:Operations"]</h2><div class="switch-rows">
                        <div><MudSwitch T="bool" Value="@_draft.AllowWriteOperations" ValueChanged="SetWrite" Color="Color.Primary" Label="@L["Policy:AllowWrite"]" /><p>@L["Policy:WriteHelper"]</p></div>
                        <div><MudSwitch T="bool" Value="@_draft.AllowDeleteOperations" ValueChanged="SetDelete" Color="@(_draft.AllowDeleteOperations ? Color.Warning : Color.Default)" Label="@L["Policy:AllowDelete"]" /><p>@L["Policy:DeleteHelper"]</p></div>
                        <div><MudSwitch T="bool" Value="@_draft.AllowHiddenEntries" ValueChanged="SetHidden" Color="@(_draft.AllowHiddenEntries ? Color.Info : Color.Default)" Label="@L["Policy:AllowHidden"]" /><p>@L["Policy:HiddenHelper"]</p></div>
                    </div></section>
                    <section><h2>@L["Policy:Limits"]</h2><div class="limit-fields">
                        <MudNumericField T="long" Label="@L["Policy:MaxText"]" HelperText="@L["Policy:TextLimitHelper", _draft.MaxTextFileSizeBytes.FormatByteSize()]" Value="@_draft.MaxTextFileSizeBytes" ValueChanged="SetTextLimit" Min="4096" Variant="Variant.Outlined" Immediate="true" Error="@(_draft.MaxTextFileSizeBytes < 4096)" ErrorText="@L["Policy:TextMinimum"]" />
                        <MudNumericField T="long" Label="@L["Policy:MaxUpload"]" HelperText="@L["Policy:UploadLimitHelper", _draft.MaxUploadFileSizeBytes.FormatByteSize()]" Value="@_draft.MaxUploadFileSizeBytes" ValueChanged="SetUploadLimit" Min="65536" Variant="Variant.Outlined" Immediate="true" Error="@(_draft.MaxUploadFileSizeBytes < 65536)" ErrorText="@L["Policy:UploadMinimum"]" />
                        <MudNumericField T="long" Label="@L["Policy:MaxDownload"]" HelperText="@L["Policy:DownloadLimitHelper", _draft.MaxDownloadFileSizeBytes.FormatByteSize()]" Value="@_draft.MaxDownloadFileSizeBytes" ValueChanged="SetDownloadLimit" Min="65536" Variant="Variant.Outlined" Immediate="true" Error="@(_draft.MaxDownloadFileSizeBytes < _draft.MaxUploadFileSizeBytes)" ErrorText="@L["Policy:DownloadMinimum"]" />
                        <MudNumericField T="int" Label="@L["Policy:MaxEntries"]" HelperText="@L["Policy:EntriesHelper"]" Value="@_draft.MaxDirectoryEntries" ValueChanged="SetEntryLimit" Min="50" Max="5000" Variant="Variant.Outlined" Immediate="true" Error="@(_draft.MaxDirectoryEntries < 50 || _draft.MaxDirectoryEntries > 5000)" ErrorText="@L["Policy:EntryRange"]" />
                    </div></section>
                    <section><h2>@L["Policy:TextEditing"]</h2><div class="technical-fields"><MudTextField T="string" Label="@L["Policy:Extensions"]" HelperText="@L["Policy:ExtensionsHelper"]" Value="@_extensions" ValueChanged="SetExtensions" Lines="2" Sizing="InputSizing.Auto" MaxLines="12" Variant="Variant.Outlined" Immediate="true" spellcheck="false" /></div></section>
                </div>
            </div>
            <div class="policy-outcomes">
                <FileOpsOutcomeView Outcome="@_command" ShowSuccess="true" />
                <FileOpsOutcomeView Outcome="@_read" />
                @if (_newerEdits) { <p class="newer-edits">@L["Policy:NewerEdits"]</p> }
                @if (_readbackFailed)
                { <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Icon="@MoIcons.Warning">@L["Policy:ReadbackFailed"]</MudAlert> }
            </div>

        </section>
    }
</div>

    </DialogContent>
    <DialogActions><footer class="policy-actions">
        <span><MoIcon Size="1.25rem" Icon="@(Dirty ? MoIcons.Edit : MoIcons.Check)" Style="@(Dirty ? "color:var(--mud-palette-warning);" : "color:var(--mud-palette-text-secondary);")" />@L[!_initialized ? "Policy:NotLoaded" : Dirty ? "Inspector:Unsaved" : "Policy:NoChanges"]</span>
        <div><MudButton @ref="_closeButton" aria-disabled="@(Busy ? "true" : "false")" OnClick="RequestDismissAsync">@L["Policy:Close"]</MudButton>
            <MudButton Variant="Variant.Outlined" Disabled="@(Busy && !_reloadActive)" aria-disabled="@(Busy ? "true" : "false")" OnClick="ReloadAsync">@L["Policy:Reload"]</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@MoIcons.Check" aria-disabled="@(Busy || _accessDenied || !Dirty || !Valid ? "true" : "false")" OnClick="ApplyAsync">@L["Policy:Apply"]</MudButton>
        </div>
    </footer></DialogActions>
</MudDialog>
</div>
