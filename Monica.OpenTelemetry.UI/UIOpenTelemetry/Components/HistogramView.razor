@using System.Globalization
@inject IStringLocalizer<OpenTelemetryUIResource> L

@if (Histogram is { } histogram)
{
    <section class="histogram-panel" aria-label="@L["Histogram:WindowTitle"]">
        <header class="histogram-heading"><div><span>@L["Histogram:Percentiles"]</span><h3>@L["Histogram:WindowTitle"]</h3></div><span>@L["Histogram:FiniteCount", histogram.Count]</span></header>
        <p class="histogram-help">@L["Histogram:WindowHelp"]</p>
        @if (histogram.NonFiniteSampleCount > 0) { <p class="histogram-help">@L["Histogram:Excluded", histogram.NonFiniteSampleCount]</p> }
        <div class="histogram-percentiles"><div><span>@L["Histogram:P50"]</span><strong>@Format(histogram.P50)</strong></div><div class="percentile-focus"><span>@L["Histogram:P95"]</span><strong>@Format(histogram.P95)</strong></div><div><span>@L["Histogram:P99"]</span><strong>@Format(histogram.P99)</strong></div></div>
        <dl class="histogram-statistics"><div><dt>@L["Histogram:Average"]</dt><dd>@Format(histogram.Average)</dd></div><div><dt>@L["Histogram:Min"]</dt><dd>@Format(histogram.Min)</dd></div><div><dt>@L["Histogram:Max"]</dt><dd>@Format(histogram.Max)</dd></div></dl>
        <h4>@L["Histogram:Distribution"]</h4><p class="histogram-help">@L["Histogram:BucketHelp"]</p>
        <div class="histogram-buckets">
            @foreach (var bucket in histogram.Buckets)
            {
                <div class="histogram-bucket" data-lower-bound="@Raw(bucket.LowerBound)" data-upper-bound="@Raw(bucket.UpperBound)" data-bucket-count="@bucket.Count"><span class="bucket-bounds" title="@(Raw(bucket.LowerBound) + " – " + Raw(bucket.UpperBound))">@Format(bucket.LowerBound) – @Format(bucket.UpperBound)</span><div class="bucket-track" aria-hidden="true"><div class="bucket-fill" style="width:@Percentage(bucket.Count)"></div></div><code>@bucket.Count</code></div>
            }
        </div>
    </section>
}

@code {
    /// <summary>Gets or sets finite-only statistics from one actual bounded retained series.</summary>
    [Parameter] public HistogramSnapshot? Histogram { get; set; }
    /// <summary>Gets or sets the instrument's unchanged declared unit.</summary>
    [Parameter] public string? Unit { get; set; }
    private long MaxBucketCount => Histogram is { Buckets.Count: > 0 } histogram ? Math.Max(1, histogram.Buckets.Max(bucket => bucket.Count)) : 1;
    private string Format(double value) => MetricValueFormatter.Format(value, Unit, L);
    private string Percentage(long count) => $"{(count * 100d / MaxBucketCount).ToString("0.####", CultureInfo.InvariantCulture)}%";
    private static string Raw(double value) => value.ToString("G17", CultureInfo.InvariantCulture);
}
